module

public import Lean.Elab.Import
public import Lean.Elab.Frontend
public import Scripts.Dead.Census
public import Scripts.Pack.Residue

@[expose] public section Blanket

/-!
# `lake run dead-census [-- -C ROOT] [--check | --write]` — the dead-declaration census

DOCS items 476 / 477.  Loads the built environment of `L4YAML`, `Tests.Guards`,
`Tests.AdversarialInstantiation` and `Tests.Reflections`, runs `Scripts.Dead.Census.classify`
and prints the summary and the three per-module tables.  `--check` compares the summary with
`expectedDeadCensus` (`Tests/Guards/Proofs/DeadDeclarationCensus.lean`) and the (B) roster with
`Tests/Guards/Proofs/DeadDeclarationRoster.lean`'s set, and exits 1 when either moved — a name
ENTERING the roster is the finding Rule 1 exists for; one LEAVING it was deleted or reached.
`--write` rewrites both pins to the fresh reading (read every change: a pin is a decision).
-/

open Lean
open Scripts.Dead.Census

namespace Scripts.Main.DeadCensus

def guardFile := "Tests/Guards/Proofs/DeadDeclarationCensus.lean"
def rosterFile := "Tests/Guards/Proofs/DeadDeclarationRoster.lean"

def die (msg : String) (code : UInt32 := 1) : IO UInt32 := do
  IO.eprintln msg; return code

/-- The literal of `def NAME : String :=` on the line after the head. -/
def pinString? (text name : String) : Option String := do
  let after ← (text.splitOn s!"def {name} : String :=")[1]?
  let t := after.trimAscii.toString
  let '"' :: body := t.toList | none
  some (String.ofList (body.takeWhile (· != '"')))

/-- The roster file's raw-string body: everything between the opening `r"` line and the closing `"`. -/
def rosterBody? (text : String) : Option String := do
  let after ← (text.splitOn "r\"\n")[1]?
  (after.splitOn "\n\"")[0]?

def rosterSource (body : String) : String :=
  "/-!\n# The dead-declaration roster — class (B), pinned as a SET (DOCS item 477)\n\nGenerated by `lake run dead-census -- --write`; checked by `-- --check`.  One fully-qualified\nname per line with its kind; sorted.  Shrink-only: a name leaves when it is deleted or a\ncapstone reaches it; a name entering needs the owner's word (Rule 1).  Not edited by hand.\n-/\n\nnamespace L4YAML.Tests.Guards.DeadDeclarationRoster\n\ndef expectedDeadRoster : String := r\"\n" ++ body ++ "\n\"\n\nend L4YAML.Tests.Guards.DeadDeclarationRoster\n"

def replacePin (text name value : String) : String :=
  match text.splitOn s!"def {name} : String :=" with
  | [pre, post] =>
    let rest := ((post.splitOn "\n").drop 1).dropWhile (fun l => l.trimAscii.startsWith "\"")
    pre ++ s!"def {name} : String :=\n  \"{value}\"" ++ "\n" ++ "\n".intercalate rest
  | _ => text

unsafe def run (args : List String) : IO UInt32 := do
  let args := if args.headD "" == "--" then args.drop 1 else args
  let root := match args.dropWhile (· != "-C") with
    | _ :: r :: _ => r
    | _ => "."
  let check := args.contains "--check"
  let write := args.contains "--write"
  let root ← IO.FS.realPath root
  enableInitializersExecution
  let r ← IO.Process.output { cmd := "lean", args := #["--print-prefix"], cwd := some root }
  if r.exitCode != 0 then return ← die s!"lean --print-prefix failed in {root}: {r.stderr}"
  initSearchPath (System.FilePath.mk r.stdout.trimAscii.toString) [root / ".lake" / "build" / "lib" / "lean"]
  let text := "import L4YAML\nimport Tests.Guards\nimport Tests.AdversarialInstantiation\nimport Tests.Reflections\n"
  let ictx := Parser.mkInputContext text "<dead-census>"
  let (hdr, _, msgs) ← Parser.parseHeader ictx
  let (env, msgs) ← Elab.processHeader hdr {} msgs ictx
  if msgs.hasErrors then
    for m in msgs.toList do IO.eprint (← m.toString)
    return ← die "the environment did not load (build L4YAML, Tests.Guards, Tests.AdversarialInstantiation, Tests.Reflections first)"
  let bpText ← IO.FS.readFile (root / "scripts" / "blueprint-capstones.txt")
  let bpRows : List String := (bpText.splitOn "\n").filterMap fun (l : String) =>
    let l : String := l.trimAscii.toString
    if l.isEmpty || l.startsWith "#" then none else (l.splitOn " ").getLast?
  let rep := classify env bpRows
  IO.print (rep.render)
  if write then
    let guard ← IO.FS.readFile (root / guardFile)
    IO.FS.writeFile (root / guardFile) (replacePin guard "expectedDeadCensus" rep.summary)
    IO.FS.writeFile (root / rosterFile) (rosterSource rep.rosterText)
    IO.println s!"wrote {guardFile} and {rosterFile} ({rep.roster.size} names)"
    return 0
  if check then
    let guard ← IO.FS.readFile (root / guardFile)
    let some pinned := pinString? guard "expectedDeadCensus" | return ← die s!"{guardFile}: expectedDeadCensus not found"
    let rosterText ← IO.FS.readFile (root / rosterFile)
    let some body := rosterBody? rosterText | return ← die s!"{rosterFile}: roster body not found"
    let (entered, left, kindChanged) := rosterDiff body rep.rosterText
    let mut bad := false
    if pinned != rep.summary then
      bad := true
      IO.eprintln s!"DEAD-CENSUS: the summary moved.\nexpected: {pinned}\ngot:      {rep.summary}"
    if !entered.isEmpty then
      bad := true
      IO.eprintln s!"DEAD-CENSUS: {entered.length} declaration(s) ENTERED the roster (reached by no capstone, export or test; Rule 1 asks for the chain or the deletion):"
      for e in entered.take 40 do IO.eprintln s!"  + {e}"
    if !left.isEmpty then
      IO.eprintln s!"DEAD-CENSUS: {left.length} declaration(s) left the roster (deleted or reached) — re-pin with --write:"
      for e in left.take 40 do IO.eprintln s!"  - {e}"
      bad := true
    if !kindChanged.isEmpty then
      bad := true
      IO.eprintln s!"DEAD-CENSUS: {kindChanged.length} roster declaration(s) changed kind (the name stays; re-pin with --write):"
      for e in kindChanged.take 40 do IO.eprintln s!"  ~ {e}"
    if bad then return 1
    IO.println s!"DEAD-CENSUS agrees with {guardFile} and {rosterFile}"
  return 0

end Scripts.Main.DeadCensus

public unsafe def main (args : List String) : IO UInt32 := Scripts.Main.DeadCensus.run args
