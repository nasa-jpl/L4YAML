example {k : Nat} {sp_start sp_scan sp_ind : SurfPos} {nsU : List Nat}
    (h_lit : GLit '?' sp_ind sp_scan)
    (up : ∀ nv ∈ nsU, ∀ sp_v : SurfPos, SBlockMapEntry k sp_ind sp_v →
