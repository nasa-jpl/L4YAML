          (SBlockIndented.node 4 .blockOut sp_scan sp_m
            (L4YAML.Proofs.NodeProduction.SBlockNode_blockIn_to_blockOut h_node))
          h_iv h_lit h_sbi))
    · exact absurd h' (List.not_mem_nil)
