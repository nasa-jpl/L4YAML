#guard pins "?\n  a: 1\n  c: b\n: w\n" == ("scan-accepted", "+STR +DOC +MAP +MAP =VAL :a =VAL :1 =VAL :c =VAL :b -MAP =VAL :w -MAP -DOC -STR")

/-! …and the CONTROLS.  Without the frame the same collection keys the root's
