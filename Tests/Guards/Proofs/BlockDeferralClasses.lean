#guard pins "?\nk: v\n: w\n" == ("scan-accepted", "+STR +DOC +MAP =VAL : =VAL : =VAL :k =VAL :v =VAL : =VAL :w -MAP -DOC -STR")
#guard pins "?\n  k: v\n: w\n" == ("scan-accepted", "+STR +DOC +MAP +MAP =VAL :k =VAL :v -MAP =VAL :w -MAP -DOC -STR")

