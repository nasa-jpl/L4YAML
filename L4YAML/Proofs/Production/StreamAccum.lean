/-- A flow collection's closing indicator is the last consumed char at its park. -/
lemma scanFlowSequenceEnd_peekBack {s : ScannerState} {sp : SurfPos}
    (hcorr : ScannerSurfCorr s sp) (hpeek : s.peek? = some ']') :
    (scanFlowSequenceEnd s).peekBack? = some ']' := by
  have h := advance_peekBack_of_peek
    (L4YAML.Proofs.StructureCoupling.corr_of_emit .flowSequenceEnd hcorr) hpeek
    (by decide) (by decide)
  first | exact h | simpa [scanFlowSequenceEnd, ScannerState.peekBack?] using h

lemma scanFlowMappingEnd_peekBack {s : ScannerState} {sp : SurfPos}
    (hcorr : ScannerSurfCorr s sp) (hpeek : s.peek? = some '}') :
    (scanFlowMappingEnd s).peekBack? = some '}' := by
  have h := advance_peekBack_of_peek
    (L4YAML.Proofs.StructureCoupling.corr_of_emit .flowMappingEnd hcorr) hpeek
    (by decide) (by decide)
  first | exact h | simpa [scanFlowMappingEnd, ScannerState.peekBack?] using h

/-- `peekBack?` reads only `offset`/`input`: a state sitting where `(s.emit tok).advance`
    sits has the advanced char behind it. -/
lemma peekBack_of_emit_advance {s t : ScannerState} {sp : SurfPos} {c : Char}
    (tok : YamlToken) (hcorr : ScannerSurfCorr s sp) (hpk : s.peek? = some c)
    (hnl : c ≠ '\n') (hcr : c ≠ '\r')
    (hoff : t.offset = ((s.emit tok).advance).offset) (hin : t.input = s.input) :
    t.peekBack? = some c := by
  have h := advance_peekBack_of_peek
    (L4YAML.Proofs.StructureCoupling.corr_of_emit tok hcorr) hpk hnl hcr
  have hin' : ((s.emit tok).advance).input = s.input :=
    L4YAML.Proofs.CouplingBridge.advance_input _
  unfold ScannerState.peekBack? at h ⊢
  rw [hoff, hin, ← hin']; exact h

/-- `advance` reads only `offset`/`input`/`inputEnd`. -/
lemma advance_offset_input_congr {a b : ScannerState}
    (ho : a.offset = b.offset) (hi : a.input = b.input) (he : a.inputEnd = b.inputEnd) :
    a.advance.offset = b.advance.offset ∧ a.advance.input = b.advance.input := by
  simp only [ScannerState.advance, ho, hi, he]
  repeat' split
  all_goals first | exact ⟨rfl, rfl⟩ | simp_all

/-- `-` is the last consumed char at a block-entry park. -/
lemma scanBlockEntry_peekBack {s s' : ScannerState} {sp : SurfPos}
    (hcorr : ScannerSurfCorr s sp) (h_noflow : s.inFlow = false) (hpk : s.peek? = some '-')
    (hok : scanBlockEntry s = .ok s') : s'.peekBack? = some '-' := by
  unfold scanBlockEntry at hok
  simp only [bind, Except.bind, h_noflow, Bool.not_false, ite_true] at hok
  split at hok
  · simp at hok
  · split at hok
    · simp at hok
    split at hok
    · simp at hok
    simp only [Except.ok.injEq] at hok
    subst hok
    have hps : (pushSequenceIndent s ↑s.col).offset = s.offset ∧
        (pushSequenceIndent s ↑s.col).input = s.input ∧
        (pushSequenceIndent s ↑s.col).inputEnd = s.inputEnd := by
      unfold pushSequenceIndent; split <;> exact ⟨rfl, rfl, rfl⟩
    have hc := advance_offset_input_congr (a := (pushSequenceIndent s ↑s.col).emit .blockEntry)
      (b := s.emit .blockEntry) hps.1 hps.2.1 hps.2.2
    have hin' : ((s.emit .blockEntry).advance).input = s.input :=
      L4YAML.Proofs.CouplingBridge.advance_input _
    exact peekBack_of_emit_advance .blockEntry hcorr hpk (by decide) (by decide) hc.1
      (hc.2.trans hin')

/-- `?` is the last consumed char at an explicit-key park. -/
lemma scanKey_peekBack {s s' : ScannerState} {sp : SurfPos}
    (hcorr : ScannerSurfCorr s sp) (hpk : s.peek? = some '?')
    (hok : scanKey s = .ok s') : s'.peekBack? = some '?' := by
  have hpm : (pushMappingIndent s ↑s.col).offset = s.offset ∧
      (pushMappingIndent s ↑s.col).input = s.input ∧
      (pushMappingIndent s ↑s.col).inputEnd = s.inputEnd := by
    unfold pushMappingIndent; split <;> exact ⟨rfl, rfl, rfl⟩
  have hin' : ((s.emit .key).advance).input = s.input :=
    L4YAML.Proofs.CouplingBridge.advance_input _
  unfold scanKey at hok
  simp only [bind, Except.bind] at hok
  repeat (any_goals (split at hok))
  all_goals (try contradiction)
  all_goals (simp only [Except.ok.injEq] at hok; subst hok)
  all_goals first
    | exact peekBack_of_emit_advance .key hcorr hpk (by decide) (by decide) rfl hin'
    | (have hc := advance_offset_input_congr (a := (pushMappingIndent s ↑s.col).emit .key)
        (b := s.emit .key) hpm.1 hpm.2.1 hpm.2.2
       exact peekBack_of_emit_advance .key hcorr hpk (by decide) (by decide) hc.1
         (hc.2.trans hin'))

/-- `:` is the last consumed char at a value-indicator park. -/
lemma scanValue_peekBack {s s' : ScannerState} {sp : SurfPos}
    (hcorr : ScannerSurfCorr s sp) (hpk : s.peek? = some ':')
    (hok : scanValue s = .ok s') : s'.peekBack? = some ':' := by
  have hsv : (scanValuePrepare (scanValueClearKey s)).offset = s.offset ∧
      (scanValuePrepare (scanValueClearKey s)).input = s.input ∧
      (scanValuePrepare (scanValueClearKey s)).inputEnd = s.inputEnd := by
    refine ⟨by rw [L4YAML.Proofs.ScannerCorrectness.svp_offset,
                  L4YAML.Proofs.ScannerCorrectness.svck_offset], ?_,
            by rw [L4YAML.Proofs.ScannerCorrectness.svp_inputEnd,
                  L4YAML.Proofs.ScannerCorrectness.svck_inputEnd]⟩
    have hpmi : ∀ (t : ScannerState) (c : Int), (pushMappingIndent t c).input = t.input := by
      intro t c; unfold pushMappingIndent; split <;> rfl
    unfold scanValuePrepare scanValueClearKey
    repeat' split
    all_goals first | rfl | simp [hpmi]
  have hin' : ((s.emit .value).advance).input = s.input :=
    L4YAML.Proofs.CouplingBridge.advance_input _
  have hc := advance_offset_input_congr
    (a := (scanValuePrepare (scanValueClearKey s)).emit .value)
    (b := s.emit .value) hsv.1 hsv.2.1 hsv.2.2
  unfold scanValue at hok
  simp only [bind, Except.bind] at hok
  repeat (any_goals (split at hok))
  all_goals (try contradiction)
  all_goals (simp only [Except.ok.injEq] at hok; subst hok)
  all_goals (refine peekBack_of_emit_advance .value hcorr hpk (by decide) (by decide) ?_ ?_
             · exact hc.1
             · exact hc.2.trans hin')

/-- A flow-context park owes no block gate. -/
lemma noPending_gate_of_inFlow {s : ScannerState} {sp : SurfPos} (h : s.inFlow = true) :
    s.inFlow = false → sp.col ≠ 0 → ¬ (CommentOk s ∧ s.peek? = some '#') :=
  fun hnf => absurd h (by rw [hnf]; simp)

/-- The park comment gate, read at the surface column, from a non-white last char. -/
lemma gate_of_peekBack {s : ScannerState} {sp : SurfPos} {c : Char}
    (hcorr : ScannerSurfCorr s sp) (hpb : s.peekBack? = some c)
    (hc : (isWhiteSpaceBool c || isLineBreakBool c || c == '\uFEFF') = false) :
    sp.col ≠ 0 → ¬ (CommentOk s ∧ s.peek? = some '#') :=
  fun hcol hh => CommentOk_false_of_peekBack (by rw [← hcorr.col_eq]; exact hcol) hpb hc hh.1

/-- The park comment gate, read at the surface column, from a next char that is not `#`. -/
lemma gate_of_peek {s : ScannerState} {sp : SurfPos} (h : s.peek? ≠ some '#') :
    sp.col ≠ 0 → ¬ (CommentOk s ∧ s.peek? = some '#') :=
  fun _ hh => h hh.2

/-- The gate behind a landed `:`. -/
lemma gate_of_value {s s' : ScannerState} {sp sp' : SurfPos}
    (hcorr : ScannerSurfCorr s sp) (hpk : s.peek? = some ':')
    (hok : scanValue s = .ok s') (hcorr' : ScannerSurfCorr s' sp') :
    sp'.col ≠ 0 → ¬ (CommentOk s' ∧ s'.peek? = some '#') :=
  gate_of_peekBack hcorr' (scanValue_peekBack hcorr hpk hok) (by decide)

/-- The gate behind a landed `?`. -/
lemma gate_of_key {s s' : ScannerState} {sp sp' : SurfPos}
    (hcorr : ScannerSurfCorr s sp) (hpk : s.peek? = some '?')
    (hok : scanKey s = .ok s') (hcorr' : ScannerSurfCorr s' sp') :
    sp'.col ≠ 0 → ¬ (CommentOk s' ∧ s'.peek? = some '#') :=
  gate_of_peekBack hcorr' (scanKey_peekBack hcorr hpk hok) (by decide)

/-- The gate behind a landed `-`. -/
lemma gate_of_blockEntry {s s' : ScannerState} {sp sp' : SurfPos}
    (hcorr : ScannerSurfCorr s sp) (h_noflow : s.inFlow = false) (hpk : s.peek? = some '-')
    (hok : scanBlockEntry s = .ok s') (hcorr' : ScannerSurfCorr s' sp') :
    sp'.col ≠ 0 → ¬ (CommentOk s' ∧ s'.peek? = some '#') :=
  gate_of_peekBack hcorr' (scanBlockEntry_peekBack hcorr h_noflow hpk hok) (by decide)

/-- A surface-column gate read at the scanner column. -/
lemma gate_sc {s : ScannerState} {sp : SurfPos} {P : Prop} (hcorr : ScannerSurfCorr s sp)
    (h : sp.col ≠ 0 → P) : s.col ≠ 0 → P :=
  fun hc => h (by rw [hcorr.col_eq]; exact hc)

/-- `peek?`/`peekAt?` read only `offset`/`input`/`inputEnd`. -/
lemma peek_congr {a b : ScannerState} (ho : a.offset = b.offset) (hi : a.input = b.input)
    (he : a.inputEnd = b.inputEnd) : a.peek? = b.peek? ∧ ∀ n, a.peekAt? n = b.peekAt? n := by
  constructor
  · unfold ScannerState.peek?; rw [ho, hi, he]
  · intro n; unfold ScannerState.peekAt?; rw [ho, hi, he]

lemma advance_congr {a b : ScannerState}
    (ho : a.offset = b.offset) (hi : a.input = b.input) (he : a.inputEnd = b.inputEnd) :
    a.advance.offset = b.advance.offset ∧ a.advance.input = b.advance.input ∧
      a.advance.inputEnd = b.advance.inputEnd := by
  simp only [ScannerState.advance, ho, hi, he]
  repeat' split
  all_goals first | exact ⟨rfl, rfl, rfl⟩ | simp_all

lemma noflow_of_fl0 {s : ScannerState} (h : s.flowLevel = 0) : s.inFlow = false := by
  unfold ScannerState.inFlow; rw [h]; rfl

/-- What the scanner lets follow a park at an indicator or a property: nothing,
    a blank, or a flow-entry close.  Never `#`, never `[`/`{`. -/
def NextIsSep (s : ScannerState) : Prop :=
  match s.peek? with
  | none => True
  | some ch => (isBlankBool ch || ch == ',' || ch == ']' || ch == '}') = true

lemma NextIsSep.gate {s : ScannerState} (h : NextIsSep s) :
    ¬ (CommentOk s ∧ s.peek? = some '#') := by
  intro hh; unfold NextIsSep at h; rw [hh.2] at h; exact absurd h (by decide)

lemma NextIsSep.not_open {s : ScannerState} {c : Char} (h : NextIsSep s)
    (hpk : s.peek? = some c) (hc : c = '[' ∨ c = '{') : False := by
  unfold NextIsSep at h; rw [hpk] at h
  rcases hc with rfl | rfl <;> exact absurd h (by decide)

/-- A flow open glued to a separator-expecting park is not what the scanner read. -/
lemma eps_refuted_of_next {sc s_prep : ScannerState} {sp sp_prep : SurfPos} {c : Char}
    (h_next : NextIsSep sc) (h_corr : ScannerSurfCorr sc sp)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (hpk : s_prep.peek? = some c) (hc : c = '[' ∨ c = '{') (heq : sp_prep = sp) : False := by
  subst heq
  obtain ⟨rest, hsp⟩ := ScalarProduction.peek_some_sp hcorr_prep hpk
  have hhead : sp_prep.chars = c :: rest := by rw [hsp]
  exact h_next.not_open (L4YAML.Proofs.LandingTab.peek_of_head h_corr hhead) hc

lemma resolve_eps_of_next {A : Prop} {sc s_prep : ScannerState} {sp sp_gram sp_prep : SurfPos}
    {c : Char} (h_next : NextIsSep sc) (h_corr : ScannerSurfCorr sc sp)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (hpk : s_prep.peek? = some c) (hc : c = '[' ∨ c = '{')
    (h : A ∨ (sp_prep = sp ∧ sp_gram = sp ∧ 0 < sp.col)) : A :=
  h.resolve_right (fun hh => eps_refuted_of_next h_next h_corr hcorr_prep hpk hc hh.1)

/-- A landing the scanner then reads a char at is at column 0, not at eof. -/
lemma col0_of_ssl_landing {sp sp_mid : SurfPos} {s_prep : ScannerState} {c : Char}
    (h_ssl : SSLComments sp sp_mid) (hcorr : ScannerSurfCorr s_prep sp_mid)
    (hpk : s_prep.peek? = some c) : sp_mid.col = 0 := by
  rcases SSLComments_end_col0_or_eof h_ssl with h | h
  · exact h
  · obtain ⟨rest, hsp⟩ := ScalarProduction.peek_some_sp hcorr hpk
    rw [hsp] at h; cases h

lemma nextIsSep_of_propertyFollowerOk {s : ScannerState} (h : propertyFollowerOk s = true) :
    NextIsSep s := by
  unfold NextIsSep
  split
  · trivial
  · rename_i ch hpk
    unfold propertyFollowerOk at h; rw [hpk] at h
    simpa [isBlankBool] using h

/-- One char consumed past a blank-or-end lookahead: the next char is a separator. -/
lemma nextIsSep_of_peekAt_one {s t : ScannerState} {c : Char} (hpk : s.peek? = some c)
    (ho : t.offset = s.advance.offset) (hi : t.input = s.input) (he : t.inputEnd = s.inputEnd)
    (hcand : (match s.peekAt? 1 with | some n => isBlankBool n | none => true) = true) :
    NextIsSep t := by
  have hadv : s.advance.input = s.input := L4YAML.Proofs.CouplingBridge.advance_input _
  have hadvE : s.advance.inputEnd = s.inputEnd := L4YAML.Proofs.CouplingBridge.advance_inputEnd _
  have ht : t.peek? = s.advance.peek? :=
    (peek_congr ho (hi.trans hadv.symm) (he.trans hadvE.symm)).1
  unfold NextIsSep
  rw [ht, L4YAML.Proofs.ScannerPlainContent.advance_peek_eq_peekAt_one s c hpk]
  split at hcand <;> rename_i heq <;> rw [heq] <;> simp_all

lemma nextIsSep_of_scanValue {s s' : ScannerState} (h_noflow : s.inFlow = false)
    (hpk : s.peek? = some ':') (hcand : isValueCandidate s = true)
    (hok : scanValue s = .ok s') : NextIsSep s' := by
  have hsv : (scanValuePrepare (scanValueClearKey s)).offset = s.offset ∧
      (scanValuePrepare (scanValueClearKey s)).input = s.input ∧
      (scanValuePrepare (scanValueClearKey s)).inputEnd = s.inputEnd := by
    refine ⟨by rw [L4YAML.Proofs.ScannerCorrectness.svp_offset,
                  L4YAML.Proofs.ScannerCorrectness.svck_offset], ?_,
            by rw [L4YAML.Proofs.ScannerCorrectness.svp_inputEnd,
                  L4YAML.Proofs.ScannerCorrectness.svck_inputEnd]⟩
    have hpmi : ∀ (t : ScannerState) (c : Int), (pushMappingIndent t c).input = t.input := by
      intro t c; unfold pushMappingIndent; split <;> rfl
    unfold scanValuePrepare scanValueClearKey
    repeat' split
    all_goals first | rfl | simp [hpmi]
  have hc := advance_congr (a := (scanValuePrepare (scanValueClearKey s)).emit .value)
    (b := s) hsv.1 hsv.2.1 hsv.2.2
  have hcand' : (match s.peekAt? 1 with | some n => isBlankBool n | none => true) = true := by
    unfold isValueCandidate at hcand
    simp only [h_noflow, Bool.false_and, Bool.false_eq_true, ite_false, Bool.or_false] at hcand
    first | exact hcand | (split at hcand <;> simp_all)
  unfold scanValue at hok
  simp only [bind, Except.bind] at hok
  repeat (any_goals (split at hok))
  all_goals (try contradiction)
  all_goals (simp only [Except.ok.injEq] at hok; subst hok)
  all_goals (refine nextIsSep_of_peekAt_one hpk ?_ ?_ ?_ hcand'
             · exact hc.1
             · exact hc.2.1.trans (L4YAML.Proofs.CouplingBridge.advance_input _)
             · exact hc.2.2.trans (L4YAML.Proofs.CouplingBridge.advance_inputEnd _))

lemma nextIsSep_of_scanKey {s s' : ScannerState} (h_noflow : s.inFlow = false)
    (hpk : s.peek? = some '?') (hcand : isKeyCandidate s = true)
    (hok : scanKey s = .ok s') : NextIsSep s' := by
  have hpm : (pushMappingIndent s ↑s.col).offset = s.offset ∧
      (pushMappingIndent s ↑s.col).input = s.input ∧
      (pushMappingIndent s ↑s.col).inputEnd = s.inputEnd := by
    unfold pushMappingIndent; split <;> exact ⟨rfl, rfl, rfl⟩
  have hc := advance_congr (a := (pushMappingIndent s ↑s.col).emit .key) (b := s)
    hpm.1 hpm.2.1 hpm.2.2
  have hc0 := advance_congr (a := s.emit .key) (b := s) rfl rfl rfl
  have hcand' : (match s.peekAt? 1 with | some n => isBlankBool n | none => true) = true := by
    unfold isKeyCandidate at hcand
    simp only [h_noflow, Bool.false_and, Bool.or_false] at hcand
    first | exact hcand | (split at hcand <;> simp_all)
  unfold scanKey at hok
  simp only [bind, Except.bind] at hok
  repeat (any_goals (split at hok))
  all_goals (try contradiction)
  all_goals (simp only [Except.ok.injEq] at hok; subst hok)
  all_goals first
    | (refine nextIsSep_of_peekAt_one hpk ?_ ?_ ?_ hcand'
       · exact hc0.1
       · exact hc0.2.1.trans (L4YAML.Proofs.CouplingBridge.advance_input _)
       · exact hc0.2.2.trans (L4YAML.Proofs.CouplingBridge.advance_inputEnd _))
    | (refine nextIsSep_of_peekAt_one hpk ?_ ?_ ?_ hcand'
       · exact hc.1
       · exact hc.2.1.trans (L4YAML.Proofs.CouplingBridge.advance_input _)
       · exact hc.2.2.trans (L4YAML.Proofs.CouplingBridge.advance_inputEnd _))

lemma nextIsSep_of_scanBlockEntry {s s' : ScannerState} (h_noflow : s.inFlow = false)
    (hpk : s.peek? = some '-') (hcand : isBlockEntryCandidate s = true)
    (hok : scanBlockEntry s = .ok s') : NextIsSep s' := by
  have hcand' : (match s.peekAt? 1 with | some n => isBlankBool n | none => true) = true := by
    unfold isBlockEntryCandidate at hcand; exact hcand
  unfold scanBlockEntry at hok
  simp only [bind, Except.bind, h_noflow, Bool.not_false, ite_true] at hok
  split at hok
  · simp at hok
  · split at hok
    · simp at hok
    split at hok
    · simp at hok
    simp only [Except.ok.injEq] at hok
    subst hok
    have hps : (pushSequenceIndent s ↑s.col).offset = s.offset ∧
        (pushSequenceIndent s ↑s.col).input = s.input ∧
        (pushSequenceIndent s ↑s.col).inputEnd = s.inputEnd := by
      unfold pushSequenceIndent; split <;> exact ⟨rfl, rfl, rfl⟩
    have hc := advance_congr (a := (pushSequenceIndent s ↑s.col).emit .blockEntry) (b := s)
      hps.1 hps.2.1 hps.2.2
    refine nextIsSep_of_peekAt_one hpk ?_ ?_ ?_ hcand'
    · exact hc.1
    · exact hc.2.1.trans (L4YAML.Proofs.CouplingBridge.advance_input _)
    · exact hc.2.2.trans (L4YAML.Proofs.CouplingBridge.advance_inputEnd _)

/-- The park comment gate from a next char that is not `#`. -/
lemma park_gate_of_peek {s : ScannerState} (h : s.peek? ≠ some '#') :
    s.col ≠ 0 → ¬ (CommentOk s ∧ s.peek? = some '#') :=
  fun _ hh => h hh.2

/-- The park comment gate from a non-white last consumed char. -/
lemma park_gate_of_peekBack {s : ScannerState} {c : Char} (hpb : s.peekBack? = some c)
    (hc : (isWhiteSpaceBool c || isLineBreakBool c || c == '\uFEFF') = false) :
    s.col ≠ 0 → ¬ (CommentOk s ∧ s.peek? = some '#') :=
  fun hcol hh => CommentOk_false_of_peekBack hcol hpb hc hh.1


/-! ## §0a PendingNode — Immediate Pending State

    Tracks the gap between the block marker (`sp_block`, §0b) and the scanner
    position (`sp_scan`). This gap contains the most recent token's characters
    that haven't yet been incorporated into either a block collection entry
    or a standalone grammar production.

    When the next preprocessing step provides `SSLComments`, the pending node
    is "closed" — incorporated into the grammar — and the state advances.

    **Evidence-bearing design (v0.4.7):** Structural pending variants carry
    grammar markers directly (`SCDirectivesEnd` for `---`, `SCDocumentEnd` for `...`).
    These are constructed at dispatch time using `_prod` theorems and consumed
    when preprocessing provides SSLComments — the marker plus SSLComments compose
    directly into `SLExplicitDocument` or `SLDocumentSuffix` without any closure.
    Other pending variants retain `h_closable` closures for now.

    **Scanner-parametrized (item 12):** the pending is indexed by the scanner
    state it accompanies — the state at the END of the step that parked it,
    which is the state the NEXT step receives.  Only `pendingProps` reads the
    parameter: its same-line guard couplings (`trailingPropertyRunOnLine`) are
    facts about `sc.tokens`/`sc.line` that the consuming dispatch fires against
    item 9k's block-half property tests.  Every other constructor ignores it. -/

/-- **[96] c-ns-properties**, indexed by which of its two halves are present.

    That index is not decoration: it is exactly what the scanner's
    `propertyRunHasAnchor` / `propertyRunHasTag` guards test, so a run already
    carrying an anchor refuting a second `&` is a match on this index rather than
    a fresh argument. The four constructors are `[96]`'s two arms with the
    optional half absent (`anchor`, `tag`) or present (`anchorThenTag`,
    `tagThenAnchor`). -/
inductive PropsRun (n : Nat) (c : YamlContext) : Bool → Bool → SurfPos → SurfPos → Prop where
  | anchor (s s' : SurfPos) (h : SCNsAnchorProperty s s') : PropsRun n c true false s s'
  | tag (s s' : SurfPos) (h : SCNsTagProperty s s') : PropsRun n c false true s s'
  | anchorThenTag (s s₁ s₂ s' : SurfPos) (ha : SCNsAnchorProperty s s₁)
      (hsep : SSeparate n c s₁ s₂) (ht : SCNsTagProperty s₂ s') :
      PropsRun n c true true s s'
  | tagThenAnchor (s s₁ s₂ s' : SurfPos) (ht : SCNsTagProperty s s₁)
      (hsep : SSeparate n c s₁ s₂) (ha : SCNsAnchorProperty s₂ s') :
      PropsRun n c true true s s'

/-- Every `[96]` run used at least one half (item 48's props refutation). -/
lemma PropsRun.ha_or_ht {n : Nat} {c : YamlContext} {ha ht : Bool} {s s' : SurfPos}
    (h : PropsRun n c ha ht s s') : ha = true ∨ ht = true := by
  cases h with
  | anchor _ _ _ => exact Or.inl rfl
  | tag _ _ _ => exact Or.inr rfl
  | anchorThenTag _ _ _ _ _ _ _ => exact Or.inl rfl
  | tagThenAnchor _ _ _ _ _ _ _ => exact Or.inl rfl

/-- A held run is `[96] c-ns-properties`; the index only records which halves it
    used to get there. -/
lemma PropsRun.toProperties {n : Nat} {c : YamlContext} {ha ht : Bool} {s s' : SurfPos}
    (h : PropsRun n c ha ht s s') : SCNsProperties n c s s' := by
  cases h with
  | anchor _ _ h => exact .anchorFirst _ _ _ _ _ h (.none _)
  | tag _ _ h => exact .tagFirst _ _ _ _ _ h (.none _)
  | anchorThenTag _ _ _ _ ha hsep ht =>
      exact .anchorFirst _ _ _ _ _ ha (.some _ _ (.mk _ _ _ hsep ht))
  | tagThenAnchor _ _ _ _ ht hsep ha =>
      exact .tagFirst _ _ _ _ _ ht (.some _ _ (.mk _ _ _ hsep ha))

/-- Extend an anchor-only run with the tag half (`[&a !t x]`). The `false` tag
    index is what makes this total: a run that already carried a tag is not of
    this type, and the scanner rejects the input that would build one. -/
lemma PropsRun.addTag {n : Nat} {c : YamlContext} {s s₁ s₂ s' : SurfPos}
    (h : PropsRun n c true false s s₁) (hsep : SSeparate n c s₁ s₂)
    (ht : SCNsTagProperty s₂ s') : PropsRun n c true true s s' := by
  cases h with | anchor _ _ ha => exact .anchorThenTag _ _ _ _ ha hsep ht

/-- Extend a tag-only run with the anchor half (`[!t &a x]`). -/
lemma PropsRun.addAnchor {n : Nat} {c : YamlContext} {s s₁ s₂ s' : SurfPos}
    (h : PropsRun n c false true s s₁) (hsep : SSeparate n c s₁ s₂)
    (ha : SCNsAnchorProperty s₂ s') : PropsRun n c true true s s' := by
  cases h with | tag _ _ ht => exact .tagThenAnchor _ _ _ _ ht hsep ha

/-- The BLOCK-KEY twins of `addTag`/`addAnchor` (item 17).  `[96]`'s optional
    second half embeds `s-separate(n,c)`, and that is the ONLY place the run's
    context can matter: a single-half run reads in any context, and a two-half
    run reads at `block-key` exactly when its internal separation stayed on the
    line — which is what the extension arm has in hand, since it built the
    separator from the preprocessing's residual whites.  The run being extended
    is single-half, so its own index never occurs and the twins take it at any
    value (item 24). -/
lemma PropsRun.blockKey_addTag {n : Nat} {s s₁ s₂ s' : SurfPos}
    (h : PropsRun n .flowOut true false s s₁) (hsep : SSeparateInLine s₁ s₂)
    (ht : SCNsTagProperty s₂ s') : SCNsProperties 0 .blockKey s s' := by
  cases h with
  | anchor _ _ ha => exact .anchorFirst _ _ _ _ _ ha (.some _ _ (.mk _ _ _ hsep ht))

/-- …and dually. -/
lemma PropsRun.blockKey_addAnchor {n : Nat} {s s₁ s₂ s' : SurfPos}
    (h : PropsRun n .flowOut false true s s₁) (hsep : SSeparateInLine s₁ s₂)
    (ha : SCNsAnchorProperty s₂ s') : SCNsProperties 0 .blockKey s s' := by
  cases h with
  | tag _ _ ht => exact .tagFirst _ _ _ _ _ ht (.some _ _ (.mk _ _ _ hsep ha))

/-- …and the twins' one-step-earlier form (item 41): a SINGLE-half run reads at
    `block-key` with no separator to convert, because `[96]`'s only occurrence of
    its context sits inside the optional second half.  The hypothesis is the
    run's own index read as a fact — `(false, false)` is not a `PropsRun`, so
    "one half is absent" is exactly "the second half was never built" — and it is
    what a FRESH `&`/`!` dispatch has: `PropsRun.anchor` and `PropsRun.tag` are
    the only runs a property push creates.

    Stated on the index rather than concluding the re-read at the producer so
    that the caller which needs neither pays nothing (Reflection 662's rule
    applied to a Boolean pair): the run's shape is what the producer knows, the
    `block-key` reading is one projection of it. -/
lemma PropsRun.toPropertiesBlockKey {n : Nat} {ha ht : Bool} {s s' : SurfPos}
    (h : PropsRun n .flowOut ha ht s s') (h_single : ha = false ∨ ht = false) :
    SCNsProperties 0 .blockKey s s' := by
  cases h with
  | anchor _ _ h => exact .anchorFirst _ _ _ _ _ h (.none _)
  | tag _ _ h => exact .tagFirst _ _ _ _ _ h (.none _)
  | anchorThenTag => simp at h_single
  | tagThenAnchor => simp at h_single

/-- `[96]` has no empty arm, so a held run always carries at least one half.
    That is what says the last real token is a property — which is how a held run
    refutes a following alias (`[&a *x]`, item 9e). -/
lemma PropsRun.some_half {n : Nat} {c : YamlContext} {ha ht : Bool} {s s' : SurfPos}
    (h : PropsRun n c ha ht s s') : ha = true ∨ ht = true := by cases h <;> simp

/-- A run with no anchor is the tag-only one: `[96]` has no empty arm, so the
    index cannot be `(false, false)`. This is what turns "the scanner let a `&`
    through, so the held run carries no anchor" into a run `addAnchor` accepts. -/
lemma PropsRun.tag_of_no_anchor {n : Nat} {c : YamlContext} {ht : Bool} {s s' : SurfPos}
    (h : PropsRun n c false ht s s') : ht = true := by cases h <;> rfl

/-- …and dually. -/
lemma PropsRun.anchor_of_no_tag {n : Nat} {c : YamlContext} {ha : Bool} {s s' : SurfPos}
    (h : PropsRun n c ha false s s') : ha = true := by cases h <;> rfl

/-- The separator embedded in `[96]` is `s-separate-lines` in every non-key
    context, so a run built at `.flowOut` reads back at `.blockIn` — the
    context `[198] s-l+block-scalar`'s props slot wants (item 12).  The proof
    is `toProperties` verbatim: the embedded `SSeparate` converts by defeq. -/
lemma PropsRun.toPropertiesBlockIn {n : Nat} {ha ht : Bool} {s s' : SurfPos}
    (h : PropsRun n .flowOut ha ht s s') : SCNsProperties n .blockIn s s' := by
  cases h with
  | anchor _ _ h => exact .anchorFirst _ _ _ _ _ h (.none _)
  | tag _ _ h => exact .tagFirst _ _ _ _ _ h (.none _)
  | anchorThenTag _ _ _ _ ha hsep ht =>
      exact .anchorFirst _ _ _ _ _ ha (.some _ _ (.mk _ _ _ hsep ht))
  | tagThenAnchor _ _ _ _ ht hsep ha =>
      exact .tagFirst _ _ _ _ _ ht (.some _ _ (.mk _ _ _ hsep ha))

/-- The same conversion stated on `[96]` itself (item 174): a properties
    reading at `.flowOut` re-reads at `.blockIn` because the embedded
    `s-separate` is `s-separate-lines` in both, by defeq.  This is what puts a
    held run into `[196] s-l+block-collection`'s own slot, where
    `PropsRun.toPropertiesBlockIn` above serves `[198]`'s. -/
lemma props_linesLift {n : Nat} {s s' : SurfPos}
    (h : SCNsProperties n .flowOut s s') : SCNsProperties n .blockIn s s' := by
  cases h with
  | tagFirst _ _ ht hopt => exact .tagFirst _ _ _ _ _ ht hopt
  | anchorFirst _ _ ha hopt => exact .anchorFirst _ _ _ _ _ ha hopt

/-! ### The resume frames (item 99)

    A DEDENT landing ends the awaited entry and CONTINUES an enclosing
    `[187] l+block-mapping` — the parser's own reading (`k:⏎  :⏎b: 2` emits
    ONE outer mapping with `b` as `k`'s sibling).  The fused closures the
    pendings carry cannot say that: their codomain is the finished stream, so
    once the entry closes nothing is left to cons a sibling onto.  What the
    landing needs is the stack of still-open mapping levels, each held as its
    ENTRIES-level continuation — the part of the level after the entries read
    so far, which is exactly `[195]`'s tail shape, `(s-indent(k)
    ns-l-block-map-entry(k))*`.

    Block grammar closes every level at the same position (no closing
    indicators), so the frames chain by position alone: a level's tail ends
    where the next level out continues.  Closing every level with its `nil`
    tail recovers the fused stream (`ResumeFrames.close`); a landing at width
    `j` pops the levels above `j` with `nil` tails and conses its sibling onto
    the `j` level (`ResumeFrames.resumeAt`), which is `[187]` continued rather
    than a bare-document re-open.

    The widths ride the type, innermost (largest) first and strictly
    decreasing, so a landing width names at most one level.  Only MAPPING
    levels are framed: a dedent CONTENT landing is an implicit key, and a
    sequence level it crosses can only close — the producers fold sequence
    closes into the enclosing continuation. -/

/-- The level's own tail, by its kind: a sequence level owes `SCompactSeqTail`,
    a mapping level `SCompactMapTail`. -/
def _root_.L4YAML.Proofs.IndentStackCover.FrameLevel.tail (e : FrameLevel) (sp sp_end : SurfPos) : Prop :=
  if e.isSeq then SCompactSeqTail e.width sp sp_end else SCompactMapTail e.width sp sp_end

lemma _root_.L4YAML.Proofs.IndentStackCover.FrameLevel.tail_nil (e : FrameLevel) (sp : SurfPos) : e.tail sp sp := by
  unfold FrameLevel.tail; split
  · exact SCompactSeqTail.nil _ _
  · exact SCompactMapTail.nil _ _

@[simp] lemma _root_.L4YAML.Proofs.IndentStackCover.FrameLevel.tail_map (k : Nat) (sp sp_end : SurfPos) :
    (FrameLevel.map k).tail sp sp_end = SCompactMapTail k sp sp_end := rfl

@[simp] lemma _root_.L4YAML.Proofs.IndentStackCover.FrameLevel.tail_seq (k : Nat) (sp sp_end : SurfPos) :
    (FrameLevel.seq k).tail sp sp_end = SCompactSeqTail k sp sp_end := rfl

/-- The still-open block-mapping levels at a park, innermost first: each level
    is its entries-level continuation (the level's remaining tail, then the
    next level out), the bottom is whatever the OUTERMOST level still owes.

    **The bottom is a parameter** (item 108).  Item 99 wrote it as
    `SLYamlStream sp_start`, which is what the root producers pay and what the
    dedent branch's route spends; but the same stack under an open `[186]`
    explicit key owes the frame's value line rather than the finished stream,
    and a frames field bottomed at the stream cannot say so — closing it commits
    the `?` entry to its `e-node` value.  Taking `P` as a parameter states both
    with one inductive: `ResumeFrames (SLYamlStream sp_start)` is item 99's, and
    `KeyFrames (ExplValueLine sp_start nv)` is the same stack with the `?`'s
    `s-indent(nv) ':'` value line still owed underneath it.

    The list carries each level's KIND (item 332, `FrameLevel`); this lane holds
    mapping levels only, so every element is `FrameLevel.map k`. -/
inductive ResumeFrames (P : SurfPos → Prop) : List FrameLevel → SurfPos → Prop where
  | bottom (sp : SurfPos) (h_bot : P sp) :
      ResumeFrames P [] sp
  | level (k : Nat) (ks : List FrameLevel) (sp : SurfPos)
      (h_lt : ∀ fr ∈ ks, fr.width < k)
      (h_cont : ∀ sp_end, SCompactMapTail k sp sp_end →
        ResumeFrames P ks sp_end) :
      ResumeFrames P (FrameLevel.map k :: ks) sp

/-- Close every level with its empty tail, reaching whatever the bottom owes —
    the fused stream the pendings' existing closures end in, or the explicit
    frame's value line. -/
lemma ResumeFrames.close {P : SurfPos → Prop} :
    ∀ {ks : List FrameLevel} {sp : SurfPos},
      ResumeFrames P ks sp → P sp
  | [], _, h => by cases h with | bottom _ h_bot => exact h_bot
  | _ :: _, sp, h => by
      cases h with
      | level k _ _ _ h_cont => exact (h_cont sp (SCompactMapTail.nil k sp)).close

/-- **What a landing at `j` leaves of the frames** (item 149): exactly the
    levels `j` stands above.  `resumeAt` used to report only the BOUND — every
    surviving width is below `j` — which is what the surface side spends, and
    the scanner side cannot use: a cover over the incoming widths has to be
    re-listed over the surviving ones, and for that the missing direction is
    COMPLETENESS, that a level below `j` survived at all.  The frames are
    strictly decreasing, so both directions hold of the same list and one
    equation states them together. -/
def ResumeWidths (ks ks' : List FrameLevel) (j : Nat) : Prop :=
  ∀ fr, fr ∈ ks' ↔ (fr ∈ ks ∧ fr.width < j)

/-- The bound, which is what `ResumeFrames`' own `h_lt` slot asks for. -/
lemma ResumeWidths.lt {ks ks' : List FrameLevel} {j : Nat} (h : ResumeWidths ks ks' j) :
    ∀ fr ∈ ks', fr.width < j := fun fr hk' => ((h fr).mp hk').2

/-- The surviving levels were frames already — so a floor that bounded the
    incoming list bounds this one (`IndentStackCover.Floor.pop_to`). -/
lemma ResumeWidths.sub {ks ks' : List FrameLevel} {j : Nat} (h : ResumeWidths ks ks' j) :
    ∀ fr ∈ ks', fr ∈ ks := fun fr hk' => ((h fr).mp hk').1

/-- …and nothing below `j` was dropped, which is what re-lists a carried cover
    over the popped stack (`IndentStackCover.Covered.pop_to`). -/
lemma ResumeWidths.keep {ks ks' : List FrameLevel} {j : Nat} (h : ResumeWidths ks ks' j) :
    ∀ fr ∈ ks, fr.width < j → fr ∈ ks' := fun fr hk' hlt => (h fr).mpr ⟨hk', hlt⟩

/-- **The dedent's spend**: pop the levels strictly above `j` (their tails are
    empty — the landing ended them) and hand back the `j` level's own
    continuation, with the popped stack's levels named exactly (`ResumeWidths`).
    The landing level is a member by the scanner's own unwind — a width
    matching no open level is `trailingContent`, refused before any dispatch
    runs — so the arm decides membership per input and defers the
    non-member case it can no longer receive. -/
lemma ResumeFrames.resumeAt {P : SurfPos → Prop} {sp : SurfPos} :
    ∀ {ks : List FrameLevel}, ResumeFrames P ks sp → ∀ {j : Nat}, FrameLevel.map j ∈ ks →
      ∃ ks', ResumeWidths ks ks' j ∧
        (∀ sp_end, SCompactMapTail j sp sp_end → ResumeFrames P ks' sp_end)
  | [], _, _, hmem => absurd hmem (List.not_mem_nil)
  | _ :: ks, h, j, hmem => by
      cases h with
      | level k _ _ h_lt h_cont =>
          by_cases hj : j = k
          · subst hj
            refine ⟨ks, fun fr => ⟨fun hk' => ⟨List.mem_cons_of_mem _ hk', h_lt fr hk'⟩, ?_⟩,
              h_cont⟩
            rintro ⟨hm, hlt⟩
            rcases List.mem_cons.mp hm with rfl | h'
            · exact absurd hlt (Nat.lt_irrefl _)
            · exact h'
          · have hmem' : FrameLevel.map j ∈ ks := by
              cases List.mem_cons.mp hmem with
              | inl h_eq => exact absurd (FrameLevel.map_inj.mp h_eq) hj
              | inr h_in => exact h_in
            obtain ⟨ks', h_w, cont⟩ := (h_cont sp (SCompactMapTail.nil k sp)).resumeAt hmem'
            refine ⟨ks', fun fr => ⟨fun hk' =>
              ⟨List.mem_cons_of_mem _ (h_w.sub fr hk'), h_w.lt fr hk'⟩, ?_⟩, cont⟩
            rintro ⟨hm, hlt⟩
            rcases List.mem_cons.mp hm with rfl | h'
            · exact absurd (Nat.lt_trans (h_lt _ hmem') hlt) (Nat.lt_irrefl _)
            · exact h_w.keep fr h' hlt

  /-- **The value-line stack of a park inside a `?` frame's KEY, over MIXED
      levels** (item 302).  `ResumeFrames` records the still-open MAPPING levels
      above a park.  A park deep inside the frame's key sequence stands inside
      SEQUENCE levels too — `?⏎-⏎  - a⏎- b⏎: w` lands two levels out, and
      `?⏎- k:⏎    - a⏎- b⏎: w` has a mapping level between the sequence levels —
      and the dedenting `-` must cons its entry onto the level at its own width
      before the frame's `[190] s-indent(nv) ':'` line is reached.  Item 167
      carried the sequence lane's tail as ONE width (`SeqEntryTail`) because the
      STREAM has the document reading to fall back on; the frame's value line has
      none, so this is the stack `ResumeFrames` is, with a sequence level beside
      the mapping one.  `P` is the bottom, as there:
      `KeyFrames (ExplValueLine sp_start nv)`.  Every `ResumeFrames` embeds
      (`KeyFrames.ofResumeFrames`), so what the mapping lane pays rides unchanged.

      One constructor (item 332): the level's kind selects its tail
      (`FrameLevel.tail`), so a resume at a level resumes the tail THAT level
      owes, and the two-arm `mapLevel`/`seqLevel` reading survives as the smart
      constructors below. -/
  inductive KeyFrames (P : SurfPos → Prop) : List FrameLevel → SurfPos → Prop where
    | bottom (sp : SurfPos) (h_bot : P sp) :
        KeyFrames P [] sp
    | level (e : FrameLevel) (ks : List FrameLevel) (sp : SurfPos)
        (h_lt : ∀ fr ∈ ks, fr.width < e.width)
        (h_cont : ∀ sp_end, e.tail sp sp_end →
          KeyFrames P ks sp_end) :
        KeyFrames P (e :: ks) sp

  /-- A mapping level on the key stack. -/
  lemma KeyFrames.mapLevel {P : SurfPos → Prop} (k : Nat) (ks : List FrameLevel) (sp : SurfPos)
      (h_lt : ∀ fr ∈ ks, fr.width < k)
      (h_cont : ∀ sp_end, SCompactMapTail k sp sp_end → KeyFrames P ks sp_end) :
      KeyFrames P (FrameLevel.map k :: ks) sp :=
    .level (FrameLevel.map k) ks sp h_lt h_cont

  /-- A sequence level on the key stack. -/
  lemma KeyFrames.seqLevel {P : SurfPos → Prop} (k : Nat) (ks : List FrameLevel) (sp : SurfPos)
      (h_lt : ∀ fr ∈ ks, fr.width < k)
      (h_cont : ∀ sp_end, SCompactSeqTail k sp sp_end → KeyFrames P ks sp_end) :
      KeyFrames P (FrameLevel.seq k :: ks) sp :=
    .level (FrameLevel.seq k) ks sp h_lt h_cont

  /-- Close every level with its empty tail, reaching the bottom —
      `ResumeFrames.close` over the kind-selected tail. -/
  lemma KeyFrames.close {P : SurfPos → Prop} :
      ∀ {ks : List FrameLevel} {sp : SurfPos},
        KeyFrames P ks sp → P sp
    | [], _, h => by cases h with | bottom _ h_bot => exact h_bot
    | e :: _, sp, h => by
        cases h with
        | level _ _ _ _ h_cont => exact (h_cont sp (e.tail_nil sp)).close

  /-- Every mapping-lane stack is a key stack, level for level. -/
  lemma KeyFrames.ofResumeFrames {P : SurfPos → Prop} :
      ∀ {ks : List FrameLevel} {sp : SurfPos},
        ResumeFrames P ks sp → KeyFrames P ks sp
    | [], _, h => by cases h with | bottom _ h_bot => exact .bottom _ h_bot
    | _ :: ks, sp, h => by
        cases h with
        | level k _ _ h_lt h_cont =>
          exact .mapLevel k ks sp h_lt
            (fun sp_end h_tail => KeyFrames.ofResumeFrames (h_cont sp_end h_tail))

  /-- **The dedent's spend, by the level's OWN kind**: pop the levels strictly
      above the landing (their tails are empty — the landing ended them) and hand
      back the landing level's continuation — the tail ITS kind owes — with the
      popped stack's levels named exactly (`ResumeWidths`).  Item 302's version
      returned "a mapping tail OR a sequence tail" and left the consumer to refute
      the arm it could not take; membership of the LEVEL (kind included) says
      which arm, so there is nothing to refute (item 332). -/
  lemma KeyFrames.resumeAt {P : SurfPos → Prop} {sp : SurfPos} :
      ∀ {ks : List FrameLevel}, KeyFrames P ks sp → ∀ {e : FrameLevel}, e ∈ ks →
        ∃ ks', ResumeWidths ks ks' e.width ∧
          (∀ sp_end, e.tail sp sp_end → KeyFrames P ks' sp_end)
    | [], _, _, hmem => absurd hmem (List.not_mem_nil)
    | k :: ks, h, e, hmem => by
        cases h with
        | level _ _ _ h_lt h_cont =>
        by_cases he : e = k
        · subst he
          refine ⟨ks, fun fr => ⟨fun hk' => ⟨List.mem_cons_of_mem _ hk', h_lt fr hk'⟩, ?_⟩,
            h_cont⟩
          rintro ⟨hm, hlt⟩
          rcases List.mem_cons.mp hm with rfl | h'
          · exact absurd hlt (Nat.lt_irrefl _)
          · exact h'
        · have hmem' : e ∈ ks := (List.mem_cons.mp hmem).elim (fun h => absurd h he) id
          obtain ⟨ks', h_w, cont⟩ := (h_cont sp (k.tail_nil sp)).resumeAt hmem'
          refine ⟨ks', fun fr => ⟨fun hk' =>
            ⟨List.mem_cons_of_mem _ (h_w.sub fr hk'), h_w.lt fr hk'⟩, ?_⟩, cont⟩
          rintro ⟨hm, hlt⟩
          rcases List.mem_cons.mp hm with rfl | h'
          · exact absurd (Nat.lt_trans (h_lt e hmem') hlt) (Nat.lt_irrefl _)
          · exact h_w.keep fr h' hlt

/-- The mapping-level spend of the key stack, in the shape item 302's
    consumers hold: a landing width known to be a MAPPING level. -/
lemma KeyFrames.resumeAtMap {P : SurfPos → Prop} {sp : SurfPos} {ks : List FrameLevel}
    (h : KeyFrames P ks sp) {j : Nat} (hmem : FrameLevel.map j ∈ ks) :
    ∃ ks', ResumeWidths ks ks' j ∧
      (∀ sp_end, SCompactMapTail j sp sp_end → KeyFrames P ks' sp_end) :=
  h.resumeAt hmem

/-- The sequence-level spend of the key stack. -/
lemma KeyFrames.resumeAtSeq {P : SurfPos → Prop} {sp : SurfPos} {ks : List FrameLevel}
    (h : KeyFrames P ks sp) {j : Nat} (hmem : FrameLevel.seq j ∈ ks) :
    ∃ ks', ResumeWidths ks ks' j ∧
      (∀ sp_end, SCompactSeqTail j sp sp_end → KeyFrames P ks' sp_end) :=
  h.resumeAt hmem

/-- **The explicit frame's value line**, named (item 108).  `[186]`'s key is
    complete at `sp_e`, and what the `[188]` entry still owes is `[190]
    s-indent(nv) ':' s-l+block-indented(nv, block-out)`, after which it reaches
    the stream.  Items 93/106 wrote this predicate inline at every twin that
    carries it; naming it is what lets a stack of still-open mapping levels
    stand ON it — `KeyFrames (ExplValueLine sp_start nv)` — instead of on
    the finished stream, which is the difference between a dedent landing that
    keeps the enclosing `?` frame open and one that can only close it with
    `[188]`'s `e-node` value. -/
def ExplValueLine (sp_start : SurfPos) (nv : Nat) (sp_e : SurfPos) : Prop :=
  ∀ sp_i sp_c : SurfPos, SIndent nv sp_e sp_i → GLit ':' sp_i sp_c →
  ∀ sp_w : SurfPos, SBlockIndented nv .blockOut sp_c sp_w →
  SLYamlStream sp_start sp_w

/-- **The enclosing sequence's own remaining tail** (item 167) — the SEQUENCE
    lane's bottom, and `ExplValueLine`'s twin on it.

    A park deep inside a `[183] l+block-sequence(ke)` entry owes that
    collection the rest of itself: once the entry the park stands in is
    complete at `sp_e`, what is still open is `[186]`'s tail at `ke`, and only
    after it does the stream close.  The fused closures every park already
    carries end AT the stream, which folds that tail into `nil` and commits the
    collection — so a dedenting `-` landing back at `ke` has nothing to cons
    its entry onto and can only re-open as a second bare document.  Held as
    this predicate, the same landing CONTINUES the collection it stands in.

    It is the bottom `ResumeFrames` would stand on when the sequence lane grows
    the mapping levels between (item 108's parameter, on this lane); item 167
    carries one width and folds those levels into the producer, because the
    corpus puts nothing else there — see
    `Tests/Guards/Proofs/SeqDedentEntryTail.lean`. -/
def SeqEntryTail (sp_start : SurfPos) (ke : Nat) (sp_e : SurfPos) : Prop :=
  ∀ sp_end : SurfPos, SCompactSeqTail ke sp_e sp_end → SLYamlStream sp_start sp_end

/-- The key HEADS `[188] ns-s-block-map-implicit-key` admits — cut along the
    PRODUCTION's seam, which is `[188]`'s own two alternatives, rather than
    along the producer's cases (item 17; item 16 had this as three arms, one per
    scanner branch).  `[193] ns-s-implicit-yaml-key` reads the plain scalar,
    `[194] c-s-implicit-json-key` reads a flow node, and everything else about
    the two is the shared `s-separate-in-line?` tail the pack carries as whites.

    Cutting it here is what makes the remaining heads free: an alias key and a
    property-prefixed key are `[161] ns-flow-node(0, block-key)`'s own `alias`
    and `propsContent` arms, so item 17 added no arm at all.  (`SFlowNode` is
    where this encoding merges `[159] ns-flow-yaml-node` and `[160]
    c-flow-json-node` — the two are covered at the PARSER level only, and their
    union is `ns-flow-node` alternative-for-alternative, so the JSON arm's
    payload is exact in language and loose only in attribution.) -/
inductive ImplicitKeyHead : SurfPos → SurfPos → Prop where
  | yaml {s s' : SurfPos} : SNsPlainOneLine .blockKey s s' → ImplicitKeyHead s s'
  | json {s s' : SurfPos} : SFlowNode 0 .blockKey s s' → ImplicitKeyHead s s'

/-- **The pack family's alternative — what a park carries INSTEAD of a value-line
    pack** (item 308): the park's explicit-key register is DEAD.  A class-A `:` — the
    explicit value of a `?` frame, `[197]`'s `s-indent(n) ':'` — fires only when the
    dispatch state's register is live (`explicitKeyLine ≠ none`), and preprocessing
    ends or carries the register (`ekl_disp_none_of_park_none`), so a dead register at the
    park refutes the landing (`ExplicitValueRefused.not_of_classA`).  The register is
    the whole predicate: the sentinel indent `-1` a document marker's unwind leaves
    behind refutes nothing the register does not, because a marker ends the register
    (`scanDocumentStart`, `scanDocumentEnd`, item 317 — item 308's probe 726 had read a
    `?` frame's register crossing `---`/`...`, which was the scanner over-acceptance that
    item fixed).  Producers are the family's roots, each paying the fact its park can
    prove (12.3.4.2); consumers the three `block_dispatch_deferred_stamp_nopack`
    applications. -/
def ExplicitValueRefused (sc : ScannerState) : Prop :=
  sc.explicitKeyLine = none

/-- **The pack family's alternative, NAMED** (item 311) — what every value-line pack, chain pack
    and value-line stack carries instead of its payment.  `True` for now: retyping the two
    families to `∨ PackAlt sc` is a pure type step — every `Or.inr trivial` still elaborates,
    every `Or.inr h` still relays — and the flip census flips this one body instead of the
    families' tails.  The payments then go by lane (12.3.4.2's (b)–(g)), each replacing
    `Or.inr trivial` by `Or.inr (PackAlt.ofRefused h)` with the register or indent fact its site
    holds, against the census's residue under the `ExplicitValueRefused sc` flip; at zero this
    body becomes `ExplicitValueRefused sc`, `ofRefused` the identity, and 12.3.4.3 refutes it at
    the class-A landings. -/
abbrev PackAlt (_sc : ScannerState) : Prop := True

/-- A payment of the alternative from the predicate (the identity once `PackAlt` is it). -/
lemma PackAlt.ofRefused {sc : ScannerState} (_h : ExplicitValueRefused sc) : PackAlt sc :=
  trivial  -- refused: _h

/-- **A flow frame's alternative.**  `FlowBaseRoutes` carries no park state, so what the open
    declines on the frame's pack and stack is carried to the close as `PackAltG g`, indexed by
    the frame's §9.2 gate for want of another open-time datum.  A placeholder: `True` until
    lane (d) chooses the carrier — the gate is `none` at the `pendingBlock` and `pendingMapValue`
    opens, so a predicate on the gated state alone could never be paid at their closes — and the
    two conversions below are that lane's obligations. -/
abbrev PackAltG (_g : Option ScannerState) : Prop := True

/-- The open: a park's alternative crosses into the frame it opens (lane (c)'s stub). -/
lemma PackAltG.ofPark {sc : ScannerState} {g : Option ScannerState} (_h : PackAlt sc) :
    PackAltG g := trivial

/-- The close: the frame's alternative reaches the park the close builds (lane (d)'s stub, which
    proves it from the close's register restore and the indent the interior leaves still). -/
lemma PackAlt.ofGateClose {g : Option ScannerState} {s' : ScannerState} (_h : PackAltG g) :
    PackAlt s' := trivial

/-- The implicit-key pack (item 15): everything a same-line `:` needs to read
    the parked content back as `[193] ns-s-block-map-implicit-key`.
    `sp_key` is the key's start (= the content start), and the trailing
    `s-white*` runs to the pending's scan position, where the consumer appends
    its own preprocessing whites and the `GLit ':'`.

    **`h_route` is the entry's way back into the stream** (item 38), and it is
    the whole of what the pack owes besides the head.  Items 15–25 wrote the
    same fact as three coordinates — a column-0 line start, the stream closed
    there, and `[63] s-indent(k)` from it to the key — which is one particular
    way to reach a `[187] l+block-mapping` and not the only one: `[185]
    s-l+block-indented`'s `ns-l-compact-mapping` alternative reaches the same
    entry with NO line start in front of it at all, which is what `- a: 1` is.
    Coordinates admit one producer; the route admits every producer that can
    finish an entry, and the consumer needs nothing else — see
    [[CarryTheRouteNotTheCoordinates]].

    `k` (item 25) is the entry's own indentation — `[187] l+block-mapping(n)`'s
    auto-detected `n+m` at a line start, `[195]`'s `n+1+m` in a compact one.
    Items 15–17 pinned it at 0 by demanding `sp_key.col = 0`, which made every
    INDENTED mapping (`  a: 1`, and so most of the language) underivable.
    Nothing about the key HEAD moves with it: `[193]`/`[194]` take no indent at
    all — the spec writes `n/a` — so `ImplicitKeyHead` is stated once and reads
    inside an entry at any width.

    The last conjunct (item 28) is `k` read on the SCANNER's side: the key the
    `:` is about to resolve was saved at the key's own column, which is the
    column `[63] s-indent(k)` measures.  It is what lets the entry index reach
    `scanValuePrepare`'s push — the coordinate that arm actually uses.

    **It is an equation** (item 79).  Item 28 wrote it `∨ True` for Reflection
    653's reason and items 59/75 whittled that reason down; what is left of it
    is nothing.  The four producers measure for four different reasons: the root
    route off a column-0 landing, the compact route off the park's own width
    (bundled with the frame, so the arm that has the route has the width), the
    props run off the key the property saved (the park's flag says preprocessing
    inherited it), and a closed flow collection off the key its OPEN stacked,
    carried across the interior by the mask's base slot.  Nothing in the pack is
    conditional on the state any more; what is still optional is the ROUTE, and
    that is a fact about the enclosing construct rather than about a
    measurement. -/
def ImplicitKeyPack (sc : ScannerState) (sp_start sp_scan : SurfPos) : Prop :=
  ∃ (k : Nat) (sp_key sp_gram : SurfPos),
    (∀ sp_v, SBlockMapEntry k sp_key sp_v → SLYamlStream sp_start sp_v) ∧
    ImplicitKeyHead sp_key sp_gram ∧
    GStar SSWhite sp_gram sp_scan ∧
    sc.simpleKey.pos.col = k ∧
    -- Item 93: the route's VALUE-LINE twin, at the ENTRY level (item 92's
    -- rule).  Where the entry this pack opens is the FIRST of a `[195]`
    -- compact mapping that is itself an open `[187]` explicit KEY, the
    -- route alone cannot serve the landed `:` — its codomain is the closed
    -- stream.  This face takes the entry, the mapping's tail (`SCompactMapTail`
    -- rides so a sibling site can cons its entry on before re-parking;
    -- consumers pass `nil`), and then the frame's value line.  Producers
    -- whose frame has no value line pass `Or.inr trivial`.
    ((∃ ns : List Nat, ∀ nv ∈ ns,
      ∀ sp_v : SurfPos, SBlockMapEntry k sp_key sp_v →
      ∀ sp_e : SurfPos, SCompactMapTail k sp_v sp_e →
      ∀ sp_i sp_c : SurfPos, SIndent nv sp_e sp_i → GLit ':' sp_i sp_c →
      ∀ sp_w : SurfPos, SBlockIndented nv .blockOut sp_c sp_w →
      SLYamlStream sp_start sp_w) ∨ PackAlt sc) ∧
    -- Item 99: the route's RESUME twin — the same entry and the same tail,
    -- ending in the still-open mapping levels BELOW this one instead of the
    -- fused stream.  It is what lets a park opened off this pack hand its own
    -- dedent landing somewhere: the entry conses, the tail rides, and the
    -- frames below stand ready for the next landing (`ResumeFrames`).
    -- Producers whose outer levels are already fused pass `Or.inr trivial`;
    -- the root producers pay `ks = []` (the bottom is the stream), and the
    -- dedent arm pays the popped stack it landed on.
    --
    -- **Item 148: the frames' own COVER rides with them.**  `ResumeFrames`
    -- says what the SURFACE can resume at each width; the cover says the
    -- SCANNER holds no open mapping level at or right of the floor that those
    -- widths miss.  A park gets one from `pendingMapValue.h_frames` (item 147)
    -- and a pack is how it crosses to the NEXT park, so the two fields have
    -- the same shape.  The list is `FrameLevel.map k :: ks` — this entry's own level
    -- included — because the two branches that pay reach it differently: a
    -- key NESTED below the park opens its level at the `:` still to come and
    -- conses the width for free (`Covered.cons`), while a key that LANDED on
    -- an open level finds that level already on the stack and cannot drop it.
    -- Stating the full list is what lets one field serve both.  The
    -- floor does NOT move — it is where the chain bottoms, and a landing can
    -- only be read as a frame at or right of it, so a floor that climbed with
    -- the widths would be spendable nowhere.  Optional on its own, so a
    -- producer whose stack it cannot measure keeps the route it already pays.
    ((∃ ks : List FrameLevel, (∀ fr ∈ ks, fr.width < k) ∧
      ((∃ lo : Nat, IndentStackCover.Floor lo k (FrameLevel.map k :: ks) ∧
        IndentStackCover.Covered lo (FrameLevel.map k :: ks) sc) ∨ True) ∧
      ∀ sp_v : SurfPos, SBlockMapEntry k sp_key sp_v →
      ∀ sp_e : SurfPos, SCompactMapTail k sp_v sp_e →
      ResumeFrames (SLYamlStream sp_start) ks sp_e) ∨ True) ∧
    -- Item 108: the resume twin under an open `[186]` explicit KEY — the same
    -- entry and the same tail, but the levels below it bottom at the FRAME's
    -- value line rather than at the stream.  The two are genuinely different
    -- stacks, not one stack with two readings: the stream face closes the `?`
    -- entry with `[188]`'s `e-node` value on its way down (that close is
    -- inside the level's own continuation), and once closed the value line is
    -- unreachable.  A dedent landing inside the key spends this one, which is
    -- what keeps `?⏎  a:⏎    b:⏎  c: 2⏎: - w`'s `c` a sibling of `a` with the
    -- `?`'s value line still owed.  Producers with no explicit frame — every
    -- root and every `[189]` slot — pass `Or.inr trivial`.
    ((∃ (nv : Nat) (ks : List FrameLevel), (∀ fr ∈ ks, fr.width < k) ∧
      -- Item 150: the value-line face's own cover, the item-148 field's twin.
      -- The stack is the same one the stream face reads — what differs is
      -- where the frames BOTTOM, and a dedent inside an explicit key pops this
      -- list.
      ((∃ lo : Nat, IndentStackCover.Floor lo k (FrameLevel.map k :: ks) ∧
        IndentStackCover.Covered lo (FrameLevel.map k :: ks) sc) ∨ True) ∧
      ∀ sp_v : SurfPos, SBlockMapEntry k sp_key sp_v →
      ∀ sp_e : SurfPos, SCompactMapTail k sp_v sp_e →
      KeyFrames (ExplValueLine sp_start nv) ks sp_e) ∨ PackAlt sc) ∧
    -- Item 168: the route's SEQUENCE face — the same entry and the same tail,
    -- ending at the enclosing `[183]`'s own remaining tail instead of the
    -- fused stream.  The pack is how a key crosses the `:` into
    -- `pendingMapValue`, so it is also how item 167's `SeqEntryTail` crosses:
    -- a compact mapping that FILLS a sequence entry (`- a:⏎    b: 1⏎- c`)
    -- reaches the landing that dedents back to the collection only if this
    -- face rides the `:`.  Paid off `pendingBlockContent.h_closable_entry`
    -- (the park's own collection, which IS this face at the park's width) and
    -- relayed by `pendingContent`; producers whose enclosing levels are fused
    -- pass `Or.inr trivial`.
    --
    -- **Item 169: FRAMED, like its two siblings above.**  Item 168 wrote this
    -- fused — one width, every level between it and the collection folded into
    -- the producer — on the measurement that 68 of the corpus's 76 dedenting
    -- landings stand on exactly one open mapping level.  They do; what that
    -- census did not read is the ENTRY HEAD, and a `-` whose node starts on
    -- the NEXT line (`-⏎  a: 1⏎  b: 2⏎- c`) reaches its key through the LANDED
    -- branch, which had no face to pay.  Framing the lane pays that branch and
    -- the two-level family with one move: `ks` is the still-open mapping
    -- levels below this entry's own, innermost first, and closing them all
    -- (`ResumeFrames.close`) is what a dedenting `-` does.  No cover rides
    -- here — item 148's cover funds a membership test (`resumeAt`), and this
    -- lane's landing never resumes a mapping level, it closes every one.
    ((∃ (ke : Nat) (ks : List FrameLevel), (∀ fr ∈ ks, fr.width < k) ∧
      ∀ sp_v : SurfPos, SBlockMapEntry k sp_key sp_v →
      ∀ sp_e : SurfPos, SCompactMapTail k sp_v sp_e →
      ResumeFrames (SeqEntryTail sp_start ke) ks sp_e) ∨ True)


/-- **The inline residue's own premise** (item 36).  A block dispatch that
    crossed NO break from a park off column 0: `sp` is the park, `sp_ws` the
    landing the step's `s-white` [33] run reached, and `c` the character it
    read there.

    Naming it is the point.  The escape it feeds is handed to its call sites
    as a bare `SLYamlStream sp_start sp_X` — a conclusion every pending can
    supply and therefore one that records nothing about WHEN it is needed.
    Taken as a function OF this premise, the same sites pay `fun _ => h`
    unchanged, and a pending whose producer already refuted the shape pays
    `nofun` instead: the escape becomes refusable without splitting the lemma
    that carries it.  (Defined here, before `PendingNode`, because item 47's
    `h_stale` fields take it as their premise.) -/
def InlineResidue (sp : SurfPos) (c : Char) : Prop :=
  sp.col ≠ 0 ∧ ∃ sp_ws, GStar SSWhite sp sp_ws ∧ sp_ws.chars.head? = some c

/-- **The stale node tail** (item 47): the scanner-state face of a park that
    follows a COMPLETE node.  The last real token completes a value
    (`completesFlowValue`); the completed scan cleared `simpleKeyAllowed`
    (only a structural break re-arms it, which is also what keeps
    `:foo: v` at a LINE START out of the check's domain); and — since the
    token's interior breaks are the token's own — it left `needIndentCheck`
    down.  These are exactly the facts `scanNextToken_checkAdjacentValue`
    reads: carried by a pending, they let its `:`-residue arm refute the
    check's success instead of deferring.  (`LastTokenReal` is what carries
    the token reading across the next preprocessing's placeholder
    reservation.) -/
def StaleNodeTail (sc : ScannerState) : Prop :=
  sc.needIndentCheck = false ∧ sc.simpleKeyAllowed = false ∧ LastTokenReal sc.tokens ∧
  ∃ t, lastRealTokenVal? sc.tokens = some t ∧ t.completesFlowValue = true

/-- **What a punt's refutation actually spends** (item 102): the park's three
    LINE facts, with no claim about what stands in front of them.

    `KeyPackPunt`'s two refutable reasons carried `StaleNodeTail` because the
    first producer to build them had one; the refutations use its first three
    conjuncts and never the fourth.  That fourth conjunct names a COMPLETED
    value, which is precisely what a `[96] c-ns-properties` park has not got —
    `completesFlowValue` excludes the property tokens by construction — so the
    carrier, not the reasoning, is what kept the props path from naming a
    reason at all.  Typed as what the consumer reads, the same two refutations
    serve the value parks and the property parks alike. -/
def StalePark (sc : ScannerState) : Prop :=
  sc.needIndentCheck = false ∧ sc.simpleKeyAllowed = false ∧ LastTokenReal sc.tokens

/-- A completed node's tail is a stale park; the converse is false at a `[96]`
    run, which is the whole point of the split. -/
lemma StaleNodeTail.toStalePark {sc : ScannerState} (h : StaleNodeTail sc) :
    StalePark sc := ⟨h.1, h.2.1, h.2.2.1⟩

/-- **The completed node's tail, and nothing about the line** (item 139):
    exactly the token-array half of `scanNextToken_checkBareDocument`'s reading.

    `StaleNodeTail` is this predicate plus two LINE facts — `needIndentCheck`
    and `simpleKeyAllowed` both down — and neither survives a park AT a line
    start: the block scalar ends past a break with the flag up (item 77) and
    the break sets the indent check.  §9.2's landing refusal wants the opposite
    polarity of the flag anyway, because the landing crossed the break that
    re-arms it, and never reads the indent check at all.  So the two §9.2
    checks read the same token array through opposite readings of the same
    flag, and what a park can carry UNCONDITIONALLY is the half that mentions
    neither.

    Named `CompletedTail` rather than `NodeTail` because `LineOpenGuard` already
    has a `NodeTail`, and that one is a predicate on a CHARACTER — §7.5's tail
    allowlist.  Two `open`ed namespaces, two different questions. -/
def CompletedTail (sc : ScannerState) : Prop :=
  LastTokenReal sc.tokens ∧
  ∃ t, lastRealTokenVal? sc.tokens = some t ∧ t.completesFlowValue = true

/-- A stale tail is a node tail with the two line facts on top; those two are
    what the §9.2 readings disagree about. -/
lemma StaleNodeTail.toCompletedTail {sc : ScannerState} (h : StaleNodeTail sc) :
    CompletedTail sc := ⟨h.2.2.1, h.2.2.2⟩

/-- **The face, read off the mid-stream check** — a landing that crossed a
    break has already refused every dangling park behind it, so the check's
    success IS the face at the park's own state. -/
lemma dangling_none_of_check {s_run s_land : ScannerState}
    (h_dn : scanNextToken_checkDanglingNode s_run s_land = .ok ())
    (h_ska : s_land.simpleKeyAllowed = true) :
    danglingNodePos? s_run = none := by
  unfold scanNextToken_checkDanglingNode at h_dn
  rw [ite_eq_left h_ska] at h_dn
  cases h : danglingNodePos? s_run with
  | none => rfl
  | some p => rw [h] at h_dn; cases h_dn

/-- …and off the end-of-input check, which has no gate to pay. -/
lemma dangling_none_of_eof {s : ScannerState}
    (h_dn : scanLoop_checkDanglingNode s = .ok ()) :
    danglingNodePos? s = none := by
  unfold scanLoop_checkDanglingNode at h_dn
  cases h : danglingNodePos? s with
  | none => rfl
  | some p => rw [h] at h_dn; cases h_dn

/-- **§8.1's face, read off the mid-stream check** (item 275) — the twin of
    `dangling_none_of_check`, on the same gate.  `scanNextToken` runs both
    checks back to back on the one landing, and both are guarded by
    `simpleKeyAllowed`, so wherever §9.2's success is the face at the park's
    state §8.1's success is too. -/
lemma underIndented_none_of_check {s_run s_land : ScannerState}
    (h_fv : scanNextToken_checkFlowValueIndent s_run s_land = .ok ())
    (h_ska : s_land.simpleKeyAllowed = true) :
    underIndentedFlowValuePos? s_run = none := by
  unfold scanNextToken_checkFlowValueIndent at h_fv
  rw [ite_eq_left h_ska] at h_fv
  cases h : underIndentedFlowValuePos? s_run with
  | none => rfl
  | some p => rw [h] at h_fv; cases h_fv

/-- …and §8.1's own, off the check the loop runs on the next line (item 275).
    `scanLoop_checkFlowValueIndent` stands immediately after
    `scanLoop_checkDanglingNode` at both loop ends, so a park that reaches the
    end of input has both silences read on the one state. -/
lemma underIndented_none_of_eof {s : ScannerState}
    (h_fv : scanLoop_checkFlowValueIndent s = .ok ()) :
    underIndentedFlowValuePos? s = none := by
  unfold scanLoop_checkFlowValueIndent at h_fv
  cases h : underIndentedFlowValuePos? s with
  | none => rfl
  | some p => rw [h] at h_fv; cases h_fv


/-- **Why the pack is not there** (item 65) — the reasons a producer has
    for handing no `ImplicitKeyPack`, in place of the `True` that used to stand
    for all of them at once.  (Item 65 also named a `staleKey` reason —
    preprocessing made no fresh save — but outside a flow the save declines
    only with `simpleKeyAllowed` down, every producer's park carries it up,
    and `preprocess_saved_key_fresh` reads the save off the flag, so that
    constructor has no producer and is gone — item 90.)

    A `True` right disjunct is a claim about the producer, not about the input:
    every site that reaches it is indistinguishable from every other, so the
    `:` step that consumes the field can only defer, whatever the reason was.
    The reasons are not alike, and only the last is the caller's
    business:

    * `tab` — a TAB sits in the `[63] s-indent` run in front of the key
      (`k:⏎␣→a: 1`).  This one is REFUTABLE, and only at the consumer: §6.1's
      preprocessing gate fires at or left of `currentIndent` and this tab is
      past it (so `k:⏎␣→a` is accepted and the pack really does punt), while
      the `:`'s own backward scan — `scanValueIndentTabCheck`, items 31/32 —
      reads the run in front of the KEY and throws.  The constructor therefore
      carries that scan's own reading, plus the park's own three flags
      (`StalePark`) — which is what makes the reading transportable: with the
      flag down and no break, preprocessing re-saves nothing, so the key the
      `:` resolves is the key the tab precedes (`colon_fires_implicit_key`
      spends both).  **Item 289: and the saved key's possibility and line**,
      which that refutation (`scanValue_tab_keyrun_ne`) also reads.  The
      implicit-key consumer has them from the guard its field is stated
      under; `colon_fires_props_key` has no such guard, and both producers
      hold the two facts anyway (the implicit pack under that guard, the
      props pack off the fresh save) — so the reason carries them, and it is
      refuted at both consumers.
    * ~~`dedent` — the landing under-ran the pending's index, so the value is
      not this entry's at all.  Item 64's boundary, and row 19's to close: the
      enclosing collection resumes, which needs a frame stack the pending does
      not carry.~~  **GONE at item 297.**  A dedent landing is the pack
      producers' own business: where the landing width names a frame of the
      park's stack, the frames resume there (item 99); where it names none, or
      the park carries no frames, the producers key a fresh document at the
      landing (items 297 and 296) — row 19's over-approximation of the sibling
      reading, and row 19's to refine.  The reason carried no payload, so a
      consumer could only defer it; deleting it retires the two `:`
      consumers' `dedent` arms.
    (A fourth reason, `noFrame` — a same-line key at a park with no compact
    alternative to close — is GONE, item 125.  A park that owns a frame hands
    it: item 89 threads `pendingMapValue.h_vslot` through the content
    dispatch, item 105 pays the compact `?`'s (`compactExplicitKeyFrame`),
    and item 125 makes the field itself stamp-or-FACE — the frameless
    explicit park does not exist, and the frameless implicit one carries the
    stamp for REAL, because the landed `:` consumers now decide their own
    dispatch state's registers against item 124's line-free discriminators
    instead of reading `scanValue_ok_park_facts`' optional third component.)

    * `implicitValue` — the frameless park's other half, split off the former
      `noFrame` by item 101 and REFUTABLE for the same reason `tab` is, at
      the same place.  `[189]`'s value slot is `s-l+block-node`, which has no compact
      alternative, so a key on the park's own line has no frame here either —
      but the value indicator STAMPED that line (`implicitValueLine`), and
      §8.2.2 refuses a second value indicator on a stamped line, so
      `k: a: 1` is not an input the pack owes a reading for.  The constructor
      carries the stamp at the park, the park's saved-key LINE and its three
      flags (`StalePark`), which is what makes the stamp transportable:
      `scanValue` is the field's only writer, so the content scan between the
      value indicator and this park left it alone
      (`dispatchContent_implicitValueLine`), and the no-break landing puts the
      park on the stamped line.  Item 102 adds the key line and widens the
      carrier from `StaleNodeTail`, which is what lets a `[96]` property run
      hand the same reason on (`k: &p a: 1`) — the run is a key HEAD, and the
      stamp survives its scan too.
    * `markerLine` — the `---` marker is on the key's line (item 300).  §9.1.1
      admits one same-line node on the marker's line and no mapping entry, so a
      block-context `:` there is refused (`contentOnDocumentStartLine`:
      `--- a: 1`, `--- &p a: 1`, `--- [1]: b`).  REFUTABLE at the consumer by
      the stamp's own shape: the constructor carries the scanner's field read
      (`docStartLine`, item 299's, which `scanDocumentStart` alone writes) and
      the key's line, and `dispatch_refutes_sameLine`'s marker disjunct spends
      them with the park's flags the consumers already hold.  Produced where
      item 298 found the class: the content dispatched on a `---` park's own
      line (`content_dispatch_routed`'s `h_markerline`, paid by the `---` arm
      alone) and the flow close whose base slot the open stamped with the
      marker's line (`flowKeyPack_of_close`, off `KmSound`'s base slot).
    * `noKeyContext` — the producer was handed none: the depth-0 flow closes
      whose frame carries no mapping route (item 56's residue), and the two
      packs whose own key context is optional.  It is the one reason that is
      about the CALLER rather than the input, which is why it is named
      separately instead of being folded in with the three above.  Item 103
      split it for that same reason: a flow collection opened in a `[189]`
      value slot on the indicator's own line has no route AND a live stamp, and
      the stamp is the INPUT's fact — so those closes hand `implicitValue`,
      carried across the whole collection on the mask's base slot.  What keeps
      the name is a frame with neither.

    What is NOT here is a missing key HEAD, and that is this item's measured
    correction to the plan.  Items 15–17's alias arm, both quoted arms and the
    plain arm cover every character a content dispatch accepts, and the one
    exception — a block-scalar header — is REFUTED rather than punted (§8.1
    clears the saved key, so `implicitKeyHead_of_dispatch` is total as of this
    item, and every block-scalar park pays its `h_key` field the same way).
    `*x : b` is the scanner's business (`invalidImplicitKey`) and not the
    pack's. -/
inductive KeyPackPunt (sc : ScannerState) : Prop where
  | tab (h : ScannerState.hasTabInPrecedingWhitespaceLoop sc.input
      sc.simpleKey.pos.offset sc.simpleKey.pos.offset = true)
      (h_st : StalePark sc)
      (h_poss : sc.simpleKey.possible = true)
      (h_kline : sc.simpleKey.pos.line = sc.line) : KeyPackPunt sc
  | implicitValue (h_ivl : sc.implicitValueLine = some sc.line)
      (h_kline : sc.simpleKey.pos.line = sc.line)
      (h_st : StalePark sc) : KeyPackPunt sc
  | markerLine (h_doc : sc.docStartLine = some sc.line)
      (h_kline : sc.simpleKey.pos.line = sc.line) : KeyPackPunt sc
  | noKeyContext : KeyPackPunt sc

/-- **A punt travels with the park it is about** (item 102).

    Every reason is a statement about the park's own state, and a step that
    moves the park without moving what the reason reads carries it: a `[96]`
    run's EXTENSION (`&p !t`) and the run's own CONTENT are both such steps.
    What each reason reads is exactly the premise list — the input and the
    saved key's POSITION for the tab's backward scan, the line and the stamp
    for the implicit value, the park's three flags for both, and nothing at
    all for the ~~three~~ ~~two~~ one unpayable name (`noFrame` went at item
    125, `dedent` at item 297).
    **Item 289: the tab also reads the saved key's possibility and line.**
    The line travels by the same two routes as the implicit value's; the
    possibility is the one new premise, `h_poss`, which a property extension
    pays from the saved-key equation it holds and a decorated content from
    its own guard.  The `.pos` (rather than the whole
    saved key) is what makes this usable at a content dispatch, where the
    scans return the position alone.

    The LINE reaches the new park by either of two routes, and which one is
    available is a property of the step rather than of the reason: a property
    EXTENSION never moves the line and says so directly, while a content scan
    may (a multi-line scalar), and there the saved key's own line is what
    carries it — the step's consumer observes exactly that guard on its own
    post-state, and a key that spanned a break fails it first. -/
lemma keyPackPunt_transport {sc s' : ScannerState} (h_punt : KeyPackPunt sc)
    (h_skpos : s'.simpleKey.pos = sc.simpleKey.pos)
    (h_input : s'.input = sc.input)
    (h_line : s'.line = sc.line ∨ s'.simpleKey.pos.line = s'.line)
    (h_ivl : s'.implicitValueLine = sc.implicitValueLine)
    (h_dsl : s'.docStartLine = sc.docStartLine)
    (h_st : StalePark s')
    (h_poss : sc.simpleKey.possible = true → s'.simpleKey.possible = true) :
    KeyPackPunt s' := by
  cases h_punt with
  | tab h _ h_p h_kl =>
    exact KeyPackPunt.tab (by rw [h_input, h_skpos]; exact h) h_st (h_poss h_p)
      (by
        cases h_line with
        | inl h => rw [h_skpos, h]; exact h_kl
        | inr h => exact h)
  | implicitValue h_ivl0 h_kl _ =>
    have h_ln : s'.line = sc.line := by
      cases h_line with
      | inl h => exact h
      | inr h => rw [← h, h_skpos]; exact h_kl
    exact KeyPackPunt.implicitValue (by rw [h_ivl, h_ivl0, h_ln])
      (by rw [h_skpos, h_ln]; exact h_kl) h_st
  | markerLine h_doc0 h_kl =>
    -- Item 300: the marker's line rides as the stamp does — no step but
    -- `scanDocumentStart` writes the field, and the line travels by the saved key.
    have h_ln : s'.line = sc.line := by
      cases h_line with
      | inl h => exact h
      | inr h => rw [← h, h_skpos]; exact h_kl
    exact KeyPackPunt.markerLine (by rw [h_dsl, h_doc0, h_ln])
      (by rw [h_skpos, h_ln]; exact h_kl)
  | noKeyContext => exact KeyPackPunt.noKeyContext

/-- **A closed flow collection's implicit-key pack** (item 56): the two halves,
    joined at the close.

    The pack's ROUTE is the enclosing construct's, and it was known at the OPEN
    — which is why the frame carries it (`FlowBaseRoutes.key`) rather than the
    close recomputing it from a state that no longer sees the block level.  The
    HEAD is the close's own: the completed collection re-read as `[161]
    ns-flow-node(0, block-key)`, which is `[193] c-s-implicit-json-key`'s node
    and so `ImplicitKeyHead.json`'s payload.  Neither half is available where
    the other is, and both are optional for their own reasons: an enclosing
    construct that hosts no mapping entry has no route, and a collection whose
    interior crossed a line has no key reading (the scanner refuses that input
    as a key — `[1,⏎ 2]: b` is "invalid implicit key", and item 104 spends that
    refusal at the guard BEFORE this lemma, so the head's option is never the
    one an input turns on).

    The trailing `s-white*` is empty because the close parks ON the bracket:
    `sp_tok` is both the head's end and the park.

    **The column is the datum item 75 threaded** — the one this producer used to
    hand `True` for, on the grounds that item 28's coordinate belongs to the key
    save at the `[` and the close has RESTORED a different one.  It has not: the
    key the close restores IS the one the open stacked, and the two halves of
    saying so meet here.  The FRAME carries the entry index the route was built
    at against the column the open recorded (`FlowBaseRoutes.key`'s last
    conjunct); the MASK carries that column forward across the whole interior
    (`KmSound`'s base slot, read out by `KmSound.back_col`).

    Item 78 settled the frame's half: no block-context park reaches a bracket
    without knowing what preprocessing saved, so the entry index a frame hands
    over is MEASURED against the stacked key rather than offered.  Item 79
    settled the mask's: an empty mask has no bottom slot and a frame's mask is
    never empty, so the base column is a promise conditional on the mask rather
    than an option.  Both halves are equations now, and the pack this lemma
    builds carries its column — what is left OPTIONAL is the key ROUTE itself,
    which an enclosing construct that hosts no mapping entry does not have.

    **And where the route is absent, the punt has a NAME** (item 103).  The
    same base slot the column rides carries the open's own stamp reading, so a
    collection opened in a `[189]` value slot on the indicator's line hands its
    close the reason `k: [1]: 2` is refused: the `:` after the `]` is a SECOND
    value indicator on a stamped line, which is item 101's refutation at the
    park a flow collection makes.  `noKeyContext` keeps the inputs whose
    enclosing construct simply hosts no mapping entry. -/
lemma flowKeyPack_of_close {sc : ScannerState} {g : Option ScannerState} {n kc : Nat} {sp_start sp_br sp_tok : SurfPos}
    (h_key : (∃ (k : Nat) (sp_key : SurfPos),
      (∀ sp_v, SBlockMapEntry k sp_key sp_v → SLYamlStream sp_start sp_v) ∧
      (∀ sp_end, SFlowContent n .flowOut sp_br sp_end →
        ImplicitKeyHead sp_key sp_end ∨ True) ∧
      kc = k ∧
      -- Item 196: a CHAIN, for `ImplicitKeyPack`'s own reason — this pair is
      -- handed straight to the pack's value-line conjunct, so the flow frame
      -- carries whatever the pack now states.
      ((∃ ns : List Nat, ∀ nv ∈ ns,
        ∀ sp_v : SurfPos, SBlockMapEntry k sp_key sp_v →
        ∀ sp_e : SurfPos, SCompactMapTail k sp_v sp_e →
        ∀ sp_i sp_c : SurfPos, SIndent nv sp_e sp_i → GLit ':' sp_i sp_c →
        ∀ sp_w : SurfPos, SBlockIndented nv .blockOut sp_c sp_w →
        SLYamlStream sp_start sp_w) ∨ PackAltG g) ∧
      -- Item 120: the resume twins ride the frame beside the pair.
      ((∃ ks : List FrameLevel, (∀ fr ∈ ks, fr.width < k) ∧
        ∀ sp_v : SurfPos, SBlockMapEntry k sp_key sp_v →
        ∀ sp_e : SurfPos, SCompactMapTail k sp_v sp_e →
        ResumeFrames (SLYamlStream sp_start) ks sp_e) ∨ True) ∧
      ((∃ (nv : Nat) (ks : List FrameLevel), (∀ fr ∈ ks, fr.width < k) ∧
        ∀ sp_v : SurfPos, SBlockMapEntry k sp_key sp_v →
        ∀ sp_e : SurfPos, SCompactMapTail k sp_v sp_e →
        KeyFrames (ExplValueLine sp_start nv) ks sp_e) ∨ PackAltG g)) ∨ True)
    -- Item 103: the close's own reading of the base slot, both halves at once
    -- (`close_col_of_base`) — the column the pack carries and the stamp the
    -- punt names.
    (h_base : sc.simpleKey.pos.col = kc ∧
      (sc.implicitValueLine = some sc.simpleKey.pos.line ∨ True) ∧
      -- Item 300: and the marker's line, the base slot's third reading.
      (sc.docStartLine = some sc.simpleKey.pos.line ∨ True))
    (h_park : StalePark sc)
    (h_content : SFlowContent n .flowOut sp_br sp_tok) :
    sc.simpleKey.possible = true → sc.simpleKey.pos.line = sc.line →
      ImplicitKeyPack sc sp_start sp_tok ∨ KeyPackPunt sc := by
  intro _ h_kline
  obtain ⟨h_kc, h_stamp, h_mark⟩ := h_base
  -- The punts this lemma can reach, named once: a stamped slot refutes (item
  -- 101), a slot on the marker's line refutes (item 300), and everything else
  -- is the caller's missing key context.
  have punt : KeyPackPunt sc := by
    cases h_stamp with
    | inl h => exact KeyPackPunt.implicitValue (by rw [h, h_kline]) h_kline h_park
    | inr _ =>
      cases h_mark with
      | inl h => exact KeyPackPunt.markerLine (by rw [h, h_kline]) h_kline
      | inr _ => exact KeyPackPunt.noKeyContext
  rcases h_key with ⟨k, sp_key, route, head, hkcol, h_pair, h_tw99, h_tw108⟩ | _
  · rcases head sp_tok h_content with h_head | _
    -- Item 96: the frame carries the value-line pair now, and it passes
    -- through verbatim — the pack's twin is the frame's own.
    -- Item 120: and the resume twins ride the same way, so the pack a
    -- props-headed flow key hands the landed `:` keeps its context's
    -- holdings across the collection.
    · exact Or.inl ⟨k, sp_key, sp_tok, route, h_head, GStar.nil _, h_kc.trans hkcol,
        (h_pair.imp id PackAlt.ofGateClose),
        -- Item 148: the frame's own resume twin carries widths and no stack —
        -- a flow collection's interior is where the block levels stand still,
        -- so the reading a landed `:` would inherit is the FRAME's to hold.
        (h_tw99.imp (fun ⟨ks, h_lt, r⟩ => ⟨ks, h_lt, Or.inr trivial, r⟩) id),
        -- Item 150: the value-line twin the same way — a flow collection's
        -- interior holds the block levels still, so this face carries widths
        -- and no stack either.
        (h_tw108.imp (fun ⟨nv, ks, h_lt, r⟩ => ⟨nv, ks, h_lt, Or.inr trivial, r⟩)
          PackAlt.ofGateClose), Or.inr trivial⟩
    · exact Or.inr punt
  · exact Or.inr punt

/-! ### §1b''' The frame CHAIN, consed (item 192)

    Items 189–191 turned "the `?` frame this park stands inside" from one index
    into a LIST, because the frames above a park are a chain and the landed `:`
    picks one of them by column.  Every producer of such a list holds its
    funders one at a time, so the only two shapes it ever builds are "one
    funder" and "one funder on top of a list I was handed" — spelled out here
    once instead of at each of the sites that build them. -/

/-- One funder, one-element chain (item 192). -/
lemma frameChainOne {P : Nat → Prop} {a : Nat} (ha : P a) : ∀ x ∈ [a], P x := by
  rintro x hx
  rcases List.mem_cons.mp hx with rfl | hx'
  · exact ha
  · exact absurd hx' List.not_mem_nil

/-- One funder consed onto the chain the producer was handed (item 192). -/
lemma frameChainCons {P : Nat → Prop} {a : Nat} {ns : List Nat}
    (ha : P a) (hs : ∀ x ∈ ns, P x) : ∀ x ∈ a :: ns, P x := by
  rintro x hx
  rcases List.mem_cons.mp hx with rfl | hx'
  · exact ha
  · exact hs x hx'

/-- **Two optional funders, one chain** (item 192).  Where a park holds both
    its own frame's value line and the frame above it — which is the shape item
    189 found shadowed, `explFrameValueLine` answering with one of the two — the
    list carries BOTH and the landing chooses by column.  Each funder stays in
    its own `match`, so neither body is written twice. -/
lemma frameChainUnion {P : Nat → Prop} {alt : Prop}
    (h₁ : (∃ ns : List Nat, ∀ nv ∈ ns, P nv) ∨ alt)
    (h₂ : (∃ ns : List Nat, ∀ nv ∈ ns, P nv) ∨ alt) :
    (∃ ns : List Nat, ∀ nv ∈ ns, P nv) ∨ alt := by
  -- Item 309: generic in the alternative `alt` — `True` at every caller until
  -- 12.3.4.2 narrows the family, `ExplicitValueRefused sc` after; the union keeps an
  -- `inr` as it finds it and never manufactures one.
  rcases h₁ with ⟨ns₁, f₁⟩ | _
  · rcases h₂ with ⟨ns₂, f₂⟩ | _
    · refine Or.inl ⟨ns₁ ++ ns₂, ?_⟩
      rintro x hx
      rcases List.mem_append.mp hx with h | h
      · exact f₁ x h
      · exact f₂ x h
    · exact Or.inl ⟨ns₁, f₁⟩
  · exact h₂

/-- **A closed flow collection's explicit-value pack** (item 56): the `?`
    frame's half, carried across the collection.

    `[188]`'s value half needs the KEY's `s-l+block-indented` to close it, and
    for `? [1]⏎: v` that key is the collection the close has just completed —
    which is why the frame carries the pack with the content still to come and
    the close applies it.  Reconstructing it at the close is not an option: the
    frame's value route ends in an already-closed `SLYamlStream`, so nothing
    downstream can recover the node it consumed.

    **Item 192: the frames are a LIST**, and this step is indifferent to how
    long it is — the content it applies is the same for every ancestor, so the
    crossing consumes the whole list in one term. -/
lemma flowVPack_of_close {n : Nat} {sp_start sp_br sp_tok : SurfPos} {alt : Prop}
    (h_vslot : (∃ ns : List Nat, ∀ nv ∈ ns, ∀ sp_end, SFlowContent n .flowOut sp_br sp_end →
      ∀ sp_mid sp_i sp_c, SSLComments sp_end sp_mid → SIndent nv sp_mid sp_i →
        GLit ':' sp_i sp_c → ∀ sp_v, SBlockIndented nv .blockOut sp_c sp_v →
        SLYamlStream sp_start sp_v) ∨ alt)
    (h_content : SFlowContent n .flowOut sp_br sp_tok) :
    (∃ ns : List Nat, ∀ nv ∈ ns,
      ∀ sp_mid sp_i sp_c : SurfPos,
        SSLComments sp_tok sp_mid → SIndent nv sp_mid sp_i →
        GLit ':' sp_i sp_c →
        ∀ sp_v : SurfPos, SBlockIndented nv .blockOut sp_c sp_v →
        SLYamlStream sp_start sp_v) ∨ alt :=
  -- Item 309: generic in the alternative (`frameChainUnion`'s note).
  match h_vslot with
  | Or.inl ⟨ns, f⟩ => Or.inl ⟨ns, fun nv hmem => f nv hmem sp_tok h_content⟩
  | Or.inr h => Or.inr h

/-- The props-key pack (item 17): what a held `[96] c-ns-properties` run hands
    to the content it is about to decorate, so that the pair can be read as
    `[161]`'s `propsContent` arm — the head `[188]` takes for `&a x: v`.

    **`h_route` is `ImplicitKeyPack`'s, at the RUN's start** (item 41).  Items
    17–29 wrote it as the run's own coordinates — the column-0 line start it
    opened on, the stream closed there, and (item 25) the `[63] s-indent(k)`
    between them — which is `rootMapRoute`'s argument list and so admitted the
    root producer alone.  A run is a key HEAD, not a frame: `&p a: 1`'s entry
    reaches the stream by whichever route its enclosing construct offers, and
    those are the three `ImplicitKeyPack` already names (`rootMapRoute`,
    `compactMapRoute`, `valueMapRoute`).  Carrying the conclusion instead of one
    route's coordinates is what lets `- &p a: 1`, `-⏎  &p a: 1` and
    `k:⏎  &p a: 1` be read where `&p a: 1` was — see
    [[CarryTheRouteNotTheCoordinates]], applied a second time to the sibling
    pack.  The consumer got SHORTER by exactly the `rootMapRoute` application it
    used to make.

    The second component is the run RE-READ at
    `block-key`: `[96]`'s optional second half embeds an `s-separate(n,c)`,
    which is `s-separate-lines` in the context the run was built in and
    `s-separate-in-line` here, so a two-half run only re-reads if its internal
    separation crossed no break — and the extension arm builds it from the
    residual whites, which is precisely that fact.

    `h_sk_line` is the pending state's own §7.4 datum: the key saved when the
    run OPENED still sits on the scanner's current line.  It is carried rather
    than demanded because the consuming step can only observe the guard on its
    OWN post-state, and needs this one to conclude the content scan crossed no
    break.

    The route's last conjunct (item 29) is the run's COLUMN, the twin of
    the line datum and of `ImplicitKeyPack`'s own (item 28): a `[96]` scan is
    not a key save (`dispatchContent_*_simpleKey`), so the key the `:` will
    resolve for `&a x: v` is the one saved AT the property — at column `k`,
    which is what lets `scanValuePrepare`'s push inherit the entry index here
    too.  It sits INSIDE the existential because it is a statement about that
    `k`.  Item 29 left it optional for Reflection 653's reason — the compact
    route cannot measure its own column — and item 79 removed that reason: the
    compact route now travels WITH the park's width, so both producers measure
    and the conjunct is an equation.

    **Item 111 — the route's two RESUME twins, `ImplicitKeyPack`'s items 99/108
    verbatim at the run's start.**  A props-headed key parked at a RESUMED
    landing (`k:⏎  m:⏎    - a⏎  &p n: 2⏎o: 3`) must hand the still-open levels
    below its entry to whatever park it opens, or the NEXT landing re-opens at
    the root; the route alone cannot, its codomain being the fused stream.  The
    stream-bottomed twin carries them; the `ExplValueLine`-bottomed one is the
    same stack under an open `[186]` explicit key.  Producers whose levels are
    fused pass `Or.inr trivial`; the landing producer pays them from
    `ResumeKeyCtx` and the root one pays `ks = []`. -/
def PropsKeyPack (sc : ScannerState) (sp_start sp_p sp_scan : SurfPos) : Prop :=
  (∃ k : Nat,
    (∀ sp_v, SBlockMapEntry k sp_p sp_v → SLYamlStream sp_start sp_v) ∧
    sc.simpleKey.pos.col = k ∧
    -- Item 94: the route's VALUE-LINE twin, at the ENTRY level — the pair
    -- `ImplicitKeyPack` carries (item 93), stated at the run's own start,
    -- because a props-headed key (`? &p a: b⏎: - w`) resolves its entry
    -- there.  The `SCompactMapTail` rides so a sibling site can cons;
    -- every present consumer passes `nil`.  Producers whose frame has no
    -- value line pass `Or.inr trivial`.
    -- Item 196: a CHAIN, for `ImplicitKeyPack`'s reason and in step with it —
    -- the two conjuncts are one datum under two heads, and a park reached
    -- through either stands inside the same chain of `?` frames.
    ((∃ ns : List Nat, ∀ nv ∈ ns,
      ∀ sp_v : SurfPos, SBlockMapEntry k sp_p sp_v →
      ∀ sp_e : SurfPos, SCompactMapTail k sp_v sp_e →
      ∀ sp_i sp_c : SurfPos, SIndent nv sp_e sp_i → GLit ':' sp_i sp_c →
      ∀ sp_w : SurfPos, SBlockIndented nv .blockOut sp_c sp_w →
      SLYamlStream sp_start sp_w) ∨ PackAlt sc) ∧
    -- Item 111: the route's RESUME twin (item 99's shape).  Item 148: with
    -- the scanner stack under it, the same way — a props-headed key is a hop
    -- in the same chain, and `colon_open_map_props` spends it identically.
    ((∃ ks : List FrameLevel, (∀ fr ∈ ks, fr.width < k) ∧
      ((∃ lo : Nat, IndentStackCover.Floor lo k (FrameLevel.map k :: ks) ∧
        IndentStackCover.Covered lo (FrameLevel.map k :: ks) sc) ∨ True) ∧
      ∀ sp_v : SurfPos, SBlockMapEntry k sp_p sp_v →
      ∀ sp_e : SurfPos, SCompactMapTail k sp_v sp_e →
      ResumeFrames (SLYamlStream sp_start) ks sp_e) ∨ True) ∧
    -- Item 111: …and the value-line-bottomed one (item 108's shape).
    ((∃ (nv : Nat) (ks : List FrameLevel), (∀ fr ∈ ks, fr.width < k) ∧
      -- Item 150: the value-line face's cover, as at `ImplicitKeyPack`.
      ((∃ lo : Nat, IndentStackCover.Floor lo k (FrameLevel.map k :: ks) ∧
        IndentStackCover.Covered lo (FrameLevel.map k :: ks) sc) ∨ True) ∧
      ∀ sp_v : SurfPos, SBlockMapEntry k sp_p sp_v →
      ∀ sp_e : SurfPos, SCompactMapTail k sp_v sp_e →
      KeyFrames (ExplValueLine sp_start nv) ks sp_e) ∨ PackAlt sc)) ∧
  SCNsProperties 0 .blockKey sp_p sp_scan ∧
  sc.simpleKey.pos.line = sc.line ∧
  -- Item 63: the key is actually SAVED.  Both producers read it off
  -- preprocessing's own save, and `implicit_key_floor` needs it to spend the
  -- column conjunct above — a column is a coordinate of a key that exists.
  sc.simpleKey.possible = true

/-- `inFlow` is `0 < flowLevel` read as a `Bool` (item 35): the flow producers
    of `PendingNode.noPending` all know their depth, and this is the one step
    from that depth to the field they owe. -/
lemma inFlow_of_flowLevel_eq {s : ScannerState} {n : Nat} (h : s.flowLevel = n + 1) :
    s.inFlow = true := by
  unfold ScannerState.inFlow; rw [h]; simp

/-- The flow producers' `h_nodoc` (item 116): at depth ≥ 1 the face's
    `inFlow = false` premise refutes itself — the same
    `inFlow_of_flowLevel_eq h_fl1` the sites pay `h_col` and `h_arm` with,
    read against the premise instead of into a disjunct. -/
lemma nodoc_of_flowLevel_succ {sc : ScannerState} {n : Nat} {sp_start sp : SurfPos}
    (h : sc.flowLevel = n + 1) :
    sc.inFlow = false → GStar SLDocumentPrefix sp_start sp :=
  fun hnf => (Bool.noConfusion (hnf ▸ inFlow_of_flowLevel_eq h) : GStar _ sp_start sp)

/-- The flow producers' `h_noek` (item 186), `nodoc_of_flowLevel_succ`'s twin
    on the scanner side: the seven sites refute the field's `inFlow = false`
    premise with the depth they already hold, so the register face costs them
    the same nothing the document face does. -/
lemma noek_of_flowLevel_succ {sc : ScannerState} {n : Nat}
    (h : sc.flowLevel = n + 1) :
    sc.inFlow = false → sc.explicitKeyLine = none :=
  fun hnf => (Bool.noConfusion (hnf ▸ inFlow_of_flowLevel_eq h) : sc.explicitKeyLine = none)

/-- The flow producers' `h_ntop` (item 208), the third of the same shape: the
    seven flow-interior sites refute `inFlow = false` with the depth they
    already hand `h_col`, `h_arm`, `h_nodoc` and `h_noek`, so the STACK face
    costs them what the other four do.

    Item 205 named this lemma and the field it feeds; what it could not name
    was the count, because `noPending`'s "eight producers" was a sentence
    (item 116) that four items spent and no instrument had re-derived.
    `scripts/park_top_price.py noPending` derives it: **8**, of which these
    seven, and the raw error list reads ELEVEN. -/
lemma ntop_of_flowLevel_succ {sc : ScannerState} {n : Nat}
    (h : sc.flowLevel = n + 1) :
    sc.inFlow = false → sc.currentIndent < 0 :=
  fun hnf => (Bool.noConfusion (hnf ▸ inFlow_of_flowLevel_eq h) : sc.currentIndent < 0)

/-- **The slot face** (item 284): `ParkSlot.slotRun`, read on an array.  The
    `[96]` run in front of the top is absent, or the real token behind it offers
    the next node a slot.  Item 283 measured it true at every reachable depth-0
    props park §9.2 lets through, and showed the arm's token-side fields cannot
    derive it, so the parks that open a depth-0 flow CARRY it. -/
def SlotFace (ts : Array (Positioned YamlToken)) : Prop :=
  propsRunStart ts ts.size = ts.size ∨
    ∃ j, prevRealIdx? ts (propsRunStart ts ts.size) = some j ∧
      ts[j]!.val.offersNodeSlot = true

/-- The real token on top of the array offers the next node a slot — the
    complement of `DanglingPred`'s third conjunct.  It is what a `-`, `?`, `:` or
    `...` park records about itself (item 284). -/
def OfferPred (ts : Array (Positioned YamlToken)) : Prop :=
  ∃ i, prevRealIdx? ts ts.size = some i ∧ ts[i]!.val.offersNodeSlot = true

-- ~~**The `[96]` tail window that CROSSED a break**~~ (`PropsWindowCross`,
-- item 170) is DELETED at item 181.  It named the array whose last real token
-- has a PROPERTY on a different line directly below it — the configuration
-- where §9.2's verdict could not be relayed across a property push, because
-- the walk-back is capped at `[96]`'s arity and so SLIDES one token, and the
-- two windows read different start columns against the same indent stack
-- (`a:⏎!t⏎&b⏎␣␣!s &c x`, `Scratch/ProbeSlide170.lean`).  Three declarations
-- spoke about it: the narrowed length gate (which defers on it still, by its
-- own reading), `propsPark_dangling_of_prop` (which handed it back), and
-- `pendingProps.h_routeX` (which carried a route for it).
--
-- What removes it is not a better relay but an emptier domain: a property
-- pushed onto such a window makes THREE adjacent properties, `[96]` admits
-- one anchor and one tag, and §9.2's fourth clause (item 180) refuses the
-- duplicate.  So the states the window named are scanner-refused, the relay's
-- premise is false there, and no route is owed
-- (`crossedPropsExcessPos?_push_prop_three`; pinned in
-- `Tests/Guards/Proofs/PropsCrossWindowRoute.lean`).

inductive PendingNode (sc : ScannerState) : Bool → SurfPos → SurfPos → SurfPos → Prop where
  /-- No pending gap. Block stack top and scanner at same position.
      Occurs at stream start, between documents, after document suffixes
      whose trailing SSLComments has already been absorbed, and at the
      start of a new block collection level (before any entry content).

      **`h_col` — where the machine parks with nothing pending** (item 35).
      In BLOCK context that is a line start and nothing else: the stream's
      own beginning, or a document boundary whose `[79] s-l-comments` the
      previous step already absorbed.  Every other producer is a FLOW one —
      the position after a `[`/`{`/`,`/`]`/`}` at depth ≥ 1 — and parks
      mid-line by construction.  The disjunction is not a weakening: it is
      the two families named, and the block-dispatch consumer reads it with
      `sc.inFlow = false` in hand, which is exactly the side that has to be
      at column 0.

      What it buys is an UNREACHABILITY rather than a production.  The
      inline residue at `accum_block_on_noPending` — a `-`/`?`/`:` reached
      from a mid-line park with nothing pending — has no inhabitant to
      derive: the only block-context park is at column 0, which is the
      landing arm.  A pending that carries no evidence is also a pending
      that names no state, and this is what naming the state is worth. -/
  | noPending (sp_start sp : SurfPos)
      (h_col : sp.col = 0 ∨ sc.inFlow = true)
      -- **`h_arm` — the save is armed wherever the column is 0** (item 76, LAST
      -- so the patterns naming `h_col` still bind it).  The block-context park
      -- is the stream's own seed, and `ScannerState.mk'` arms the flag; every
      -- other producer is a flow one and pays the same `inFlow` disjunct
      -- `h_col` does.  It is what lets the landed `:` here MEASURE its floor:
      -- a park at a line start crosses no break, so the landing's own re-arm
      -- says nothing and the flag has to come from the park.
      (h_arm : (sc.simpleKeyAllowed = true ∧ sc.simpleKey.possible = false) ∨ sc.inFlow = true)
      -- **`h_nodoc` — the region behind a virgin block-context park is
      -- document prefixes only** (item 116): row 19's "no document started"
      -- carrier, the prerequisite item 110 measured 1c's constructor
      -- tightening against.  The constructor has exactly EIGHT producers,
      -- and the premises split them the way `h_col`'s disjunction does: the
      -- seven flow-interior sites refute `inFlow = false` with the
      -- `inFlow_of_flowLevel_eq h_fl1` they already pay the other two
      -- fields with (`nodoc_of_flowLevel_succ`), and the seed pays the real
      -- witness — `[202]`'s byte order mark if there is one, nothing else —
      -- ignoring both premises.  A `---` parks `pendingDocStart` and raises
      -- `documentEverStarted`; a `...` parks `pendingDocEnd`; so a block
      -- context park with the flag still down stands on prefixes alone.
      -- What it buys: a landing off this park can spend a completed root
      -- node as the stream's FIRST document — `nodocMapRoute`, `[211]`'s
      -- `single`, whose document slot the tightening leaves untouched —
      -- where `rootMapRoute` hands `implicitContinue` a bare document the
      -- stream cannot honestly restart.
      --
      -- **The flag premise came OFF at item 135**, which is what makes the
      -- field spendable rather than merely true.  Item 116 wrote both premises
      -- because they name the two producer families; but the seven flow sites
      -- refute on `inFlow` ALONE and the seed pays unconditionally, so
      -- `documentEverStarted = false` was never load-bearing at any producer —
      -- while at every CONSUMER it is a scanner-state fact nothing threads.
      -- A premise no producer spends and no consumer can discharge is a field
      -- that cannot be cashed; dropping it costs nothing and pays
      -- `accum_block_on_noPending`'s two root-sequence routes.
      (h_nodoc : sc.inFlow = false → GStar SLDocumentPrefix sp_start sp)
      -- **`h_noek` — a virgin block-context park has NO explicit key open**
      -- (item 186, LAST so the patterns naming the older fields still bind
      -- them).  `h_nodoc`'s scanner-side twin, and paid by the same split of
      -- the SAME eight producers: the seven flow-interior sites refute
      -- `inFlow = false` with the `inFlow_of_flowLevel_eq h_fl1` they already
      -- hand `h_col` and `h_arm`, and the seed pays the real witness —
      -- `ScannerState.mk'` writes `none` and neither the `streamStart`
      -- emission nor §5.2's BOM advance touches the register.
      --
      -- What it buys is a REFUTATION.  `scanKey` is the register's only
      -- writer that makes it live — `[191]`'s `?` — and `scanValue` only ever
      -- carries it forward or clears it, so the escape's class-A branch (a
      -- landed `:` whose dispatch state holds a LIVE register at its own
      -- column) cannot stand on a park behind which nothing has been scanned.
      -- Item 185 left that branch here as `_stamp_nopack`'s fourth site, the
      -- one it read as "in the class by construction"; this field discharges
      -- it instead, and item 186 measured the emptiness before paying for it
      -- (1 440 class-A `:` dispatches over the sweep corpus, ZERO of them
      -- behind a virgin park).
      (h_noek : sc.inFlow = false → sc.explicitKeyLine = none)
      -- **`h_ntop` — a virgin block-context park's indent stack is EMPTY**
      -- (item 208, LAST so the patterns naming the older fields still bind
      -- them).  `h_noek`'s stack-side twin, paid by the same split of the same
      -- eight producers: the seven flow-interior sites refute `inFlow = false`
      -- with the `inFlow_of_flowLevel_eq h_fl1` they already hand `h_col`,
      -- `h_arm` and `h_noek` (`ntop_of_flowLevel_succ`), and the seed pays the
      -- real witness — `ScannerState.mk'` leaves `indents` empty, where
      -- `currentIndent` reads the stream level `-1`, and neither the
      -- `streamStart` emission nor §5.2's BOM advance pushes anything.
      --
      -- What it buys is the `-`'s FLOOR at a landing this park cannot floor
      -- any other way.  `landing_floor_of_arm` reads the floor off the walk
      -- that carried a park DOWN to column 0; the seed is already there and
      -- crosses no such walk, so the unwind may never run and the stack the
      -- dispatch reads is this one — which is empty.  That is the one of ring
      -- 1's seven producers whose payment is a FIELD rather than a reading.
      --
      -- Eight is the instrument's number (`scripts/park_top_price.py
      -- noPending`), not item 116's sentence, which said the same thing and
      -- was spent four times before anything re-derived it.
      (h_ntop : sc.inFlow = false → sc.currentIndent < 0)
      -- `[66]` narrowed to col 0: the scanner's comment gate at this park, off a
      -- line start — the token that parked here is the last consumed char.
      (h_gate : sc.inFlow = false → sp.col ≠ 0 → ¬ (CommentOk sc ∧ sc.peek? = some '#')) :
      PendingNode sc false sp_start sp sp
  /-- Content token scanned (scalar, anchor, alias, tag).
      The gap sp_block → sp_scan contains SSeparate + content.
      Awaiting SSLComments sp_scan sp' to close into SBlockNode.
      `h_closable` constructs the stream extension using grammar evidence
      and the stream captured at dispatch time. The `SLYamlStream sp_start`
      is captured inside the closure, not passed at consumption time.

      `h_key` (items 15/16, column coupling item 28) is the implicit-key
      coupling, riding the
      scanner-state parameter like item 12's props couplings: when the saved
      key is possible AND rests on the current line — exactly
      `scanValueValidate`'s §7.4 block-context pass — the parked content
      re-reads as a `.blockKey` one-line key head (plain, double- or
      single-quoted), or the site punts (`Or.inr`: alias/block-scalar
      content, or col ≠ 0).  The guard's two
      hypotheses are decidable on `sc`, so the same-line `:` consumer fires
      the field by classical case split alone. -/
  | pendingContent (sp_start sp_block sp_scan sp_gram : SurfPos)
      (h_line : sp_scan.col = 0 ∨ LineNodeStop sp_scan.chars)
      -- **Item 275: §8.1's silence, beside §9.2's.**  The close's own floor
      -- reading, carried where the dangling reading already sits.  Item 274
      -- measured what it buys: the slot branch of `FlowBaseAnchor.gate` closes
      -- by EX FALSO off this premise and does not close without it (`floor=B`
      -- against `offer=O`), and the pair of silences is the only premise false
      -- at every cell of the family the gate admits.  It costs its producers
      -- nothing, exactly as §9.2's did (item 159), and its one consumer reads
      -- it off `scanLoop_checkFlowValueIndent`, which the loop runs on the
      -- line after the check `h_nd` already comes from.
      (h_closable : danglingNodePos? sc = none →
        underIndentedFlowValuePos? sc = none → ∀ sp_mid,
        SSLComments sp_gram sp_mid →
        SLYamlStream sp_start sp_mid)
      (h_key : sc.simpleKey.possible = true → sc.simpleKey.pos.line = sc.line →
        ImplicitKeyPack sc sp_start sp_scan ∨ KeyPackPunt sc)
      -- Item 47 (LAST so the patterns naming the older fields still bind
      -- them): a mid-line park that could meet an inline `:` at the CONTENT
      -- dispatch is a stale node tail — the completed scan cleared the
      -- simple-key flag and left the key strictly behind the cursor — which
      -- is what refutes `scanNextToken_checkAdjacentValue`'s success at the
      -- arm.  A park that cannot meet one (a line-start or EOL park) refutes
      -- the premise instead.
      (h_stale : InlineResidue sp_scan ':' → StaleNodeTail sc)
      -- Item 51 (LAST, same reason): the pending explicit-KEY frame this
      -- park's content lives inside, when there is one.  The value pack is
      -- `[187]`'s value half waiting for its line: given the landing's
      -- `[79] s-l-comments` (which completes this park's content into the
      -- KEY's `s-l+block-indented`), the `s-indent(nv) ':'` read off that
      -- landing, and the value slot — `[185] s-l+block-indented`, compact
      -- alternatives included — it produces the stream through the ONE
      -- `[188]` explicit entry.  This is what `? a⏎: - w` needed: a
      -- standalone `: - w` line has no production of its own ([189]'s
      -- empty-key value slot is `s-l+block-node`), so the entry must stay
      -- open across the break, and this field is how it rides.
      --
      -- **Item 192: a LIST of frames, for item 191's reason one lane over.**
      -- The frames open above this park are a CHAIN, and which of them the
      -- landed `:` is on is not known here: `?⏎  ? - [1]⏎: w` lands one frame
      -- up and `?⏎  ?⏎    ? - [1]⏎: w` two, both accepted, and the ladder has
      -- no largest member.  The block lane carries that chain on the PARK
      -- (`pendingBlock.h_kslotUp`); a flow collection standing in the entry's
      -- node slot re-parks HERE when it closes, so the chain has to survive
      -- the crossing — `FlowBaseRoutes.vslot` carries it across the
      -- collection and `flowVPack_of_close` hands it on.
      (h_vpack : (∃ ns : List Nat, ∀ nv ∈ ns,
        ∀ sp_mid sp_i sp_c : SurfPos,
          SSLComments sp_scan sp_mid → SIndent nv sp_mid sp_i →
          GLit ':' sp_i sp_c →
          ∀ sp_v : SurfPos, SBlockIndented nv .blockOut sp_c sp_v →
          SLYamlStream sp_start sp_v) ∨ PackAlt sc)
      -- **Item 77 — the park's own arm** (LAST, so the patterns naming the older
      -- fields still bind them).  A landed `:` measures its floor against the
      -- save preprocessing makes at the landing, and item 76 supplies that save
      -- for every park OFF a line start (the walk crosses a break, which
      -- re-arms).  A park AT one needs the flag itself, and
      -- `dispatchContent_col_pos_or_armed` says the content scans deliver one or
      -- the other: the block scalar ends past a break with the flag UP, and
      -- every other content scan ends on a character it consumed inside a line.
      --
      -- **Item 80 — the armed park's key is DOWN.**  The one armed content scan
      -- is the block scalar, and §8.1 clears the saved key on its way out
      -- (`scanBlockScalar_simpleKey_false`) — so a live pack and an armed park
      -- cannot coexist, which is what lets the same-line `:` refute
      -- preprocessing's re-save instead of punting on it: armed refutes the
      -- pack's own guard, and mid-line reaches `h_stale`, whose flag-down half
      -- is the no-break inherit's premise.
      (h_arm : (sc.simpleKeyAllowed = true ∧ sc.simpleKey.possible = false) ∨
        0 < sp_scan.col)
      -- **Item 109 (LAST, same reason): the completed content's RESUME frames.**
      -- `h_closable` and `h_vpack` are this park's two closes — the stream and
      -- the enclosing `?`'s value line — and both END the still-open mapping
      -- levels this content sits in.  A landed SIBLING does not end them: it
      -- continues the innermost level whose width it matches, which is what the
      -- parser reads (`?⏎  a: b⏎  c: d⏎: - w` emits ONE inner mapping with two
      -- entries).  These two fields are the same two closes held at the
      -- ENTRIES level, so a landing can resume instead of re-opening at the
      -- root — `h_closable` is the stream face's `ResumeFrames.close` and
      -- `h_vpack` is the value face's, which is why neither field moves.
      --
      -- Both faces ride because they are different stacks (item 108): the
      -- stream face closes the `?` entry with `[188]`'s `e-node` on its way
      -- down, and once closed the frame's value line is unreachable.  Paid by
      -- the value completion of a `pendingMapValue` that carried them; every
      -- other producer passes `Or.inr trivial`.
      --
      -- **Item 152: the cover rides both faces**, in the shape a landing reads
      -- it — `resumectx_of_landing`'s own input.  The INDEX is existential
      -- here, and that is the whole reason one slot serves two lanes: this park
      -- has no `n` of its own (it is depth-0 by construction), the two producers
      -- that pay bound their lists at DIFFERENT indices (the stream face at the
      -- entry's level, the value face one column above the `?` — item 150's
      -- stagger), and `IndentStackCover.Floor.pop_to` spends the WIDTHS half
      -- alone.  So the index is carried and forgotten, and the landing's hop
      -- costs the same at either face.
      (h_framesS : (∃ ks : List FrameLevel,
        ((∃ lo n : Nat, IndentStackCover.Floor lo n ks ∧
          IndentStackCover.Covered lo ks sc) ∨ True) ∧
        ∀ sp_mid : SurfPos, SSLComments sp_scan sp_mid →
        ResumeFrames (SLYamlStream sp_start) ks sp_mid) ∨ True)
      (h_framesV : (∃ (nv : Nat) (ks : List FrameLevel),
        ((∃ lo n : Nat, IndentStackCover.Floor lo n ks ∧
          IndentStackCover.Covered lo ks sc) ∨ True) ∧
        ∀ sp_mid : SurfPos, SSLComments sp_scan sp_mid →
        KeyFrames (ExplValueLine sp_start nv) ks sp_mid) ∨ PackAlt sc)
      (h_nodir : sc.allowDirectives = false)
      -- **Item 139 — the park's own §9.2 face** (LAST, so the patterns naming
      -- the older fields still bind them).  Every producer of this park is a
      -- scan that FINISHED a node, so the token array's reading is the same at
      -- all of them and needs no premise: `scanNextToken_checkBareDocument`'s
      -- fourth conjunct, held where the landing can read it.  `h_stale` carries
      -- the same fact behind `InlineResidue`'s `col ≠ 0`, which a column-0
      -- landing has not got.
      (h_tail : CompletedTail sc)
      -- **Item 154 — the park's own INDENT CHECK, where the park is at a line
      -- start** (LAST, same reason).  Item 147 gave a landing its floor off the
      -- walk that carried it down to column 0; a park already AT column 0
      -- crosses no such walk, so that reading is not there and item 152's
      -- consumer punted its PAYER on exactly those landings.  The floor is
      -- preprocessing's unwind, the unwind runs on this flag, and the flag is
      -- the park's to state.
      --
      -- ~~Only the block scalar pays, and it is the only producer that can be
      -- asked: `[170]`/`[174]` is the one content scan that reaches column 0
      -- (item 77's note on `dispatchContent_col_pos_or_armed`), and it reaches
      -- it by consuming the break that arms the check.  The other producers
      -- punt into a premise none of their parks can satisfy.~~
      --
      -- **REQUIRED since item 207, and the paragraph above was a reading of
      -- item 77's note rather than a measurement of it.**  What that note says
      -- is that `dispatchContent_col_pos_or_armed` hands back a COLUMN for
      -- every content arm but one; it does not say the remaining arm is the
      -- only one that can answer this question, and the other direction of the
      -- disjunct answers it just as well — a park OFF a line start satisfies
      -- the premise vacuously.  Item 206 made the case analysis total
      -- (`dispatchContent_nic_or_col_any`), and `content_park_nic_any` is the
      -- resulting term: the same five arguments `h_arm` is already paid with,
      -- at every one of this park's producers.
      (h_nic0 : sp_scan.col = 0 → sc.needIndentCheck = true)
      -- **Item 168 — the enclosing SEQUENCE's tail, across the compact-mapping
      -- cascade** (LAST, so the patterns naming the older fields still bind
      -- them).  Item 167 gave the two ENTRY parks this face; the corpus's own
      -- dedenting `-` does not park on either of them.  It parks HERE, after a
      -- mapping value (`- sku: BL394D⏎  quantity: 4⏎- sku: …`) — 75 of the 76,
      -- measured — so the collection's tail reaches the landing only if it
      -- crosses the `:` with the key and comes back out with the value.
      --
      -- `kk` is the innermost still-open mapping level and its tail RIDES, so a
      -- SIBLING entry at that width conses before re-parking; `ke` is the
      -- `[183]` the whole compact mapping fills.
      --
      -- **Item 169: and `ks` is everything between them** — the still-open
      -- mapping levels BELOW `kk`, innermost first, each held as its own
      -- entries-level continuation.  Item 168 had one width and folded the
      -- rest into the producer; that reaches a park nested one mapping deep
      -- inside the entry and no further, which is 67 of the corpus's 76.  A
      -- park two deep (`- step:⏎    instrument: x⏎- …`) needs `kk`'s tail and
      -- then the level below it, and `ResumeFrames` is that list.  The landing
      -- closes every one of them (`ResumeFrames.close`), so no cover rides
      -- here and no width is ever tested for membership.  Paid by the value
      -- completion of a `pendingMapValue` that carries one; every other
      -- producer punts.
