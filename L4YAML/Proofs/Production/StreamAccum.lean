      (Or.inl ⟨⟨j, sp_mid, h_col0m, h_stream_mid, h_ind⟩, h_sk_f.1, h_sk_f.2⟩)
      -- Item 109: and the SAME landing read at the entries level — the entry
      -- closes empty on the landing's comments, the sequence tail is `nil`, and
      -- what is left is the mapping levels below (`k:⏎  -⏎b: 2`).  The root
      -- context above stays as the fallback for a width that names no level.
      (resumectx_of_landing h_col0m (SIndent_gives_GStar_SSWhite h_ind) h_ssl_land
        h_preprocess hcorr_prep
        -- ~~Item 151: the SEQUENCE park's face has frames and no cover —
        -- `pendingBlock.h_closeF` carries the widths alone, and this relay has
        -- neither of the stack's two readings to pay one with — so the slot
        -- the context now has is filled with the punt.  That field and this
        -- relay's missing `Mono`/`SentinelBase` are what a payment costs here.~~
        -- **Item 155 pays all three.**  The field carries a cover, this relay
        -- takes the two stack readings as parameters, and the face goes through
        -- whole — index and all, which the payer then forgets.
        (match h_closeF_old with
         | Or.inl ⟨ks, _, h_cvS, closeF⟩ =>
             Or.inl ⟨ks, h_cvS.imp (fun ⟨lo, hb, hc⟩ => ⟨lo, n, hb, hc⟩) id, fun sp_m h_ssl =>
             closeF sp_m (SBlockIndented.empty n .blockIn sp_scan sp_m h_ssl) sp_m
               (SCompactSeqTail.nil n sp_m)⟩
         | Or.inr _ => Or.inr trivial)
        (match h_closeFV_old with
         | Or.inl ⟨nv, ks, _, closeFV⟩ =>
             Or.inl ⟨nv, ks, Or.inr trivial, fun sp_m h_ssl =>
             closeFV sp_m (SBlockIndented.empty n .blockIn sp_scan sp_m h_ssl) sp_m
               (SCompactSeqTail.nil n sp_m)⟩
         | Or.inr h_alt => Or.inr h_alt)
        h_pay_seq (Or.inr trivial))
      (Or.inr trivial)
      (Or.inr trivial) (Or.inr trivial)
      -- Item 144: a `-` park's tail is `blockEntry`, which `completesFlowValue`
      -- excludes — §9.2 stands aside here on its token reading, and on the
      -- indent stack too (`k:⏎␣␣-⏎␣␣␣␣b` lands at `sz=3`).
      sc (Or.inr trivial)
      -- Item 174: no held run stands behind a `-` park.
      (Or.inr trivial)

/-- The mapping twin of `accum_content_on_pendingBlock_indented` (item 23):
    the value of an INDENTED `[189]` empty-key entry or `[186]` explicit key —
    `  : v`, `  ? a`, `    : "x"`.  Same one question, same answer; the only
    difference from the sequence arm is that there is no entries-level snoc to
    carry (siblings re-open through `[211]`'s bare-document continuation, as
    item 13 established). -/
lemma accum_content_on_pendingMapValue_indented
    (sc : ScannerState) (sp_start sp_block sp_scan : SurfPos) (n : Nat)
    (s_prep s' : ScannerState) (c : Char) (sp_prep sp_scan' : SurfPos)
    (h_stream_block : SLYamlStream sp_start sp_block)
    -- Item 179: `n` is the RAW entry column; the awaited node and the floor
    -- read at the SHIFTED index, `pendingMapValue`'s own fields' shape.
    (h_close_old : ∀ (sp : SurfPos), SBlockNode (n + 1) .blockIn sp_scan sp → SLYamlStream sp_start sp)
    (h_floor_old : IndentFloor sc (n + 1))
    -- Item 83: the park is off a line start (every producer parks one past an
    -- indicator), which the indented reading now demands.
    (h_col0_old : 0 < sp_scan.col)
    -- Item 68: the park's own column, where the pending could measure it — a
    -- `[96]` run parked from here inherits it through the run's leading
    -- separation (`separateLines_col_ge`).
    (h_ncol_old : n ≤ sp_scan.col ∨ True)
    -- Item 51: the pending's `[187]` explicit frame at the entry's index
    -- (`k:⏎  ? a` — the nested `?`), threaded exactly as at the root arm.
    (h_expl : (∃ sp_q : SurfPos, GLit '?' sp_q sp_scan ∧
      ∀ sp_v : SurfPos, SBlockMapEntry n sp_q sp_v →
        SLYamlStream sp_start sp_v) ∨ PackAlt sc)
    -- Item 89: the pending's OPEN `[185]` slot at the entry's index, threaded
    -- exactly as at the root arm (`k:⏎  ? a: b`'s `a`).
    (h_vslot : (sp_scan.col = n + 1 ∧ ∀ sp_v : SurfPos,
      SBlockIndented n .blockOut sp_scan sp_v →
        SLYamlStream sp_start sp_v) ∨ PackAlt sc)
    -- Item 93: the park's value-line twin at the entry's index, threaded
    -- exactly as at the root arm (`k:⏎  ? a: b⏎  : - w`'s `b`).
    (h_kslot : (∃ ns : List Nat, ∀ nv ∈ ns,
      ∀ sp_m : SurfPos, SBlockNode (n + 1) .blockIn sp_scan sp_m →
      ∀ sp_i sp_c : SurfPos, SIndent nv sp_m sp_i → GLit ':' sp_i sp_c →
      ∀ sp_v : SurfPos, SBlockIndented nv .blockOut sp_c sp_v →
      SLYamlStream sp_start sp_v) ∨ PackAlt sc)
    -- Item 99: the park's resume frames, both faces (`pendingMapValue`'s
    -- `h_closeF`/`h_frames`), threaded for the pack lemmas' resume twins.
    (h_closeF99 : (∃ ks : List FrameLevel, (∀ fr ∈ ks, fr.width < n) ∧
      -- Item 148: the cover rides this face, which is the one the pack
      -- lemma's NESTED branch reads.
      ((∃ lo : Nat, IndentStackCover.Floor lo n (FrameLevel.map n :: ks) ∧
        IndentStackCover.Covered lo (FrameLevel.map n :: ks) sc) ∨ True) ∧
      ∀ sp_mid : SurfPos, SBlockNode (n + 1) .blockIn sp_scan sp_mid →
      ResumeFrames (SLYamlStream sp_start) (FrameLevel.map n :: ks) sp_mid) ∨ True)
    -- Item 147: the field's shape, cover included — this relay carries the
    -- park's `h_frames` verbatim, and ~~projects the ROUTE at the pack lemma,
    -- whose `h_dframes` is still the widths alone~~ **since item 149 hands it
    -- to the pack lemma unchanged**: `h_dframes` carries the cover the DEDENT
    -- branch spends, and `h_closeF99` the one its NESTED branch reads.
    -- ~~The one place the route is still projected out is
    -- `resumectx_of_landing`, which has no cover slot on either lane.~~
    -- **Item 151 gave it one on each**, and the face goes through whole —
    -- index included, which the payer then forgets.
    (h_frames99 : (∃ ks : List FrameLevel,
      ((∃ lo : Nat, IndentStackCover.Floor lo n ks ∧
        IndentStackCover.Covered lo ks sc) ∨ True) ∧
      ∀ sp_mid : SurfPos, SSLComments sp_scan sp_mid →
      ResumeFrames (SLYamlStream sp_start) ks sp_mid) ∨ True)
    -- Item 108: the same two faces bottomed at the enclosing `?` frame's
    -- value line, threaded for the pack lemma's dedent branch.
    (h_closeFV108 : (∃ (nv : Nat) (ks : List FrameLevel), (∀ fr ∈ ks, fr.width ≤ n) ∧
      -- Item 150: the value-line faces carry the cover too.
      ((∃ lo : Nat, IndentStackCover.Floor lo (n + 1) ks ∧
        IndentStackCover.Covered lo ks sc) ∨ True) ∧
      ∀ sp_mid : SurfPos, SBlockNode (n + 1) .blockIn sp_scan sp_mid →
      KeyFrames (ExplValueLine sp_start nv) ks sp_mid) ∨ PackAlt sc)
    (h_framesV108 : (∃ (nv : Nat) (ks : List FrameLevel),
      ((∃ lo : Nat, IndentStackCover.Floor lo (n + 1) ks ∧
        IndentStackCover.Covered lo ks sc) ∨ True) ∧
      ∀ sp_mid : SurfPos, SSLComments sp_scan sp_mid →
      KeyFrames (ExplValueLine sp_start nv) ks sp_mid) ∨ PackAlt sc)
    -- Item 90: the park's own flag (item 58), handed to the pack lemmas.
    (h_ska : sc.simpleKeyAllowed = true)
    -- Item 101: the park's own implicit-value stamp and the two facts that
    -- carry it to the content park — `pendingMapValue`'s `h_ivl`, `h_nic` and
    -- `h_real`.  Spent by the pack lemma at the branch `h_vslot` has no frame
    -- for: an IMPLICIT value's same-line key is refused by §8.2.2, so that
    -- punt names a reason rather than an input.  Item 125: stamp-or-FACE, as
    -- at the root arm.
    (h_ivl_mv : sc.implicitValueLine = some sc.line ∨
      (sp_scan.col = n + 1 ∧ ∀ sp_v : SurfPos,
        SBlockIndented n .blockOut sp_scan sp_v → SLYamlStream sp_start sp_v))
    (h_nic_mv : sc.needIndentCheck = false)
    (h_real_mv : LastTokenReal sc.tokens)
    -- **Item 149: the stack's two readings**, carried down to the pack
    -- lemmas' dedent branch, which is where a landing's cover is re-listed
    -- over the widths it pops to.  `h_base` rides beside them from item
    -- 146's own thread (`accum_content_pending`).
    (h_mono : IndentStackMono.Mono sc)
    (h_base : IndentStackBase.SentinelBase sc)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (hcorr_result : ScannerSurfCorr s' sp_scan')
    (h_corr : ScannerSurfCorr sc sp_scan)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h_not_doc : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).col = 0 →
      atDocumentBoundary (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) = false)
    (h_flow_disp : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).inFlow = false)
    (h_dispatch : scanNextToken_dispatchContent
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) c = .ok s')
    -- **Item 168 — the park's SEQUENCE face** (LAST, so the existing argument
    -- order stands).  `pendingMapValue.h_seqF`, threaded so the content park
    -- this arm opens can carry it on: the scanned content is the node the face
    -- awaits, and what is still open underneath is this entry's own level and
    -- then the enclosing `[183]`'s tail.  The ROOT arm has no such parameter —
    -- a `pendingMapValue` at index 0 is the root mapping's value, and no
    -- sequence entry encloses it.
    (h_seqF168 : (∃ (ke : Nat) (ks : List FrameLevel), (∀ fr ∈ ks, fr.width < n) ∧
      ∀ sp_mid : SurfPos, SBlockNode (n + 1) .blockIn sp_scan sp_mid →
      ∀ sp_e : SurfPos, SCompactMapTail n sp_mid sp_e →
      ResumeFrames (SeqEntryTail sp_start ke) ks sp_e) ∨ True)
    -- Item 284: what the token behind this landing pays a property run's
    -- slot face with (`SlotGateAt`).
    (h_src : SlotGateAt s_prep) :
    ∃ sp_gram' sp_block' sp_flow' sp_scan',
      SLYamlStream sp_start sp_gram' ∧
      BlockStack sp_gram' sp_block' ∧
      FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
      PendingNode s' false sp_start sp_flow' sp_scan' ∧
      ScannerSurfCorr s' sp_scan' := by
  -- **Item 152: the incoming stack, stepped to the PARK.**  Preprocessing only
  -- pops and a content dispatch writes no level, so the cover items 148/150 put
  -- on the two close faces reaches the park those faces fund unchanged — which
  -- is what lets the park's own resume frames carry it without re-deriving
  -- anything.  Same chain as `accum_content_pending`'s `h_cov_step`.
  have h_cov_step : ∀ (lo : Nat) (ks : List FrameLevel),
      IndentStackCover.Covered lo ks sc → IndentStackCover.Covered lo ks s' :=
    fun lo ks hc =>
      IndentStackCover.dispatchContent_cover h_dispatch
        ((IndentStackCover.preprocess_cover h_preprocess hc).of_indents_eq
          (by split <;> rfl))
  -- Item 89: the open slot in the shape the pack lemmas bundle, as at the
  -- root arm.
  -- Item 93: with the frame's value-line pack beside it, paid from `h_expl`
  -- as at the root arm.
  -- Item 101: the stamp in the shape the pack lemma reads it.  Item 125: or
  -- the FACE, converted as at the root arm.
  have h_ivl_pack : (sc.implicitValueLine = some sc.line ∧
      sc.needIndentCheck = false ∧ LastTokenReal sc.tokens) ∨
      ((∀ sp, SBlockIndented n .blockIn sp_scan sp → SLYamlStream sp_start sp) ∧
        sp_scan.col = n + 1 ∧
        -- Item 196: the chain, in step with the pack conjunct it funds.
        ((∃ ns : List Nat, ∀ nv ∈ ns, ∀ sp : SurfPos, SBlockIndented n .blockIn sp_scan sp →
          ∀ sp_i sp_c : SurfPos, SIndent nv sp sp_i → GLit ':' sp_i sp_c →
          ∀ sp_v : SurfPos, SBlockIndented nv .blockOut sp_c sp_v →
          SLYamlStream sp_start sp_v) ∨ PackAlt sc)) :=
    match h_ivl_mv with
    | Or.inl h => Or.inl ⟨h, h_nic_mv, h_real_mv⟩
    | Or.inr h_face => Or.inr ⟨fun sp h_bi =>
        h_face.2 sp (SBlockIndented_blockIn_to_blockOut h_bi), h_face.1,
        -- Item 196: this lane's slot is `[185]`'s, WIDER than the awaited
        -- node `h_kslot` premises, so the ancestors cannot fund it and the
        -- park's own frame is still the only answer — as a one-element chain.
        match h_expl with
        | Or.inl ⟨sp_q, h_qlit, route⟩ => Or.inl ⟨[n], frameChainOne (a := n)
            (fun sp h_bi sp_i sp_c h_iv h_lit sp_v h_sbi =>
              route sp_v (SBlockMapEntry.explicit n sp_q sp_scan sp sp_i sp_c sp_v
                h_qlit (SBlockIndented_blockIn_to_blockOut h_bi) h_iv h_lit h_sbi))⟩
        | Or.inr h => Or.inr h⟩
  have h_compact_vslot : ((∀ sp, SBlockIndented n .blockIn sp_scan sp →
      SLYamlStream sp_start sp) ∧ sp_scan.col = n + 1 ∧
      -- Item 196: the chain, in step with the pack conjunct it funds.
      ((∃ ns : List Nat, ∀ nv ∈ ns, ∀ sp : SurfPos, SBlockIndented n .blockIn sp_scan sp →
        ∀ sp_i sp_c : SurfPos, SIndent nv sp sp_i → GLit ':' sp_i sp_c →
        ∀ sp_v : SurfPos, SBlockIndented nv .blockOut sp_c sp_v →
        SLYamlStream sp_start sp_v) ∨ PackAlt sc)) ∨ True :=
    match h_vslot with
    | Or.inl hvs => Or.inl ⟨fun sp h_bi =>
        hvs.2 sp (SBlockIndented_blockIn_to_blockOut h_bi), hvs.1,
        -- Item 196: this lane's slot is `[185]`'s, WIDER than the awaited
        -- node `h_kslot` premises, so the ancestors cannot fund it and the
        -- park's own frame is still the only answer — as a one-element chain.
        match h_expl with
        | Or.inl ⟨sp_q, h_qlit, route⟩ => Or.inl ⟨[n], frameChainOne (a := n)
            (fun sp h_bi sp_i sp_c h_iv h_lit sp_v h_sbi =>
              route sp_v (SBlockMapEntry.explicit n sp_q sp_scan sp sp_i sp_c sp_v
                h_qlit (SBlockIndented_blockIn_to_blockOut h_bi) h_iv h_lit h_sbi))⟩
        | Or.inr h => Or.inr h⟩
    | Or.inr _ => Or.inr trivial
  rcases indentedValue_reads_at_any_indent (h_src := h_src) sc sp_scan (n + 1) s_prep s' c sp_prep sp_scan'
      h_floor_old h_col0_old hcorr_prep hcorr_result h_corr h_preprocess h_not_doc h_flow_disp h_dispatch with
    ⟨sp_gram, h_sep_all, h_flow_all, h_trailing_ws, h_gate, h_line, hna, hnt⟩ |
    ⟨ha, ht, h_sep_all, h_run_all, h_nic_s, h_real_s, h_anchor_s, h_tag_s, h_ind_s,
      h_single, h_sk_s, h_line_s, h_ska_s, h_ivl_s, h_slot_s⟩ |
    ⟨h_read, h_absorb95, h_sep_all, h_line, ⟨hna, hnt⟩, hbs⟩ |
    ⟨sp_gramf, h_node_f, h_tws_f, h_gate_f, h_sep_all, h_line, hna, hnt⟩ | h_ded
  · -- Item 39 stopped here, reading the value route's side condition `n ≤ k` as
    -- a property of this ARM: at an indented pending a landing can be a DEDENT
    -- (`  : v⏎a: 1` ends the enclosing entry instead of nesting inside its
    -- value), and there the datum is false.  Item 40: it is false at the
    -- dedent, not at the arm — `entryKeyPack_of_dispatch` decides `n ≤ w` from
    -- the two numbers it already holds, so `  :⏎    a: 1` composes and only the
    -- dedent ~~takes the deferral~~ takes the pack's dedent branch (Reflection
    -- 666; served there since items 99, 296 and 297).
    exact ⟨sp_block, sp_block, sp_block, sp_scan', h_stream_block,
           BlockStack.nil sp_block, FlowStackB.nil sp_block .sep,
           PendingNode.pendingContent (sp_gram := sp_gram) (h_run := h_trailing_ws) (h_gate := h_gate) (h_live := live_of_dispatch h_dispatch hna hnt (by rw [allowDirectives_update_simpleKey]; exact (preprocess_saved_key_fresh h_ska (noflow_of_noflow_disp h_flow_disp) h_preprocess).1) hcorr_result) sp_start sp_block sp_scan' h_line
             (fun _ _ sp_final h_ssl =>
               h_close_old sp_final
                 (SBlockNode.flowInBlock (n + 1) .blockIn sp_scan sp_prep sp_gram sp_final
                   h_sep_all (h_flow_all (n + 1)) h_ssl))
             (entryKeyPack_of_dispatch (h_alt := trivial) sc sp_start sp_scan n s_prep s' c sp_prep sp_scan'
               h_close_old (explFrameValueLine h_expl h_kslot)
               h_compact_vslot h_ivl_pack
               -- Item 99: the frames feed the pack's resume twin — level `n`
               -- rides on top for the transport face, and the spend face is
               -- the park's own `h_frames`.
               (match h_closeF99 with
                | Or.inl ⟨ks, h_lt, h_cov, closeF⟩ => Or.inl ⟨FrameLevel.map n :: ks,
                    fun k' hk' => by
                      rcases List.mem_cons.mp hk' with h | h
                      · subst h; dsimp only; omega
                      · exact Nat.le_of_lt (h_lt k' h),
                    -- Item 148: the stack, unchanged — the list is the same one.
                    h_cov,
                    closeF⟩
                | Or.inr _ => Or.inr trivial)
               -- Item 147: the widths alone, as at the sibling arms.
               -- Item 149: the stack's two readings, for the dedent branch's cover.
               h_frames99 h_closeFV108 h_framesV108 (Or.inl ⟨h_mono, h_base⟩) hna hnt h_ska
               hcorr_prep hcorr_result h_corr h_not_doc h_flow_disp
               h_preprocess h_dispatch (Or.inr trivial)
               -- **Item 169: the park's own face, with its level consed
               -- on.**  The awaited node is this entry's value; behind it this
               -- entry's `[187]` level at `n` stays tail-open, and below that
               -- stands whatever `h_seqF168` already carries.  That is exactly
               -- one `ResumeFrames.level`, and it is the hop that reaches a
               -- mapping nested TWO levels inside a sequence entry
               -- (`- step:⏎    instrument: x⏎- …`).
               (match h_seqF168 with
                | Or.inl ⟨ke, ks, h_ltq, seqF⟩ =>
                    Or.inl ⟨ke, FrameLevel.map n :: ks, by
                      intro k' hk'
                      rcases List.mem_cons.mp hk' with h | h
                      · subst h; dsimp only; omega
                      · exact Nat.le_of_lt (h_ltq k' h),
                      fun sp_m h_bn =>
                        ResumeFrames.level n ks sp_m h_ltq
                          (fun sp_end h_tail => seqF sp_m h_bn sp_end h_tail)⟩
                | Or.inr _ => Or.inr trivial))
             (stale_of_dispatch h_dispatch hna hnt
               (by split <;> exact nic_false_of_flow_disp (sc := sc) (s_prep := s_prep) h_preprocess h_flow_disp)
               hcorr_result)
             -- Item 51: the nested `?`'s key content, break-free one-line —
             -- the pack completes the key at the entry's index.
             -- **Item 192: BOTH funders ride, where item 112 chose one.**  The
             -- nested `?` frame's own entry and the frame it stands inside are
             -- open at two different columns at once (`?⏎  ? a: b⏎: w` lands on
             -- the OUTER), so preferring either shadows the other — item 189's
             -- finding, one production over.  The chain takes both.
             (frameChainUnion
               (match h_expl with
                | Or.inl ⟨sp_q, h_qlit, route⟩ => Or.inl ⟨[n], frameChainOne (a := n)
                    (fun sp_m sp_i sp_c h_ssl h_ind h_lit sp_v h_sbi =>
                      route sp_v (SBlockMapEntry.explicit n sp_q sp_scan sp_m sp_i sp_c sp_v
                        h_qlit
                        (SBlockIndented.node n .blockOut sp_scan sp_m
                          (SBlockNode_blockIn_to_blockOut
                            (SBlockNode.flowInBlock (n + 1) .blockIn sp_scan sp_prep sp_gram sp_m
                              h_sep_all (h_flow_all (n + 1))
                              (white_prepend_SSLComments h_trailing_ws h_ssl))))
                        h_ind h_lit h_sbi))⟩
                | Or.inr h => Or.inr (PackAlt.step_content h_preprocess h_dispatch h))
               -- Item 93: the park's twin, as at the root arm
               -- (`k:⏎  ? a: b⏎  : - w`).
               (match h_kslot with
                | Or.inl ⟨ns, kslot⟩ => Or.inl ⟨ns, fun nv hmem =>
                    (fun sp_m sp_i sp_c h_ssl h_ind h_lit sp_v h_sbi =>
                      kslot nv hmem sp_m
                        (SBlockNode.flowInBlock (n + 1) .blockIn sp_scan sp_prep sp_gram sp_m
                          h_sep_all (h_flow_all (n + 1))
                          (white_prepend_SSLComments h_trailing_ws h_ssl))
                        sp_i sp_c h_ind h_lit sp_v h_sbi)⟩
                | Or.inr h => Or.inr (PackAlt.step_content h_preprocess h_dispatch h)))
              (content_park_arm (preprocess_some_peek h_preprocess)
                h_flow_disp h_not_doc h_dispatch hcorr_result)
             -- **Item 109: the park's own RESUME frames** — the SAME node the
             -- two closures above wrap, handed to the pending's two transport
             -- faces instead of to their closes.  The value node completed on
             -- the landing's `[79] s-l-comments` is exactly where the enclosing
             -- levels stand, so nothing has to be re-derived: `h_closeF99` and
             -- `h_closeFV108` land here unchanged.  This is what lets a landed
             -- SIBLING continue the level it matches (`?⏎  a: b⏎  c: d⏎: - w`
             -- reads `c` as `a`'s sibling with the `?`'s value line still owed)
             -- rather than re-open at the root through `[211]`.
             -- Item 152: and the cover with them — the stream face's list is
             -- this one, and the value face's is the `?`'s own (item 150's
             -- stagger), which is why the park's slot forgets the index.
             (match h_closeF99 with
              | Or.inl ⟨ks, _, h_cov, closeF⟩ => Or.inl ⟨FrameLevel.map n :: ks,
                  h_cov.imp (fun ⟨lo, hb, hc⟩ =>
                    ⟨lo, _, hb, h_cov_step lo (FrameLevel.map n :: ks) hc⟩) id,
                  fun sp_mid h_ssl =>
                  closeF sp_mid (SBlockNode.flowInBlock (n + 1) .blockIn sp_scan sp_prep sp_gram
                    sp_mid h_sep_all (h_flow_all (n + 1))
                    (white_prepend_SSLComments h_trailing_ws h_ssl))⟩
              | Or.inr _ => Or.inr trivial)
             (match h_closeFV108 with
              | Or.inl ⟨nv, ks, _, h_cov, closeFV⟩ => Or.inl ⟨nv, ks,
                  h_cov.imp (fun ⟨lo, hb, hc⟩ =>
                    ⟨lo, _, hb, h_cov_step lo ks hc⟩) id,
