      rcases h_cv with ⟨lo, _, h_fl, h_cv0⟩ | _
      · rcases h_disj_land with ⟨_, _, _, h_larm⟩ | _
        · have h_floor := landing_floor_of_arm h_noflow_land h_larm
            (by omega) h_base h_preprocess
          exact Or.inl (dedent_cover_of_floor
            (IndentStackMono.preprocess_mono h_preprocess h_mono)
            (by rw [← h_scolw]; exact h_floor) h_fl
            (IndentStackCover.preprocess_cover h_preprocess h_cv0) hmemw h_ww)
        · exact Or.inr trivial
      · exact Or.inr trivial
    exact content_dispatch_after_close (h_possD := (preprocess_saved_key_fresh h_ska (noflow_of_noflow_disp h_flow_disp) h_preprocess).1) (h_src := h_src) sp_start sp_mid s_prep s' c sp_prep sp_scan'
      h_stream_mid h_sep_del (nic_false_of_flow_disp h_preprocess h_flow_disp)
      hcorr_prep hcorr_result h_not_doc (preprocess_some_peek h_preprocess)
      h_flow_disp h_dispatch
      (Or.inl ⟨⟨j, sp_mid, h_col0m, h_stream_mid, h_ind⟩, h_sk_f.1, h_sk_f.2⟩)
      -- Item 109: the entries-level reading of the same landing.  Here BOTH
      -- faces ride: the awaited value never arrived, so the park's own spend
      -- faces already stand at the landing (`?⏎  a:⏎    b:⏎  c: 2⏎: - w`, the
      -- family item 108 paid at the pack lemma, now paid at the dispatch too).
      -- ~~Item 149: `resumectx_of_landing`'s own frames field is still the
      -- widths alone — the context it builds has no cover slot to put one in,
      -- so this is where the projection survives.~~  **Item 151: it has one on
      -- both lanes, and this relay is the site that pays it** — the two
      -- readings of the stack ride here already, and the park is OFF a line
      -- start by its own field, so the landing's floor is reachable and
      -- neither of `dedent_cover_of_landing`'s escapes is taken.  The faces go
      -- through whole, index and all; the payer forgets the index, which is
      -- what lets one argument serve a stream face bounded at `n` and a value
      -- face bounded at `n + 1`.
      (resumectx_of_landing h_col0m (SIndent_gives_GStar_SSWhite h_ind) h_ssl_land
        h_preprocess hcorr_prep
        (h_frames99.imp (fun ⟨ks, hc, r⟩ =>
          ⟨ks, hc.imp (fun ⟨lo, hb, hcv⟩ => ⟨lo, n, hb, hcv⟩) id, r⟩) id)
        (h_framesV108.imp (fun ⟨nv, ks, hc, r⟩ =>
          ⟨nv, ks, hc.imp (fun ⟨lo, hb, hcv⟩ => ⟨lo, n + 1, hb, hcv⟩) id, r⟩) id)
        h_pay_res (Or.inr trivial))
      (Or.inr trivial) (Or.inr trivial) (Or.inr trivial)
      -- Item 144: a `:` park's tail is `value`, excluded for the same reason.
      sc (Or.inr trivial)
      -- Item 174: no held run stands behind a `:` park.
      (Or.inr trivial)

-- Helper: handles all PendingNode cases for content dispatch given stream at sp_block.
lemma accum_content_pending (sc : ScannerState)
    (sp_start sp_block sp_scan : SurfPos)
    (h_fl0 : sc.flowLevel = 0)
    (s_prep s' : ScannerState) (c : Char)
    (h_stream_block : SLYamlStream sp_start sp_block)
    (h_pending : PendingNode sc false sp_start sp_block sp_scan)
    (h_corr : ScannerSurfCorr sc sp_scan)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    -- Item 47: the adjacent-value check's success, from the step's own chain.
    (h_adj : scanNextToken_checkAdjacentValue
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) c = .ok ())
    -- **Item 139: and §9.2's landing refusal, from the same chain** — item 47's
    -- shape one check earlier and one polarity over.  `scanNextToken` runs this
    -- one BEFORE the `allowDirectives` update, so it reads `s_prep` itself.
    (h_bare : scanNextToken_checkBareDocument s_prep = .ok ())
    -- **Item 157: and §9.2's DANGLING refusal beside it** — the check one step
    -- earlier in the same chain, gated on the same break.  `h_bare` refutes the
    -- route the landing would take; this is what the PARK behind it owes.
    (h_dn : scanNextToken_checkDanglingNode sc s_prep = .ok ())
    -- Item 275: §8.1's check, carried beside §9.2's.
    (h_fv : scanNextToken_checkFlowValueIndent sc s_prep = .ok ())
    -- Item 146: the stack's BASE, carried by the accumulation from `mk'`
    -- down.  §9.2's landing refusal spends it to read the dedent exemption
    -- off the landing's column instead of splitting on it.
    (h_base : IndentStackBase.SentinelBase sc)
    -- **Item 149: and its SHAPE**, carried the same way and from the same
    -- seed.  A dedent landing's pack reads the scanner stack it pops to,
    -- and reading a bound on the TOP as a bound on every entry is what
    -- monotonicity buys (`IndentStackCover.Covered.pop_to`).
    (h_mono : IndentStackMono.Mono sc)
    (h_not_doc : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).col = 0 →
      atDocumentBoundary (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) = false)
    (h_dispatch : scanNextToken_dispatchContent
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) c = .ok s') :
    ∃ sp_gram' sp_block' sp_flow' sp_scan',
      SLYamlStream sp_start sp_gram' ∧
      BlockStack sp_gram' sp_block' ∧
      FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
      PendingNode s' false sp_start sp_flow' sp_scan' ∧
      ScannerSurfCorr s' sp_scan' := by
  obtain ⟨sp_prep, hcorr_prep⟩ :=
    scanNextToken_preprocess_corr sc sp_scan h_corr s_prep c h_preprocess
  obtain ⟨sp_scan', hcorr_result⟩ :=
    dispatchContent_corr _ sp_prep c (corr_of_allowDirectives_update hcorr_prep) h_dispatch
  -- Item 148: the incoming stack, stepped to the park — preprocessing pops
  -- and a content dispatch writes no level, so a carried cover survives both.
  have h_cov_step : ∀ (lo : Nat) (ks : List FrameLevel),
      IndentStackCover.Covered lo ks sc → IndentStackCover.Covered lo ks s' :=
    fun lo ks hc =>
      IndentStackCover.dispatchContent_cover h_dispatch
        ((IndentStackCover.preprocess_cover h_preprocess hc).of_indents_eq
          (by split <;> rfl))
  -- Capture closing strategy before case-split (Pattern 6: parametric closing).
  -- Each transition case can close old pending to stream in one call.
  -- **Item 157: the close carries the park's FACE.**  Every landing that
  -- spends it below crossed a break or stands at the park's own line start,
  -- and both are exactly what `landing_or_park_ska` reads — so the premise is
  -- paid where the close is spent, not where it is built.
  have h_close_pending : danglingNodePos? sc = none →
      underIndentedFlowValuePos? sc = none →
      ∀ sp_mid, SSLComments sp_scan sp_mid → SLYamlStream sp_start sp_mid :=
    fun h_nd h_ui sp_mid h_ssl =>
      h_pending.close_with_ssl h_stream_block h_nd h_ui h_ssl
  have h_close_from : danglingNodePos? sc = none →
      underIndentedFlowValuePos? sc = none →
      ∀ sp_mid, SSLCommentsFrom sp_scan sp_mid → (SSLComments sp_scan sp_mid ∨ CommentOk sc) →
        SLYamlStream sp_start sp_mid :=
    fun h_nd h_ui sp_mid h_from h_ok =>
      h_pending.close_with_sslFrom h_stream_block h_nd h_ui (noflow_of_fl0 h_fl0)
        h_corr h_from h_ok
  have h_flow_disp : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).inFlow = false := by
    unfold ScannerState.inFlow
    rw [allowDirectives_update_flowLevel s_prep,
        preprocess_preserves_flowLevel sc s_prep c h_preprocess, h_fl0]
    rfl
  -- Item 136: the step's own block context, for the `noPending` arm's
  -- `h_nodoc` — the field's premise, discharged where the flow level is known.
  have h_scflow : sc.inFlow = false := by
    unfold ScannerState.inFlow
    rw [h_fl0]
    rfl
  -- Item 139: the same reading at the LANDING's state, which is where §9.2's
  -- refusal is evaluated (preprocessing writes no flow level).
  have h_noflow_prep : s_prep.inFlow = false := by
    unfold ScannerState.inFlow
    rw [preprocess_preserves_flowLevel sc s_prep c h_preprocess, h_fl0]
    rfl
  -- Item 157: …and at the PARK's, which is where `danglingNodePos?` is read.
  have h_noflow_s' : s'.inFlow = false := by
    unfold ScannerState.inFlow
    rw [ScannerCorrectness.dispatchContent_preserves_flowLevel _ c _ h_dispatch,
      allowDirectives_update_flowLevel s_prep,
      preprocess_preserves_flowLevel sc s_prep c h_preprocess, h_fl0]
    rfl
  -- Item 15: the implicit-key context, derived once from THIS preprocessing —
  -- the closing closure places the stream at the content's line start.
  have h_keyctx := keyctx_of_preprocess sc sp_scan sp_prep s_prep c h_corr hcorr_prep
    h_close_pending h_dn h_fv h_noflow_prep (h_pending.arm_or_col h_scflow) h_preprocess
  -- ═══ Item 42: the shared landing skeleton, factored.  The column-0 and
  -- break-crossed landings CLOSE the pending identically for every parked
  -- constructor (`close_with_ssl` + `content_dispatch_after_close`); only the
  -- no-break arm reads the pending's own line fact, so it is the one thing
  -- each constructor supplies.  The continuation receives the landing pieces
  -- the residue lemmas consume: the off-column park, the crossed whites, and
  -- the peek disjunct that pins the dispatch character at their end. ═══
  have h_defer_split :
      -- **Item 109: the skeleton takes the park's frames.**  Closing is what
      -- the two landing arms do, and closing is what loses the enclosing
      -- levels; a park that kept them lets the landed key RESUME the level its
      -- width names instead of re-opening at the root.  The parameter is where
      -- each constructor says whether it kept any.
      -- **Item 152: and the park's COVER beside them**, so the resuming key
      -- context the two landing arms build gets its slot filled instead of
      -- punted.  The skeleton reads the pair exactly as `resumectx_of_landing`
      -- does — index existential, forgotten at the hop — and the PAYMENT is the
      -- skeleton's own (`h_pay_res` below), off the `SentinelBase` and `Mono`
      -- this lemma already carries.  So a park has only to say what it kept.
      ∀ (h_fS : (∃ ks : List FrameLevel,
            ((∃ lo n : Nat, IndentStackCover.Floor lo n ks ∧
              IndentStackCover.Covered lo ks sc) ∨ True) ∧
            ∀ sp_m : SurfPos, SSLComments sp_scan sp_m →
            ResumeFrames (SLYamlStream sp_start) ks sp_m) ∨ True)
        (h_fV : (∃ (nv : Nat) (ks : List FrameLevel),
            ((∃ lo n : Nat, IndentStackCover.Floor lo n ks ∧
              IndentStackCover.Covered lo ks sc) ∨ True) ∧
            ∀ sp_m : SurfPos,
            SSLComments sp_scan sp_m →
            KeyFrames (ExplValueLine sp_start nv) ks sp_m) ∨ PackAlt sc)
        -- **Item 117: and the skeleton takes the park's OPEN suffix arm.**
        -- Closing is also what folds a `...` into the empty-slot
        -- `suffixContinue`; a park that hands the arm open lets the landed
        -- document take `suffixContinue`'s own `l-any-document?` slot.  Only
        -- `pendingDocEnd` pays.
        (h_sfx : (∀ sp_m : SurfPos, SSLComments sp_scan sp_m →
            SuffixRun sp_start sp_m) ∨ True)
        -- **Item 137: and the park's MARKER arm.**  Closing is also what turns
        -- a `---` park's still-open explicit document into a finished one with
        -- an `e-node` body; a park that hands the arm open keeps the document
        -- open, and the node this dispatch starts becomes its content.  Only
        -- `pendingDocStart` pays.
        (h_mk : (∀ sp_m : SurfPos, SSLComments sp_scan sp_m →
            MarkerNodeRoute sp_start sp_m) ∨ True)
        -- **Item 139: and the park's own §9.2 FACE.**  Where the four arms above
        -- do not fire, the landed node appends a second BARE document, and that
        -- reading is one the scanner refuses whenever the park's stack is the
        -- sentinel alone.  The park is what says the token behind it completed a
        -- node; the skeleton decides the stack.  `pendingContent` and
        -- `pendingBlockContent` pay; the two marker parks take their own arms
        -- above, and `pendingFlow`'s tail is a block INDICATOR, which
        -- `completesFlowValue` excludes — so its `Or.inr` names a park where the
        -- fact is FALSE, not one where it is merely unstated.
        (h_tail139 : CompletedTail sc ∨ True)
        -- **Item 154: and the park's own INDENT CHECK.**  The column-0 arm
        -- below is the one landing that cannot floor itself: item 147's reading
        -- comes off a walk that crossed a break, and a park already at a line
        -- start crosses none.  The unwind that IS the floor runs on this flag,
        -- so the park states it and the arm spends it.  ~~`pendingContent` pays,
        -- from its block-scalar producers; the other four parks punt, and their
        -- punts name a premise none of their producers can reach column 0 to
        -- satisfy.~~
        --
        -- **REQUIRED since item 207: all five parks pay.**  The sentence struck
        -- above was a claim about producers, and the instrument disagreed with
        -- it at twenty of twenty-one: every content-dispatch producer answers
        -- by `content_park_nic_any`, and the flow closes and the two markers
        -- answer by the columns they spend.  The arm below is unconditional now
        -- and `park_col0_floor` is what it spends.
        (h_nic0 : sp_scan.col = 0 → sc.needIndentCheck = true)
        -- **Item 168: and the park's SEQUENCE face.**  The same shape as
        -- `h_fS`, one level wide and bottomed at the enclosing `[183]` instead
        -- of at the stream: closing is what commits that collection's tail, and
        -- a park that kept it lets the landed key stay INSIDE the entry it
        -- stands in.  Only `pendingContent` pays — it is the one park the
        -- corpus's dedenting `-` meets — and what the payment buys is the
        -- multi-line sequence entry, where the collection has to survive a
        -- sibling landing before the `-` arrives.
        -- Item 169: with the levels below `kk` listed, so a park two mapping
        -- levels inside the entry reaches the collection the same way.
        (h_fQ : (∃ (ke kk : Nat) (ksq : List FrameLevel), (∀ fr ∈ ksq, fr.width < kk) ∧
            ∀ sp_m : SurfPos, SSLComments sp_scan sp_m →
            ∀ sp_e : SurfPos, SCompactMapTail kk sp_m sp_e →
            ResumeFrames (SeqEntryTail sp_start ke) ksq sp_e) ∨ True),
      (sp_scan.col ≠ 0 → ∀ sp_ws, GStar SSWhite sp_scan sp_ws →
        (sp_prep = sp_ws ∨ s_prep.peek? = none) →
        -- Item 47: the no-break step's scanner payload, from the anyCol
        -- product's inline disjunct — what the stale-tail refutation feeds
        -- `checkAdjacentValue_refutes_stale`.
        (sc.needIndentCheck = false → LastTokenReal sc.tokens →
          s_prep.line = sc.line ∧ s_prep.needIndentCheck = false ∧
          lastRealToken? s_prep.tokens = lastRealToken? sc.tokens ∧
          penultRealToken? s_prep.tokens = penultRealToken? sc.tokens) →
        (sc.needIndentCheck = false → sc.simpleKeyAllowed = false →
          s_prep.simpleKey = sc.simpleKey ∧ s_prep.tokens = sc.tokens ∧
          sc.offset ≤ s_prep.offset ∧ s_prep.simpleKeyAllowed = false) →
        ∃ sp_gram' sp_block' sp_flow' sp_scan',
          SLYamlStream sp_start sp_gram' ∧
          BlockStack sp_gram' sp_block' ∧
          FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
          PendingNode s' false sp_start sp_flow' sp_scan' ∧
          ScannerSurfCorr s' sp_scan') →
      -- **Item 284: what the park hands a property run started at the landing**
      -- — a completed node (read through §9.2's bare-document check) or an offer.
      (h_srcP : CompletedTail sc ∨ OfferPred sc.tokens) →
      ∃ sp_gram' sp_block' sp_flow' sp_scan',
        SLYamlStream sp_start sp_gram' ∧
        BlockStack sp_gram' sp_block' ∧
        FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
        PendingNode s' false sp_start sp_flow' sp_scan' ∧
        ScannerSurfCorr s' sp_scan' := by
    intro h_fS h_fV h_sfx h_mk h_tail139 h_nic0 h_fQ h_noBreak h_srcP
    by_cases hcol : sp_scan.col = 0
    · obtain ⟨sp_mid, sp_ws, sp_prep2, h_ssl, hcol_mid, h_ws, h_cmt, hcorr_prep2, h_pk⟩ :=
        preprocess_some_ssl_comments_col0 sc sp_scan s_prep c h_corr hcol h_preprocess
      have hsp_eq2 := ScannerSurfCorr_unique hcorr_prep hcorr_prep2; subst hsp_eq2
      have h_eq : sp_prep = sp_ws := by
        cases h_pk with
        | inl h => exact h
        | inr h => rw [preprocess_some_peek h_preprocess] at h; cases h
      subst h_eq
      -- Item 144: the flag §9.2 reads, hoisted out of `h_route_mid` so the KEY
      -- routes can spend it too.  The park is AT a line start in this arm, so
      -- the flag is the park's own (items 76/77) carried across preprocessing.
      -- **Item 157: and it pays the park's face at the same time.**
      have h_ska : s_prep.simpleKeyAllowed = true :=
        preprocess_simpleKeyAllowed_mono
          ((h_pending.arm_or_col h_scflow).resolve_right (by omega)) h_preprocess
      have h_stream_mid := h_close_pending (dangling_none_of_check h_dn h_ska)
        (underIndented_none_of_check h_fv h_ska) sp_mid h_ssl
      -- …and the bundle the root fallback inside `content_dispatch_routed` takes.
      have h_ref_land : BareLandingFacts sc s_prep c ∨ True :=
        h_tail139.imp (fun h_tl =>
          ⟨h_bare, h_preprocess, h_noflow_prep, h_ska, h_tl, h_base⟩) id
      -- **Item 154: and the PAYER this arm could not build.**  Item 152 left
      -- it punting because a landing's floor is read off the walk that carried
      -- the park down to column 0, and a park already AT column 0 crosses no
      -- such walk.  The floor is not the walk's, though — it is preprocessing's
      -- UNWIND, and the unwind runs on `needIndentCheck`.  A park at a line
      -- start got there by consuming a break, so the flag is up, and
      -- `preprocess_top_le_col_of_armed` reads the floor off it with no arm at
      -- all.  The sentinel disjunct falls to `h_base` exactly as it does in
      -- `landing_floor_of_arm`, and the hop is item 151's, unchanged.
      have h_pay_col0 : ∀ (w : Nat) (ksw ksw' : List FrameLevel),
          ((∃ lo m : Nat, IndentStackCover.Floor lo m ksw ∧
            IndentStackCover.Covered lo ksw sc) ∨ True) →
          FrameLevel.map w ∈ ksw → ResumeWidths ksw ksw' w → s_prep.col = w →
          ((∃ lo : Nat, IndentStackCover.Floor lo w (FrameLevel.map w :: ksw') ∧
            IndentStackCover.Covered lo (FrameLevel.map w :: ksw') s_prep) ∨ True) := by
        intro w ksw ksw' h_cv hmemw h_ww h_scolw
        -- Item 207: the floor this branch computed inline is `park_col0_floor`,
        -- which item 205 lifted OUT of here so the block landings could spend
        -- it too.  With the field required it comes back to replace its own
        -- source, and the arm has no punt left.
        rcases h_cv with ⟨lo, _, h_fl, h_cv0⟩ | _
        · exact Or.inl (dedent_cover_of_floor
            (IndentStackMono.preprocess_mono h_preprocess h_mono)
            (by rw [← h_scolw]
                exact park_col0_floor h_scflow (h_nic0 hcol) h_base h_preprocess) h_fl
            (IndentStackCover.preprocess_cover h_preprocess h_cv0) hmemw h_ww)
        · exact Or.inr trivial
      -- ═══ Item 137: a `---` park's landing hands the node to the MARKER's own
      -- document.  The anchor moves from the landing back to the park —
      -- `content_dispatch_routed` takes it as a parameter — so the crossed
      -- `[79] s-l-comments` sits inside `[80] s-separate-lines(0)` and the
      -- node the dispatch builds starts where `---` ended.  `---⏎hello` and
      -- `---⏎a: 1` are ONE explicit document each. ═══
      rcases h_mk with h_mk_on | _
      · obtain ⟨sp_mk, h_ssl_mk, mkroute⟩ := h_mk_on sp_mid h_ssl
        exact content_dispatch_routed (h_alt := trivial) (h_possD := preprocess_saved_key_possible_post h_ska h_noflow_prep h_preprocess) (h_src := slotGateAt_of_parkSource h_srcP h_bare h_preprocess h_noflow_prep h_ska h_base) sp_start sp_mk sp_mid s_prep s' c sp_prep sp_scan'
          h_stream_mid
          (SSeparateLines.commented 0 sp_mk sp_mid sp_prep h_ssl_mk
            (SFlowLinePrefix.mk 0 sp_mid sp_mid sp_prep (SIndent.zero sp_mid)
              (ScalarProduction.gstar_sswhite_to_gopt_sep h_ws)))
          (nic_false_of_flow_disp h_preprocess h_flow_disp)
          hcorr_prep hcorr_result h_not_doc
          (preprocess_some_peek h_preprocess) h_flow_disp h_dispatch (fun _ => mkroute) h_keyctx
          -- ~~Item 152: the park's faces now CARRY the cover, and this arm cannot
          -- spend it.~~  **Item 154: it spends it.**  The obstacle was item 147's
          -- escape read at the consumer — a park AT a line start crosses no walk
          -- for `landing_floor_of_arm` to read a floor off.  But the floor is
          -- preprocessing's UNWIND, the unwind runs on `needIndentCheck`, and a
          -- park that reached column 0 consumed the break that arms it.  So the
          -- faces and the payer both go through, and `k:⏎  a: |⏎    x⏎  c: d`
          -- resumes the level its block scalar was written inside.
          (resumectx_of_landing hcol_mid h_ws h_ssl h_preprocess hcorr_prep
            h_fS h_fV h_pay_col0 h_fQ)
          (Or.inr trivial) (Or.inr trivial)
          (markerctx_of_landing hcol_mid h_ws h_ssl h_preprocess (Or.inl h_mk_on))
          sc h_ref_land
          -- Item 174: the run's ride is the PARK arm's to pay, above.
          (Or.inr trivial)
          (Or.inr trivial)
      have h_sep := SSeparateLines.inline 0 sp_mid sp_prep
        (GStar_SSWhite_to_SSeparateInLine sp_mid sp_prep h_ws (fun _ => hcol_mid))
      -- Item 117: a `...` park routes the completed node into the open arm's
      -- own slot; every other park keeps the bare-document route
      -- (`content_dispatch_after_close`'s, written out here because the
      -- route is now the one thing the two cases do differently).
      have h_route_mid : ContentRouteGate s' c → ∀ sp_m,
          SBlockNode 0 .blockIn sp_mid sp_m → SLYamlStream sp_start sp_m :=
        fun h_gate =>
        match h_sfx with
        | Or.inl sfx => suffixNodeRoute (sfx sp_mid h_ssl)
        -- ═══ Item 139: the fallback, with §9.2's landing refusal taken out of
        -- its domain.  The park is AT a line start here, so the flag the check
        -- reads is the park's own (item 76/77) carried across preprocessing. ═══
        -- **Item 157 takes the OTHER half out** — the landing that rests ON an
        -- open level makes a dangling run, and the park's face says the next
        -- landing already refused it.  What is left of the route's domain is
        -- the gate's property disjunct.  ~~Item 170: the crossed-window arm
        -- skips the refinement.~~  **Item 181: there is no crossed-window arm**
        -- — the refinement is the route's only construction again. ═══
        | Or.inr _ =>
            bareNodeRoute_or_refused_content h_stream_mid h_bare h_preprocess
              h_noflow_prep h_ska h_base h_tail139 h_dispatch h_noflow_s' h_gate
      exact content_dispatch_routed (h_alt := trivial) (h_possD := preprocess_saved_key_possible_post h_ska h_noflow_prep h_preprocess) (h_src := slotGateAt_of_parkSource h_srcP h_bare h_preprocess h_noflow_prep h_ska h_base) sp_start sp_mid sp_mid s_prep s' c sp_prep sp_scan'
