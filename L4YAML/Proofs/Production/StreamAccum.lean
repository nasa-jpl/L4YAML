                      fun _ => ⟨.white (GStar.nil _) (sync_scanFlowEntry hfe) nofun (by have := glit_col h_comma_lit; omega), (tailOf_scanFlowEntry hfe).2,
                        (scanFlowEntry_allowDirectives hfe).trans h_ad_false⟩⟩
            · -- fallthrough: dispatch returns `.ok none`, not `.ok (some s')`.
              simp at h_dispatch

/-! ### §1c'''c The `:` step's scanner facts (item 10)

`scanValue` in flow: clear-key is conditional identity, validate is pure,
prepare resolves the pending reservation (writing only at its own two slots)
and CONSUMES the key, then one `.value` token is pushed.  The facts below are
what the `:` arm's frame receivers, mask transport, and gap re-establishment
read off that pipeline. -/

/-- `ScannerSurfCorr` reads five fields; states agreeing on them share it. -/
lemma corr_congr {a b : ScannerState} {sp : SurfPos}
    (h_off : b.offset = a.offset) (h_col : b.col = a.col)
    (h_end : b.inputEnd = a.inputEnd) (h_inp : b.input = a.input)
    (h_ind : b.indents = a.indents)
    (h : ScannerSurfCorr a sp) : ScannerSurfCorr b sp := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · rw [h_inp, h_off]; exact h.chars_from
  · rw [h_col]; exact h.col_eq
  · rw [h_end, h_inp]; exact h.end_eq
  · rw [h_inp, h_off]; exact h.input_prefix
  · rw [h_ind]; exact h.indent_cols_nonneg

/-- In flow, `scanValuePrepare` moves none of the correspondence fields. -/
lemma scanValuePrepare_fields {s : ScannerState} (h_flow : s.inFlow = true) :
    (scanValuePrepare s).offset = s.offset ∧ (scanValuePrepare s).col = s.col ∧
    (scanValuePrepare s).inputEnd = s.inputEnd ∧
    (scanValuePrepare s).input = s.input ∧
    (scanValuePrepare s).indents = s.indents ∧
    (scanValuePrepare s).flowLevel = s.flowLevel ∧
    (scanValuePrepare s).simpleKeyStack = s.simpleKeyStack ∧
    (scanValuePrepare s).simpleKey.possible = false ∧
    (scanValuePrepare s).line = s.line ∧
    (scanValuePrepare s).allowDirectives = s.allowDirectives := by
  unfold scanValuePrepare
  rw [show (!s.inFlow) = false from by rw [h_flow]; rfl]
  split
  · rw [ite_eq_right (by simp)]
    exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩
  · split
    · exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩
    · rw [ite_eq_right (by simp)]
      rename_i h_np _
      exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, by
        simp only [Bool.not_eq_true] at h_np
        exact h_np, rfl, rfl⟩

/-- `scanValueClearKey` is the identity on everything but the pending key. -/
lemma scanValueClearKey_fields (s : ScannerState) :
    (scanValueClearKey s).offset = s.offset ∧ (scanValueClearKey s).col = s.col ∧
    (scanValueClearKey s).inputEnd = s.inputEnd ∧
    (scanValueClearKey s).input = s.input ∧
    (scanValueClearKey s).indents = s.indents ∧
    (scanValueClearKey s).flowLevel = s.flowLevel ∧
    (scanValueClearKey s).simpleKeyStack = s.simpleKeyStack ∧
    (scanValueClearKey s).tokens = s.tokens ∧
    (scanValueClearKey s).line = s.line ∧
    (scanValueClearKey s).allowDirectives = s.allowDirectives := by
  unfold scanValueClearKey
  split
  · split
    · exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩
    · split
      · exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩
      · exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩
  · exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

/-- In BLOCK context `scanValuePrepare` may push a mapping indent, so the
    field-equality transport above does not apply — but the correspondence
    survives anyway: the pushed column is a `Nat` cast (the resolved key's
    column, or the `:`'s own via `pushMappingIndent`), so the nonnegativity
    invariant extends, and no other correspondence field moves (item 13). -/
lemma scanValuePrepare_corr {s : ScannerState} {sp : SurfPos}
    (h : ScannerSurfCorr s sp) : ScannerSurfCorr (scanValuePrepare s) sp := by
  have push_case : ∀ (col : Nat) (tokens : Array (Positioned YamlToken))
      (sk : SimpleKeyState),
      ScannerSurfCorr { s with
        tokens := tokens
        indents := s.indents.push { column := (col : Int), isSequence := false }
        pendingKeys := s.pendingKeys.push none
        simpleKey := sk } sp := by
    intro col tokens sk
    refine ⟨h.chars_from, h.col_eq, h.end_eq, h.input_prefix, ?_⟩
    intro i hi hpos
    show (s.indents.push _)[i].column ≥ 0
    rw [Array.getElem_push]
    split
    · exact h.indent_cols_nonneg i (by assumption) hpos
    · exact Int.natCast_nonneg col
  unfold scanValuePrepare
  split
  · split
    · split
      · exact push_case _ _ _
      · exact ⟨h.chars_from, h.col_eq, h.end_eq, h.input_prefix, h.indent_cols_nonneg⟩
    · exact ⟨h.chars_from, h.col_eq, h.end_eq, h.input_prefix, h.indent_cols_nonneg⟩
  · split
    · exact ⟨h.chars_from, h.col_eq, h.end_eq, h.input_prefix, h.indent_cols_nonneg⟩
    · split
      · unfold pushMappingIndent
        split
        · refine ⟨h.chars_from, h.col_eq, h.end_eq, h.input_prefix, ?_⟩
          intro i hi hpos
          show ((s.emit .blockMappingStart).indents.push
            { column := (s.col : Int), isSequence := false })[i].column ≥ 0
          rw [Array.getElem_push]
          split
          · exact h.indent_cols_nonneg i (by assumption) hpos
          · exact Int.natCast_nonneg s.col
        · exact h
      · exact h

/-- `scanValuePrepare` never moves the cursor, in ANY context — the block
    branches touch tokens, indents and the pending key only (item 13). -/
lemma scanValuePrepare_col (s : ScannerState) : (scanValuePrepare s).col = s.col := by
  unfold scanValuePrepare pushMappingIndent
  split
  · split
    · split <;> rfl
    · rfl
  · split
    · rfl
    · split
      · split <;> rfl
      · rfl

/-- The `:` step's post-state, field-wise (in flow): one `.value` token on
    top of the prepared array, fresh saves re-enabled, no explicit key, the
    pending key CONSUMED, and the stack untouched. -/
lemma scanValue_inFlow_facts {s s' : ScannerState} (h_flow : s.inFlow = true)
    (hok : scanValue s = .ok s') :
    s'.tokens = (scanValuePrepare (scanValueClearKey s)).tokens.push
      ⟨(scanValuePrepare (scanValueClearKey s)).currentPos, .value,
       (scanValuePrepare (scanValueClearKey s)).currentPos⟩ ∧
    s'.simpleKeyAllowed = true ∧
    s'.explicitKeyLine = none ∧
    s'.simpleKey.possible = false ∧
    s'.simpleKeyStack = s.simpleKeyStack ∧
    s'.flowLevel = s.flowLevel ∧
    s.offset ≤ s'.offset ∧
    s'.allowDirectives = s.allowDirectives := by
  have h_ck := scanValueClearKey_fields s
  have h_flow_ck : (scanValueClearKey s).inFlow = true := by
    unfold ScannerState.inFlow
    rw [h_ck.2.2.2.2.2.1]
    exact h_flow
  have h_prep := scanValuePrepare_fields h_flow_ck
  unfold scanValue at hok
  simp only [bind, Except.bind] at hok
  split at hok
  · exact absurd hok (by simp)
  · split at hok
    · exact absurd hok (by simp)   -- scanValueIndentTabCheck (item 31)
    split at hok
    · exact absurd hok (by simp)
    · have h := Except.ok.inj hok
      subst h
      refine ⟨?_, rfl, ?_, ?_, ?_, ?_, ?_⟩
      · show ((scanValuePrepare (scanValueClearKey s)).emit .value).advance.tokens = _
        rw [ScannerCorrectness.advance_preserves_tokens]
        rfl
      · -- explicitKeyLine: both of item 48's survival arms are dead in flow.
        simp [h_flow]
      · show ((scanValuePrepare (scanValueClearKey s)).emit .value).advance.simpleKey.possible = false
        rw [ScannerCorrectness.advance_preserves_simpleKey,
            ScannerCorrectness.emit_preserves_simpleKey]
        exact h_prep.2.2.2.2.2.2.2.1
      · show ((scanValuePrepare (scanValueClearKey s)).emit .value).advance.simpleKeyStack = _
        rw [ScannerCorrectness.advance_preserves_simpleKeyStack,
            ScannerCorrectness.emit_preserves_simpleKeyStack,
            h_prep.2.2.2.2.2.2.1, h_ck.2.2.2.2.2.2.1]
      · show ((scanValuePrepare (scanValueClearKey s)).emit .value).advance.flowLevel = _
        rw [ScannerCorrectness.advance_preserves_flowLevel,
            ScannerCorrectness.emit_preserves_flowLevel,
            h_prep.2.2.2.2.2.1, h_ck.2.2.2.2.2.1]
      · dsimp only []
        constructor
        · have h1 := ScannerProgress.advance_offset_ge
            ((scanValuePrepare (scanValueClearKey s)).emit .value)
          have h2 : ((scanValuePrepare (scanValueClearKey s)).emit .value).offset
              = s.offset := by
            rw [ScannerProgress.emit_offset, h_prep.1, h_ck.1]
          exact h2 ▸ h1
        · rw [ScannerAllowDirectives.advance_preserves_allowDirectives,
              ScannerAllowDirectives.emit_preserves_allowDirectives,
              h_prep.2.2.2.2.2.2.2.2.2, h_ck.2.2.2.2.2.2.2.2.2]

/-- The `:` step's frame tail: the pushed `.value` puts the gap at `.colon`
    with the two token readings in sync. -/
lemma tailOf_scanValue {s s' : ScannerState} (h_flow : s.inFlow = true)
    (hok : scanValue s = .ok s') :
    tailOf s'.tokens = .colon ∧ LastTokenReal s'.tokens ∧
      frameTokenVal? s'.tokens = lastRealTokenVal? s'.tokens := by
  rw [(scanValue_inFlow_facts h_flow hok).1]
  exact tailOf_push_sync (by simp) (by simp [YamlToken.isNodeProperty])

/-- Slots away from the pending reservation survive the `:` step. -/
lemma scanValue_prefix_off_targets {s s' : ScannerState} (h_flow : s.inFlow = true)
    (hok : scanValue s = .ok s')
    (i : Nat) (h_i : i < s.tokens.size)
    (h_ne : s.simpleKey.possible = true →
      i ≠ s.simpleKey.tokenIndex ∧ i ≠ s.simpleKey.tokenIndex + 1) :
    s'.tokens[i]? = s.tokens[i]? := by
  have h_ck := scanValueClearKey_fields s
  have h_flow_ck : (scanValueClearKey s).inFlow = true := by
    unfold ScannerState.inFlow
    rw [h_ck.2.2.2.2.2.1]
    exact h_flow
  rw [(scanValue_inFlow_facts h_flow hok).1]
  have h_prep_tokens : (scanValuePrepare (scanValueClearKey s)).tokens[i]?
      = s.tokens[i]? := by
    unfold scanValuePrepare
    rw [show (!(scanValueClearKey s).inFlow) = false from by rw [h_flow_ck]; rfl]
    split
    · rename_i h_poss
      -- the clear-key either kept the pending key (targets excluded by h_ne)
      -- or this branch is unreachable
      rw [ite_eq_right (by simp)]
      have h_keep : (scanValueClearKey s).simpleKey.possible = true → 
          (scanValueClearKey s).simpleKey = s.simpleKey := by
        unfold scanValueClearKey
        split
        · split
          · intro h; exact absurd h (by simp)
          · split
            · intro h; exact absurd h (by simp)
            · intro _; rfl
        · intro _; rfl
      have h_sk_eq := h_keep h_poss
      rw [h_ck.2.2.2.2.2.2.2.1]
      rw [Array.getElem?_setIfInBounds_ne]
      · rw [h_sk_eq]
        have := (h_ne (by rw [← h_sk_eq]; exact h_poss)).2
        omega
    · split
      · rw [h_ck.2.2.2.2.2.2.2.1]
      · rw [ite_eq_right (by simp)]
        rw [h_ck.2.2.2.2.2.2.2.1]
  rw [Array.getElem?_push, ite_eq_right (by
    have h_mono : s.tokens.size ≤ (scanValuePrepare (scanValueClearKey s)).tokens.size := by
      have h1 := ScannerCorrectness.scanValuePrepare_tokens_monotonic (scanValueClearKey s)
      rw [h_ck.2.2.2.2.2.2.2.1] at h1
      omega
    omega)]
  exact h_prep_tokens

/-- **In flow, `scanValuePrepare` writes exactly one slot** (item 164): the
    SECOND of the two the save reserved, turned into `[193]`'s `key`.  The
    block arms — the mapping-indent push and the `blockMappingStart` pair —
    are both off `inFlow`. -/
lemma scanValuePrepare_inFlow_tokens {s : ScannerState} (h_flow : s.inFlow = true) :
    (s.simpleKey.possible = false ∧ (scanValuePrepare s).tokens = s.tokens) ∨
    (s.simpleKey.possible = true ∧
      (scanValuePrepare s).tokens =
        s.tokens.setIfInBounds (s.simpleKey.tokenIndex + 1)
          ⟨s.simpleKey.pos, .key, s.simpleKey.pos⟩) := by
  unfold scanValuePrepare
  split
  · rename_i hp
    refine Or.inr ⟨hp, ?_⟩
    rw [ite_eq_right (by simp [h_flow])]
  · rename_i hp
    simp only [Bool.not_eq_true] at hp
    refine Or.inl ⟨hp, ?_⟩
    split
    · rfl
    · rw [ite_eq_right (by simp [h_flow])]

/-- The clear-key either kills the pending key outright or leaves it exactly
    as it was — it never moves a reservation. -/
lemma scanValueClearKey_keeps (s : ScannerState) :
    (scanValueClearKey s).simpleKey.possible = true →
      (scanValueClearKey s).simpleKey = s.simpleKey := by
  unfold scanValueClearKey
  split
  · split
    · intro h; exact absurd h (by simp)
    · split
      · intro h; exact absurd h (by simp)
      · intro _; rfl
  · intro _; rfl

/-- **The `:` step's token array, in flow** (item 164) — either a bare `.value`
    push, or the pending reservation's SECOND slot rewritten to `[193]`'s `key`
    and then the push.  This is item 162's fifth shape, stated against the
    scanner's own function. -/
lemma scanValue_inFlow_tokens_shape {s s' : ScannerState} (h_flow : s.inFlow = true)
    (hok : scanValue s = .ok s') :
    (∃ q : Positioned YamlToken, q.val = .value ∧ s'.tokens = s.tokens.push q) ∨
    (s.simpleKey.possible = true ∧ ∃ v q : Positioned YamlToken,
      v.val = .key ∧ q.val = .value ∧
      s'.tokens = (s.tokens.setIfInBounds (s.simpleKey.tokenIndex + 1) v).push q) := by
  have h_ck := scanValueClearKey_fields s
  have h_flow_ck : (scanValueClearKey s).inFlow = true := by
    unfold ScannerState.inFlow; rw [h_ck.2.2.2.2.2.1]; exact h_flow
  have h_tok := (scanValue_inFlow_facts h_flow hok).1
  rcases scanValuePrepare_inFlow_tokens h_flow_ck with ⟨_, hpt⟩ | ⟨hp, hpt⟩
  · exact Or.inl ⟨⟨(scanValuePrepare (scanValueClearKey s)).currentPos, .value,
      (scanValuePrepare (scanValueClearKey s)).currentPos⟩, rfl,
      by rw [h_tok, hpt, h_ck.2.2.2.2.2.2.2.1]⟩
  · have hkey := scanValueClearKey_keeps s hp
    refine Or.inr ⟨by rw [← hkey]; exact hp,
      ⟨s.simpleKey.pos, .key, s.simpleKey.pos⟩,
      ⟨(scanValuePrepare (scanValueClearKey s)).currentPos, .value,
       (scanValuePrepare (scanValueClearKey s)).currentPos⟩, rfl, rfl, ?_⟩
    rw [h_tok, hpt, h_ck.2.2.2.2.2.2.2.1, hkey]

/-- **The fifth shape, at last** (item 164).  The `:` resolves the pending key
    by REWRITING the slot its save reserved, and the floor is exactly what says
    that slot is neither below the base open nor a bracket — the precondition
    item 163 measured and found uncarried.  The keyless arm is an ordinary
    push: with nothing pending there is nothing to resolve. -/
lemma FlowBaseAnchor.flowValue {g : Option ScannerState} {s s' : ScannerState} {d : Nat}
    (h : FlowBaseAnchor g s d) (h_flow : s.inFlow = true) (hstep : scanValue s = .ok s') :
    FlowBaseAnchor g s' d := by
  have hind := L4YAML.Proofs.FlowIndentStable.scanValue_indents_of_inFlow h_flow hstep
  have hsks := (scanValue_inFlow_facts h_flow hstep).2.2.2.2.1
  have hposs := (scanValue_inFlow_facts h_flow hstep).2.2.2.1
  rcases scanValue_inFlow_tokens_shape h_flow hstep with ⟨q, hq, htok⟩ | ⟨hp, v, q, hv, hq, htok⟩
  · exact h.pushInert htok (by rw [hq]; rfl) (by rw [hq]; rfl) hind hsks (Or.inr hposs)
  · refine h.transport (fun _ ha hf => ⟨?_, ?_⟩)
    · exact ha.rewriteKey hf.pending hp htok (by rw [hv]; rfl) (by rw [hv]; rfl)
        (by rw [hq]; rfl) (by rw [hq]; rfl) hind
    · exact hf.rewriteKey htok (by rw [hv]; rfl) (by rw [hv]; rfl) hsks hposs

/-- The mask across the `:` step itself (item 10).  The resolution write
    lands at the pending reservation's own slots; the ARMED-FLOOR half of the
    mask keeps every armed slot at least three below them, so the per-slot
    prefix condition is dischargeable even though the pending key may sit
    DEEP in the array (a restored collection key, `[{x: y}: b]`). -/
lemma KmSound.colon_transport {sc s' : ScannerState} {km : Array Bool} {kc : Nat}
    (h : KmSound sc km kc)
    (h_ivl : s'.implicitValueLine = sc.implicitValueLine)
    (h_dsl : s'.docStartLine = sc.docStartLine)
    (h_sks : s'.simpleKeyStack = sc.simpleKeyStack)
    (h_off : sc.offset ≤ s'.offset)
    (h_size : sc.tokens.size ≤ s'.tokens.size)
    (h_poss' : s'.simpleKey.possible = false)
    (h_pref : ∀ j, j < sc.tokens.size →
      (sc.simpleKey.possible = true →
        j + 3 ≤ sc.simpleKey.tokenIndex ∨ sc.tokens.size ≤ sc.simpleKey.tokenIndex) →
      s'.tokens[j]? = sc.tokens[j]?) : KmSound s' km kc := by
  obtain ⟨off, h_al, h_bits, h_floor, h_base⟩ := h
  refine ⟨off, by rw [h_sks]; exact h_al, fun i hi hb => ?_, fun i hi hb => ?_,
    fun hpos => (h_base hpos).imp
      (fun _ ⟨h_get, h_col, h_st⟩ => ⟨by rw [h_sks]; exact h_get, h_col,
        h_st.imp (fun hh => by rw [h_ivl]; exact hh)
          (fun h2 => h2.imp (fun hh => by rw [h_dsl]; exact hh) id)⟩)⟩
  · obtain ⟨k, h_get, h1, h2, ⟨tok, h3, h4⟩, h5, h6⟩ := h_bits i hi hb
    have h_get' : sc.simpleKeyStack[off + i]! = k := by
      rw [Array.getElem!_eq_getD, Array.getD_eq_getD_getElem?, h_get]
      rfl
    have h_floor_i := (h_floor i hi hb).2
    refine ⟨k, by rw [h_sks]; exact h_get, h1, h2, ⟨tok, ?_, h4⟩, by omega, by omega⟩
    rw [h_pref (k.tokenIndex - 1) (by omega) ?_]
    · exact h3
    · intro h_poss
      rcases Nat.lt_or_ge sc.simpleKey.tokenIndex sc.tokens.size with h_in | h_out
      · left
        have := h_floor_i h_poss
        rw [h_get'] at this
        omega
      · right
        exact h_out
  · obtain ⟨h_above, _⟩ := h_floor i hi hb
    refine ⟨fun j hj hjs h_jposs => ?_, fun h_poss => absurd h_poss (by
      rw [h_poss']; exact nofun)⟩
    rw [h_sks] at hjs h_jposs ⊢
    exact h_above j hj hjs h_jposs

/-- The `:` step's grammar production: a `GLit ':'` from the cursor. -/
lemma scanValue_prod (sc : ScannerState) (sp : SurfPos)
    (h_flow : sc.inFlow = true)
    (hcorr : ScannerSurfCorr sc sp) (hpeek : sc.peek? = some ':')
    (s' : ScannerState) (hok : scanValue sc = .ok s') :
    ∃ sp', GLit ':' sp sp' ∧ ScannerSurfCorr s' sp' := by
  obtain ⟨rest, hsp_eq⟩ := peek_some_sp hcorr hpeek
  subst hsp_eq
  have hmore := peek_some_has_more hpeek
  refine ⟨⟨rest, sc.col + 1⟩, GLit.mk rest sc.col, ?_⟩
  have h_ck := scanValueClearKey_fields sc
  have h_flow_ck : (scanValueClearKey sc).inFlow = true := by
    unfold ScannerState.inFlow
    rw [h_ck.2.2.2.2.2.1]
    exact h_flow
  have h_prep := scanValuePrepare_fields h_flow_ck
  have hcorr_prep : ScannerSurfCorr (scanValuePrepare (scanValueClearKey sc))
      ⟨':' :: rest, sc.col⟩ :=
    corr_congr (by rw [h_prep.1, h_ck.1]) (by rw [h_prep.2.1, h_ck.2.1])
      (by rw [h_prep.2.2.1, h_ck.2.2.1]) (by rw [h_prep.2.2.2.1, h_ck.2.2.2.1])
      (by rw [h_prep.2.2.2.2.1, h_ck.2.2.2.2.1]) hcorr
  have hcorr_at : ScannerSurfCorr (scanValuePrepare (scanValueClearKey sc))
      ⟨':' :: rest, (scanValuePrepare (scanValueClearKey sc)).col⟩ :=
    ⟨hcorr_prep.chars_from, rfl, hcorr_prep.end_eq, hcorr_prep.input_prefix,
     hcorr_prep.indent_cols_nonneg⟩
  have hcorr_emit : ScannerSurfCorr
      ((scanValuePrepare (scanValueClearKey sc)).emit .value)
      ⟨':' :: rest, (scanValuePrepare (scanValueClearKey sc)).col⟩ :=
    ⟨hcorr_at.chars_from, hcorr_at.col_eq, hcorr_at.end_eq, hcorr_at.input_prefix,
     hcorr_at.indent_cols_nonneg⟩
  have hmore_at := corr_nonempty_has_more hcorr_emit
  have hcorr_adv := advance_non_newline_corr
    ((scanValuePrepare (scanValueClearKey sc)).emit .value)
    ':' rest hcorr_emit hmore_at (by decide) (by decide)
  unfold scanValue at hok
  simp only [bind, Except.bind] at hok
  split at hok
  · exact absurd hok (by simp)
  · split at hok
    · exact absurd hok (by simp)   -- scanValueIndentTabCheck (item 31)
    split at hok
    · exact absurd hok (by simp)
    · have h := Except.ok.inj hok
      subst h
      refine ⟨hcorr_adv.chars_from, ?_, hcorr_adv.end_eq, hcorr_adv.input_prefix,
              hcorr_adv.indent_cols_nonneg⟩
      have h1 := hcorr_adv.col_eq
      have h2 : (scanValuePrepare (scanValueClearKey sc)).col = sc.col := by
        rw [h_prep.2.1, h_ck.2.1]
      have h3 : ((scanValuePrepare (scanValueClearKey sc)).emit .value).col
          = (scanValuePrepare (scanValueClearKey sc)).col := rfl
      dsimp only [] at *
      omega

/-! ### §1d Preprocessing + Block Indicator Dispatch

    `scanNextToken_dispatchBlockIndicators` handles `-`, `?`, `:`.
    This is the core of block collection accumulation:

    1. Preprocessing may unwind indent levels → the landing resumes at a level
    2. `pushSequenceIndent`/`pushMappingIndent` may push → a level opens
    3. The indicator character is consumed → pendingBlock

    **Scanner → frames correspondence.**  The scanner's stack is
    `sc.indents` (a sentinel at column -1, then one `IndentEntry` per open
    level, columns strictly increasing).  The grammar's counterpart is the
    pending's own `ResumeFrames`: the still-open MAPPING levels, innermost
    first, each held as its entries-level continuation.
    - `scanKey`/`scanValuePrepare` push `{ column, isSequence := false }` where
      a producer conses a `ResumeFrames.level`.
    - `scanBlockEntry` pushes `{ column, isSequence := true }`, which the
      frames do NOT record: a dedent landing is an implicit key, and a
      sequence level it crosses can only close.
    - `unwindIndents` pops back to the landing's column, which
      `ResumeFrames.resumeAt` matches by popping the widths above it.

    The two are not yet coupled, and that gap is what the pack producers'
    `FrameLevel.map w ∉ ks` exit stands at (~~`KeyPackPunt.dedent`~~, deleted at item 297; the
    exit keys a fresh document): `resumeAt` needs the landing width to be a
    MEMBER of the frames,
    and only `sc.indents` knows that it is (item 127's §1c pins the scanner
    half — an accepted popping landing sits exactly AT the level it lands on).

    **Proven case**: `BlockStack.nil` + `PendingNode.noPending`.
    No pending to close. Block indicator opens `pendingBlock`. -/

-- Helper: block indicator dispatch preserves `ScannerSurfCorr` on `some` paths.
lemma dispatchBlockIndicators_corr (sc : ScannerState) (sp : SurfPos) (c : Char)
    {s' : ScannerState}
    (hcorr : ScannerSurfCorr sc sp)
    (hok : scanNextToken_dispatchBlockIndicators sc c = .ok (some s')) :
    ∃ sp', ScannerSurfCorr s' sp' := by
  unfold scanNextToken_dispatchBlockIndicators at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  -- c == '-' && !inFlow && isBlockEntryCandidate
  split at hok
  · split at hok
    · simp at hok
    · rename_i s_be hbe
      have h := Except.ok.inj hok; injection h with h; subst h
      exact scanBlockEntry_corr sc sp hcorr s_be hbe
  -- c == '?' && isKeyCandidate
  · split at hok
    · split at hok
      · simp at hok
      · rename_i s_k hk
        have h := Except.ok.inj hok; injection h with h; subst h
        exact scanKey_corr sc sp hcorr s_k hk
    -- c == ':' && isValueCandidate
    · split at hok
      · split at hok
        · simp at hok
        · rename_i s_v hv
          have h := Except.ok.inj hok; injection h with h; subst h
          exact scanValue_corr sc sp hcorr s_v hv
      -- none (fallthrough)
      · simp at hok

-- Block entry dispatch full production: GLit '-' + GNot SNsChar + ScannerSurfCorr.
-- Unfolds dispatchBlockIndicators for the '-' case. The result includes:
-- 1) A literal dash character
-- 2) Negative lookahead: the char after '-' is not ns-char
-- 3) Scanner/surface correspondence after the dash
lemma dispatchBlockEntry_full_prod (sc : ScannerState) (sp : SurfPos)
    {s' : ScannerState}
    (hcorr : ScannerSurfCorr sc sp)
    (hpeek : sc.peek? = some '-')
    (hok : scanNextToken_dispatchBlockIndicators sc '-' = .ok (some s')) :
    ∃ sp', GLit '-' sp sp' ∧ GNot SNsChar sp' ∧ ScannerSurfCorr s' sp' := by
  obtain ⟨rest, hsp_eq⟩ := peek_some_sp hcorr hpeek
  subst hsp_eq
  unfold scanNextToken_dispatchBlockIndicators at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  split at hok
  · -- '-' == '-' && ... is true: enter scanBlockEntry path
    rename_i h_entry_cond
    have h_candidate : isBlockEntryCandidate sc = true := by
      simp [Bool.and_eq_true] at h_entry_cond; exact h_entry_cond.2
    split at hok
    · simp at hok
    · rename_i s_be hbe
      have h := Except.ok.inj hok; injection h with h; subst h
      obtain ⟨sp', h_lit, hcorr'⟩ := scanBlockEntry_prod sc ⟨'-' :: rest, sc.col⟩
        hcorr hpeek s_be hbe
      cases h_lit
      exact ⟨⟨rest, sc.col + 1⟩, GLit.mk rest sc.col,
             blockEntryCandidate_gnot sc rest sc.col hcorr h_candidate, hcorr'⟩
  · -- First branch failed: '-' ≠ '?' and '-' ≠ ':' means remaining dispatch returns none
    have hq : ('-' == '?' : Bool) = false := by native_decide
    have hc : ('-' == ':' : Bool) = false := by native_decide
    simp only [hq, hc, Bool.false_and, ite_eq_right Bool.false_ne_true] at hok
    simp at hok

-- The `:` step's production in BLOCK context (item 13): one literal colon.
-- The flow twin (`scanValue_prod`) rides `scanValuePrepare_fields`, which
-- holds only in flow; here the prepare step may push a mapping indent, so
-- the correspondence crosses it via `scanValuePrepare_corr` instead and the
-- cursor via `scanValuePrepare_col`.
lemma scanValue_block_prod (sc : ScannerState) (sp : SurfPos)
    (hcorr : ScannerSurfCorr sc sp) (hpeek : sc.peek? = some ':')
    (s' : ScannerState) (hok : scanValue sc = .ok s') :
    ∃ sp', GLit ':' sp sp' ∧ ScannerSurfCorr s' sp' := by
  obtain ⟨rest, hsp_eq⟩ := peek_some_sp hcorr hpeek
  subst hsp_eq
  refine ⟨⟨rest, sc.col + 1⟩, GLit.mk rest sc.col, ?_⟩
  have h_ck := scanValueClearKey_fields sc
  have hcorr_ck : ScannerSurfCorr (scanValueClearKey sc) ⟨':' :: rest, sc.col⟩ :=
    corr_congr h_ck.1 h_ck.2.1 h_ck.2.2.1 h_ck.2.2.2.1 h_ck.2.2.2.2.1 hcorr
  have hcorr_prep : ScannerSurfCorr (scanValuePrepare (scanValueClearKey sc))
      ⟨':' :: rest, sc.col⟩ := scanValuePrepare_corr hcorr_ck
  have hcorr_at : ScannerSurfCorr (scanValuePrepare (scanValueClearKey sc))
      ⟨':' :: rest, (scanValuePrepare (scanValueClearKey sc)).col⟩ :=
    ⟨hcorr_prep.chars_from, rfl, hcorr_prep.end_eq, hcorr_prep.input_prefix,
     hcorr_prep.indent_cols_nonneg⟩
  have hcorr_emit : ScannerSurfCorr
      ((scanValuePrepare (scanValueClearKey sc)).emit .value)
      ⟨':' :: rest, (scanValuePrepare (scanValueClearKey sc)).col⟩ :=
    ⟨hcorr_at.chars_from, hcorr_at.col_eq, hcorr_at.end_eq, hcorr_at.input_prefix,
     hcorr_at.indent_cols_nonneg⟩
  have hmore_at := corr_nonempty_has_more hcorr_emit
  have hcorr_adv := advance_non_newline_corr
    ((scanValuePrepare (scanValueClearKey sc)).emit .value)
    ':' rest hcorr_emit hmore_at (by decide) (by decide)
  unfold scanValue at hok
  simp only [bind, Except.bind] at hok
  split at hok
  · exact absurd hok (by simp)
  · split at hok
    · exact absurd hok (by simp)   -- scanValueIndentTabCheck (item 31)
    split at hok
    · exact absurd hok (by simp)
    · have h := Except.ok.inj hok
      subst h
      refine ⟨hcorr_adv.chars_from, ?_, hcorr_adv.end_eq, hcorr_adv.input_prefix,
              hcorr_adv.indent_cols_nonneg⟩
      have h1 := hcorr_adv.col_eq
      have h2 : (scanValuePrepare (scanValueClearKey sc)).col = sc.col :=
        (scanValuePrepare_col (scanValueClearKey sc)).trans h_ck.2.1
      have h3 : ((scanValuePrepare (scanValueClearKey sc)).emit .value).col
          = (scanValuePrepare (scanValueClearKey sc)).col := rfl
      dsimp only [] at *
      omega

-- Block value dispatch full production (item 13): the `:` arm is the only
-- one the dispatcher can take for c = ':' (the `-`/`?` guards test their own
-- literal), so a `some` result IS `scanValue`'s.
lemma dispatchBlockValue_full_prod (sc : ScannerState) (sp : SurfPos)
    {s' : ScannerState}
    (hcorr : ScannerSurfCorr sc sp)
    (hpeek : sc.peek? = some ':')
    (hok : scanNextToken_dispatchBlockIndicators sc ':' = .ok (some s')) :
    ∃ sp', GLit ':' sp sp' ∧ ScannerSurfCorr s' sp' := by
  unfold scanNextToken_dispatchBlockIndicators at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  have hdash : ((':' : Char) == '-' : Bool) = false := by native_decide
  have hq : ((':' : Char) == '?' : Bool) = false := by native_decide
  simp only [hdash, hq, Bool.false_and, ite_eq_right Bool.false_ne_true] at hok
  split at hok
  · split at hok
    · simp at hok
    · rename_i s_v hv
      have h := Except.ok.inj hok; injection h with h; subst h
      exact scanValue_block_prod sc sp hcorr hpeek s_v hv
  · simp at hok

-- Block key dispatch full production (item 20): the mirror of the `:` lemma
-- above.  For c = '?' the `-` and `:` arms test their own literal, so a `some`
-- result IS `scanKey`'s — and `scanKey_prod` already reads it as `GLit '?'`
-- across the block branch's `pushMappingIndent`.
lemma dispatchBlockKey_full_prod (sc : ScannerState) (sp : SurfPos)
    {s' : ScannerState}
    (hcorr : ScannerSurfCorr sc sp)
    (hpeek : sc.peek? = some '?')
    (hok : scanNextToken_dispatchBlockIndicators sc '?' = .ok (some s')) :
    ∃ sp', GLit '?' sp sp' ∧ ScannerSurfCorr s' sp' := by
  unfold scanNextToken_dispatchBlockIndicators at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  have hdash : (('?' : Char) == '-' : Bool) = false := by native_decide
  have hcolon : (('?' : Char) == ':' : Bool) = false := by native_decide
  simp only [hdash, hcolon, Bool.false_and, ite_eq_right Bool.false_ne_true] at hok
  split at hok
  · split at hok
    · simp at hok
    · rename_i s_k hk
      have h := Except.ok.inj hok; injection h with h; subst h
      exact scanKey_prod sc sp hcorr hpeek s_k hk
  · simp at hok

-- The three readers above are exhaustive (item 21).  Each of the dispatcher's
-- arms opens with its own literal test, so a `some` result NAMES its character:
-- there is no fourth block indicator, and the classical split on `c` that the
-- four block-dispatch lemmas perform is strictly FINER than the dispatcher can
-- branch.  The branches past `-`, `:` and `?` were being routed to
-- `block_dispatch_deferred`, which stated them as deferred input; they are not
-- input at all (Reflection 646).
lemma dispatchBlockIndicators_indicator_of_some {s s' : ScannerState} {c : Char}
    (h : scanNextToken_dispatchBlockIndicators s c = .ok (some s')) :
    c = '-' ∨ c = '?' ∨ c = ':' := by
  by_cases hd : c = '-'
  · exact Or.inl hd
  · by_cases hq : c = '?'
    · exact Or.inr (Or.inl hq)
    · by_cases hv : c = ':'
      · exact Or.inr (Or.inr hv)
      · exfalso
        have h1 : (c == '-') = false := by simp [hd]
        have h2 : (c == '?') = false := by simp [hq]
        have h3 : (c == ':') = false := by simp [hv]
        unfold scanNextToken_dispatchBlockIndicators at h
        simp only [bind, Except.bind, pure, Except.pure, h1, h2, h3,
          Bool.false_and, ite_eq_right Bool.false_ne_true] at h
        injection h with h
        exact absurd h (by simp)

/-- The three block-dispatch lemmas' shared refutation (item 21): with `-` and
    the two mapping indicators already taken, no character is left. -/
lemma block_indicator_exhausted {s s' : ScannerState} {c : Char}
    (h : scanNextToken_dispatchBlockIndicators s c = .ok (some s'))
    (hdash : ¬ c = '-') (hmap : ¬ (c = ':' ∨ c = '?')) : False := by
  rcases dispatchBlockIndicators_indicator_of_some h with h | h | h
  · exact hdash h
  · exact hmap (Or.inr h)
  · exact hmap (Or.inl h)

/-- **The TAB branch, refuted** (item 32) — the four block-dispatch lemmas'
    other shared refutation.

    Item 22 read the whites a step leaves in front of the indicator as
    `[63] s-indent(k)` OR a tab, and deferred the tab: `[63]` is spaces only,
    so no derivation exists, but the accumulator had no way to say the SCANNER
    had already refused.  Two things were missing, and item 31 paid the half
    nobody had priced — only `-` carried the backward scan, so `?` and `:`
    accepted four families of shape no `[187]` derivation reaches.  What is
    left is this: the disjunct, LOCATED (`gstar_white_sIndent_or_tab`), is the
    statement that a tab stands in the run between the landing and the
    indicator; the landing is at column 0 and preprocessing did not change the
    string (`preprocess_input`), so that run is the line's indentation inside
    the very input the scanner walks backwards; and both of the scanner's §6.1
    scans therefore answer `true` (`tabIndent_scans_of_located`).

    `!inFlow` is a genuine premise rather than a convenience: in a flow
    collection `[63]` is not in play at all and the tab is legal separation,
    so the arm is refutable only where the block grammar is the reading.  The
    caller supplies it from the accumulator's own depth-0 case. -/
lemma tab_refutes_dispatch {sc s_prep s' : ScannerState} {sp sp_land sp_ind : SurfPos}
    {c : Char}
    (h_noflow : s_prep.inFlow = false)
    (h_corr : ScannerSurfCorr sc sp)
    (h_ssl : SSLComments sp sp_land)
    (hcol0 : sp_land.col = 0)
    (hcorr_prep : ScannerSurfCorr s_prep sp_ind)
    (hws : GStar SSWhite sp_land sp_ind)
    (htab : ∃ sa sb, GStar SSWhite sp_land sa ∧ SSWhite sa sb ∧
              sa.chars.head? = some '\t' ∧ GStar SSWhite sb sp_ind)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) c = .ok (some s')) : False := by
  have h_inp : s_prep.input = sc.input := preprocess_input h_preprocess
  have hsuf : sp_land.chars <:+ s_prep.input.toList := by
    rw [h_inp]; exact (sslComments_suffix h_ssl).trans (corr_chars_suffix h_corr)
  obtain ⟨h_run, h_line⟩ := tabIndent_scans_of_located hcorr_prep hsuf hcol0 hws htab
  -- The allow-directives update writes neither the string nor the cursor.
  have h_fl : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).inFlow = false := by split <;> exact h_noflow
  have h_r : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).hasTabInPrecedingWhitespace = true := by split <;> exact h_run
  have h_l : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).tabInLineIndent = true := by split <;> exact h_line
  rcases dispatchBlockIndicators_indicator_of_some h_dispatch with rfl | rfl | rfl
  · exact scanBlockEntry_tab_ne h_fl h_r (dispatchBlockIndicators_dash_scan h_dispatch).2
  · exact scanKey_tab_ne h_fl h_r (dispatchBlockIndicators_key_scan h_dispatch)
  · exact scanValue_tab_ne h_fl h_l (dispatchBlockIndicators_value_scan h_dispatch)

/-- **The compact indicator's half of the same refutation** (items 33/34).

    A tab inside `[185] s-l+block-indented`'s `s-indent(m)` is illegal for the
    same reason it is inside `[63]` anywhere: `s-indent` is spaces.  But the
    run in front of a COMPACT indicator is not the whole line — the indicator
    that opened the entry is in front of it — so `[63]`'s own backward walk
    stops there and `tabInLineIndent` answers `false`.  Only `[66]`'s scan is
    available, and the three arms do not read it alike: `scanBlockEntry` and
    `scanKey` consult `hasTabInPrecedingWhitespace` unconditionally in block
    context, so `- \t- a` and `- \t? a` refuse; `scanValue` consults it only
    when the simple-key machine has recorded NO key.

    Item 33 stopped there and concluded a CHARACTER — after a located tab the
    indicator can only be a `:` — because whether a key was recorded is a fact
    about `simpleKeyAllowed`, and no pending carried one.  Item 34 carries it
    (`PendingNode.pendingBlock`'s `h_sk`), and then the `:` arm is not an
    exception but the same run read from one field further along: the flag says
    preprocessing SAVED, a save is at the cursor, and `scanValue`'s key branch
    walks back from the cursor.  All three arms refuse, and the conclusion is
    `False` again.

    `h_sk` is about `sc` — the state the pending is parked at, one preprocessing
    step BEFORE the dispatch — which is what makes it a pending's field rather
    than a hypothesis about the dispatch: fresh saves only ever go up across the
    walk (`skipToContent_simpleKeyAllowed_mono`), so the producer's `-` scan
    settles it for whatever the next step turns out to be. -/
lemma tab_refutes_dispatch_inline {sc s_prep s' : ScannerState} {sp sp_ind : SurfPos}
    {c : Char}
    (h_noflow : s_prep.inFlow = false)
    (h_sk : sc.simpleKeyAllowed = true)
    (h_corr : ScannerSurfCorr sc sp)
    (hcorr_prep : ScannerSurfCorr s_prep sp_ind)
    (htab : ∃ sa sb, GStar SSWhite sp sa ∧ SSWhite sa sb ∧
              sa.chars.head? = some '\t' ∧ GStar SSWhite sb sp_ind)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) c = .ok (some s')) : False := by
  have h_inp : s_prep.input = sc.input := preprocess_input h_preprocess
  have hsuf : sp.chars <:+ s_prep.input.toList := by
    rw [h_inp]; exact corr_chars_suffix h_corr
  have h_run := tabRun_scan_of_located hcorr_prep hsuf htab
  have h_fl : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).inFlow = false := by split <;> exact h_noflow
  have h_r : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).hasTabInPrecedingWhitespace = true := by split <;> exact h_run
  rcases dispatchBlockIndicators_indicator_of_some h_dispatch with rfl | rfl | rfl
  · exact scanBlockEntry_tab_ne h_fl h_r (dispatchBlockIndicators_dash_scan h_dispatch).2
  · exact scanKey_tab_ne h_fl h_r (dispatchBlockIndicators_key_scan h_dispatch)
  · -- The `:`: the key the step recorded is AT this character, so the branch
    -- `scanValueIndentTabCheck` takes reads the run in front of it either way.
    obtain ⟨_, h_pos⟩ := preprocess_saved_key_at_cursor h_sk h_noflow h_preprocess
    have h_pos' : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).simpleKey.pos.offset =
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).offset := by split <;> exact h_pos
    exact scanValue_tab_run_ne h_fl h_r (fun _ => h_pos')
      (dispatchBlockIndicators_value_scan h_dispatch)

/-! ### §1c''c'' The tab in front of the KEY, and the `:` that reads it (item 65)

`tab_refutes_dispatch_inline` above refutes a tab in the run in front of the
INDICATOR — the coordinate every block indicator's own scan reads.  A parked
entry's implicit key puts the run somewhere else: in front of the KEY, one
token back, where §6.1's preprocessing gate has already let it through
(`k:⏎␣→a` is accepted — the gate fires at or left of `currentIndent` and this
tab sits past it).  What refuses `k:⏎␣→a: 1` is the `:`'s own backward scan,
and `scanValueIndentTabCheck` runs it from `simpleKey.pos.offset` rather than
from the cursor.  So the fact travels as a reading AT THE KEY, and these four
lemmas are the two ends of that transport: the producer's (`dispatchContent`
moves neither the string nor the saved key's position) and the consumer's
(`scanValue` throws on it, whichever branch the clear leaves).
-/

/-- The byte size of a string built from a character list is the list's own. -/
lemma ofList_utf8ByteSize (l : List Char) :
    (String.ofList l).utf8ByteSize = listByteSize l := by
  induction l with
  | nil => simp [listByteSize]
  | cons c cs ih => simp [listByteSize, ih]

/-- A correspondence's own prefix decomposition IS the UTF-8 validity of the
    cursor: `isValid_iff_exists_take_toList` asks for a prefix whose encoding
    ends at the offset, and `input_prefix` names one. -/
lemma corr_isValid {sc : ScannerState} {sp : SurfPos} (h : ScannerSurfCorr sc sp) :
    String.Pos.Raw.IsValid sc.input ⟨sc.offset⟩ := by
  obtain ⟨pre, hpre, hlen⟩ := h.input_prefix
  refine String.Pos.Raw.isValid_iff_exists_take_toList.2 ⟨pre.length, ?_⟩
  rw [hpre]
  simp [ofList_utf8ByteSize, hlen]

/-- …and the same decomposition bounds the cursor by the input's end. -/
lemma corr_offset_le {sc : ScannerState} {sp : SurfPos} (h : ScannerSurfCorr sc sp) :
    sc.offset ≤ sc.inputEnd := by
  obtain ⟨pre, hpre, hlen⟩ := h.input_prefix
  have h1 : listByteSize sc.input.toList = listByteSize pre + listByteSize sp.chars := by
    rw [hpre, listByteSize_append]
  have h2 : sc.input.utf8ByteSize = listByteSize sc.input.toList := by
    rw [← ofList_utf8ByteSize]; simp
  rw [h.end_eq, h2, h1, ← hlen]
  omega

/-- **The string survives a content dispatch.**  `ScannerBound` proved it for
    every scan the dispatcher composes, bundled with the UTF-8 validity it has
    to carry; a correspondence supplies that validity, so the bound's own
    reflexive seed is available wherever the accumulation is. -/
lemma dispatchContent_input {s s' : ScannerState} {sp : SurfPos} {c : Char}
    (hcorr : ScannerSurfCorr s sp)
    (hok : scanNextToken_dispatchContent s c = .ok s') :
    s'.input = s.input :=
  (ScannerBound.dispatchContent_preserves_bound s s s' c
    (ScannerBound.BoundInv.refl s (corr_offset_le hcorr) (corr_isValid hcorr))
    hcorr.end_eq hok).input_eq

-- (`scanBlockScalarBody_simpleKey_false` and `scanBlockScalar_simpleKey_false`
-- live in `LineOpenGuard`, where `dispatchContent_col_pos_or_armed` spends them
-- on its armed arm.)
lemma dispatchContent_blockScalar_simpleKey_false {s s' : ScannerState} {c : Char}
    (hbs : c = '|' ∨ c = '>')
    (hok : scanNextToken_dispatchContent s c = .ok s') :
    s'.simpleKey.possible = false := by
  unfold scanNextToken_dispatchContent at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  split at hok
  · rename_i heq
    have : c = '&' := by simpa using heq
    rcases hbs with rfl | rfl <;> simp at this
  split at hok
  · rename_i heq
    have : c = '*' := by simpa using heq
    rcases hbs with rfl | rfl <;> simp at this
  split at hok
  · rename_i heq
    have : c = '!' := by simpa using heq
    rcases hbs with rfl | rfl <;> simp at this
  split at hok
  · exact scanBlockScalar_simpleKey_false (peel_blockScalarGuard hok)
  · rename_i heq
    rcases hbs with rfl | rfl <;> simp at heq

/-- …and it leaves the flag up (item 293): the scan ends past a break. -/
lemma dispatchContent_blockScalar_ska {s s' : ScannerState} {c : Char}
    (hbs : c = '|' ∨ c = '>')
    (hok : scanNextToken_dispatchContent s c = .ok s') :
    s'.simpleKeyAllowed = true := by
  unfold scanNextToken_dispatchContent at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  split at hok
  · rename_i heq
    have : c = '&' := by simpa using heq
    rcases hbs with rfl | rfl <;> simp at this
  split at hok
  · rename_i heq
    have : c = '*' := by simpa using heq
    rcases hbs with rfl | rfl <;> simp at this
  split at hok
  · rename_i heq
    have : c = '!' := by simpa using heq
    rcases hbs with rfl | rfl <;> simp at this
  split at hok
  · exact scanBlockScalar_simpleKeyAllowed (peel_blockScalarGuard hok)
  · rename_i heq
    rcases hbs with rfl | rfl <;> simp at heq

-- (`scanValueClearKey_keyrun` lives in `PreprocessIndentStable` since item 81,
-- where `scanValue_key_col_le` spends it.)

/-- §6.1 read at the KEY: with a key recorded and a tab in the run in front of
    it, the check's key branch throws (and the line-indent branch above it
    throws first when the key IS the line's first token). -/
lemma scanValueIndentTabCheck_keyrun {s : ScannerState}
    (h_noflow : s.inFlow = false)
    (h_poss : s.simpleKey.possible = true)
    (h_run : ScannerState.hasTabInPrecedingWhitespaceLoop s.input
        s.simpleKey.pos.offset s.simpleKey.pos.offset = true) :
    ∃ e, scanValueIndentTabCheck s = .error e := by
  by_cases h_til : s.tabInLineIndent = true
  · exact ⟨_, scanValueIndentTabCheck_tab h_noflow h_til⟩
  · have h_til' : s.tabInLineIndent = false := by simpa using h_til
    refine ⟨.tabInIndentation s.simpleKey.pos.line s.simpleKey.pos.col, ?_⟩
    unfold scanValueIndentTabCheck
    simp only [h_noflow, h_til', h_poss, h_run, Bool.false_eq_true, ite_false, ite_true]
    rfl

/-- **The `:` scan over a tab in front of its KEY.**  The two branches
    `scanValueClearKey` can leave read the same run: untouched, the key's own;
    cleared, the cursor's — and the clear only fires on a key that sat there. -/
lemma scanValue_tab_keyrun_ne {s s' : ScannerState}
    (h_noflow : s.inFlow = false)
    (h_poss : s.simpleKey.possible = true)
    (h_kline : s.simpleKey.pos.line = s.line)
    (h_run : ScannerState.hasTabInPrecedingWhitespaceLoop s.input
        s.simpleKey.pos.offset s.simpleKey.pos.offset = true) :
    scanValue s ≠ .ok s' := by
  intro hok
  obtain ⟨h_fl, _, _, _⟩ := scanValueClearKey_scan_fields s
  obtain ⟨h_inp, h_off, _⟩ := scanValueClearKey_key_fields s
  have h_check : ∃ e, scanValueIndentTabCheck (scanValueClearKey s) = .error e := by
    rcases scanValueClearKey_keyrun h_kline with h | ⟨h_cl, h_at⟩
    · exact scanValueIndentTabCheck_keyrun (by rw [h_fl]; exact h_noflow)
        (by rw [h]; exact h_poss) (by rw [h_inp, h]; exact h_run)
    · exact scanValueIndentTabCheck_run (by rw [h_fl]; exact h_noflow)
        (by unfold ScannerState.hasTabInPrecedingWhitespace
            rw [h_inp, h_off, ← h_at]; exact h_run)
        (by intro hp; rw [h_cl] at hp; simp at hp)
  obtain ⟨e, h_check⟩ := h_check
  unfold scanValue at hok
  simp only [bind, Except.bind] at hok
  split at hok
  · simp at hok
  · rw [h_check] at hok; simp at hok

/-- **`[199] s-l+block-collection` under an entry that is still awaiting its
    node** (item 30) — a NESTED block sequence, at the outer entry's own index.

    `[183] l+block-sequence(n)`'s auto-detected `m` is `k - n`: the outer entry
    awaits `s-l+block-node(n, block-in)`, whose collection alternative opens
    `l+block-sequence(seq-spaces(n, block-in) + m)` and `seq-spaces(n,
    block-in) = n`, so a `-` that the landing leaves at width `k > n` is the
    inner collection's first entry rather than a sibling of the outer's.  The
    gap between the two is `[79] s-l-comments`, which is the same evidence a
    SIBLING snoc consumes — what differs is only where it is spent (the
    collection's own leading comments, not the previous entry's tail).

    The side condition is `n ≤ k` and it is the whole content of the split: at
    `k > n` this reading exists and at `k < n` it does not, because `m` would
    have to be negative.  A DEDENT is therefore a different construct, not a
    harder instance — it ends the inner collection and resumes the outer, which
    is a frame the pending does not carry. -/
lemma nestedBlockSeq {n k : Nat} (hnk : n ≤ k) {s s₂ s' : SurfPos}
    (h_ssl : SSLComments s s₂) (h_entries : SBlockSeqEntries k s₂ s') :
    SBlockNode n .blockIn s s' :=
  SBlockNode.blockSeq n .blockIn (k - n) s s s₂ s' (GOpt.none s) h_ssl
    (by simpa [seqSpaces, Nat.add_sub_cancel' hnk] using h_entries)

/-- `[199] s-l+block-collection` opening a document's root node, with
    `[183] l+block-sequence`'s auto-detected indentation set to `k` — the
    width the landing actually left before the `-` (item 22).  At `k = 0` this
    is the column-0 collection every producer built through item 21; at
    `k > 0` it is the indented one, which had no derivation at all.  It is
    `nestedBlockSeq` at the root's `n = 0`, where the side condition is
    vacuous. -/
lemma rootBlockSeq (k : Nat) {s s₂ s' : SurfPos}
    (h_ssl : SSLComments s s₂) (h_entries : SBlockSeqEntries k s₂ s') :
    SBlockNode 0 .blockIn s s' :=
  nestedBlockSeq (Nat.zero_le k) h_ssl h_entries

/-- **An open `[185]` slot filled by a LANDED sequence — `seq-spaces` at work**
    (item 188).

    `nestedBlockSeq` and `rootBlockSeq` build the `.blockIn` collection an
    ENTRY awaits.  This is the `.blockOut` one a `?` frame's key slot (or an
    explicit `:`'s value slot) awaits, and the two differ by exactly the
    production `[183]`'s index is read through: `[185]`'s `s-l+block-node(nv,
    block-out)` crosses to `SBlockNode (nv + 1)` (`SBlockIndented.node`, item
    179), and `seq-spaces(nv + 1, block-out) = nv` — so the entries may sit at
    the frame's OWN width, one column left of where the block-in reading would
    put them.  That is the whole content of the `-1`: `?⏎-⏎: w` and
    `?⏎- a⏎: w` land their `-` at column 0 under a `?` at column 0, and
    nothing but this alternative admits them.

    The side condition is `nv ≤ k` — `m` may not go negative — and it is the
    same split `nestedBlockSeq` makes, taken one index to the left.  A landing
    strictly inside the frame (`?⏎  - a⏎: w`) is the `0 < m` case; a landing
    left of it has no reading here and keeps the deferral. -/
lemma slotLandedSeq {nv k : Nat} (hnk : nv ≤ k) {s s₂ s' : SurfPos}
    (h_ssl : SSLComments s s₂) (h_entries : SBlockSeqEntries k s₂ s') :
    SBlockIndented nv .blockOut s s' :=
  SBlockIndented.node nv .blockOut s s'
    (SBlockNode.blockSeq (nv + 1) .blockOut (k - nv) s s s₂ s' (GOpt.none s) h_ssl
      (by
        have h : seqSpaces (nv + 1) .blockOut + (k - nv) = k := by
          simp only [seqSpaces]; omega
        rw [h]; exact h_entries))

/-- **The same slot filled by a landed MAPPING, and the `-1` is NOT there**
    (item 189).

    `slotLandedSeq`'s twin, one production over: `[185]`'s `s-l+block-node(nv,
    block-out)` crosses to `SBlockNode (nv + 1)` exactly as it does there, but
    `[187] l+block-mapping(n)` is opened at `n + m` with NO `seq-spaces` in
    front of it — the function is `[183]`'s alone.  So the entries start at
    `nv + 1` and the side condition is `nv + 1 ≤ k`, one column right of the
    sequence's `nv ≤ k`, and the twin exists only STRICTLY INSIDE the frame.

    The runtime draws the same line.  `?⏎  ?⏎: w` and `?⏎  k: v⏎: w` read the
    indented mapping as the frame's key (`+MAP +MAP … -MAP =VAL :w -MAP`),
    while `?⏎?⏎: w` at the frame's own column does not nest at all — the two
    `?`s fuse into one entry.  A `:` inside the frame is refused outright
    (`?⏎  : a⏎: w`), so the only landings that reach this production are a `?`
    and an implicit key. -/
lemma slotLandedMap {nv k : Nat} (hnk : nv + 1 ≤ k) {s s₂ s' : SurfPos}
    (h_ssl : SSLComments s s₂) (h_entries : SBlockMapEntries k s₂ s') :
    SBlockIndented nv .blockOut s s' :=
  SBlockIndented.node nv .blockOut s s'
    (SBlockNode.blockMap (nv + 1) .blockOut (k - (nv + 1)) s s s₂ s' (GOpt.none s) h_ssl
      (by
        have h : (nv + 1) + (k - (nv + 1)) = k := by omega
        rw [h]; exact h_entries))

/-- **The ancestor CHAIN crosses a landed `?` in one term** (item 191).

    `slotLandedMap` fills the closed park's still-open `[185]` key slot with the
    `[187]` mapping this landing opens, and its side condition `nv + 1 ≤ k` reads
    the PARK's index against the LANDING's — it says nothing about which frame's
    `:` line is owed after the fill.  So the identical crossing carries every
    ancestor the park was already holding, and the new park leaves the landing
    with the whole chain rather than with the nearest frame alone.

    That is the step item 190's payment dropped, and dropping it is what
    `?⏎  ?⏎    ? -⏎: w` measured: the `:` there lands TWO frames up, while
    `?⏎  ?⏎    ? -⏎  : v⏎: w` lands one, and the two inputs differ only in where
    the `:` stands — so no payment that names a single ancestor can serve both.
    The list is the cheap shape precisely because this lemma's side condition is
    indifferent to it. -/
lemma slotChainMap {sp_start sp_scan sp_mid sp_ind : SurfPos} {nv k : Nat}
    {ns : List Nat} (hnk : nv + 1 ≤ k)
    (h_ssl : SSLComments sp_scan sp_mid) (h_ind : SIndent k sp_mid sp_ind)
    (up : ∀ nvX ∈ ns, ∀ sp_m : SurfPos, SBlockIndented nv .blockOut sp_scan sp_m →
      ExplValueLine sp_start nvX sp_m) :
    ∀ nvX ∈ ns, ∀ sp_v : SurfPos, SBlockMapEntry k sp_ind sp_v →
      ExplValueLine sp_start nvX sp_v :=
  fun nvX hmem sp_v h_entry =>
    up nvX hmem sp_v
      (slotLandedMap hnk h_ssl
        (SBlockMapEntries.single k sp_mid sp_ind sp_v h_ind h_entry))

/-- **The same chain crossing a landed `?` that fills an AWAITED SEQUENCE
    ENTRY** (item 193).

    `slotChainMap` crosses a `?` landing that fills a still-open `[185]` KEY
    slot — the frame's own.  This is the crossing where what stands open is a
    `[184] c-l-block-seq-entry(n)` instead: the `-` has been read, its
    `s-l+block-indented(n, block-in)` node is still awaited, and the `[187]`
    mapping this landing opens IS that node (`nestedBlockMap` at the entry's
    shifted index, item 179) with the collection's remaining tail closing
    behind it at `nil`.

    **The side condition `n + 1 ≤ k` is the runtime's own line**, measured
    rather than assumed: with the `-` at column 2 under a `?` at 0, a `?` at
    column 0 dedents out of the sequence entirely, columns 1 and 2 are refused
    (`trailing content at line 2`), and every column from 3 rightward nests —
    `?⏎  -⏎   ? a⏎: w` through `?⏎  -⏎       ? a⏎: w` all read
    `+SEQ +MAP … -MAP -SEQ` with the outer `:` landing.  As at `slotChainMap`,
    the condition weighs the PARK's index against the LANDING's and says
    nothing about which ancestor's `:` line follows, so the identical term
    carries every ancestor the park was holding. -/
lemma entryChainMap {sp_start sp_scan sp_mid sp_ind : SurfPos} {n k : Nat}
    {ns : List Nat} (hnk : n + 1 ≤ k)
    (h_ssl : SSLComments sp_scan sp_mid) (h_ind : SIndent k sp_mid sp_ind)
    (up : ∀ nvX ∈ ns, ∀ sp_m : SurfPos, SBlockIndented n .blockIn sp_scan sp_m →
      ∀ sp_e : SurfPos, SCompactSeqTail n sp_m sp_e → ExplValueLine sp_start nvX sp_e) :
    ∀ nvX ∈ ns, ∀ sp_v : SurfPos, SBlockMapEntry k sp_ind sp_v →
      ExplValueLine sp_start nvX sp_v :=
  fun nvX hmem sp_v h_entry =>
    up nvX hmem sp_v
      (SBlockIndented.node n .blockIn sp_scan sp_v
        (nestedBlockMap hnk h_ssl
          (SBlockMapEntries.single k sp_mid sp_ind sp_v h_ind h_entry)))
      sp_v (SCompactSeqTail.nil n sp_v)

/-- **`rootBlockSeq`'s MARKER route** (item 137): the sequence the landed `-`
    opens is the `---` document's own content, so the entries go into
    `[199] s-l+block-collection`'s slot behind the landing's comments rather
    than into a fresh bare document appended to the closed marker.  Stated over
    the ENTRIES, not the node, because that is where the route has to intervene
    — `SSLComments` is inside the collection, so a node already built at the
    landing can no longer absorb it. -/
lemma markerSeqRoute {sp_start sp_land : SurfPos} {k : Nat}
    (h_mk : MarkerNodeRoute sp_start sp_land) :
    ∀ sp_e, SBlockSeqEntries k sp_land sp_e → SLYamlStream sp_start sp_e :=
  fun sp_e h_entries =>
    match h_mk with
    | ⟨_, h_ssl, route⟩ => route sp_e (rootBlockSeq k h_ssl h_entries)


/-- `[63] s-indent(k)` is `k` spaces, so it advances the column by exactly `k`
    (item 27): the entry index the accumulator measures off the landing IS the
    indicator's column, which is what the scanner pushed its indent at. -/
lemma SIndent_col {k : Nat} {sp sp' : SurfPos} (h : SIndent k sp sp') :
    sp'.col = sp.col + k := by
  induction h with
  | zero s => rfl
  | succ n rest col s' _ ih => simp only [] at ih ⊢; omega

/-- **The park is one column past the indent its indicator stands on** (item
    59).  An entry's index IS its indicator's column — `[63] s-indent(n)` off a
    line start for a fresh collection, off the enclosing park for a compact one
    — and the indicator is one character wide, so the position the pending
    parks at is `n + 1`.  That is the datum `[195]`'s compact route could not
    measure (`ImplicitKeyPack`'s column conjunct, item 28), and with it the
    compact key's `[187]` entry index is known equal to the column the scanner
    pushed its indent at. -/
lemma park_col_of_indicator {k : Nat} {ch : Char} {sp_base sp_ind sp_park : SurfPos}
    (hcol : sp_base.col = 0) (h_ind : SIndent k sp_base sp_ind)
    (h_lit : GLit ch sp_ind sp_park) : sp_park.col = k + 1 := by
  have hl : sp_park.col = sp_ind.col + 1 := by cases h_lit; rfl
  rw [hl, SIndent_col h_ind, hcol]; omega

/-- …and the compact twin: the indent is measured off the enclosing PARK, whose
    own column the pending carries, so the inner entry's index is
    `n + 1 + m`. -/
lemma park_col_of_compact {n m : Nat} {ch : Char} {sp_par sp_ind sp_park : SurfPos}
    (hcol : sp_par.col = n + 1) (h_ind : SIndent m sp_par sp_ind)
    (h_lit : GLit ch sp_ind sp_park) : sp_park.col = (n + 1 + m) + 1 := by
  have hl : sp_park.col = sp_ind.col + 1 := by cases h_lit; rfl
  rw [hl, SIndent_col h_ind, hcol]

-- Shared by every depth-0 dispatch that has to know the indent-check flag is
-- down: the block-indicator floors (items 27/28) and the content dispatches
-- (`accum_content_on_noPending`, `accum_content_pending`'s transition-close
-- arms).
/-- At a depth-0 dispatch the preprocessing left the flag down: the dispatch's
    own `inFlow = false` transports back through the update and the
    preprocessing to gate `preprocess_some_needIndentCheck_false` (item 12). -/
lemma nic_false_of_flow_disp {sc s_prep : ScannerState} {c : Char}
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h_flow_disp : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).inFlow = false) :
    s_prep.needIndentCheck = false := by
  have h_inflow : sc.inFlow = false := by
    unfold ScannerState.inFlow at h_flow_disp ⊢
    rw [allowDirectives_update_flowLevel s_prep,
        preprocess_preserves_flowLevel sc s_prep c h_preprocess] at h_flow_disp
    exact h_flow_disp
  exact preprocess_some_needIndentCheck_false h_inflow h_preprocess

/-- The `allowDirectives` update keeps `inFlow` (item 48's callers). -/
lemma noflow_disp_of_noflow {s_prep : ScannerState} (h : s_prep.inFlow = false) :
    (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).inFlow = false := by
  split
  · exact h
  · exact h

/-- Preprocessing writes no flow level, so the PARK's flag is the landing's
    (item 186) — the direction `h_scflow` reads at the lemmas that carry one,
    packaged for the consumers that hold the dispatch equation instead. -/
lemma noflow_park_of_noflow {sc s_prep : ScannerState} {c : Char}
    (h : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (hnf : s_prep.inFlow = false) : sc.inFlow = false := by
  unfold ScannerState.inFlow at hnf ⊢
  rw [← preprocess_preserves_flowLevel sc s_prep c h]; exact hnf

/-- The directive normalization carries the explicit-key register (item 186):
    neither branch writes it, so a landing's `none` is the dispatch state's. -/
lemma ekl_disp_of_ekl {s_prep : ScannerState} (h : s_prep.explicitKeyLine = none) :
    (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).explicitKeyLine = none := by
  split
  · exact h
  · exact h

/-- **A dead register at the PARK is dead at the landing** (item 187, narrowed
    by item 333).  Preprocessing either carries the explicit-key register or
    ends it (`preprocess_explicitKey_cases`), and the directive normalization
    writes neither field, so `none` at the park is `none` on the dispatch
    state.  The equation item 187 stated (`= sc.explicitKeyLine`) no longer
    holds — a sibling at the `?`'s column now ends the register in
    preprocessing — and every reader only ever spent its `none` half. -/
lemma ekl_disp_none_of_park_none {sc s_prep : ScannerState} {c : Char}
    (h : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h0 : sc.explicitKeyLine = none) :
    (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).explicitKeyLine = none := by
  have h_norm : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).explicitKeyLine = s_prep.explicitKeyLine := by
    split
    · rfl
    · rfl
  exact h_norm.trans (ExplicitKeyCoupling.preprocess_explicitKeyLine_none sc s_prep c h h0)

/-- **The alternative, refuted at a class-A landing** (item 309) — from the fact the three
    `block_dispatch_deferred_stamp_nopack` applications already hold: the live register at
    the dispatch state (`h_src`'s first disjunct, the `_h_park` term), which `ekl_disp_none_of_park_none`
    reads back at the park.  No park carrying `ExplicitValueRefused` is the park such a `:`
    landed on — which is what lets 12.3.4.3 close the wrapper's `inr` branch. -/
lemma ExplicitValueRefused.not_of_classA {sc s_prep : ScannerState} {c : Char}
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h_live : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).explicitKeyLine ≠ none) :
    ¬ ExplicitValueRefused sc :=
  fun h_ek => h_live (ekl_disp_none_of_park_none h_preprocess h_ek)

/-- **Lane (b)'s transport: the alternative survives a CONTENT step** (item 313).  A park at `sc`
    whose register is dead hands the park the content dispatch builds a dead register: preprocessing
    writes neither register field (`ekl_disp_none_of_park_none`), and the content dispatch — a scalar, a quoted
    scalar, a property, an alias, a block scalar — writes none either
    (`dispatchContent_preserves_explicitKeyLine`).  The fourteen leaves of
    `accum_content_pending` and the one of `accum_content_on_pendingMapValue_indented` that relay a
    park's pack or stack into the park the step builds are this lemma's spends. -/
lemma ExplicitValueRefused.step_content {sc s_prep s' : ScannerState} {c : Char}
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h_dispatch : scanNextToken_dispatchContent (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep) c = .ok s')
    (h : ExplicitValueRefused sc) : ExplicitValueRefused s' :=
  (ExplicitKeyCoupling.dispatchContent_preserves_explicitKeyLine _ _ _ h_dispatch).trans
    (ekl_disp_none_of_park_none h_preprocess h)

/-- The same step on the named alternative.  `trivial` while `PackAlt` is `True`; the census's
    residue mode substitutes the proof promised after `-- refused:` (`scripts/pack_flip_census.py`),
    and the final flip makes that proof the body. -/
lemma PackAlt.step_content {sc s_prep s' : ScannerState} {c : Char}
    (_h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (_h_dispatch : scanNextToken_dispatchContent (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep) c = .ok s')
    (_h : PackAlt sc) : PackAlt s' :=
  trivial  -- refused: ExplicitValueRefused.step_content _h_preprocess _h_dispatch _h

/-- **The same transport from the LANDING's own state** (item 314): a resuming context states the
    alternative at `s_prep`, the preprocessed state, and the content dispatch carries it to `s'` —
    the directive normalization writes no register field. -/
lemma ExplicitValueRefused.step_dispatch {s_prep s' : ScannerState} {c : Char}
    (h_dispatch : scanNextToken_dispatchContent (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep) c = .ok s')
    (h : ExplicitValueRefused s_prep) : ExplicitValueRefused s' := by
  refine (ExplicitKeyCoupling.dispatchContent_preserves_explicitKeyLine _ _ _ h_dispatch).trans ?_
  split <;> exact h

/-- The dispatch-only step on the named alternative (`trivial` while `PackAlt` is `True`, its
    proof promised after `-- refused:`). -/
lemma PackAlt.step_dispatch {s_prep s' : ScannerState} {c : Char}
    (_h_dispatch : scanNextToken_dispatchContent (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep) c = .ok s')
    (_h : PackAlt s_prep) : PackAlt s' :=
  trivial  -- refused: ExplicitValueRefused.step_dispatch _h_dispatch _h

/-- **The preprocess step alone** (item 324): a resuming context (`ResumeKeyCtx`) states the
    alternative at `s_prep`, the preprocessed state, and the landing lemma holds the park's — the
    skip chain, the unwind and the save write no register field. -/
lemma ExplicitValueRefused.step_preprocess {sc s_prep : ScannerState} {c : Char}
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h : ExplicitValueRefused sc) : ExplicitValueRefused s_prep :=
  ExplicitKeyCoupling.preprocess_explicitKeyLine_none sc s_prep c h_preprocess h

/-- The preprocess step on the named alternative (`trivial` while `PackAlt` is `True`, its proof
    promised after `-- refused:`). -/
lemma PackAlt.step_preprocess {sc s_prep : ScannerState} {c : Char}
    (_h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (_h : PackAlt sc) : PackAlt s_prep :=
  trivial  -- refused: ExplicitValueRefused.step_preprocess _h_preprocess _h

/-- The indicator dispatch's own `!inFlow` guard, run back to the flag: shared
    by both floors (items 27/28), which each need the post-update state's
    `needIndentCheck` and can only observe `inFlow` on it. -/
lemma nic_false_of_indicator_noflow {sc s_prep : ScannerState} {c : Char}
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h_noflow : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).inFlow = false) :
    (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).needIndentCheck = false := by
  have h_nicd : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).needIndentCheck = s_prep.needIndentCheck := by split <;> rfl
  rw [h_nicd]
  exact nic_false_of_flow_disp h_preprocess h_noflow

/-- **The dash's floor is unconditional** (item 73).

    The `?` and the `:` can push at a column that is not their own — the `?`
    inside a flow collection, the `:` when it resolves an inherited key (item
    74 narrowed both to that, and each states its own premise below).  The `-`
    never does: `[183]`'s `pushSequenceIndent` goes to the indicator's own
    column, which IS the entry index the accumulator reads off the landing.
    Every `pendingBlock` comes off a `-` scan, so that constructor's floor
    field carries no `∨ True` — the escape it used to fund was never funded by
    this indicator. -/
lemma indicator_floor_dash_at_col {sc s_prep s' : ScannerState} {sp_prep : SurfPos}
    {k : Nat}
    (hcol_prep : sp_prep.col = k)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, '-')))
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) '-' = .ok (some s')) :
    IndentFloor s' (k + 1) := by
  have h_col : (((if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).col : Int)) = (k : Int) := by
    have h2 : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).col = s_prep.col := by split <;> rfl
    rw [h2, ← hcorr_prep.col_eq, hcol_prep]
  have h_nic_of_noflow := nic_false_of_indicator_noflow (c := '-') h_preprocess
  obtain ⟨h_noflow, _⟩ := dispatchBlockIndicators_dash_scan h_dispatch
  obtain ⟨h_le, h_nic⟩ := dash_floor h_dispatch
  -- Item 179: the push is AT the indicator's column, so the floor holds one
  -- above it — the index the entry's awaited node now reads at.
  exact ⟨by rw [h_nic]; exact h_nic_of_noflow h_noflow,
         succ_le_minContentIndentOf_of_int_le (by omega)⟩

/-- The landing form of the dash floor: a zero landing plus `[63]`'s width IS
    the dispatch's column. -/
lemma indicator_floor_dash {sc s_prep s' : ScannerState} {sp_land sp_prep : SurfPos}
    {k : Nat}
    (hcol_land : sp_land.col = 0)
    (h_ind : SIndent k sp_land sp_prep)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, '-')))
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) '-' = .ok (some s')) :
    IndentFloor s' (k + 1) :=
  indicator_floor_dash_at_col
    (by have := SIndent_col h_ind; rw [hcol_land] at this; omega)
    hcorr_prep h_preprocess h_dispatch

/-! #### The dash's TOP, and the two places a landing's floor comes from
     (item 205)

    Item 204 proved the compact deferral false from ONE missing number, the
    stack's top at an entry park (`sc.currentIndent ≤ n`), and priced the
    carrier at the producers of the field that would hold it.  These four
    lemmas are that carrier's payment chain, measured by paying it: every
    `pendingBlock` producer in this file discharges the top from them and
    nothing else.  What they do NOT supply is the chain's own premise — the
    dispatch state's floor — and the price of THAT is item 205's subject. -/

/-- **The dash's TOP** (item 205) — `indicator_floor_dash_at_col`'s twin on the
    other side of the same number.

    The floor says the entry's node reads at or right of `k + 1`; this says the
    stack the entry pushed onto stops AT `k`.  `[183]`'s push is conditional
    (`col > currentIndent`), so the push branch gives the bound outright and the
    NO-push branch gives it only from a dispatch state already floored — which
    is the premise, and the whole cost of this reading. -/
lemma indicator_top_dash_at_col {s_prep s' : ScannerState} {sp_prep : SurfPos}
    {k : Nat}
    (hcol_prep : sp_prep.col = k)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (h_fl : s_prep.currentIndent ≤ (s_prep.col : Int))
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) '-' = .ok (some s')) :
    s'.currentIndent ≤ (k : Int) := by
  have h_upd_ind : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).indents = s_prep.indents := by split <;> rfl
  have h_upd_col : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).col = s_prep.col := by split <;> rfl
  have h_col : s_prep.col = k := by rw [← hcorr_prep.col_eq, hcol_prep]
  obtain ⟨h_noflow, h_scan⟩ := dispatchBlockIndicators_dash_scan h_dispatch
  have h_fl_disp : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).currentIndent ≤ ((if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).col : Int) := by
    rw [currentIndent_of_indents_eq h_upd_ind, h_upd_col]; exact h_fl
  have := IndentStackCover.scanBlockEntry_top_le h_noflow h_scan h_fl_disp
  rw [h_upd_col, h_col] at this
  exact this

/-- **The landed dash's TOP**, `indicator_floor_dash`'s twin (item 205): a zero
    landing plus `[63]`'s width IS the dispatch's column, here as there. -/
lemma indicator_top_dash {s_prep s' : ScannerState} {sp_land sp_prep : SurfPos}
    {k : Nat}
    (hcol_land : sp_land.col = 0)
    (h_ind : SIndent k sp_land sp_prep)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (h_fl : s_prep.currentIndent ≤ (s_prep.col : Int))
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) '-' = .ok (some s')) :
    s'.currentIndent ≤ (k : Int) :=
  indicator_top_dash_at_col
    (by have := SIndent_col h_ind; rw [hcol_land] at this; omega)
    hcorr_prep h_fl h_dispatch

/-- **The `?`/`:` opener's TOP** (item 209) — `indicator_top_dash_at_col`'s twin
    on `[187]`'s and `[196]`'s openers, and what `pendingMapValue.h_vslot` now
    carries beside the slot it names.

    `[183]`'s push goes to the `-`'s own column and `[187]`'s to the `?`'s;
    `[196]`'s goes to the KEY's, which is the same column exactly when the save
    preprocessing left is FRESH.  That is `landing_or_park_save`'s conclusion,
    which every consumer in this file already pays for the floor — so the two
    indicators are one lemma and the `∨` the caller already holds picks the arm.
    The explicit `:` pushes nothing at all and the bound passes through. -/
lemma indicator_top_kv_at_col {s_prep s' : ScannerState} {sp_prep : SurfPos}
    {k : Nat} {c : Char}
    (hc : c = ':' ∨ c = '?')
    (hcol_prep : sp_prep.col = k)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (h_save : s_prep.simpleKey.pos.col = s_prep.col)
    (h_noflow : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).inFlow = false)
    (h_fl : s_prep.currentIndent ≤ (s_prep.col : Int))
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) c = .ok (some s')) :
    s'.currentIndent ≤ (k : Int) := by
  have h_upd_ind : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).indents = s_prep.indents := by split <;> rfl
  have h_upd_col : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).col = s_prep.col := by split <;> rfl
  have h_upd_sk : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).simpleKey = s_prep.simpleKey := by split <;> rfl
  have h_col : s_prep.col = k := by rw [← hcorr_prep.col_eq, hcol_prep]
  have h_fl_disp : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).currentIndent ≤ ((if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).col : Int) := by
    rw [currentIndent_of_indents_eq h_upd_ind, h_upd_col]; exact h_fl
  rcases hc with rfl | rfl
  · have key := IndentStackCover.scanValue_top_le
      (dispatchBlockIndicators_value_scan h_dispatch)
      (fun _ => by rw [h_upd_sk, h_upd_col]; exact h_save) h_fl_disp
    rw [h_upd_col, h_col] at key
    exact key
  · have key := IndentStackCover.scanKey_top_le h_noflow
      (dispatchBlockIndicators_key_scan h_dispatch) h_fl_disp
    rw [h_upd_col, h_col] at key
    exact key


/-- **The dispatch's floor, from the LANDING or from the PARK** (item 205).

    `IndentStackCover.preprocess_top_le_col`'s right disjunct is not "the unwind
    popped nothing"; it is "the unwind never ran", and then the stack the
    dispatch reads IS the park's.  So the two disjuncts split by who pays: the
    landing pays where its walk crossed a break, and the park pays where it did
    not — at a column preprocessing can only have moved RIGHT of without one. -/
lemma dash_dispatch_floor {sc s_prep : ScannerState} {c : Char}
    (h_base : IndentStackBase.SentinelBase sc)
    (h_ptop : sc.currentIndent ≤ (s_prep.col : Int))
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c))) :
    s_prep.currentIndent ≤ (s_prep.col : Int) := by
  rcases IndentStackCover.preprocess_top_le_col h_preprocess h_base with h | h_ids
  · exact h
  · rw [currentIndent_of_indents_eq h_ids]; exact h_ptop

/-- **The floor at a park already AT column 0** (item 205) — item 154's
    reading, lifted out of the content landing so the BLOCK landings can spend
    it too.

    `landing_floor_of_arm` reads the floor off the walk that carried a park DOWN
    to a line start, and a park already at one crosses no such walk.  The floor
    is preprocessing's UNWIND, the unwind runs on `needIndentCheck`, and a park
    that reached column 0 consumed the break that arms it — so the flag is the
    park's to state and the unwind is the landing's to run.  The sentinel
    disjunct is closed by the base, as everywhere else. -/
lemma park_col0_floor {sc s_prep : ScannerState} {c : Char}
    (h_scflow : sc.inFlow = false)
    (h_armed : sc.needIndentCheck = true)
    (h_base : IndentStackBase.SentinelBase sc)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c))) :
    s_prep.currentIndent ≤ (s_prep.col : Int) := by
  obtain ⟨_, s_skip, hsk, _, _⟩ := preprocess_save_elim h_preprocess
  rcases IndentStackCover.preprocess_top_le_col_of_armed hsk
      (by unfold ScannerState.inFlow at h_scflow ⊢
          rw [ScannerCorrectness.skipToContent_preserves_flowLevel sc s_skip hsk]
          exact h_scflow)
      (skipToContentLoop_needIndentCheck_mono sc s_skip _ hsk h_armed)
      h_preprocess with h | h
  · exact h
  · rw [(IndentStackBase.preprocess_base h_preprocess h_base).currentIndent_of_size_le_one h]
    omega

/-- **The block landing's floor, from EITHER source** (item 205) — the walk's
    unwind where the park stood off a line start, the park's own armed flag
    where it stood on one.  The two arms are exhaustive by the park's column,
    which is why the `-`'s top costs a landing consumer one reading rather than
    a case split.

    The SECOND premise is the one nothing supplies: `landing_floor_of_arm`'s
    half is free at every block landing, and `h_nic0`'s half is a field only
    `pendingContent` carries (item 154) — and carries as an OPTION. -/
lemma dash_landing_floor {sc s_prep : ScannerState} {sp_scan : SurfPos} {c : Char}
    (h_noflow : s_prep.inFlow = false)
    (h_larm : sp_scan.col ≠ 0 → s_prep.inFlow = false →
      s_prep.simpleKey.possible = true ∧ s_prep.simpleKey.pos.col = s_prep.col ∧
      s_prep.simpleKeyAllowed = true ∧
      (s_prep.currentIndent ≤ (s_prep.col : Int) ∨ s_prep.indents.size ≤ 1))
    (h_nic0 : sp_scan.col = 0 → sc.needIndentCheck = true)
    (h_base : IndentStackBase.SentinelBase sc)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c))) :
    s_prep.currentIndent ≤ (s_prep.col : Int) := by
  by_cases hc0 : sp_scan.col = 0
  · refine park_col0_floor ?_ (h_nic0 hc0) h_base h_preprocess
    unfold ScannerState.inFlow at h_noflow ⊢
    rw [← preprocess_preserves_flowLevel sc s_prep c h_preprocess]; exact h_noflow
  · exact landing_floor_of_arm h_noflow h_larm hc0 h_base h_preprocess

/-- **The `?`'s floor is a fact about the CONTEXT** (item 74).

    `[187]`'s `pushMappingIndent` goes to the `?`'s own column, which IS the
    entry index, and `key_floor_or`'s only undecided case is a `?` scanned
    inside a FLOW collection.  Every block-indicator producer in this file
    already holds `inFlow = false` at the dispatch state, so the `?` half never
    costs a caller anything. -/
lemma indicator_floor_question_at_col {sc s_prep s' : ScannerState} {sp_prep : SurfPos}
    {k : Nat}
    (hcol_prep : sp_prep.col = k)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (h_noflow : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).inFlow = false)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, '?')))
    (h_dispatch : scanNextToken_dispatchBlockIndicators (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep) '?' = .ok (some s')) :
    IndentFloor s' (k + 1) := by
  have h_col : (((if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).col : Int)) = (k : Int) := by
    have h2 : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).col = s_prep.col := by split <;> rfl
    rw [h2, ← hcorr_prep.col_eq, hcol_prep]
  have h_nic_of_noflow := nic_false_of_indicator_noflow (c := '?') h_preprocess
  rcases key_floor_or h_dispatch with ⟨_, h_le, h_nic⟩ | h_flow
  · exact ⟨by rw [h_nic]; exact h_nic_of_noflow h_noflow,
           succ_le_minContentIndentOf_of_int_le (by omega)⟩
  · rw [h_flow] at h_noflow; exact absurd h_noflow (by simp)

/-- **The `:`'s floor is a fact about the SAVE** (items 74/76).

    Two things made item 27's `:` arm optional, and neither is about the
    indicator.  The first is the SHAPE of the coupling `scanValuePrepare` needs:
    the push reads `simpleKey.pos.col` and nothing else, so a producer only has
    to place the save on the LINE — which is what `value_floor_or` asks for now.
    The second is whether preprocessing re-saved at all, and that is what this
    lemma's premise IS: the fresh save, however the caller came by it.

    There are two ways to come by it, and item 76 is the second.  A park that
    just scanned `-`/`?`/`:` has the flag up and hands it to the walk unchanged
    (`preprocess_saved_key_col`, the `h_sk` every one of them carries).  A park
    that carries no flag can still be OFF a line start, and then the column-0
    landing it reaches was reached across a break — which re-arms in block
    context, so the save is fresh for that input.

    Item 77 showed the two are exhaustive: a park at a line start with no flag
    has no inhabitant, because every content scan either re-arms (the block
    scalar) or ends on a character it consumed.  `landing_or_park_save` is the
    pair, and every call site of this lemma now measures. -/
lemma indicator_floor_colon_at_col_of_save {sc s_prep s' : ScannerState} {sp_prep : SurfPos}
    {k : Nat}
    (hcol_prep : sp_prep.col = k)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (h_noflow : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).inFlow = false)
    (h_pcol : s_prep.simpleKey.pos.col = s_prep.col)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, ':')))
    (h_dispatch : scanNextToken_dispatchBlockIndicators (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep) ':' = .ok (some s')) :
    IndentFloor s' (k + 1) := by
  have h_upd_col : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).col = s_prep.col := by split <;> rfl
  have h_upd_sk : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).simpleKey = s_prep.simpleKey := by split <;> rfl
  have h_col : (((if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).col : Int)) = (k : Int) := by
    rw [h_upd_col, ← hcorr_prep.col_eq, hcol_prep]
  have h_fresh : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).simpleKey.possible = true → (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).simpleKey.pos.col = (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).col := by
    intro _; rw [h_upd_sk, h_upd_col]; exact h_pcol
  have h_nic_of_noflow := nic_false_of_indicator_noflow (c := ':') h_preprocess
  rcases value_floor_or h_fresh h_dispatch with ⟨_, h_le, h_nic⟩ | h_flow
  · exact ⟨by rw [h_nic]; exact h_nic_of_noflow h_noflow,
           succ_le_minContentIndentOf_of_int_le (by omega)⟩
  · rw [h_flow] at h_noflow; exact absurd h_noflow (by simp)

/-- Item 74's form: the park's own armed flag funds the save.  Item 76 added the
    OTHER funder — a break in the walk — which is why the premise above is the
    save and not the flag. -/
lemma indicator_floor_colon_at_col {sc s_prep s' : ScannerState} {sp_prep : SurfPos}
    {k : Nat}
    (hcol_prep : sp_prep.col = k)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (h_noflow : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).inFlow = false)
    (h_sk : sc.simpleKeyAllowed = true)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, ':')))
    (h_dispatch : scanNextToken_dispatchBlockIndicators (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep) ':' = .ok (some s')) :
    IndentFloor s' (k + 1) := by
  have h_upd_fl : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).flowLevel = s_prep.flowLevel := by split <;> rfl
  have h_noflow_prep : s_prep.inFlow = false := by
    unfold ScannerState.inFlow at h_noflow ⊢
    rw [h_upd_fl] at h_noflow
    exact h_noflow
  exact indicator_floor_colon_at_col_of_save hcol_prep hcorr_prep h_noflow
    (preprocess_saved_key_col h_sk h_noflow_prep h_preprocess).2 h_preprocess h_dispatch

/-- **The implicit key's floor** (item 28).

    Item 27 measured `scanValuePrepare`'s push at the INDICATOR's column, which
    is the resolved key's only when the save was fresh — so `[189]`'s empty-key
    entry carried its index and item 15's `  a: |` handed `True` back.  This
    lemma measures the same push at the coordinate it actually uses: the entry
    index the pack read off the landing IS the column the key was saved at
    (`ImplicitKeyPack`'s last conjunct), and the push goes there.

    Nothing punts (item 81).  Item 79 made the pack's column an equation, item
    80 made the inherit a premise (every caller can answer the re-save
    question), and item 81 closed `[197]`'s explicit-key clear: its branch (2)
    needs a key from the `?`'s own earlier line, refuted by `h_kline`; its
    branch (1) needs a key saved AT the `:` itself, refuted by `h_behind` —
    which every caller reads off `KeysBehindCursor`, the scanner-wide fact
    that a saved key sits strictly behind the cursor. -/
lemma implicit_key_floor {sc s_prep s' : ScannerState} {k : Nat}
    (h_poss : sc.simpleKey.possible = true)
    (h_kcol : sc.simpleKey.pos.col = k)
    (h_inh : s_prep.simpleKey = sc.simpleKey)
    (h_kline : s_prep.simpleKey.pos.line = s_prep.line)
    (h_behind : s_prep.simpleKey.pos.offset ≠ s_prep.offset)
    (h_noflow : s_prep.inFlow = false)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, ':')))
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) ':' = .ok (some s')) :
    IndentFloor s' (k + 1) := by
  have h_sk : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).simpleKey = sc.simpleKey := by
    rw [allowDirectives_update_simpleKey]; exact h_inh
  have h_nic_of_noflow := nic_false_of_indicator_noflow (c := ':') h_preprocess
  have h_noflow_disp := noflow_disp_of_noflow h_noflow
  obtain ⟨h_le, h_nic⟩ := value_key_floor (k := k) h_noflow_disp
      (by rw [h_sk]; exact h_poss)
      (by split <;> exact h_kline)
      (by split <;> exact h_behind)
      (by rw [h_sk, h_kcol]; exact Int.le_refl _) h_dispatch
  -- Item 179: the push goes to the KEY's column, so the floor holds one above
  -- it — the shifted index the entry's value now reads at.
  exact ⟨by rw [h_nic]; exact h_nic_of_noflow h_noflow_disp,
         succ_le_minContentIndentOf_of_int_le h_le⟩

/-- The block dispatch's `:` branch IS `scanValue` (item 48's extraction). -/
lemma dispatchBlock_colon_scanValue {s s' : ScannerState}
    (h : scanNextToken_dispatchBlockIndicators s ':' = .ok (some s')) :
    scanValue s = .ok s' := by
  unfold scanNextToken_dispatchBlockIndicators at h
  simp only [Bind.bind, Except.bind, Pure.pure, Except.pure,
             show ((':' : Char) == '-') = false from by decide, Bool.false_and,
             show ((':' : Char) == '?') = false from by decide,
             show ((':' : Char) == ':') = true from by decide, Bool.true_and,
             Bool.false_eq_true, ite_false] at h
  split at h
  · split at h
    case h_1 => cases h
    case h_2 s1 hv =>
      have h2 := Except.ok.inj h
      injection h2 with h2
      subst h2
      exact hv
  · cases h

/-- **…and its `-` branch is `scanBlockEntry`** (item 204).  A `-` reaches no
    other branch of the dispatcher, so `.ok (some _)` forces the first one. -/
lemma dispatchBlock_dash_scanBlockEntry {s s' : ScannerState}
    (h : scanNextToken_dispatchBlockIndicators s '-' = .ok (some s')) :
    scanBlockEntry s = .ok s' := by
  unfold scanNextToken_dispatchBlockIndicators at h
  simp only [Bind.bind, Except.bind, Pure.pure, Except.pure,
             show (('-' : Char) == '-') = true from by decide, Bool.true_and,
             show (('-' : Char) == '?') = false from by decide, Bool.false_and,
             show (('-' : Char) == ':') = false from by decide,
             Bool.false_eq_true, ite_false] at h
  split at h
  · split at h
    case h_1 => cases h
    case h_2 s1 hv =>
      have h2 := Except.ok.inj h
      injection h2 with h2
      subst h2
      exact hv
  · cases h

/-- …and its `?` branch is `scanKey`. -/
lemma dispatchBlock_question_scanKey {s s' : ScannerState}
    (h : scanNextToken_dispatchBlockIndicators s '?' = .ok (some s')) :
    scanKey s = .ok s' := by
  unfold scanNextToken_dispatchBlockIndicators at h
  simp only [Bind.bind, Except.bind, Pure.pure, Except.pure,
             show (('?' : Char) == '-') = false from by decide, Bool.false_and,
             show (('?' : Char) == '?') = true from by decide, Bool.true_and,
             show (('?' : Char) == ':') = false from by decide,
             Bool.false_eq_true, ite_false] at h
  split at h
  · split at h
    case h_1 => cases h
    case h_2 s1 hk =>
      have h2 := Except.ok.inj h
      injection h2 with h2
      subst h2
      exact hk
  · cases h

/-- The three block indicators park before a separator (§8.2.1/§8.2.2 lookahead). -/
lemma dispatchBlock_colon_next {s s' : ScannerState} (h_noflow : s.inFlow = false)
    (hpk : s.peek? = some ':')
    (h : scanNextToken_dispatchBlockIndicators s ':' = .ok (some s')) : NextIsSep s' := by
  have hv := dispatchBlock_colon_scanValue h
  have hcand : isValueCandidate s = true := by
    unfold scanNextToken_dispatchBlockIndicators at h
    simp only [Bind.bind, Except.bind, Pure.pure, Except.pure,
               show ((':' : Char) == '-') = false from by decide, Bool.false_and,
               show ((':' : Char) == '?') = false from by decide,
               show ((':' : Char) == ':') = true from by decide, Bool.true_and,
               Bool.false_eq_true, ite_false] at h
    split at h
    · assumption
    · cases h
  exact nextIsSep_of_scanValue h_noflow hpk hcand hv

lemma dispatchBlock_question_next {s s' : ScannerState} (h_noflow : s.inFlow = false)
    (hpk : s.peek? = some '?')
    (h : scanNextToken_dispatchBlockIndicators s '?' = .ok (some s')) : NextIsSep s' := by
  have hv := dispatchBlock_question_scanKey h
  have hcand : isKeyCandidate s = true := by
    unfold scanNextToken_dispatchBlockIndicators at h
    simp only [Bind.bind, Except.bind, Pure.pure, Except.pure,
               show (('?' : Char) == '-') = false from by decide, Bool.false_and,
               show (('?' : Char) == '?') = true from by decide, Bool.true_and,
               Bool.false_eq_true, ite_false] at h
    split at h
    · rename_i hc; simp only [Bool.and_eq_true] at hc; exact hc.1.1
    · cases h
  exact nextIsSep_of_scanKey h_noflow hpk hcand hv

lemma dispatchBlock_dash_next {s s' : ScannerState} (h_noflow : s.inFlow = false)
    (hpk : s.peek? = some '-')
    (h : scanNextToken_dispatchBlockIndicators s '-' = .ok (some s')) : NextIsSep s' := by
  have hv := dispatchBlock_dash_scanBlockEntry h
  have hcand : isBlockEntryCandidate s = true := by
    unfold scanNextToken_dispatchBlockIndicators at h
    simp only [Bind.bind, Except.bind, Pure.pure, Except.pure,
               show (('-' : Char) == '-') = true from by decide, Bool.true_and,
               h_noflow, Bool.not_false, Bool.false_eq_true, ite_false] at h
    split at h
    · assumption
    · cases h
  exact nextIsSep_of_scanBlockEntry h_noflow hpk hcand hv

lemma dispatchBlock_dash_offerPred {s s' : ScannerState}
    (h : scanNextToken_dispatchBlockIndicators s '-' = .ok (some s')) : OfferPred s'.tokens :=
  scanBlockEntry_offerPred (dispatchBlock_dash_scanBlockEntry h)

lemma dispatchBlock_colon_offerPred {s s' : ScannerState}
    (h : scanNextToken_dispatchBlockIndicators s ':' = .ok (some s')) : OfferPred s'.tokens :=
  scanValue_offerPred (dispatchBlock_colon_scanValue h)

lemma dispatchBlock_question_offerPred {s s' : ScannerState}
    (h : scanNextToken_dispatchBlockIndicators s '?' = .ok (some s')) : OfferPred s'.tokens :=
  scanKey_offerPred (dispatchBlock_question_scanKey h)

lemma dispatchBlock_colon_or_question_offerPred {s s' : ScannerState} {c : Char}
    (hc : c = ':' ∨ c = '?')
    (h : scanNextToken_dispatchBlockIndicators s c = .ok (some s')) : OfferPred s'.tokens := by
  rcases hc with rfl | rfl
  · exact dispatchBlock_colon_offerPred h
  · exact dispatchBlock_question_offerPred h

/-- **The block lane's `-` transport** (item 318; item 316's probe 863 without its invariant,
    which item 317 made unnecessary): a block entry writes no register field
    (`scanBlockEntry_preserves_explicitKey`), so a park whose register is dead hands the park
    the `-` builds a dead register.  The dash arms of the six block-lane lemmas are this
    lemma's spends. -/
lemma ExplicitValueRefused.step_blockEntry {sc s_prep s' : ScannerState}
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, '-')))
    (h_dispatch : scanNextToken_dispatchBlockIndicators (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep) '-' = .ok (some s'))
    (h : ExplicitValueRefused sc) : ExplicitValueRefused s' :=
  (ExplicitKeyCoupling.scanBlockEntry_preserves_explicitKey
    (dispatchBlock_dash_scanBlockEntry h_dispatch)).1.trans (ekl_disp_none_of_park_none h_preprocess h)

/-- The `-` step on the named alternative (`trivial` while `PackAlt` is `True`, its proof promised
    after `-- refused:`). -/
lemma PackAlt.step_blockEntry {sc s_prep s' : ScannerState}
    (_h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, '-')))
    (_h_dispatch : scanNextToken_dispatchBlockIndicators (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep) '-' = .ok (some s'))
    (_h : PackAlt sc) : PackAlt s' :=
  trivial  -- refused: ExplicitValueRefused.step_blockEntry _h_preprocess _h_dispatch _h

/-- **The block lane's `:` transport** (item 318): in block context a dead register stays dead
    through `scanValue` (`scanValue_ok_of_ekl_none`) — the register a class-A value would need is
    the one this predicate denies, so a block `:` landing on a refused park opens an implicit
    entry and the park it builds is refused too. -/
lemma ExplicitValueRefused.step_value {sc s_prep s' : ScannerState}
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, ':')))
    (h_dispatch : scanNextToken_dispatchBlockIndicators (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep) ':' = .ok (some s'))
    (h_noflow : s_prep.inFlow = false)
    (h : ExplicitValueRefused sc) : ExplicitValueRefused s' :=
  (ExplicitKeyCoupling.scanValue_ok_of_ekl_none (dispatchBlock_colon_scanValue h_dispatch)
    (noflow_disp_of_noflow h_noflow)
    (by have := preprocess_some_peek h_preprocess; split <;> exact this)
    (ekl_disp_none_of_park_none h_preprocess h)).2

/-- The `:` step on the named alternative (`trivial` while `PackAlt` is `True`, its proof promised
    after `-- refused:`). -/
lemma PackAlt.step_value {sc s_prep s' : ScannerState}
    (_h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, ':')))
    (_h_dispatch : scanNextToken_dispatchBlockIndicators (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep) ':' = .ok (some s'))
    (_h_noflow : s_prep.inFlow = false)
    (_h : PackAlt sc) : PackAlt s' :=
  trivial  -- refused: ExplicitValueRefused.step_value _h_preprocess _h_dispatch _h_noflow _h

/-- The `?` step's park-side facts (item 48): the `.key` push ends the array
    real and the flag rides through — `implicitValueLine` is not stamped
    (`[192]`'s explicit entry admits a compact collection on the line). -/
lemma scanKey_ok_park_facts {s s' : ScannerState}
    (h : scanKey s = .ok s') (h_nic : s.needIndentCheck = false) :
    s'.needIndentCheck = false ∧ LastTokenReal s'.tokens := by
  unfold scanKey at h
  simp only [bind, Except.bind] at h
  split at h
  · -- block context: `scanKeyValidate` (item 131), push, tab-peek check
    split at h
    · simp at h
    · split at h
      · split at h
        · simp at h
        · have h' := Except.ok.inj h; subst h'
          refine ⟨?_, ?_⟩
          · show ((pushMappingIndent s ↑s.col).emit .key).advance.needIndentCheck = false
            rw [advance_preserves_needIndentCheck]
            show (pushMappingIndent s ↑s.col).needIndentCheck = false
            unfold pushMappingIndent
            split <;> exact h_nic
          · show LastTokenReal ((pushMappingIndent s ↑s.col).emit .key).advance.tokens
            rw [ScannerCorrectness.advance_preserves_tokens]
            exact lastTokenReal_push (by simp)
      · have h' := Except.ok.inj h; subst h'
        refine ⟨?_, ?_⟩
        · show ((pushMappingIndent s ↑s.col).emit .key).advance.needIndentCheck = false
          rw [advance_preserves_needIndentCheck]
          show (pushMappingIndent s ↑s.col).needIndentCheck = false
          unfold pushMappingIndent
          split <;> exact h_nic
        · show LastTokenReal ((pushMappingIndent s ↑s.col).emit .key).advance.tokens
          rw [ScannerCorrectness.advance_preserves_tokens]
          exact lastTokenReal_push (by simp)
  · -- flow context: emit + advance only
    split at h
    · split at h
      · simp at h
      · have h' := Except.ok.inj h; subst h'
        refine ⟨?_, ?_⟩
        · show (s.emit .key).advance.needIndentCheck = false
          rw [advance_preserves_needIndentCheck]
          exact h_nic
        · show LastTokenReal (s.emit .key).advance.tokens
          rw [ScannerCorrectness.advance_preserves_tokens]
          exact lastTokenReal_push (by simp)
    · have h' := Except.ok.inj h; subst h'
      refine ⟨?_, ?_⟩
      · show (s.emit .key).advance.needIndentCheck = false
        rw [advance_preserves_needIndentCheck]
        exact h_nic
      · show LastTokenReal (s.emit .key).advance.tokens
        rw [ScannerCorrectness.advance_preserves_tokens]
        exact lastTokenReal_push (by simp)

/-! ### Item 48 — the same-line check refutes three block-dispatch parks

`scanBlockEntry`/`scanKey` throw `sameLineBlockCollection` and
`scanValueValidate` throws `nestedMappingOnLine`/`contentOnDocumentStartLine`
when the dispatch state still carries an implicit `:`, a property run, or a
`---` on the current line.  A park that RECORDS one of those facts therefore
contradicts the block dispatch's own success on the no-break step — the same
shape item 47 gave the content dispatch, at the three reads the new checks
make. -/

/-- A nonempty trailing property run puts a property token at `lastRealToken?`
    on `line` — the read `scanBlockEntry`/`scanKey`'s check makes. -/
lemma lastTokenIsNodePropertyOnLine_of_run_any {ts : Array (Positioned YamlToken)}
    {line : Nat} {f : YamlToken → Bool}
    (h : (trailingPropertyRunOnLine ts line).any f = true) :
    lastTokenIsNodePropertyOnLine ts line = true := by
  unfold trailingPropertyRunOnLine at h
  unfold lastTokenIsNodePropertyOnLine
  split at h
  case h_1 t1 heq =>
    split at h
    case isTrue hc => exact hc
    case isFalse hc => simp at h
  case h_2 => simp at h

/-- `scanBlockEntry`'s success says all three same-line facts are down. -/
lemma scanBlockEntry_ok_sameLine_false {s s' : ScannerState}
    (h : scanBlockEntry s = .ok s') (h_noflow : s.inFlow = false) :
    (s.implicitValueLine == some s.line
      || lastTokenIsNodePropertyOnLine s.tokens s.line
      || s.markerOnLine) = false := by
  unfold scanBlockEntry at h
  simp only [bind, Except.bind] at h
  rw [ite_eq_left (show (!s.inFlow) = true by rw [h_noflow]; rfl)] at h
  split at h
  · simp at h
  · split at h
    case isTrue hc => simp at h
    case isFalse hc => exact Bool.eq_false_iff.mpr hc

/-- `scanKey`'s success says the same. -/
lemma scanKey_ok_sameLine_false {s s' : ScannerState}
    (h : scanKey s = .ok s') (h_noflow : s.inFlow = false) :
    (s.implicitValueLine == some s.line
      || lastTokenIsNodePropertyOnLine s.tokens s.line
      || s.markerOnLine) = false := by
  unfold scanKey scanKeyValidate at h
  simp only [bind, Except.bind] at h
  rw [ite_eq_left (show (!s.inFlow) = true by rw [h_noflow]; rfl)] at h
  split at h
  · simp at h
  · -- The `.ok` arm's own equation: `scanKeyValidate` returned `()`, so none of
    -- its three checks fired, the same-line one included.
    rename_i heq
    split at heq
    · exact absurd heq (by simp)
    · split at heq
      case isTrue hc => exact absurd heq (by simp)
      case isFalse hc => exact Bool.eq_false_iff.mpr hc

/-- `scanValueValidate`'s success says the `:`'s two same-line facts are down
    (the property run stays legal there — `&a : b` is `[154]`'s anchored empty
    key). -/
lemma scanValueValidate_ok_sameLine_false {s : ScannerState}
    (h : scanValueValidate s = .ok ()) (h_noflow : s.inFlow = false) :
    (s.implicitValueLine == some s.line) = false ∧
      s.markerOnLine = false := by
  unfold scanValueValidate at h
  simp only [Bind.bind, Except.bind, Pure.pure, Except.pure, throw, throwThe,
             MonadExceptOf.throw] at h
  repeat' (split at h)
  all_goals try (cases h)
  all_goals
    constructor <;>
      · apply Bool.eq_false_iff.mpr
        intro hx
        simp_all
        repeat' (split at h)
        all_goals cases h

/-- `scanValueClearKey` changes only the explicit-key fields. -/
lemma scanValueClearKey_sameLine_reads (s : ScannerState) :
    (scanValueClearKey s).implicitValueLine = s.implicitValueLine ∧
    (scanValueClearKey s).line = s.line ∧
    (scanValueClearKey s).tokens = s.tokens ∧
    (scanValueClearKey s).inFlow = s.inFlow ∧
    (scanValueClearKey s).docStartLine = s.docStartLine := by
  unfold scanValueClearKey
  repeat' split
  all_goals exact ⟨rfl, rfl, rfl, rfl, rfl⟩

/-- `scanValue`'s success propagates the validate stage's refusals. -/
lemma scanValue_ok_sameLine_false {s s' : ScannerState}
    (h : scanValue s = .ok s') (h_noflow : s.inFlow = false) :
    (s.implicitValueLine == some s.line) = false ∧
      s.markerOnLine = false := by
  unfold scanValue at h
  simp only [bind, Except.bind] at h
  split at h
  case h_1 => cases h
  case h_2 u hval =>
    obtain ⟨h_ivl, h_ln, _h_tok, h_fl, h_dsl⟩ := scanValueClearKey_sameLine_reads s
    have := scanValueValidate_ok_sameLine_false (s := scanValueClearKey s)
      (by cases u; exact hval) (h_fl.trans h_noflow)
    unfold ScannerState.markerOnLine at this ⊢
    rw [h_ivl, h_ln, h_dsl] at this
    exact this

/-- The block dispatch's success, per character: whichever of the three
    scanners ran, its same-line refusals were down at the dispatch state. -/
lemma dispatchBlock_ok_sameLine_false {s s' : ScannerState} {c : Char}
    (h : scanNextToken_dispatchBlockIndicators s c = .ok (some s'))
    (h_noflow : s.inFlow = false) :
    (s.implicitValueLine == some s.line) = false ∧
      s.markerOnLine = false ∧
      (c ≠ ':' → lastTokenIsNodePropertyOnLine s.tokens s.line = false) := by
  unfold scanNextToken_dispatchBlockIndicators at h
  simp only [Bind.bind, Except.bind, Pure.pure, Except.pure] at h
  split at h
  · -- '-' branch: scanBlockEntry ran
    split at h
    case h_1 => cases h
    case h_2 s1 hbe =>
      have h3 := scanBlockEntry_ok_sameLine_false hbe h_noflow
      simp only [Bool.or_eq_false_iff] at h3
      exact ⟨h3.1.1, h3.2, fun _ => h3.1.2⟩
  · split at h
    · -- '?' branch: scanKey ran
      split at h
      case h_1 => cases h
      case h_2 s1 hk =>
        have h3 := scanKey_ok_sameLine_false hk h_noflow
        simp only [Bool.or_eq_false_iff] at h3
        exact ⟨h3.1.1, h3.2, fun _ => h3.1.2⟩
    · split at h
      · -- ':' branch: scanValue ran
        rename_i hc_colon
        split at h
        case h_1 => cases h
        case h_2 s1 hv =>
          have h2 := scanValue_ok_sameLine_false hv h_noflow
          refine ⟨h2.1, h2.2, fun hne => ?_⟩
          exact absurd (beq_iff_eq.mp (Bool.and_eq_true_iff.mp hc_colon).1) hne
      · cases h

/-- **…and a park that recorded one of the three facts refutes it** (item 48).
    The no-break payload carries the last-real reading, the line,
    `implicitValueLine` and (item 299) `docStartLine` to the dispatch state;
    whichever fact the pending holds, the check's read is then TRUE there —
    and the dispatch's success says it was false.  **Item 299: the marker
    fact is the field** `sc.docStartLine = some sc.line`, which the `---` park
    carries (`pendingDocStart.h_docline`) and a content park can carry past
    the marker; the last-real token form it replaces could not. -/
lemma dispatch_refutes_sameLine {sc s_prep s' : ScannerState} {c : Char}
    (h_nic : sc.needIndentCheck = false)
    (h_real : LastTokenReal sc.tokens)
    (h_fact :
      sc.implicitValueLine = some sc.line ∨
      sc.docStartLine = some sc.line ∨
      (lastTokenIsNodePropertyOnLine sc.tokens sc.line = true ∧ c ≠ ':'))
    (h_ivl_eq : s_prep.implicitValueLine = sc.implicitValueLine)
    (h_dsl_eq : s_prep.docStartLine = sc.docStartLine)
    (h_noflow : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).inFlow = false)
    (h_pay : sc.needIndentCheck = false → LastTokenReal sc.tokens →
      s_prep.line = sc.line ∧ s_prep.needIndentCheck = false ∧
      lastRealToken? s_prep.tokens = lastRealToken? sc.tokens ∧
      penultRealToken? s_prep.tokens = penultRealToken? sc.tokens)
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) c = .ok (some s')) : False := by
  obtain ⟨h_line_eq, -, h_tok_eq, -⟩ := h_pay h_nic h_real
  -- Generalize the dispatch state: the `allowDirectives` update touches
  -- neither the three reads nor `inFlow`, and an atomic state lets the
  -- rewrites land on plain projections.
  have hmain : ∀ sd : ScannerState, sd.tokens = s_prep.tokens →
      sd.line = s_prep.line → sd.implicitValueLine = s_prep.implicitValueLine →
      sd.docStartLine = s_prep.docStartLine →
      sd.inFlow = false →
      scanNextToken_dispatchBlockIndicators sd c = .ok (some s') → False := by
    intro sd hdt hdl hdi hdsl hdf hdd
    obtain ⟨hF_ivl, hF_doc, hF_prop⟩ := dispatchBlock_ok_sameLine_false hdd hdf
    rcases h_fact with h_ivl | h_doc | ⟨h_prop, hc⟩
    · -- implicit `:` on the line
      rw [hdi, h_ivl_eq, h_ivl, hdl, h_line_eq] at hF_ivl
      simp at hF_ivl
    · -- `---` on the line: the field (item 299)
      have hT : sd.markerOnLine = true := by
        unfold ScannerState.markerOnLine
        rw [hdsl, h_dsl_eq, h_doc, hdl, h_line_eq]
        simp
      rw [hF_doc] at hT
      cases hT
    · -- property run on the line
      have hT : lastTokenIsNodePropertyOnLine sd.tokens sd.line = true := by
        rw [hdt, hdl, h_line_eq]
        unfold lastTokenIsNodePropertyOnLine at h_prop ⊢
        rw [h_tok_eq]
        exact h_prop
      rw [hF_prop hc] at hT
      cases hT
  exact hmain _ (by split <;> rfl) (by split <;> rfl) (by split <;> rfl) (by split <;> rfl)
    h_noflow h_dispatch

/-! ### Item 104 — the key from an EARLIER line is not this `:`'s key

`[154] ns-s-implicit-yaml-key` is one line, and §7.4 is where the scanner says
so: `scanValueValidate`'s first check throws `invalidImplicitKey` when the `:`
resolves a key saved on a different line.  A park whose saved key is STALE — a
flow collection closed across a break, a folded plain or quoted scalar — is
therefore an input the scanner refuses, and the four lemmas below are that
refusal read backwards, in the shape `dispatch_refutes_sameLine` reads item
48's.

The one shape §7.4 does not decide is the one it hands on to §8.2.2 `[197]`: an
explicit-key frame open on the stale key's own line makes `scanValueClearKey`
take the key down, and the misindent check decides the `:` instead.  So the
lift's conclusion is a DISJUNCTION — the key is this line's, or the `?` frame
is open on the key's line and the `:` stands at the mapping indent — and the
second disjunct is what keeps the deferral. -/

/-- §7.4's own check, read backwards: a `:` the scanner accepted with a live
    saved key resolves a key on its OWN line. -/
lemma scanValueValidate_ok_keyLine {s : ScannerState}
    (h : scanValueValidate s = .ok ())
    (h_noflow : s.inFlow = false)
    (h_poss : s.simpleKey.possible = true) :
    s.simpleKey.pos.line = s.line := by
  unfold scanValueValidate at h
  simp only [Bind.bind, Except.bind, Pure.pure, Except.pure, throw, throwThe,
             MonadExceptOf.throw] at h
  by_cases hne : s.simpleKey.pos.line = s.line
  · exact hne
  · exfalso
    have hcond : (s.simpleKey.possible && !s.inFlow && s.simpleKey.pos.line != s.line) = true := by
      simp [h_poss, h_noflow, hne]
    rw [ite_eq_left hcond] at h
    exact absurd h (by simp)

/-- §8.2.2 `[197]`'s own check, read the same way: with the key already down
    and the `?` frame open on an earlier line, an accepted `:` stands at the
    mapping's indent — `s-indent(n)` is exact. -/
lemma scanValueValidate_ok_explicit_col {s : ScannerState} {ek : Nat}
    (h : scanValueValidate s = .ok ())
    (h_noflow : s.inFlow = false)
    (h_poss : s.simpleKey.possible = false)
    (h_ek : s.explicitKeyLine = some ek)
    (h_ne : s.line ≠ ek) :
    (s.col : Int) = s.currentIndent := by
  unfold scanValueValidate at h
  simp only [Bind.bind, Except.bind, Pure.pure, Except.pure, throw, throwThe,
             MonadExceptOf.throw, h_poss, h_noflow, h_ek, Bool.false_and,
             Bool.and_false, Bool.not_false, Bool.true_and] at h
  by_cases hcol : (s.col : Int) = s.currentIndent
  · exact hcol
  · exfalso
    simp only [h_ne, ite_false, beq_iff_eq, bne_iff_ne, ne_eq, hcol, not_false_eq_true,
      ite_true] at h
    exact absurd h (by simp)

/-- **The lift through `scanValueClearKey`** — the two checks joined at the one
    state that separates them.

    `[197]`'s clear is the only way a live key stops being §7.4's business, and
    it fires on exactly two conditions: a key saved AT the `:` (refuted by
    `KeysBehindCursor`, item 81's scanner-wide invariant) and a key saved on
    the `?`'s own line.  The second is the residue, and it carries the misindent
    check's reading with it. -/
lemma scanValue_ok_keyLine {s s' : ScannerState}
    (h : scanValue s = .ok s')
    (h_noflow : s.inFlow = false)
    (h_poss : s.simpleKey.possible = true)
    (h_behind : s.simpleKey.pos.offset < s.offset) :
    s.simpleKey.pos.line = s.line ∨
      (s.explicitKeyLine = some s.simpleKey.pos.line ∧ (s.col : Int) = s.currentIndent) := by
  unfold scanValue at h
  simp only [bind, Except.bind] at h
  split at h
  case h_1 => cases h
  case h_2 u hval =>
    have hval' : scanValueValidate (scanValueClearKey s) = .ok () := by cases u; exact hval
    unfold scanValueClearKey at hval'
    split at hval'
    · rename_i ek hek
      split at hval'
      · -- The phantom-key clear: the key sits AT the cursor, which item 81
        -- refutes for every live save.
        rename_i hc
        exfalso
        simp only [Bool.and_eq_true, beq_iff_eq] at hc
        omega
      · split at hval'
        · -- The `?`-line clear: §7.4 is silent and `[197]` decides.
          rename_i hc2
          simp only [Bool.and_eq_true, beq_iff_eq, bne_iff_ne, ne_eq] at hc2
          refine Or.inr ⟨by rw [hek, hc2.1.1.2], ?_⟩
          exact scanValueValidate_ok_explicit_col
            (s := { s with simpleKey := { possible := false } })
            hval' h_noflow rfl hek hc2.1.2
        · exact Or.inl (scanValueValidate_ok_keyLine hval' h_noflow h_poss)
    · exact Or.inl (scanValueValidate_ok_keyLine hval' h_noflow h_poss)

/-- **…and a park whose saved key is STALE refutes the dispatch** (item 104),
    in `dispatch_refutes_sameLine`'s shape: the no-break payload carries the
    key, the line and the cursor to the dispatch state, and the `:`'s own
    success then says the key was this line's — or names the `?` frame that
    took it down. -/
lemma dispatch_refutes_staleKey {sc s_prep s' : ScannerState}
    (h_poss : sc.simpleKey.possible = true)
    (h_kline : ¬ (sc.simpleKey.pos.line = sc.line))
    (h_behind : sc.simpleKey.pos.offset < sc.offset)
    (h_inh : s_prep.simpleKey = sc.simpleKey)
    (h_line_eq : s_prep.line = sc.line)
    (h_off_ge : sc.offset ≤ s_prep.offset)
    (h_noflow : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).inFlow = false)
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) ':' = .ok (some s')) :
    s_prep.explicitKeyLine = some sc.simpleKey.pos.line ∧
      (s_prep.col : Int) = s_prep.currentIndent := by
  -- Generalize the dispatch state, as item 48's transport does: the
  -- `allowDirectives` update touches none of the six fields the two checks
  -- read.
  have hmain : ∀ sd : ScannerState, sd.simpleKey = s_prep.simpleKey →
      sd.line = s_prep.line → sd.offset = s_prep.offset → sd.col = s_prep.col →
      sd.currentIndent = s_prep.currentIndent →
      sd.explicitKeyLine = s_prep.explicitKeyLine → sd.inFlow = false →
      scanNextToken_dispatchBlockIndicators sd ':' = .ok (some s') →
      s_prep.explicitKeyLine = some sc.simpleKey.pos.line ∧
        (s_prep.col : Int) = s_prep.currentIndent := by
    intro sd hsk hln hoff hcol hind hek hfl hdd
    rcases scanValue_ok_keyLine (dispatchBlock_colon_scanValue hdd) hfl
      (by rw [hsk, h_inh]; exact h_poss)
      (by rw [hsk, h_inh, hoff]; have := h_behind; omega) with h_same | ⟨h1, h2⟩
    · refine absurd ?_ h_kline
      rw [← h_line_eq, ← h_inh, ← hsk, ← hln]
      exact h_same
    · exact ⟨by rw [← hek, h1, hsk, h_inh], by rw [← hcol, ← hind]; exact h2⟩
  exact hmain _ (by split <;> rfl) (by split <;> rfl) (by split <;> rfl)
    (by split <;> rfl) (by split <;> rfl) (by split <;> rfl) h_noflow h_dispatch

/-- `peek?` reads only `offset`/`input`/`inputEnd`. -/
lemma peek?_congr {s₁ s₂ : ScannerState}
    (ho : s₁.offset = s₂.offset) (hi : s₁.input = s₂.input)
    (he : s₁.inputEnd = s₂.inputEnd) :
    s₁.peek? = s₂.peek? := by
  unfold ScannerState.peek?
  rw [ho, hi, he]

/-- `scanValueClearKey` moves nothing: the cursor, the flag, and the array all
    ride through (item 48's park-side reads). -/
lemma scanValueClearKey_park_reads (s : ScannerState) :
    (scanValueClearKey s).needIndentCheck = s.needIndentCheck ∧
    (scanValueClearKey s).offset = s.offset ∧
    (scanValueClearKey s).line = s.line ∧
    (scanValueClearKey s).input = s.input ∧
    (scanValueClearKey s).inputEnd = s.inputEnd := by
  unfold scanValueClearKey
  repeat' split
  all_goals exact ⟨rfl, rfl, rfl, rfl, rfl⟩

/-- `scanValuePrepare` writes tokens, key state and indents — never the
    cursor or the flag. -/
lemma scanValuePrepare_park_reads (s : ScannerState) :
    (scanValuePrepare s).needIndentCheck = s.needIndentCheck ∧
    (scanValuePrepare s).offset = s.offset ∧
    (scanValuePrepare s).line = s.line ∧
    (scanValuePrepare s).input = s.input ∧
    (scanValuePrepare s).inputEnd = s.inputEnd := by
  unfold scanValuePrepare pushMappingIndent
  repeat' split
  all_goals exact ⟨rfl, rfl, rfl, rfl, rfl⟩

/-- **The `:` step's park-side facts** (item 48).  In block context the
    epilogue stamps `implicitValueLine := some line` for an IMPLICIT value —
    the `.value` push ends the array real, the advance stays on the `:`'s own
    line, and the flag rides through.  The other disjunct is the EXPLICIT `:`
    (`[193]`'s value slot, which admits a compact collection): the epilogue
    does not stamp there, and the park stays escapable. -/
lemma scanValue_ok_park_facts {s s' : ScannerState}
    (h : scanValue s = .ok s') (h_noflow : s.inFlow = false)
    (h_nic : s.needIndentCheck = false) (h_peek : s.peek? = some ':') :
    s'.needIndentCheck = false ∧ LastTokenReal s'.tokens ∧
      (s'.implicitValueLine = some s'.line ∨ True) := by
  obtain ⟨hck_nic, hck_off, hck_line, hck_in, hck_end⟩ :=
    scanValueClearKey_park_reads s
  obtain ⟨hp_nic, hp_off, hp_line, hp_in, hp_end⟩ :=
    scanValuePrepare_park_reads (scanValueClearKey s)
  have h_peek_prep : ((scanValuePrepare (scanValueClearKey s)).emit .value).peek?
      = some ':' := by
    rw [peek?_congr (s₂ := s) (by rw [show ((scanValuePrepare (scanValueClearKey s)).emit
          .value).offset = (scanValuePrepare (scanValueClearKey s)).offset from rfl,
          hp_off, hck_off])
      (by rw [show ((scanValuePrepare (scanValueClearKey s)).emit .value).input
          = (scanValuePrepare (scanValueClearKey s)).input from rfl, hp_in, hck_in])
      (by rw [show ((scanValuePrepare (scanValueClearKey s)).emit .value).inputEnd
          = (scanValuePrepare (scanValueClearKey s)).inputEnd from rfl, hp_end, hck_end])]
    exact h_peek
  unfold scanValue at h
  simp only [bind, Except.bind] at h
  split at h
  · cases h
  · split at h
    · cases h
    split at h
    · cases h
    · have h' := Except.ok.inj h
      subst h'
      refine ⟨?_, ?_, ?_⟩
      · -- the flag rides through prepare, emit and a same-line advance
        show ((scanValuePrepare (scanValueClearKey s)).emit .value).advance.needIndentCheck
          = false
        rw [advance_preserves_needIndentCheck,
            show ((scanValuePrepare (scanValueClearKey s)).emit .value).needIndentCheck
              = (scanValuePrepare (scanValueClearKey s)).needIndentCheck from rfl,
            hp_nic, hck_nic]
        exact h_nic
      · -- the `.value` push ends the array real
        show LastTokenReal
          ((scanValuePrepare (scanValueClearKey s)).emit .value).advance.tokens
        rw [ScannerCorrectness.advance_preserves_tokens]
        exact lastTokenReal_push (by simp)
      · -- the stamp, or the explicit disjunct
        rw [h_noflow]
        simp only [Bool.false_or]
        split
        · exact Or.inr trivial
        · refine Or.inl ?_
          show some s.line = some
            ((scanValuePrepare (scanValueClearKey s)).emit .value).advance.line
          rw [advance_preserves_line_of_ne_break _ ':'
                h_peek_prep (by decide) (by decide),
              show ((scanValuePrepare (scanValueClearKey s)).emit .value).line
                = (scanValuePrepare (scanValueClearKey s)).line from rfl,
              hp_line, hck_line]

/-- **The stamp is REAL when the `:` could not consume an explicit pair**
    (item 125): item 124's line-free `scanValue` discriminators, joined in the
    disjunctive form the landed-`:` consumers decide by classical case split on
    their own dispatch state.  A `:` whose state has no live `explicitKeyLine`,
    whose saved key SURVIVES the clear, or whose column differs from
    `explicitKeyCol`, computed `explicitValue = false` and stamped its line —
    which is what pays `pendingMapValue.h_ivl`'s left disjunct outright.

    **Item 185: the middle alternative, and why it makes the split TOTAL.**
    `explicitValue` is a conjunction of three tests, and item 125 read the
    first and the third.  The second — the key the CLEAR leaves standing — is
    a field of the same state and decidable there like the others, so leaving
    it out did not make the escape's branch smaller, it made it UNNAMED: the
    negation of the two-alternative form is weaker than `explicitValue = true`
    and could not be spent.  With all three the negation IS
    `explicitValue = true`, which is what `explicit_at_indent_of_dispatch`
    below then reads the scanner's own `s-indent(n)` test off. -/
lemma scanValue_stamp_of_src {s s' : ScannerState}
    (h : scanValue s = .ok s') (h_noflow : s.inFlow = false)
    (h_peek : s.peek? = some ':')
    (h_src : s.explicitKeyLine = none ∨
      (scanValueClearKey s).simpleKey.possible = true ∨
      (s.col : Int) ≠ s.explicitKeyCol) :
    s'.implicitValueLine = some s'.line :=
  h_src.elim
    (fun h_ek =>
      (ExplicitKeyCoupling.scanValue_ok_of_ekl_none h h_noflow h_peek h_ek).1)
    (fun h_rest => h_rest.elim
      (fun h_key =>
        ExplicitKeyCoupling.scanValue_stamp_of_cleared_key h h_noflow h_peek h_key)
      (fun h_ne =>
        ExplicitKeyCoupling.scanValue_stamp_of_col_ne h h_noflow h_peek h_ne))

/-- **What the escape's stamp-source branch KNOWS** (item 185): the three
    alternatives refuted, the `:` is `[197] l-block-map-explicit-value`'s own —
    and the scanner admitted it, so `s-indent(n)` already holds at the dispatch
    state's own column.

    This is the branch's residue stated as data rather than as a negation.  It
    is what a route into the `?` frame's value slot has to land on, and having
    every deferral site produce it is what says the datum is THERE at all of
    them rather than at the ones a reading happened to check. -/
lemma explicit_at_indent_of_dispatch {s_dis s' : ScannerState}
    (h_dispatch : scanNextToken_dispatchBlockIndicators s_dis ':' = .ok (some s'))
    (h_noflow : s_dis.inFlow = false)
    (h_src : ¬(s_dis.explicitKeyLine = none ∨
      (scanValueClearKey s_dis).simpleKey.possible = true ∨
      (s_dis.col : Int) ≠ s_dis.explicitKeyCol)) :
    (s_dis.col : Int) = s_dis.currentIndent := by
  have h_key : (scanValueClearKey s_dis).simpleKey.possible = false := by
    cases h : (scanValueClearKey s_dis).simpleKey.possible
    · rfl
    · exact absurd (Or.inr (Or.inl h)) h_src
  cases h_ekl : s_dis.explicitKeyLine with
  | none => exact absurd (Or.inl h_ekl) h_src
  | some ekLine =>
    exact (ExplicitKeyCoupling.scanValue_explicit_at_indent
      (dispatchBlock_colon_scanValue h_dispatch) h_noflow h_ekl h_key).2

-- The col-0 `:` producer (item 13): from a stream already closed at the
-- line start, the value indicator opens an EMPTY-KEY block mapping and
-- parks `pendingMapValue`.  The entry frame — `s-indent(0)` +
-- `[189] c-l-block-map-implicit-value` with `e-node` key + `[187]
-- l+block-mapping` + `[199] s-l+block-collection` + bare document +
-- `[211]`'s implicit continuation — is captured whole; the pending's one
-- closure waits only for the VALUE node, converted to `[189]`'s
-- `.blockOut` at the capture (inert at n = 0).  Shared by all four
-- block-dispatch producer lemmas: their pendings close first, so each
-- arrives here with the same shape.
/-- **The landing's own COVER** (item 147) — what the two root `:`/`?` openers
    hand the frames beside the widths.

    Three facts meet here and none of them is new.  The LANDING floored the
    stack: the walk that carried a park off a line start down to column 0 armed
    the indent check, so preprocessing unwound, and an unwind stops with its top
    at or left of the column it unwound to
    (`IndentStackCover.preprocess_top_le_col_of_armed`, read through the base).
    The INDICATOR cannot undo that: `[187]`'s `?` pushes at its own column and
    `[193]`/`[196]`'s `:` at the key's, which the landing's fresh save puts at
    the same place (`scanKey_top_le`, `scanValue_top_le`).  And the stack is
    MONOTONE, so a top at or left of `k` leaves `k` as the only level at or
    right of `k` — `covered_singleton_of_top_le`.

    The result is the cover a producer can pay without knowing anything below
    its own entry, which is exactly the producer's situation: the levels under a
    col-0 landing are fused into the stream its route closes. -/
lemma indicator_cover_at_col {sc s_prep s' : ScannerState} {sp_prep : SurfPos}
    {k : Nat} {c : Char}
    (hc : c = ':' ∨ c = '?')
    (hcol_prep : sp_prep.col = k)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (h_noflow : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).inFlow = false)
    (h_save : s_prep.simpleKey.pos.col = s_prep.col)
    (h_mono : IndentStackMono.Mono sc)
    (h_base : IndentStackBase.SentinelBase sc)
    (h_fl : s_prep.currentIndent ≤ (s_prep.col : Int))
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h_dispatch : scanNextToken_dispatchBlockIndicators (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep) c = .ok (some s')) :
    IndentStackCover.Covered k [FrameLevel.map k] s' ∧ IndentStackCover.Covered (k + 1) [] s' := by
  have h_upd_ind : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).indents = s_prep.indents := by split <;> rfl
  have h_upd_col : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).col = s_prep.col := by split <;> rfl
  have h_upd_sk : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).simpleKey = s_prep.simpleKey := by split <;> rfl
  have h_col : s_prep.col = k := by rw [← hcorr_prep.col_eq, hcol_prep]
  have h_fl_disp : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).currentIndent ≤ ((if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).col : Int) := by
    rw [currentIndent_of_indents_eq h_upd_ind, h_upd_col]; exact h_fl
  have h_mono_disp : IndentStackMono.Mono (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep) :=
    (IndentStackMono.preprocess_mono h_preprocess h_mono).of_indents_eq h_upd_ind
  have h_base_disp : IndentStackBase.SentinelBase (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep) :=
    (IndentStackBase.preprocess_base h_preprocess h_base).of_indents_eq h_upd_ind
  have h_mono' : IndentStackMono.Mono s' :=
    IndentStackMono.dispatchBlockIndicators_mono h_dispatch h_mono_disp h_base_disp
  -- **Item 150: the top, named.**  Both readings below are about the same
  -- state, so taking the top ONCE is what lets this lemma answer the stream
  -- lane's question and the value lane's at the same price.
  have h_top : s'.currentIndent ≤ (k : Int) := by
    cases hc with
    | inl hcolon =>
      subst hcolon
      have := IndentStackCover.scanValue_top_le (dispatchBlock_colon_scanValue h_dispatch)
        (fun _ => by rw [h_upd_sk, h_upd_col]; exact h_save) h_fl_disp
      rw [h_upd_col, h_col] at this
      exact this
    | inr hq =>
      subst hq
      have := IndentStackCover.scanKey_top_le h_noflow
        (dispatchBlock_question_scanKey h_dispatch) h_fl_disp
      rw [h_upd_col, h_col] at this
      exact this
  exact ⟨IndentStackCover.covered_singleton_of_top_le h_mono' h_top,
    IndentStackCover.covered_nil_of_top_le h_mono' h_top⟩

lemma colon_open_map {sc : ScannerState} (sp_start sp_land sp_ind : SurfPos) (k : Nat)
    (s_prep s' : ScannerState) (sp_scan' : SurfPos)
    (h_stream_land : SLYamlStream sp_start sp_land)
    (hcol_land : sp_land.col = 0)
    (h_ind : SIndent k sp_land sp_ind)
    (hcorr_prep : ScannerSurfCorr s_prep sp_ind)
    (hcorr_result : ScannerSurfCorr s' sp_scan')
    -- Item 77: a MEASUREMENT here, not an option — the `?` opener's own shape
    -- since item 74.  What kept it optional was the ONE park the landing's
    -- re-arm could not fund: a CONTENT park at column 0.  There is no such
    -- park (`content_park_arm`), so every caller measures.
    -- Item 179: at the SHIFTED index — the push is at `k`, the floor is one
    -- above it, and the awaited value reads there.
    (h_floor_in : IndentFloor s' (k + 1))
    (hpeek : s_prep.peek? = some ':')
    (h_noflow_disp : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).inFlow = false)
    (h_nic_disp : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).needIndentCheck = false)
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) ':' = .ok (some s'))
    -- Item 125: the stamp's SOURCE — the dispatch state either carries no
    -- live explicit-key register or stands off its column, so `scanValue`
    -- computed `explicitValue = false` and stamped.  The caller decides this
    -- by classical case split on its own state (both conjuncts are its own
    -- fields); the one shape it cannot prove — a live register at the
    -- landing's own column with no face in hand — defers there instead of
    -- parking an unstamped `[189]` slot here.
    (h_src : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).explicitKeyLine = none ∨
      (scanValueClearKey (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep)).simpleKey.possible = true ∨
      ((if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).col : Int) ≠ (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).explicitKeyCol)
    -- Item 118: the landing's open suffix arm (item 117's face, instantiated
    -- at `sp_land` by the caller).  The entry this `:` opens belongs to the
    -- next DOCUMENT, so a `...` park routes it into `suffixContinue`'s own
    -- slot; the progress stream stays the folded close either way.
    (h_sfx_land : SuffixRun sp_start sp_land ∨ True)
    -- Item 136: the landing's HEAD arm beside it — when the park behind this
    -- landing has started no document, the entry this indicator opens heads
    -- the stream's FIRST one (`: v`, `? k`), so the route is `nodocMapRoute`'s
    -- `single` rather than `rootMapRoute`'s implicit continuation of a stream
    -- with nothing in it.
    (h_nodoc_land : GStar SLDocumentPrefix sp_start sp_land ∨ True)
    -- Item 137: and the landing's MARKER arm, the fourth.  When the park
    -- behind this landing is a `---`, the entry this indicator opens is that
    -- document's own content (`---⏎: v`, `---⏎? k`), so the route hands it to
    -- `h_doc_route`'s bare-document slot instead of closing the marker with
    -- `e-node` and opening a second document beside it.
    (h_mk_land : MarkerNodeRoute sp_start sp_land ∨ True)
    -- **Item 173: the landing's RESUME arm, the fifth** — when the landing's
    -- width names a mapping level the closed park kept OPEN, the entry this
    -- `:` opens is that level's next element (`a: 1⏎: 2` and
    -- `k:⏎  a: 1⏎  : 2` are ONE mapping each, the parser's own reading), so
    -- the route conses onto the level's tail (`resumeMapRoute`) instead of
    -- appending a bare document over the folded stream.  `ks` is the levels
    -- still open below the resumed one, carried into the new park's frames so
    -- the NEXT landing can resume too.
    (h_res_land : (∃ ks : List FrameLevel, (∀ fr ∈ ks, fr.width < k) ∧
      ∀ sp_end : SurfPos, SCompactMapTail k sp_land sp_end →
        ResumeFrames (SLYamlStream sp_start) ks sp_end) ∨ True)
    -- Item 142: §9.2's landing refusal, the sixth arm.  `Or.inl` says the
    -- scanner has already refused this landing (`a⏎: v`), so the fallback
    -- below is unreachable; `Or.inr` says nothing, exactly as the four
    -- route arms above it do.
    (h_ref_land : BareLandingFacts sc s_prep ':' ∨ True)
    -- Item 147: the landing's own cover, measured by `indicator_cover_at_col`
    -- at the caller (which holds the walk that armed the unwind) and handed to
    -- the frames field below.
    (h_cov_in : IndentStackCover.Covered k [FrameLevel.map k] s' ∨ True)
    -- **Item 175 (LAST, so the existing argument order stands): the landing's
    -- PROPS arm** — when the park behind this landing is a sentinel-level
    -- `[96]` run, the entry this `:` opens heads the RUN's own collection
    -- (`&p⏎: v` is `+MAP &p` with an empty key — `[196]`'s optional
    -- properties, the MAPPING's anchor), so the route spends the park's own
    -- route instead of closing the run `propsEmpty` and appending a bare
    -- document over it.
    (h_pr_land : PropsNodeRoute sp_start sp_land ∨ True)
    -- **Item 197 (LAST, same reason): the resume arm at the VALUE-LINE
    -- bottom.**  `h_res_land` is this stack bottomed at the finished stream and
    -- is spent on the entry ROUTE; this one is the same stack under an open
    -- `[186]` explicit key, and it is spent on the park's value-line CHAIN —
    -- the field item 93 punted here because `[189]`'s own slot is
    -- `s-l+block-node` and no frame of this park's OWN stands over it.  A frame
    -- one level DOWN does: once the enclosing `?`'s value line has been spent,
    -- a second `:` at the same column is that level's next entry and the
    -- OUTER frame's line is still owed (`?⏎  ?⏎    - a⏎  : b⏎  : c⏎: w`).
    (h_resV_land : (∃ (nv : Nat) (ks : List FrameLevel), (∀ fr ∈ ks, fr.width < k) ∧
      ∀ sp_end : SurfPos, SCompactMapTail k sp_land sp_end →
        KeyFrames (ExplValueLine sp_start nv) ks sp_end) ∨ PackAlt sc)
    -- **Item 322 (LAST): the alternative's TRANSPORT across the `:`.**  This lemma states its
    -- alternatives at the park and builds the new park at `s'` without holding the step facts
    -- (its caller does), so the step is a premise: the caller passes `PackAlt.step_value …`.
    (h_alt_step : PackAlt sc → PackAlt s') :
    ∃ sp_gram' sp_block' sp_flow' sp_scan',
      SLYamlStream sp_start sp_gram' ∧
      BlockStack sp_gram' sp_block' ∧
      FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
      PendingNode s' false sp_start sp_flow' sp_scan' ∧
      ScannerSurfCorr s' sp_scan' := by
  have hpeek_disp : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).peek? = some ':' := by
    split
    · show s_prep.peek? = some ':'; exact hpeek
    · exact hpeek
  obtain ⟨sp_colon, h_lit, hcorr_colon⟩ :=
    dispatchBlockValue_full_prod _ sp_ind
      (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_dispatch
  have hsp_eq := ScannerSurfCorr_unique hcorr_colon hcorr_result
  rw [hsp_eq] at h_lit
  have hpf := scanValue_ok_park_facts (dispatchBlock_colon_scanValue h_dispatch)
    h_noflow_disp h_nic_disp hpeek_disp
  -- Item 118: the routes ANY entry at this landing takes to the stream — the
  -- open suffix arm's slot when the closed park was a `...`, the fresh bare
  -- document otherwise — hoisted once so every face below spends the same
  -- reading.  Item 173: the RESUME arm first, as at the content cascade — a
  -- landing width naming a still-open level makes the entry that level's
  -- next element, and the `[211]` fallback keeps only the landings no face
  -- claims.
  have h_routeE : ∀ sp_v, SBlockMapEntry k sp_ind sp_v →
      SLYamlStream sp_start sp_v :=
    match h_res_land, h_sfx_land, h_nodoc_land, h_mk_land, h_pr_land with
    | Or.inl ⟨_, _, cont⟩, _, _, _, _ => resumeMapRoute h_ind cont
    | Or.inr _, Or.inl sfxrun, _, _, _ => suffixMapRoute hcol_land sfxrun h_ind
    | Or.inr _, Or.inr _, Or.inl nodoc, _, _ => nodocMapRoute hcol_land nodoc h_ind
    | Or.inr _, Or.inr _, Or.inr _, Or.inl mk, _ => markerMapRoute mk h_ind
    -- Item 175: the PROPS arm, fifth — the entry heads the held run's own
    -- collection through `[196]`'s slot and the park's route.
    | Or.inr _, Or.inr _, Or.inr _, Or.inr _, Or.inl pn => propsMapRoute pn h_ind
    -- Item 142: the fallback, with §9.2's landing refusal taken out of its
    -- domain.
    | Or.inr _, Or.inr _, Or.inr _, Or.inr _, Or.inr _ =>
        rootMapRoute_or_refused h_ref_land hcol_land h_stream_land h_ind
  -- Item 173: the entries-level twin carries the RESUMED level's own `ks`, so
  -- the park this opener makes offers the next landing the same resume this
  -- one took.  The cover rides in the same package: the root-bottomed arms
  -- pay it from the landing's own measurement (item 148) and the resume arm
  -- PUNTS it — a second dedent from the re-parked state keeps the fallback,
  -- the recorded residue (DOCS item 173).
  obtain ⟨ksF, h_ltF, h_covF, h_routeF⟩ :
      ∃ ks : List FrameLevel, (∀ fr ∈ ks, fr.width < k) ∧
        ((∃ lo : Nat, IndentStackCover.Floor lo k (FrameLevel.map k :: ks) ∧
          IndentStackCover.Covered lo (FrameLevel.map k :: ks) s') ∨ True) ∧
        ∀ sp_v, SBlockMapEntry k sp_ind sp_v →
        ∀ sp_e, SCompactMapTail k sp_v sp_e →
        ResumeFrames (SLYamlStream sp_start) ks sp_e :=
    match h_res_land, h_sfx_land, h_nodoc_land, h_mk_land, h_pr_land with
    | Or.inl ⟨ks, h_lt, cont⟩, _, _, _, _ =>
        ⟨ks, h_lt, Or.inr trivial, resumeMapRouteF h_ind cont⟩
    | Or.inr _, Or.inl sfxrun, _, _, _ =>
        ⟨[], fun _ h => absurd h (List.not_mem_nil),
          h_cov_in.imp (fun h => ⟨k, ⟨Nat.le_refl k, by simp⟩, h⟩) id,
          suffixMapRouteF hcol_land sfxrun h_ind⟩
    | Or.inr _, Or.inr _, Or.inl nodoc, _, _ =>
        ⟨[], fun _ h => absurd h (List.not_mem_nil),
          h_cov_in.imp (fun h => ⟨k, ⟨Nat.le_refl k, by simp⟩, h⟩) id,
          nodocMapRouteF hcol_land nodoc h_ind⟩
    | Or.inr _, Or.inr _, Or.inr _, Or.inl mk, _ =>
        ⟨[], fun _ h => absurd h (List.not_mem_nil),
          h_cov_in.imp (fun h => ⟨k, ⟨Nat.le_refl k, by simp⟩, h⟩) id,
          markerMapRouteF mk h_ind⟩
    | Or.inr _, Or.inr _, Or.inr _, Or.inr _, Or.inl pn =>
        ⟨[], fun _ h => absurd h (List.not_mem_nil),
          h_cov_in.imp (fun h => ⟨k, ⟨Nat.le_refl k, by simp⟩, h⟩) id,
          propsMapRouteF pn h_ind⟩
    | Or.inr _, Or.inr _, Or.inr _, Or.inr _, Or.inr _ =>
        ⟨[], fun _ h => absurd h (List.not_mem_nil),
          h_cov_in.imp (fun h => ⟨k, ⟨Nat.le_refl k, by simp⟩, h⟩) id,
          rootMapRouteF_or_refused h_ref_land hcol_land h_stream_land h_ind⟩
  exact ⟨sp_land, sp_land, sp_land, sp_scan', h_stream_land,
         BlockStack.nil sp_land, FlowStackB.nil sp_land .sep,
         PendingNode.pendingMapValue (h_next := fun _ => dispatchBlock_colon_next h_noflow_disp hpeek_disp h_dispatch) (h_offer := dispatchBlock_colon_offerPred h_dispatch) sp_start sp_land sp_scan' k
           (fun sp_v h_node =>
             h_routeE sp_v
               (SBlockMapEntry.emptyKeyNode k sp_ind sp_scan' sp_v h_lit
                 (SBlockNode_blockIn_to_blockOut h_node)))
           h_floor_in hpf.1 hpf.2.1
           -- Item 125: the stamp is REAL — the caller's `h_src` says the `:`
           -- could not consume an explicit pair, so the epilogue stamped.
           (Or.inl (scanValue_stamp_of_src (dispatchBlock_colon_scanValue h_dispatch)
             h_noflow_disp hpeek_disp h_src))
           (Or.inr trivial) (Or.inr (scanValue_stamp_of_src (dispatchBlock_colon_scanValue h_dispatch)
             h_noflow_disp hpeek_disp h_src))
           (scanValue_simpleKeyAllowed (dispatchBlock_colon_scanValue h_dispatch))
           -- Item 68: the `:` stands AT the entry index (`s-indent(k)` from a
           -- column-0 landing) and the park is the character past it.
           (by have := SIndent_col h_ind; have := glit_col h_lit; omega)
           (Or.inl (by have := SIndent_col h_ind; have := glit_col h_lit; omega))
           -- ~~Item 93: a `[189]` empty-key entry's value is `s-l+block-node` —
           -- no compact mapping heads an explicit key from this park.~~
           -- **Item 197: a frame stands UNDER this park, not over it.**  Item
           -- 93 read the field as asking for a frame whose KEY this entry heads
           -- — of which there is none here — but the field asks only for a `:`
           -- line still owed once the awaited value completes, and a landing
           -- that resumed a level inside a still-open `?` owes exactly that.
           -- One member, off the same stack `h_res_land` spends at the route.
           (match h_resV_land with
            | Or.inl ⟨nv, _, _, contV⟩ => Or.inl ⟨[nv], frameChainOne (a := nv)
                (fun sp_m h_node sp_i sp_c h_iv h_clit sp_v h_sbi =>
                  resumeFrameRouteK h_ind contV sp_m
                    (SBlockMapEntry.emptyKeyNode k sp_ind sp_scan' sp_m h_lit
                      (SBlockNode_blockIn_to_blockOut h_node))
                    sp_i sp_c h_iv h_clit sp_v h_sbi)⟩
            | Or.inr h_alt => Or.inr (h_alt_step h_alt))
           -- Item 99: the resume frames, both faces — level `k` over the
           -- entries-level route, the entry completed by the node or closed
           -- empty on the landing's comments (`k:⏎  :⏎b: 2`).  Item 173: the
           -- levels below ride from the routes' own package, so a resumed
           -- park re-offers what it resumed on.
           (Or.inl ⟨ksF, h_ltF, h_covF,
             fun sp_v h_node =>
               ResumeFrames.level k ksF sp_v h_ltF
                 (h_routeF sp_v
                   (SBlockMapEntry.emptyKeyNode k sp_ind sp_scan' sp_v h_lit
                     (SBlockNode_blockIn_to_blockOut h_node)))⟩)
           (Or.inl ⟨FrameLevel.map k :: ksF,
             -- Item 147: and the stack under it — the landing floored the top
             -- and the `:` pushed at the same column, so the open mapping
             -- levels at or right of the floor are exactly this list's.
             h_covF,
             fun sp_m h_ssl =>
               ResumeFrames.level k ksF sp_m h_ltF
                 (h_routeF sp_m
                   (SBlockMapEntry.emptyKeyEmpty k sp_ind sp_scan' sp_m h_lit h_ssl))⟩)
           -- ~~Item 108: a `[189]` empty-key entry's value slot is
           -- `s-l+block-node` — no explicit frame stands over this park, so
           -- there is no value line for a stack to bottom at.~~
           -- **Item 197: the stack is the one the landing arrived on**, and it
           -- bottoms at the value line of the `?` frame the resumed level
           -- stands inside.  Both faces are item 99's terms with `h_routeF`
           -- replaced by the value-line route — `[189]`'s entry completed by
           -- the awaited node, or closed empty on the landing's comments — so
           -- a DEEPER landing chains onto this bottom instead of dropping it.
           (match h_resV_land with
            | Or.inl ⟨nv, ksV, h_ltV, contV⟩ =>
                Or.inl ⟨nv, FrameLevel.map k :: ksV,
                  (by
                    rintro k' hk'
                    rcases List.mem_cons.mp hk' with rfl | h'
                    · exact Nat.le_refl _
                    · exact Nat.le_of_lt (h_ltV k' h')),
                  Or.inr trivial,
                  fun sp_v h_node =>
                    KeyFrames.mapLevel k ksV sp_v h_ltV
                      (resumeMapRouteK h_ind contV sp_v
                        (SBlockMapEntry.emptyKeyNode k sp_ind sp_scan' sp_v h_lit
                          (SBlockNode_blockIn_to_blockOut h_node)))⟩
            | Or.inr h_alt => Or.inr (h_alt_step h_alt))
           (match h_resV_land with
            | Or.inl ⟨nv, ksV, h_ltV, contV⟩ =>
                Or.inl ⟨nv, FrameLevel.map k :: ksV, Or.inr trivial,
                  fun sp_m h_ssl =>
                    KeyFrames.mapLevel k ksV sp_m h_ltV
                      (resumeMapRouteK h_ind contV sp_m
                        (SBlockMapEntry.emptyKeyEmpty k sp_ind sp_scan' sp_m h_lit h_ssl))⟩
            | Or.inr h_alt => Or.inr (h_alt_step h_alt))
           (nodir_of_block_dispatch h_dispatch) (Or.inr trivial)
           -- Item 190: and no `?` literal either, so no entry route to compose
           -- an outer frame's value line against.
           (Or.inr trivial),
         hcorr_result⟩

-- The col-0 `?` producer (item 20): the explicit-key twin of `colon_open_map`.
--
-- Nothing about the pending changes.  `pendingMapValue`'s closure names only
-- what it AWAITS — one `SBlockNode 0 .blockIn` starting at the indicator's
-- right edge — and never the indicator that opened it, so a producer for a
-- DIFFERENT `[188]` alternative reuses it verbatim: the awaited node is the
-- explicit KEY rather than the value, and the frame composed here is
-- `[186] c-l-block-map-explicit-entry` with its `e-node` value instead of
-- `[189]`'s empty-key entry.  Every consumption arm (`accum_content_on_pendingMapValue`
-- and siblings) is untouched, and the `? a⏎: v` continuation rides `[211]`
-- exactly as `: a⏎: b`'s sibling does.
--
-- The `e-node` value alternative is what item 20 had to ADD to the surface
-- grammar (`SBlockMapEntry.explicitEmpty`): `SBlockMapEntry.explicit` demanded
-- the `:` line, so a key-only entry had no derivation at all.
lemma question_open_map {sc : ScannerState} (sp_start sp_land sp_ind : SurfPos) (k : Nat)
    (s_prep s' : ScannerState) (sp_scan' : SurfPos)
    (h_stream_land : SLYamlStream sp_start sp_land)
    (hcol_land : sp_land.col = 0)
    (h_ind : SIndent k sp_land sp_ind)
    (hcorr_prep : ScannerSurfCorr s_prep sp_ind)
    (hcorr_result : ScannerSurfCorr s' sp_scan')
    -- Item 74: a MEASUREMENT here, not an option.  `[187]`'s push goes to the
    -- `?`'s own column and the only thing `key_floor_or` cannot decide is the
    -- flow level, which this lemma's caller holds — so the `?` opener pays its
    -- floor the way the `-` opener has since item 73.
    -- Item 179: at the SHIFTED index, off the same push.
    (h_floor_in : IndentFloor s' (k + 1))
    (hpeek : s_prep.peek? = some '?')
    (_h_noflow_disp : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).inFlow = false)
    (h_nic_disp : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).needIndentCheck = false)
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) '?' = .ok (some s'))
    -- Item 118: the landing's open suffix arm, as at `colon_open_map` — the
    -- `[188]` entry this `?` opens heads the next DOCUMENT, so a `...` park
    -- routes it into `suffixContinue`'s own slot.
    (h_sfx_land : SuffixRun sp_start sp_land ∨ True)
    -- Item 136: the landing's HEAD arm beside it — when the park behind this
    -- landing has started no document, the entry this indicator opens heads
    -- the stream's FIRST one (`: v`, `? k`), so the route is `nodocMapRoute`'s
    -- `single` rather than `rootMapRoute`'s implicit continuation of a stream
    -- with nothing in it.
    (h_nodoc_land : GStar SLDocumentPrefix sp_start sp_land ∨ True)
    -- Item 137: and the landing's MARKER arm, the fourth.  When the park
    -- behind this landing is a `---`, the entry this indicator opens is that
    -- document's own content (`---⏎: v`, `---⏎? k`), so the route hands it to
    -- `h_doc_route`'s bare-document slot instead of closing the marker with
    -- `e-node` and opening a second document beside it.
    (h_mk_land : MarkerNodeRoute sp_start sp_land ∨ True)
    -- **Item 173: the landing's RESUME arm**, as at `colon_open_map` — the
    -- sibling explicit entry continues the still-open level
    -- (`? a⏎: 1⏎? b⏎: 2` is ONE mapping, the parser's own reading).
    (h_res_land : (∃ ks : List FrameLevel, (∀ fr ∈ ks, fr.width < k) ∧
      ∀ sp_end : SurfPos, SCompactMapTail k sp_land sp_end →
        ResumeFrames (SLYamlStream sp_start) ks sp_end) ∨ True)
    -- Item 142: §9.2's landing refusal, as at `colon_open_map`.
    (h_ref_land : BareLandingFacts sc s_prep '?' ∨ True)
    -- Item 147: the landing's own cover, as at `colon_open_map`.
    (h_cov_in : IndentStackCover.Covered k [FrameLevel.map k] s' ∨ True)
    -- **Item 150: the value-line stack's own seed.**  Below the `?` there is no
    -- open mapping level — `ks = []` — and a cover over that empty list is a
    -- statement about the stack rather than a vacuity: it says the `?`'s push
    -- left nothing at or right of `k + 1`.  That is where the value-line floor
    -- has to stand, the `?`'s own level being deliberately not a frame.
    (h_cov_nil : IndentStackCover.Covered (k + 1) [] s' ∨ True)
    -- **Item 175: the landing's PROPS arm**, as at `colon_open_map` —
    -- the explicit entry this `?` opens heads the held run's own collection
    -- (`&p⏎? x⏎: v` is `+MAP &p` — `[196]`'s optional properties, the
    -- MAPPING's anchor), through the park's route.
    (h_pr_land : PropsNodeRoute sp_start sp_land ∨ True)
    -- ═══ **Item 189: the frame ONE LEVEL UP, carried into the park this `?`
    -- opens.**  Where this landing stands strictly inside an outer `?` frame's
    -- still-open `[185]` key slot, the mapping this `?` heads IS that key, and
    -- the outer entry's `s-indent(nv) ':' s-l+block-indented(nv, block-out)`
    -- line is owed after it (`?⏎  ?⏎: w`).  The caller fills the slot —
    -- `slotLandedMap` at `nv + 1 ≤ k`, one column right of the sequence twin
    -- because `[187]` carries no `seq-spaces` — and hands the route the entry
    -- still has to travel; this lemma folds its own `explicitEmpty` entry into
    -- it, exactly as `h_route51` does for `h_close`, and the park then carries
    -- the outer line in `h_kslot` beside its OWN frame in `h_expl`.  A landing
    -- at the frame's own column has no reading here (`?⏎?⏎: w` fuses the two
    -- into one entry) and punts.
    --
    -- **Item 196: item 189's own parameter is GONE, and the chain below funds
    -- both.**  It stood beside `h_explUp_chain` carrying the same body on the
    -- same entry route at one index instead of a list; with `h_kslot` a chain
    -- too, the narrowing that built the awaited-node reading narrows the list
    -- as readily as it narrowed the index, and nothing is left for the narrow
    -- funder to say. ═══
    -- ═══ **Item 191 (LAST): the whole ANCESTOR CHAIN**, which since item 196
    -- is the only ancestor funder this lemma takes.  ~~`h_kslot_up` funds
    -- `h_kslot`, whose premise is the awaited block node and whose index is one
    -- `∃ nv`; that is the right shape for `[195]`'s value slot and the wrong
    -- one for a park with several open `?` frames above it, which is what
    -- `?⏎  ?⏎    ? -⏎: w` builds.  The chain is carried separately rather than
    -- by widening `h_kslot_up`, so item 189's mapping lane is untouched.~~
    -- **Item 196 widened the mapping lane instead**, and the sentence above is
    -- the reason it had to be: keeping one index there was what stopped
    -- `?⏎  ?⏎    a: b⏎: w`.  Every ancestor the caller could compose now
    -- reaches BOTH the compact lane's `h_explUp` and the awaited-node lane's
    -- `h_kslot`. ═══
    (h_explUp_chain : (∃ ns : List Nat, ∀ nv ∈ ns,
      ∀ sp_v : SurfPos, SBlockMapEntry k sp_ind sp_v →
      ∀ sp_i sp_c : SurfPos, SIndent nv sp_v sp_i → GLit ':' sp_i sp_c →
      ∀ sp_w : SurfPos, SBlockIndented nv .blockOut sp_c sp_w →
      SLYamlStream sp_start sp_w) ∨ PackAlt sc)
    -- **Item 197 (LAST): the landing's own resume arm, at the VALUE-LINE
    -- bottom.**  `h_explUp_chain` above is the chain a caller composed by
    -- FILLING this `?`'s slot into an outer frame's key — the NESTED reading,
    -- whose side condition is `nv + 1 ≤ k`.  This arm is the DEDENT one: the
    -- landing stops at a still-open mapping level that stands inside an outer
    -- `?` frame (`?⏎  ?⏎    a: b⏎  ? c⏎: w`), so the entry continues that level
    -- and the frame's value line is what stands underneath.  Both readings end
    -- in the same body, and this lemma unions them — which is why the park
    -- carries one chain and the landed `:` still picks by column.
    (h_resV_land : (∃ (nv : Nat) (ks : List FrameLevel), (∀ fr ∈ ks, fr.width < k) ∧
      ∀ sp_end : SurfPos, SCompactMapTail k sp_land sp_end →
        KeyFrames (ExplValueLine sp_start nv) ks sp_end) ∨ PackAlt sc)
    -- **Item 209 (LAST): the `?`'s own stack TOP**, the slot's half of the
    -- number `h_floor_in` states the other half of.  `[187]`'s push goes to
    -- the `?`'s own column, so the caller measures it with
    -- `indicator_top_kv_at_col` exactly where it measures the floor — and a
    -- `?` is the one opener whose `[186]` KEY slot a compact `-`/`?`/`:` can
    -- fill, which is what the top is carried for.
    (h_top_in : s'.currentIndent ≤ (k : Int)) :
    ∃ sp_gram' sp_block' sp_flow' sp_scan',
      SLYamlStream sp_start sp_gram' ∧
      BlockStack sp_gram' sp_block' ∧
      FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
      PendingNode s' false sp_start sp_flow' sp_scan' ∧
      ScannerSurfCorr s' sp_scan' := by
  have hpeek_disp : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).peek? = some '?' := by
    split
    · show s_prep.peek? = some '?'; exact hpeek
    · exact hpeek
  obtain ⟨sp_q, h_lit, hcorr_q⟩ :=
    dispatchBlockKey_full_prod _ sp_ind
      (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_dispatch
  have hsp_eq := ScannerSurfCorr_unique hcorr_q hcorr_result
  rw [hsp_eq] at h_lit
  have hpk := scanKey_ok_park_facts (dispatchBlock_question_scanKey h_dispatch) h_nic_disp
  -- Item 51: the route ANY `[188]` entry at this column takes to the stream,
  -- factored out of the `explicitEmpty` closure so `h_expl` can carry it —
  -- which is what keeps the entry open until its `:` value line lands.
  -- Item 118: chosen by the suffix face — `rootMapRoute`'s body was inlined
  -- here before the twins existed.
  have h_route51 : ∀ sp_k, SBlockMapEntry k sp_ind sp_k →
      SLYamlStream sp_start sp_k :=
    match h_res_land, h_sfx_land, h_nodoc_land, h_mk_land, h_pr_land with
    -- Item 173: the RESUME arm first, as at the content cascade.
    | Or.inl ⟨_, _, cont⟩, _, _, _, _ => resumeMapRoute h_ind cont
    | Or.inr _, Or.inl sfxrun, _, _, _ => suffixMapRoute hcol_land sfxrun h_ind
    | Or.inr _, Or.inr _, Or.inl nodoc, _, _ => nodocMapRoute hcol_land nodoc h_ind
    | Or.inr _, Or.inr _, Or.inr _, Or.inl mk, _ => markerMapRoute mk h_ind
    -- Item 175: the PROPS arm, fifth — the explicit entry heads the held
    -- run's own collection through `[196]`'s slot and the park's route.
    | Or.inr _, Or.inr _, Or.inr _, Or.inr _, Or.inl pn => propsMapRoute pn h_ind
    -- Item 142: the fallback, with §9.2's landing refusal taken out of its
    -- domain.
    | Or.inr _, Or.inr _, Or.inr _, Or.inr _, Or.inr _ =>
        rootMapRoute_or_refused h_ref_land hcol_land h_stream_land h_ind
  -- Item 173: the entries-level twin, packaged with the resumed level's own
  -- `ks` and the root arms' cover — as at `colon_open_map` (the resume arm
  -- punts the cover; the recorded residue).
  obtain ⟨ksF, h_ltF, h_covF, h_routeF⟩ :
      ∃ ks : List FrameLevel, (∀ fr ∈ ks, fr.width < k) ∧
        ((∃ lo : Nat, IndentStackCover.Floor lo k (FrameLevel.map k :: ks) ∧
          IndentStackCover.Covered lo (FrameLevel.map k :: ks) s') ∨ True) ∧
        ∀ sp_v, SBlockMapEntry k sp_ind sp_v →
        ∀ sp_e, SCompactMapTail k sp_v sp_e →
        ResumeFrames (SLYamlStream sp_start) ks sp_e :=
    match h_res_land, h_sfx_land, h_nodoc_land, h_mk_land, h_pr_land with
    | Or.inl ⟨ks, h_lt, cont⟩, _, _, _, _ =>
        ⟨ks, h_lt, Or.inr trivial, resumeMapRouteF h_ind cont⟩
    | Or.inr _, Or.inl sfxrun, _, _, _ =>
        ⟨[], fun _ h => absurd h (List.not_mem_nil),
          h_cov_in.imp (fun h => ⟨k, ⟨Nat.le_refl k, by simp⟩, h⟩) id,
          suffixMapRouteF hcol_land sfxrun h_ind⟩
    | Or.inr _, Or.inr _, Or.inl nodoc, _, _ =>
        ⟨[], fun _ h => absurd h (List.not_mem_nil),
          h_cov_in.imp (fun h => ⟨k, ⟨Nat.le_refl k, by simp⟩, h⟩) id,
          nodocMapRouteF hcol_land nodoc h_ind⟩
    | Or.inr _, Or.inr _, Or.inr _, Or.inl mk, _ =>
        ⟨[], fun _ h => absurd h (List.not_mem_nil),
          h_cov_in.imp (fun h => ⟨k, ⟨Nat.le_refl k, by simp⟩, h⟩) id,
          markerMapRouteF mk h_ind⟩
    | Or.inr _, Or.inr _, Or.inr _, Or.inr _, Or.inl pn =>
        ⟨[], fun _ h => absurd h (List.not_mem_nil),
          h_cov_in.imp (fun h => ⟨k, ⟨Nat.le_refl k, by simp⟩, h⟩) id,
          propsMapRouteF pn h_ind⟩
    | Or.inr _, Or.inr _, Or.inr _, Or.inr _, Or.inr _ =>
        ⟨[], fun _ h => absurd h (List.not_mem_nil),
          h_cov_in.imp (fun h => ⟨k, ⟨Nat.le_refl k, by simp⟩, h⟩) id,
          rootMapRouteF_or_refused h_ref_land hcol_land h_stream_land h_ind⟩
  -- ═══ **Item 197: the two ancestor readings, unioned.**  `h_explUp_chain` is
  -- the NESTED one — a caller filled the mapping this `?` heads into an outer
  -- frame's KEY slot (`slotLandedMap` at `nv + 1 ≤ k`) and handed back the
  -- chain the slot stood in.  `h_resV_land` is the DEDENT one — the landing
  -- stopped at a still-open level that itself stands inside an outer frame, so
  -- the entry this `?` heads CONTINUES that level and the frame's value line is
  -- what the level closes onto.  The two arrive at one park by different routes
  -- and end in the same body, and the landed `:` picks by its own column, so
  -- they ride one list (item 192's union, item 191's list). ═══
  have h_upAll : (∃ ns : List Nat, ∀ nv ∈ ns,
      ∀ sp_v : SurfPos, SBlockMapEntry k sp_ind sp_v →
      ∀ sp_i sp_c : SurfPos, SIndent nv sp_v sp_i → GLit ':' sp_i sp_c →
      ∀ sp_w : SurfPos, SBlockIndented nv .blockOut sp_c sp_w →
      SLYamlStream sp_start sp_w) ∨ PackAlt sc :=
    frameChainUnion h_explUp_chain
      (match h_resV_land with
       | Or.inl ⟨nv, _, _, contV⟩ =>
           Or.inl ⟨[nv], frameChainOne (a := nv) (resumeFrameRouteK h_ind contV)⟩
       | Or.inr h_alt => Or.inr h_alt)
  exact ⟨sp_land, sp_land, sp_land, sp_scan', h_stream_land,
         BlockStack.nil sp_land, FlowStackB.nil sp_land .sep,
         PendingNode.pendingMapValue (h_next := fun _ => dispatchBlock_question_next h_noflow_disp hpeek_disp h_dispatch) (h_offer := dispatchBlock_question_offerPred h_dispatch) sp_start sp_land sp_scan' k
           (fun sp_k h_node =>
             h_route51 sp_k
               (SBlockMapEntry.explicitEmpty k sp_ind sp_scan' sp_k h_lit
                 (SBlockIndented.node k .blockOut sp_scan' sp_k
                   (SBlockNode_blockIn_to_blockOut h_node))))
           h_floor_in hpk.1 hpk.2
           -- Item 125: a `?` does not stamp — it pays the face instead, the
           -- same `[186]` KEY slot `h_vslot` carries below.
           (Or.inr ⟨park_col_of_indicator hcol_land h_ind h_lit, fun sp_v h_sbi =>
             h_route51 sp_v
               (SBlockMapEntry.explicitEmpty k sp_ind sp_scan' sp_v h_lit h_sbi)⟩)
           -- Item 51: the `?` literal + the entry route (`h_expl`), and the
           -- KEY slot itself (`h_vslot`) — `[186]`'s `s-l+block-indented`,
           -- compact alternatives included (`? - a`, `? ? b`, `? : v`).
           (Or.inl ⟨sp_ind, h_lit, h_route51⟩)
           -- Item 209: and the slot's own stack top, the caller's measurement.
           (Or.inl ⟨h_top_in, park_col_of_indicator hcol_land h_ind h_lit,
             fun sp_v h_sbi =>
               h_route51 sp_v
                 (SBlockMapEntry.explicitEmpty k sp_ind sp_scan' sp_v h_lit h_sbi)⟩)
           (scanKey_simpleKeyAllowed (dispatchBlock_question_scanKey h_dispatch))
           -- Item 68: the same column the slot above carries, stated on its own.
           (by have := park_col_of_indicator hcol_land h_ind h_lit; omega)
           (Or.inl (by have := park_col_of_indicator hcol_land h_ind h_lit; omega))
           -- Item 93: this park's own value line is `h_expl`'s to serve — the
           -- consumers read the frame there; ~~the closure twin has no payer.~~
           -- **Item 189: the closure twin has one, and it is not this park's
           -- own frame but the one ABOVE it.**  `h_expl` is the entry THIS `?`
           -- heads and `h_kslot` the entry the landing stands inside, so a
           -- park nested in an outer frame carries both and the landed `:`
           -- picks by its own column.
           --
           -- **Item 196: off the CHAIN, which retires `h_kslot_up`.**  Item 189
           -- funded this from a separate `∃ nv` naming the NEAREST ancestor,
           -- beside `h_explUp_chain` carrying the whole chain on the same entry
           -- route — the pair item 194 read as duplicated.  It is not two
           -- readings: this composition narrows the entry route to the awaited
           -- BLOCK NODE, and it narrows a list exactly as it narrowed one
           -- index.  So the chain funds both fields and the narrow parameter
           -- has no remaining caller.
           -- **Item 197: off `h_upAll`**, which is this chain unioned with the
           -- landing's own value-line resume — the dedent reading, which
           -- reaches this park by a route the composition above cannot take.
           (match h_upAll with
            | Or.inl ⟨nsU, up⟩ => Or.inl ⟨nsU, fun nv hmem =>
                fun sp_m h_node sp_i sp_c h_iv h_clit sp_v h_sbi =>
                  up nv hmem sp_m
                    (SBlockMapEntry.explicitEmpty k sp_ind sp_scan' sp_m h_lit
                      (SBlockIndented.node k .blockOut sp_scan' sp_m
                        (SBlockNode_blockIn_to_blockOut h_node)))
                    sp_i sp_c h_iv h_clit sp_v h_sbi⟩
            | Or.inr _ => Or.inr trivial)
           -- Item 99: the resume frames — as at `colon_open_map`, with
           -- `[188]`'s `e-node` value in the empty entry's place
           -- (`k:⏎  ?⏎b: 2`).  Item 173: the levels below ride from the
           -- routes' own package, so a resumed park re-offers its levels.
           (Or.inl ⟨ksF, h_ltF, h_covF,
             fun sp_v h_node =>
               ResumeFrames.level k ksF sp_v h_ltF
                 (h_routeF sp_v
                   (SBlockMapEntry.explicitEmpty k sp_ind sp_scan' sp_v h_lit
                     (SBlockIndented.node k .blockOut sp_scan' sp_v
                       (SBlockNode_blockIn_to_blockOut h_node))))⟩)
           (Or.inl ⟨FrameLevel.map k :: ksF,
             -- Item 147: the `?`'s own `[187]` push stands at its column too.
             h_covF,
             fun sp_m h_ssl =>
               ResumeFrames.level k ksF sp_m h_ltF
                 (h_routeF sp_m
                   (SBlockMapEntry.explicitEmpty k sp_ind sp_scan' sp_m h_lit
                     (SBlockIndented.empty k .blockOut sp_scan' sp_m h_ssl)))⟩)
           -- ═══ Item 108: the value-line-bottomed faces, and this is the
           -- producer that pays them.  The stream faces just above close this
           -- `?` entry with `[188]`'s `e-node` value on the way down, which is
           -- what a dedent landing inside the key must NOT do.  Below the `?`
           -- there is no open mapping level at all — `ks = []` — and what
           -- stands at the bottom is the entry's own unpaid value line, which
           -- is `h_route51` read through `[188]`'s `explicit` alternative
           -- instead of `explicitEmpty`.  The two faces differ only in how the
           -- KEY slot is filled: by the awaited node, or empty on the
           -- landing's comments. ═══
           (Or.inl ⟨k, [], fun _ h => absurd h (List.not_mem_nil),
             -- **Item 150: the value-line stack's cover, seeded.**  `ks = []`
             -- names no frame, and the cover over it is not vacuous — it says
             -- the `?`'s own push left the stack with nothing at or right of
             -- `k + 1`, which is exactly where this lane's floor stands.
             h_cov_nil.imp (fun h =>
               ⟨k + 1, ⟨Nat.le_refl _, fun _ hx => absurd hx (List.not_mem_nil)⟩, h⟩) id,
             fun sp_v h_node =>
               KeyFrames.bottom sp_v
                 (fun sp_i sp_c h_iv h_colon sp_w h_sbi =>
                   h_route51 sp_w
                     (SBlockMapEntry.explicit k sp_ind sp_scan' sp_v sp_i sp_c sp_w h_lit
                       (SBlockIndented.node k .blockOut sp_scan' sp_v
                         (SBlockNode_blockIn_to_blockOut h_node))
                       h_iv h_colon h_sbi))⟩)
           (Or.inl ⟨k, [],
             -- Item 150: the same seed on the face the dedent landing pops.
             h_cov_nil.imp (fun h =>
               ⟨k + 1, ⟨Nat.le_refl _, fun _ hx => absurd hx (List.not_mem_nil)⟩, h⟩) id,
             fun sp_m h_ssl =>
               KeyFrames.bottom sp_m
                 (fun sp_i sp_c h_iv h_colon sp_w h_sbi =>
                   h_route51 sp_w
                     (SBlockMapEntry.explicit k sp_ind sp_scan' sp_m sp_i sp_c sp_w h_lit
                       (SBlockIndented.empty k .blockOut sp_scan' sp_m h_ssl)
                       h_iv h_colon h_sbi))⟩)
           (nodir_of_block_dispatch h_dispatch) (Or.inr trivial)
           -- ═══ **Item 190: the SLOT-premised twin of item 189's payment.**
           -- `h_kslot` above narrows `h_kslot_up` to the awaited BLOCK NODE,
           -- which is all `[195]` admits; this field keeps the entry route
           -- whole, so a consumer holding `[186]`'s slot fill — the compact
           -- `-`/`?`/`:` on this very line — can close this `?` entry EMPTY
           -- around it and reach the outer frame's line (`?⏎  ? -⏎: w`).
           --
           -- **Item 191: off the CHAIN, not off `h_kslot_up`.**  The entry
           -- route is the same for every ancestor — only the index of the `:`
           -- line that follows it differs — so the whole list rides one term.
           -- Item 197: the same union, so the compact lane reaches the dedent
           -- reading too.
           (match h_upAll with
            | Or.inl ⟨ns, up⟩ => Or.inl ⟨sp_ind, ns, h_lit, up⟩
            | Or.inr _ => Or.inr trivial),
         hcorr_result⟩

/-- **The explicit VALUE line** (item 51): a `:` landing at the pending
    entry's own column with the entry's value pack in hand — `[187]`'s
    `s-indent(n) ':'`, the second half of the ONE `[188]` explicit entry the
    `?` opened.  The pending parked here awaits the value slot,
    `[185] s-l+block-indented(n,block-out)`: `h_close` takes its block-node
    alternative, and `h_vslot` IS the slot, which is what the same-line
    `-`/`?`/`:` spends on the compact alternatives (`? a⏎: - w`).  The
    progress stream is the CLOSED reading of the pending (the caller's
    `h_close_pending` at the landing); the pack's route re-reads the same
    span as the entry's key half when the value completes — both are
    derivations, and the invariant only asks for one of each. -/
lemma colon_open_map_explicit (sp_start sp_scan sp_mid sp_ind : SurfPos) (nv : Nat)
    (s_prep s' : ScannerState) (sp_scan' : SurfPos)
    (h_stream_mid : SLYamlStream sp_start sp_mid)
    (hvp : ∀ sp_m sp_i sp_c : SurfPos,
      SSLComments sp_scan sp_m → SIndent nv sp_m sp_i → GLit ':' sp_i sp_c →
      ∀ sp_v : SurfPos, SBlockIndented nv .blockOut sp_c sp_v →
      SLYamlStream sp_start sp_v)
    (h_ssl : SSLComments sp_scan sp_mid)
    (hcol_mid : sp_mid.col = 0)
    (h_ind : SIndent nv sp_mid sp_ind)
    (hcorr_prep : ScannerSurfCorr s_prep sp_ind)
    (hcorr_result : ScannerSurfCorr s' sp_scan')
    -- Item 77: measured, like the keyless opener's — the park that could not
    -- fund it does not exist.  Item 179: at the SHIFTED index.
    (h_floor_in : IndentFloor s' (nv + 1))
    (hpeek : s_prep.peek? = some ':')
    (h_noflow_disp : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).inFlow = false)
    (h_nic_disp : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).needIndentCheck = false)
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) ':' = .ok (some s'))
    -- **Item 209 (LAST): the explicit `:`'s own stack TOP** (see
    -- `question_open_map.h_top_in`).  This opener pushes NOTHING —
    -- `scanValuePrepare`'s explicit branch leaves the stack alone — so the
    -- number is the dispatch state's floor unchanged, and the caller reads it
    -- off the landing that reached the `:`.
    (h_top_in : s'.currentIndent ≤ (nv : Int)) :
    ∃ sp_gram' sp_block' sp_flow' sp_scan',
      SLYamlStream sp_start sp_gram' ∧
      BlockStack sp_gram' sp_block' ∧
      FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
      PendingNode s' false sp_start sp_flow' sp_scan' ∧
      ScannerSurfCorr s' sp_scan' := by
  have hpeek_disp : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).peek? = some ':' := by
    split
    · show s_prep.peek? = some ':'; exact hpeek
    · exact hpeek
  obtain ⟨sp_colon, h_lit, hcorr_colon⟩ :=
    dispatchBlockValue_full_prod _ sp_ind
      (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_dispatch
  have hsp_eq := ScannerSurfCorr_unique hcorr_colon hcorr_result
  rw [hsp_eq] at h_lit
  have hpf := scanValue_ok_park_facts (dispatchBlock_colon_scanValue h_dispatch)
    h_noflow_disp h_nic_disp hpeek_disp
  have h_slot : ∀ sp_v, SBlockIndented nv .blockOut sp_scan' sp_v →
      SLYamlStream sp_start sp_v :=
    fun sp_v h_sbi => hvp sp_mid sp_ind sp_scan' h_ssl h_ind h_lit sp_v h_sbi
  exact ⟨sp_mid, sp_mid, sp_mid, sp_scan', h_stream_mid,
         BlockStack.nil sp_mid, FlowStackB.nil sp_mid .sep,
         PendingNode.pendingMapValue (h_next := fun _ => dispatchBlock_colon_next h_noflow_disp hpeek_disp h_dispatch) (h_offer := dispatchBlock_colon_offerPred h_dispatch) sp_start sp_mid sp_scan' nv
           (fun sp_v h_node =>
             h_slot sp_v (SBlockIndented.node nv .blockOut sp_scan' sp_v
               (SBlockNode_blockIn_to_blockOut h_node)))
           h_floor_in hpf.1 hpf.2.1
           -- Item 125: the explicit `:` does not stamp — it pays the face,
           -- the same `[185]` value slot `h_vslot` carries below.
           (Or.inr ⟨park_col_of_indicator hcol_mid h_ind h_lit, h_slot⟩)
           (Or.inr trivial)
           -- Item 209: and the slot's own stack top, the caller's measurement.
           (Or.inl ⟨h_top_in, park_col_of_indicator hcol_mid h_ind h_lit, h_slot⟩)
           (scanValue_simpleKeyAllowed (dispatchBlock_colon_scanValue h_dispatch))
           -- Item 68: the same column the slot above carries, stated on its own.
           (by have := park_col_of_indicator hcol_mid h_ind h_lit; omega)
           (Or.inl (by have := park_col_of_indicator hcol_mid h_ind h_lit; omega))
           -- Item 93: a VALUE park has no value line of its own.
           (Or.inr trivial)
             (Or.inr trivial)
             (Or.inr trivial)
             -- Item 108: nor a value-line-bottomed stack, for the same reason.
             (Or.inr trivial) (Or.inr trivial)
           (nodir_of_block_dispatch h_dispatch) (Or.inr trivial)
           -- Item 190: a VALUE park's slot is `[195]`'s, and the `?` whose
           -- entry route an outer frame's line composes against is not here.
           (Or.inr trivial),
         hcorr_result⟩

/-- **A compact `?` opens the same `[186]` explicit key a landed one does**
    (item 105) — the two fields `question_open_map` has paid since item 51,
    for the park one line over.

    `[195] ns-l-compact-mapping(n+1+m)`'s first entry is an ordinary `[188]`,
    so the `?` that heads it is `[186] c-l-block-map-explicit-key(n+1+m)` and
    owns both of the things a `?` owns: the ENTRY route any `[188]` at that
    index takes to the stream (`h_expl`, which is what keeps the entry open
    until its `:` value line lands) and the `[186]` KEY slot itself
    (`h_vslot` — `s-l+block-indented(n+1+m, block-out)`, compact alternatives
    included).  Both factor through ONE route into the enclosing entry's
    closure, which is why they are one lemma and not two.

    The asymmetry with the landed `?` is entirely in that route, and it is the
    same one `compact_open_map`'s own `h_close` already carries:
    `question_open_map` sends the finished entry through `rootBlockMap` + a
    bare document + `[211]`'s continuation, this sends it through
    `[195]` + `[185]`'s `compactMap` alternative to the `-` (or `?`, or `:`)
    that parked the pending.  Nothing about the KEY differs, which is why
    `- ? a: b` reads as `? {a: b}` exactly as `? a: b` does. -/
lemma compactExplicitKeyFrame {sp_start sp_entry sp_ind sp_scan' : SurfPos}
    {n m : Nat} {ctx : YamlContext}
    (h_close_old : ∀ sp, SBlockIndented n ctx sp_entry sp → SLYamlStream sp_start sp)
    (h_ind : SIndent m sp_entry sp_ind)
    (h_qlit : GLit '?' sp_ind sp_scan') :
    (∃ sp_q : SurfPos, GLit '?' sp_q sp_scan' ∧
      ∀ sp_v : SurfPos, SBlockMapEntry (n + 1 + m) sp_q sp_v →
        SLYamlStream sp_start sp_v) ∧
    (∀ sp_v : SurfPos, SBlockIndented (n + 1 + m) .blockOut sp_scan' sp_v →
      SLYamlStream sp_start sp_v) :=
  have h_route : ∀ sp_v : SurfPos, SBlockMapEntry (n + 1 + m) sp_ind sp_v →
      SLYamlStream sp_start sp_v := fun sp_v h_entry =>
    h_close_old sp_v
      (SBlockIndented.compactMap n ctx m sp_entry sp_ind sp_v h_ind
        (SCompactMap.mk (n + 1 + m) sp_ind sp_v sp_v h_entry
          (SCompactMapTail.nil (n + 1 + m) sp_v)))
  ⟨⟨sp_ind, h_qlit, h_route⟩,
   fun sp_v h_sbi => h_route sp_v
     (SBlockMapEntry.explicitEmpty (n + 1 + m) sp_ind sp_scan' sp_v h_qlit h_sbi)⟩

/-- **The COMPACT mapping** (item 33): the same two keyless openers, one line
    over.

    `colon_open_map`/`question_open_map` above need a column-0 landing, because
    what they build is `[187] l+block-mapping` under `[199]`'s
    `s-l-comments` — a collection that starts on a fresh line.  A `:` or a `?`
    that arrives on the SAME LINE as the `-` (or `?`, or `:`) that parked the
    pending has no such landing and never will: `[79] s-l-comments` needs a
    break or a line start, and this step crossed neither.  What the spec offers
    there instead is `[185] s-l+block-indented`'s second alternative,
    `s-indent(m) ns-l-compact-mapping(n+1+m)` — a mapping with NO leading
    comments, which is exactly the shape the input has.

    So the residue is not a weaker case of the landing arm; it is a different
    `[185]` alternative, and the pending is the SAME `pendingMapValue` the
    landing arm parks.  Only the frame around the awaited node changes: where
    `colon_open_map` wraps the entry in `rootBlockMap` + a bare document + the
    `[211]` continuation, this wraps it in `SCompactMap` + `compactMap` and
    hands it to the enclosing ENTRY's own closure.

    `h_floor` punts (Reflection 653).  Discharging it would need the pending's
    index to be known equal to its park column, which `pendingBlock` does not
    carry — so `- - |` and `- : |` read their block scalars at 0 rather than at
    the compact index, which is the same punt `  a: |` made before item 28. -/
lemma compact_open_map (sp_start sp_entry sp_ind : SurfPos) (n m : Nat)
    (ctx : YamlContext) (c : Char)
    (hc : c = ':' ∨ c = '?')
    (sc : ScannerState)
    (s_prep s' : ScannerState) (sp_block sp_scan' : SurfPos)
    (h_stream_block : SLYamlStream sp_start sp_block)
    (h_close_old : ∀ sp, SBlockIndented n ctx sp_entry sp → SLYamlStream sp_start sp)
    (h_ind : SIndent m sp_entry sp_ind)
    -- Item 63: the entry's own column, one past the `-` at `s-indent(n)`.
    -- With it the compact indicator's column IS the pending's index, which is
    -- what the floor lemmas measure the scanner's push against.
    (hcol_entry : sp_entry.col = n + 1)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (hcorr_prep : ScannerSurfCorr s_prep sp_ind)
    (hcorr_result : ScannerSurfCorr s' sp_scan')
    (hpeek : s_prep.peek? = some c)
    (h_noflow_disp : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).inFlow = false)
    (h_nic_disp : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).needIndentCheck = false)
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) c = .ok (some s'))
    -- Item 74 (LAST): the PARK's own armed save.  Both callers reach this
    -- lemma from a pending that just scanned an indicator (`pendingBlock`'s
    -- `h_sk`, `pendingMapValue`'s through `h_vslot`), and it is what turns the
    -- compact `:`'s floor from a measurement this producer might not be able
    -- to take into one it always can.
    (h_sk : sc.simpleKeyAllowed = true)
    -- Item 125: the compact `:`'s stamp source, decided by the caller's own
    -- case split (see `colon_open_map.h_src`); the `?` arm never reads it.
    (h_src : c = ':' → (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).explicitKeyLine = none ∨
      (scanValueClearKey (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep)).simpleKey.possible = true ∨
      ((if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).col : Int) ≠ (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).explicitKeyCol)
    -- **Item 209 (LAST): the compact indicator's own stack TOP** (see
    -- `question_open_map.h_top_in`).  The park this opener builds is the one
    -- an INLINE compact fill reaches, so the slot it opens carries the top
    -- the next fill will measure its own push against — the field feeding
    -- itself one park on, as `pendingBlock.h_park_top` does.
    (h_top_in : s'.currentIndent ≤ ((n + 1 + m : Nat) : Int))
    -- ═══ **Item 259: the park's own STACK — its shape and its top.**  The
    -- slot this opener parks awaits a resume stack, and the cover that stack
    -- owes (`pendingMapValue.h_closeF`) is paid from the state BEFORE the
    -- dispatch: on a monotone stack whose top is at or left of the park's
    -- index `n`, no mapping level stands at or right of column `n + 1`
    -- (`covered_nil_of_top_le`); preprocessing carries that across, and the
    -- indicator's own step opens at most one level, which the top pinned
    -- from both sides (`h_top_in` above, `h_floor` below) names as the
    -- slot's index.  Both callers hold both: the compact fill under the
    -- SLOT's bound `h_top_slot : sc ≤ nv`, the inline arm under the PARK's
    -- `h_top_old : sc ≤ n`, each beside its `h_mono`
    -- (`Tests/Guards/Proofs/PuntCoverInputs.lean` §6). ═══
    (h_mono : IndentStackMono.Mono sc)
    (h_top : sc.currentIndent ≤ (n : Int)) :
    ∃ sp_gram' sp_block' sp_flow' sp_scan',
      SLYamlStream sp_start sp_gram' ∧
      BlockStack sp_gram' sp_block' ∧
      FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
      PendingNode s' false sp_start sp_flow' sp_scan' ∧
      ScannerSurfCorr s' sp_scan' := by
  have hpeek_disp : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).peek? = some c := by
    split
    · show s_prep.peek? = some c; exact hpeek
    · exact hpeek
  -- One `[188]` entry per indicator; from there the two arms are identical.
  -- Item 179: the entry's awaited node reads at the SHIFTED index.
  have h_entry_of : ∀ sp_v, SBlockNode (n + 1 + m + 1) .blockIn sp_scan' sp_v →
      SBlockMapEntry (n + 1 + m) sp_ind sp_v := by
    cases hc with
    | inl h =>
      subst h
      obtain ⟨sp_colon, h_lit, hcorr_colon⟩ :=
        dispatchBlockValue_full_prod _ sp_ind
          (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_dispatch
      have hsp_eq := ScannerSurfCorr_unique hcorr_colon hcorr_result
      rw [hsp_eq] at h_lit
      exact fun sp_v h_node =>
        SBlockMapEntry.emptyKeyNode (n + 1 + m) sp_ind sp_scan' sp_v h_lit
          (SBlockNode_blockIn_to_blockOut h_node)
    | inr h =>
      subst h
      obtain ⟨sp_q, h_lit, hcorr_q⟩ :=
        dispatchBlockKey_full_prod _ sp_ind
          (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_dispatch
      have hsp_eq := ScannerSurfCorr_unique hcorr_q hcorr_result
      rw [hsp_eq] at h_lit
      exact fun sp_v h_node =>
        SBlockMapEntry.explicitEmpty (n + 1 + m) sp_ind sp_scan' sp_v h_lit
          (SBlockIndented.node (n + 1 + m) .blockOut sp_scan' sp_v
            (SBlockNode_blockIn_to_blockOut h_node))
  -- Item 68: the park is the character past the indicator, whichever indicator
  -- this is — the one fact both `[188]` alternatives share.
  have h_park_col : sp_scan'.col = sp_ind.col + 1 := by
    cases hc with
    | inl h =>
      subst h
      obtain ⟨sp_colon, h_lit, hcorr_colon⟩ :=
        dispatchBlockValue_full_prod _ sp_ind
          (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_dispatch
      rw [ScannerSurfCorr_unique hcorr_colon hcorr_result] at h_lit
      exact glit_col h_lit
    | inr h =>
      subst h
      obtain ⟨sp_q, h_lit, hcorr_q⟩ :=
        dispatchBlockKey_full_prod _ sp_ind
          (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_dispatch
      rw [ScannerSurfCorr_unique hcorr_q hcorr_result] at h_lit
      exact glit_col h_lit
  have h_qlit : c = '?' → GLit '?' sp_ind sp_scan' := by
    intro h
    subst h
    obtain ⟨sp_q, h_lit, hcorr_q⟩ :=
      dispatchBlockKey_full_prod _ sp_ind
        (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_dispatch
    rw [ScannerSurfCorr_unique hcorr_q hcorr_result] at h_lit
    exact h_lit
  have h_park_col' : sp_scan'.col = (n + 1 + m) + 1 := by
    have h1 := SIndent_col h_ind; rw [hcol_entry] at h1; omega
  have hpk : s'.needIndentCheck = false ∧ LastTokenReal s'.tokens ∧
      (s'.implicitValueLine = some s'.line ∨
        (sp_scan'.col = (n + 1 + m) + 1 ∧ ∀ sp_v : SurfPos,
          SBlockIndented (n + 1 + m) .blockOut sp_scan' sp_v →
            SLYamlStream sp_start sp_v)) ∧ s'.simpleKeyAllowed = true := by
    cases hc with
    | inl h =>
      subst h
      have hpf := scanValue_ok_park_facts (dispatchBlock_colon_scanValue h_dispatch)
        h_noflow_disp h_nic_disp hpeek_disp
      -- Item 125: the compact `:` stamps for REAL, off the caller's source.
      exact ⟨hpf.1, hpf.2.1,
        Or.inl (scanValue_stamp_of_src (dispatchBlock_colon_scanValue h_dispatch)
          h_noflow_disp hpeek_disp (h_src rfl)),
        scanValue_simpleKeyAllowed (dispatchBlock_colon_scanValue h_dispatch)⟩
    | inr h =>
      subst h
      have hpf := scanKey_ok_park_facts (dispatchBlock_question_scanKey h_dispatch)
        h_nic_disp
      -- Item 125: the compact `?` pays the face (item 105's frame).
      exact ⟨hpf.1, hpf.2,
        Or.inr ⟨h_park_col',
          (compactExplicitKeyFrame h_close_old h_ind (h_qlit rfl)).2⟩,
        scanKey_simpleKeyAllowed (dispatchBlock_question_scanKey h_dispatch)⟩
  -- Item 63: the pending's floor, from the push the dispatch just made.
  -- Item 74: neither indicator punts here.  The `?` needs only the flow level
  -- and the `:` only that plus the park's armed save, and this producer holds
  -- both — so the compact opener measures its floor where item 27's umbrella
  -- had to hand `True` back for the `:`.
  have h_floor : IndentFloor s' (n + 1 + m + 1) := by
    have hcol_ind : sp_ind.col = n + 1 + m := by
      have := SIndent_col h_ind; rw [hcol_entry] at this; omega
    cases hc with
    | inr h =>
      subst h
      exact indicator_floor_question_at_col hcol_ind hcorr_prep h_noflow_disp
        h_preprocess h_dispatch
    | inl h =>
      subst h
      exact indicator_floor_colon_at_col hcol_ind hcorr_prep h_noflow_disp h_sk
        h_preprocess h_dispatch
  -- Item 259: the top pinned from both sides — the floor the park measured
  -- (`h_floor`, at the shifted index) and the bound the step's own push obeys
  -- (`h_top_in`) — so the level the indicator opened IS the slot's index.
  have h_top_eq : s'.currentIndent = ((n + 1 + m : Nat) : Int) := by
    have h_lo := h_floor.2
    unfold minContentIndentOf at h_lo
    omega
  -- ═══ Item 105: the compact `?` is a `[186]` explicit key like any other, so
  -- it hands the two fields the column-0 opener has handed since item 51 — the
  -- `[188]` entry route (`h_expl`) and the `[186]` KEY slot (`h_vslot`).  What
  -- differs between the two producers is only the frame the finished entry
  -- goes into, and that difference is already carried by `h_close` above:
  -- `question_open_map` wraps the entry in `rootBlockMap` + a bare document +
  -- the `[211]` continuation, this one in `[195] ns-l-compact-mapping` handed
  -- to the ENCLOSING entry's own closure.  Both fields factor through that one
  -- route, which is why they cost a single `have`.
  --
  -- The `:` branch pays neither, and must not: `[189]`'s value is
  -- `s-l+block-node`, which has no compact alternative and opens no `[188]`
  -- entry of its own — its same-line key is refused from the stamp instead
  -- (item 101), which is the field `hpk.2.2.1` carries. ═══
  have h_expl105 : (∃ sp_q : SurfPos, GLit '?' sp_q sp_scan' ∧
      ∀ sp_v : SurfPos, SBlockMapEntry (n + 1 + m) sp_q sp_v →
        SLYamlStream sp_start sp_v) ∨ PackAlt sc :=
    match hc with
    | Or.inl _ => Or.inr trivial
    | Or.inr h => Or.inl (compactExplicitKeyFrame h_close_old h_ind (h_qlit h)).1
  have h_vslot105 : (s'.currentIndent ≤ ((n + 1 + m : Nat) : Int) ∧
      sp_scan'.col = (n + 1 + m) + 1 ∧ ∀ sp_v : SurfPos,
      SBlockIndented (n + 1 + m) .blockOut sp_scan' sp_v →
        SLYamlStream sp_start sp_v) ∨ s'.implicitValueLine = some s'.line :=
    match hc with
    | Or.inl h => Or.inr (by
        subst h
        exact scanValue_stamp_of_src (dispatchBlock_colon_scanValue h_dispatch)
          h_noflow_disp hpeek_disp (h_src rfl))
    | Or.inr h =>
      -- Item 209: and the slot's own stack top, the caller's measurement.
      Or.inl ⟨h_top_in, h_park_col',
        (compactExplicitKeyFrame h_close_old h_ind (h_qlit h)).2⟩
  exact ⟨sp_block, sp_block, sp_block, sp_scan', h_stream_block,
         BlockStack.nil sp_block, FlowStackB.nil sp_block .sep,
         PendingNode.pendingMapValue (h_next := fun _ => by
             rcases hc with rfl | rfl
             · exact dispatchBlock_colon_next h_noflow_disp hpeek_disp h_dispatch
             · exact dispatchBlock_question_next h_noflow_disp hpeek_disp h_dispatch) (h_offer := dispatchBlock_colon_or_question_offerPred hc h_dispatch) sp_start sp_block sp_scan' (n + 1 + m)
           (fun sp_v h_node =>
             h_close_old sp_v
               (SBlockIndented.compactMap n ctx m sp_entry sp_ind sp_v h_ind
                 (SCompactMap.mk (n + 1 + m) sp_ind sp_v sp_v (h_entry_of sp_v h_node)
                   (SCompactMapTail.nil (n + 1 + m) sp_v))))
           h_floor
           hpk.1 hpk.2.1 hpk.2.2.1 h_expl105 h_vslot105
           hpk.2.2.2
           -- Item 68: the indicator stands at `s-indent(m)` past the entry's own
           -- column, and the park is the character after it.
           (by have h1 := SIndent_col h_ind; rw [hcol_entry] at h1; omega)
           (Or.inl (by have h1 := SIndent_col h_ind; rw [hcol_entry] at h1; omega))
           -- Item 93: the keyless compact entry's value is `s-l+block-node`.
           (Or.inr trivial)
             -- ═══ **Item 259: the slot's RESUME STACK, covered from the caller's
             -- park.**  The frames below the slot's own collection are none;
             -- the cover is the caller's `Covered (n + 1) [] sc`
             -- (`covered_nil_of_top_le h_mono h_top`) carried across
             -- preprocessing and across the indicator's own step, whose
             -- opened level the pinned top names as the slot's index
             -- (`CoverStep.cons_of_top_eq h_top_eq`); the floor `n + 1` stands
             -- below the index `n + 1 + m` by the `s-indent(m)` in front of the
             -- indicator; and the level resumes on `[195]`'s compact mapping
             -- with its TAIL, the same frame `h_close` writes with a `nil` one.
             -- The list is `[n + 1 + m]`, the one level the mapping value
             -- park's `FrameLevel.map n :: ks` shape names for an empty `ks`. ═══
             (Or.inl ⟨[], fun _ h => absurd h List.not_mem_nil,
               Or.inl ⟨n + 1,
                 ⟨Nat.le_add_right (n + 1) m, fun k' hk => by
                   rw [List.mem_singleton] at hk; subst hk; dsimp only; omega⟩,
                 IndentStackCover.CoverStep.cons_of_top_eq
                   (IndentStackCover.dispatchBlockIndicators_cover h_dispatch
                     ((IndentStackCover.preprocess_cover h_preprocess
                         (IndentStackCover.covered_nil_of_top_le h_mono h_top)).of_indents_eq
                       (by split <;> rfl)))
                   h_top_eq⟩,
               fun sp_mid h_node =>
                 ResumeFrames.level (n + 1 + m) [] sp_mid
                   (fun _ h => absurd h List.not_mem_nil)
                   (fun sp_end h_tail => ResumeFrames.bottom sp_end
                     (h_close_old sp_end
                       (SBlockIndented.compactMap n ctx m sp_entry sp_ind sp_end h_ind
                         (SCompactMap.mk (n + 1 + m) sp_ind sp_mid sp_end
                           (h_entry_of sp_mid h_node) h_tail))))⟩)
             (Or.inr trivial)
             -- Item 108: the compact `?`'s own frame (`h_expl105`) could bottom
             -- a stack here the way `question_open_map` does; no landing inside
             -- a compact key reaches the dedent branch yet, so it stays unpaid
             -- rather than paid and unread.
             (Or.inr trivial) (Or.inr trivial)
           (nodir_of_block_dispatch h_dispatch) (Or.inr trivial)
           -- Item 190: the compact `?` has the literal but no outer frame's
           -- line reaches it — this park stands inside a COMPACT key, whose
           -- landing has yet to reach the branch that would spend one.
           (Or.inr trivial),
         hcorr_result⟩

-- The two KEYLESS block-mapping openers under one name (item 20).  They
-- compose different `[188]` alternatives, but the dispatch arm that reaches
-- them is character-for-character the same — same landing, same `hws`/`hcmt`
-- split, same pending — so the four block-dispatch producers take ONE branch
-- for both indicators rather than a copy each.
lemma indicator_open_map {sc : ScannerState}
    (sp_start sp_land sp_ind : SurfPos) (k : Nat) (c : Char)
    (hc : c = ':' ∨ c = '?')
    (s_prep s' : ScannerState) (sp_scan' : SurfPos)
    (h_stream_land : SLYamlStream sp_start sp_land)
    (hcol_land : sp_land.col = 0)
    (h_ind : SIndent k sp_land sp_ind)
    (hcorr_prep : ScannerSurfCorr s_prep sp_ind)
    (hcorr_result : ScannerSurfCorr s' sp_scan')
    -- Item 76: the FRESH SAVE, not the floor.  Both indicators push at their own
    -- column and the `?` measures that itself (item 74); what the `:` needs on
    -- top is that preprocessing re-saved, and this lemma's callers have two ways
    -- to know it — the park's armed flag, or the landing's own break.  Item 77
    -- made the pair EXHAUSTIVE (`landing_or_park_save`), so it is no longer an
    -- option.
    (h_save : s_prep.simpleKey.pos.col = s_prep.col)
    (hpeek : s_prep.peek? = some c)
    (h_noflow_disp : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).inFlow = false)
    (h_nic_disp : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).needIndentCheck = false)
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) c = .ok (some s'))
    -- Item 74 (LAST): the walk itself.  `h_floor_in` is now the `:` half's
    -- datum alone — the `?` half measures its own floor here, from the flow
    -- level this lemma already demands.
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    -- Item 125: the `:` half's stamp source (see `colon_open_map.h_src`),
    -- handed through; the `?` half never reads it.
    (h_src : c = ':' → (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).explicitKeyLine = none ∨
      (scanValueClearKey (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep)).simpleKey.possible = true ∨
      ((if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).col : Int) ≠ (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).explicitKeyCol)
    -- Item 118: the landing's open suffix arm, handed through to whichever
    -- opener the indicator selects.
    (h_sfx_land : SuffixRun sp_start sp_land ∨ True)
    -- Item 136: the landing's HEAD arm beside it — when the park behind this
    -- landing has started no document, the entry this indicator opens heads
    -- the stream's FIRST one (`: v`, `? k`), so the route is `nodocMapRoute`'s
    -- `single` rather than `rootMapRoute`'s implicit continuation of a stream
    -- with nothing in it.
    (h_nodoc_land : GStar SLDocumentPrefix sp_start sp_land ∨ True)
    -- Item 137: and the landing's MARKER arm, the fourth.  When the park
    -- behind this landing is a `---`, the entry this indicator opens is that
    -- document's own content (`---⏎: v`, `---⏎? k`), so the route hands it to
    -- `h_doc_route`'s bare-document slot instead of closing the marker with
    -- `e-node` and opening a second document beside it.
    (h_mk_land : MarkerNodeRoute sp_start sp_land ∨ True)
    -- Item 173: the landing's RESUME arm, handed through to whichever opener
    -- the indicator selects — the sibling entry continues the still-open
    -- level the landing's width names.
    (h_res_land : (∃ ks : List FrameLevel, (∀ fr ∈ ks, fr.width < k) ∧
      ∀ sp_end : SurfPos, SCompactMapTail k sp_land sp_end →
        ResumeFrames (SLYamlStream sp_start) ks sp_end) ∨ True)
    -- Item 142: §9.2's landing refusal, handed through to whichever opener
    -- the indicator selects.
    (h_ref_land : BareLandingFacts sc s_prep c ∨ True)
    -- **Item 147: the three readings the landing's own COVER is measured
    -- from**, as ONE optional bundle — the stack's shape (monotone, based) and
    -- the landing's floor, which the walk that reached a column-0 landing off a
    -- line start hands over (`preprocess_some_ssl_comments_anyCol`'s landed
    -- arm, item 147's fourth conjunct).  `Or.inr trivial` is what a park AT a
    -- line start pays: a landing that crossed nothing floored nothing, and its
    -- opener keeps the frames it already carries.
    (h_cov : (IndentStackMono.Mono sc ∧ IndentStackBase.SentinelBase sc ∧
      s_prep.currentIndent ≤ (s_prep.col : Int)) ∨ True)
    -- Item 175: the landing's PROPS arm, handed through to whichever opener
    -- the indicator selects — the entry heads the held sentinel run's own
    -- collection through `[196]`'s slot and the park's route.
    (h_pr_land : PropsNodeRoute sp_start sp_land ∨ True)
    -- ~~**Item 189 (LAST): the frame ONE LEVEL UP.**~~  **Item 196 retired it**
    -- where it was spent (`question_open_map`), so this relay no longer carries
    -- it.
    -- **Item 191 (LAST): the ancestor CHAIN**, handed to the `?` opener — and
    -- only the `?` half can take it: a `:` strictly inside an open `?` frame is
    -- refused by the scanner at the landing itself (`?⏎  : a⏎: w` — "value
    -- indicator ':' … expected column 0 to match block mapping indent"), so the
    -- `:` opener has no input to spend it on.
    (h_explUp_chain : (∃ ns : List Nat, ∀ nv ∈ ns,
      ∀ sp_v : SurfPos, SBlockMapEntry k sp_ind sp_v →
      ∀ sp_i sp_c : SurfPos, SIndent nv sp_v sp_i → GLit ':' sp_i sp_c →
      ∀ sp_w : SurfPos, SBlockIndented nv .blockOut sp_c sp_w →
      SLYamlStream sp_start sp_w) ∨ PackAlt sc)
    -- **Item 197 (LAST): the landing's resume arm at the VALUE-LINE bottom**,
    -- handed to BOTH openers — unlike `h_explUp_chain`, which only the `?` half
    -- can take.  The two halves have different inputs and the same shape: a `?`
    -- dedenting into a frame opens `[186]`'s explicit entry there
    -- (`?⏎  ?⏎    a: b⏎  ? c⏎: w`), and a `:` opens `[189]`'s empty-key one
    -- once the frame's own value line has already been spent
    -- (`?⏎  ?⏎    - a⏎  : b⏎  : c⏎: w` — the FIRST `:` is the inner frame's
    -- value, the second a sibling entry).  `h_res_land` is the same stack at
    -- the stream bottom; item 194 named this one and could not pay it because
    -- the arm it would have paid did not exist.
    (h_resV_land : (∃ (nv : Nat) (ks : List FrameLevel), (∀ fr ∈ ks, fr.width < k) ∧
      ∀ sp_end : SurfPos, SCompactMapTail k sp_land sp_end →
        KeyFrames (ExplValueLine sp_start nv) ks sp_end) ∨ PackAlt sc)
    -- **Item 209 (LAST): the DISPATCH's floor**, required rather than
    -- optional.  `h_cov` has carried this reading since item 147 as the third
    -- conjunct of an option, and the option's right arm was the park AT a
    -- line start — which item 208 closed at every caller (`h_nic0`, `h_ntop`,
    -- `h_park_top`).  So the floor stops being a bundle's passenger and
    -- becomes the premise `question_open_map`'s top is built from.
    (h_top_prep : s_prep.currentIndent ≤ (s_prep.col : Int)) :
    ∃ sp_gram' sp_block' sp_flow' sp_scan',
      SLYamlStream sp_start sp_gram' ∧
      BlockStack sp_gram' sp_block' ∧
      FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
      PendingNode s' false sp_start sp_flow' sp_scan' ∧
      ScannerSurfCorr s' sp_scan' := by
  have hcol_ind : sp_ind.col = k := by
    have := SIndent_col h_ind; rw [hcol_land] at this; omega
  -- Item 147: the cover, measured once here and handed to whichever opener the
  -- indicator selects.
  have h_cov_in : ∀ c', c' = ':' ∨ c' = '?' →
      scanNextToken_preprocess sc = .ok (some (s_prep, c')) →
      scanNextToken_dispatchBlockIndicators (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep) c' = .ok (some s') →
      (IndentStackCover.Covered k [FrameLevel.map k] s' ∧
        IndentStackCover.Covered (k + 1) [] s') ∨ True := by
    intro c' hc' hpre' hdis'
    rcases h_cov with ⟨hm, hb, hf⟩ | _
    · exact Or.inl (indicator_cover_at_col hc' hcol_ind hcorr_prep h_noflow_disp h_save
        hm hb hf hpre' hdis')
    · exact Or.inr trivial
  cases hc with
  | inl h =>
    subst h
    exact colon_open_map sp_start sp_land sp_ind k s_prep s' sp_scan' h_stream_land
      hcol_land h_ind hcorr_prep hcorr_result
      (indicator_floor_colon_at_col_of_save hcol_ind hcorr_prep
        h_noflow_disp h_save h_preprocess h_dispatch)
      hpeek h_noflow_disp h_nic_disp h_dispatch (h_src rfl) h_sfx_land h_nodoc_land
      h_mk_land h_res_land h_ref_land
      ((h_cov_in ':' (Or.inl rfl) h_preprocess h_dispatch).imp And.left id)
      h_pr_land h_resV_land
      -- Item 322: the alternative's transport, from this lemma's own step facts (`c = ':'` here).
      (PackAlt.step_value h_preprocess h_dispatch (noflow_of_noflow_disp h_noflow_disp))
  | inr h =>
    subst h
    exact question_open_map sp_start sp_land sp_ind k s_prep s' sp_scan' h_stream_land
      hcol_land h_ind hcorr_prep hcorr_result
      (indicator_floor_question_at_col hcol_ind hcorr_prep h_noflow_disp
        h_preprocess h_dispatch)
      hpeek h_noflow_disp h_nic_disp h_dispatch h_sfx_land h_nodoc_land h_mk_land
      h_res_land h_ref_land
      ((h_cov_in '?' (Or.inr rfl) h_preprocess h_dispatch).imp And.left id)
      -- Item 150: the value-line seed, off the same measurement — the `?`'s own
      -- level is the top, so nothing stands at or right of `k + 1`.
      ((h_cov_in '?' (Or.inr rfl) h_preprocess h_dispatch).imp And.right id)
      h_pr_land h_explUp_chain h_resV_land
      -- Item 209: the `?`'s own TOP, off the dispatch floor this relay now
      -- takes — `[187]`'s push goes to the indicator's column, so the floor
      -- that reached it bounds the stack it leaves.
      (indicator_top_kv_at_col (Or.inr rfl) hcol_ind hcorr_prep h_save
        h_noflow_disp h_top_prep h_dispatch)

/-- The head IS `[188]`, arm for arm: the plain head is `[193]`'s YAML key
    directly (`SNsPlain 0 .blockKey` IS `SNsPlainOneLine .blockKey`), a flow
    head is `[194]`'s JSON key, and the trailing `s-white*` is the
    `s-separate-in-line?` slot both alternatives end with. -/
lemma implicitKeyHead_to_SImplicitKey {s s₁ s' : SurfPos}
    (h : ImplicitKeyHead s s₁) (hws : GStar SSWhite s₁ s') : SImplicitKey s s' := by
  have hsep : GOpt SSeparateInLine s₁ s' :=
    ScalarProduction.gstar_sswhite_to_gopt_sep hws
  cases h with
  | yaml hp => exact SImplicitKey.yamlKey s s₁ s' hp hsep
  | json hn => exact SImplicitKey.jsonKey s s₁ s' hn hsep

-- The same-line `:` producer (item 15): the parked scalar re-reads as
-- `[193]`'s implicit key, and the value indicator opens the block mapping
-- at the LINE START the key is indented from — `colon_open_map` with
-- `SBlockMapEntry.implicitKeyNode` in the empty-key entry's place.  The
-- trailing separation slot ([66], zero-width `startOfLine` when the `:` is
-- adjacent) absorbs the pack's trailing whites plus whatever the `:` step's
-- own preprocessing consumed.  Item 16 widened `h_ol` from the plain reading
-- to `ImplicitKeyHead`, and item 17 re-cut that carrier along `[188]`'s own
-- two alternatives, so every head — plain, quoted, alias, property-prefixed —
-- reuses this producer unchanged.
--
-- Item 25 gave it the entry indent `k`; item 38 gave the FRAME back to the
-- producer.  `rootBlockMap k` + `SBlockMapEntries.single k` + the bare
-- document + `[211]`'s continuation is one way to spend a finished entry, and
-- `[195] ns-l-compact-mapping` inside `[185]`'s compact alternative is
-- another — so what this lemma keeps is the part that is the same either way:
-- `[188]`'s implicit-key entry, built from the pack's head and the `:` this
-- step just read, handed straight to the pack's own route.  The KEY is
-- untouched — `[193]`/`[194]` carry no indent — so the producers differ only
-- in where the entry goes.
lemma colon_open_map_implicit {alt : Prop} (sp_start sp_block sp_key sp_gram sp_ws : SurfPos) (k : Nat)
    (s_prep s' : ScannerState) (sp_scan' : SurfPos)
    (h_stream_block : SLYamlStream sp_start sp_block)
    (h_route : ∀ sp_v, SBlockMapEntry k sp_key sp_v → SLYamlStream sp_start sp_v)
    -- Item 93: the route's value-line twin (`ImplicitKeyPack`'s new face),
    -- handed on to the park so the inner value's own pending can pay its
    -- `h_vpack` (`? a: b⏎: - w`).
    (h_kslot : (∃ ns : List Nat, ∀ nv ∈ ns,
      ∀ sp_v : SurfPos, SBlockMapEntry k sp_key sp_v →
      ∀ sp_e : SurfPos, SCompactMapTail k sp_v sp_e →
      ∀ sp_i sp_c : SurfPos, SIndent nv sp_e sp_i → GLit ':' sp_i sp_c →
      ∀ sp_w : SurfPos, SBlockIndented nv .blockOut sp_c sp_w →
      SLYamlStream sp_start sp_w) ∨ alt)
    -- Item 99: the pack's RESUME twin, handed on so the park it opens can
    -- pay its own frames — the transport face off the completed entry, and
    -- the spend face off the empty one (`k:⏎  a:⏎b: 2`'s `b`).
    -- Item 148: …and the SCANNER stack under those levels, read at the step's
    -- own state.  The caller carries it here from the pack across
    -- preprocessing (`IndentStackCover.preprocess_cover`, which only pops);
    -- the `:` below is the writer, and it writes at the KEY's column, which
    -- the list already names.
    (h_routeF : (∃ ks : List FrameLevel, (∀ fr ∈ ks, fr.width < k) ∧
      ((∃ lo : Nat, IndentStackCover.Floor lo k (FrameLevel.map k :: ks) ∧
        IndentStackCover.Covered lo (FrameLevel.map k :: ks) s_prep) ∨ True) ∧
      ∀ sp_v : SurfPos, SBlockMapEntry k sp_key sp_v →
      ∀ sp_e : SurfPos, SCompactMapTail k sp_v sp_e →
      ResumeFrames (SLYamlStream sp_start) ks sp_e) ∨ True)
    -- Item 108: the pack's value-line-bottomed twin, handed on the same way —
    -- this is the hop that carries an enclosing `?` frame down one mapping
    -- level, so a landing deeper inside the key can still pop back to it.
    (h_routeFV : (∃ (nv : Nat) (ks : List FrameLevel), (∀ fr ∈ ks, fr.width < k) ∧
      -- Item 150: the value-line pack field's cover, handed across the `:`.
      ((∃ lo : Nat, IndentStackCover.Floor lo k (FrameLevel.map k :: ks) ∧
        IndentStackCover.Covered lo (FrameLevel.map k :: ks) s_prep) ∨ True) ∧
      ∀ sp_v : SurfPos, SBlockMapEntry k sp_key sp_v →
      ∀ sp_e : SurfPos, SCompactMapTail k sp_v sp_e →
      KeyFrames (ExplValueLine sp_start nv) ks sp_e) ∨ alt)
    (h_ol : ImplicitKeyHead sp_key sp_gram)
    (h_ws : GStar SSWhite sp_gram sp_ws)
    (hcorr_prep : ScannerSurfCorr s_prep sp_ws)
    (hcorr_result : ScannerSurfCorr s' sp_scan')
    (hpeek : s_prep.peek? = some ':')
    (h_noflow_disp : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).inFlow = false)
    (h_nic_disp : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).needIndentCheck = false)
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) ':' = .ok (some s'))
    -- Item 81: the floor is REAL — `implicit_key_floor` is total now.
    -- Item 179: at the SHIFTED index, off the same push at the key's column.
    (h_floor : IndentFloor s' (k + 1))
    -- ═══ Item 125: the KEY the `:` resolves is what makes the stamp REAL —
    -- `scanValue` computes `explicitValue = ekl.isSome && !possible && …`,
    -- and a possible key strictly behind the cursor on the `:`'s own line
    -- (the pack's guard plus `KeysBehindCursor`, both transported by the
    -- caller through the same no-break conjuncts as the floor) forces the
    -- stamp arm whatever the register holds. ═══
    (h_poss_pp : s_prep.simpleKey.possible = true)
    (h_kline_pp : s_prep.simpleKey.pos.line = s_prep.line)
    (h_behind_pp : s_prep.simpleKey.pos.offset ≠ s_prep.offset)
    -- Item 148: the fourth of the same trio — the column the `:` opens at.
    (h_kcol_pp : s_prep.simpleKey.pos.col = k)
    -- **Item 168 — the pack's SEQUENCE face, handed across the `:`** (LAST, so
    -- the existing call sites keep their argument order).  This is the hop that
    -- carries the enclosing `[183]` down into the mapping the key opens: the
    -- entry the `:` is about to fill, its level's own tail behind it, and the
    -- collection's remaining tail underneath.  The park it opens pays its
    -- `h_seqF` from it, and the value's own content park pays from that — which
    -- is how `- sku: BL394D⏎  quantity: 4⏎- sku: BL4438H` keeps the second `-`
    -- inside the sequence it stands in.
    -- Item 169: the levels between the entry and the collection ride with it.
    (h_routeS : (∃ (ke : Nat) (ks : List FrameLevel), (∀ fr ∈ ks, fr.width < k) ∧
      ∀ sp_v : SurfPos, SBlockMapEntry k sp_key sp_v →
      ∀ sp_e : SurfPos, SCompactMapTail k sp_v sp_e →
      ResumeFrames (SeqEntryTail sp_start ke) ks sp_e) ∨ True)
    -- Item 322 (LAST): the generic alternative's transport across the `:`, supplied by the caller
    -- (`colon_fires_implicit_key` passes `PackAlt.step_value …` for `alt := PackAlt sc`).
    (h_alt_step : alt → PackAlt s') :
    ∃ sp_gram' sp_block' sp_flow' sp_scan',
      SLYamlStream sp_start sp_gram' ∧
      BlockStack sp_gram' sp_block' ∧
      FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
      PendingNode s' false sp_start sp_flow' sp_scan' ∧
      ScannerSurfCorr s' sp_scan' := by
  have hpeek_disp : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).peek? = some ':' := by
    split
    · show s_prep.peek? = some ':'; exact hpeek
    · exact hpeek
  obtain ⟨sp_colon, h_lit, hcorr_colon⟩ :=
    dispatchBlockValue_full_prod _ sp_ws
      (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_dispatch
  have hsp_eq := ScannerSurfCorr_unique hcorr_colon hcorr_result
  rw [hsp_eq] at h_lit
  have h_ik : SImplicitKey sp_key sp_ws := implicitKeyHead_to_SImplicitKey h_ol h_ws
  have hpf := scanValue_ok_park_facts (dispatchBlock_colon_scanValue h_dispatch)
    h_noflow_disp h_nic_disp hpeek_disp
  -- Item 125: the resolved key's three facts, read on the dispatch state
  -- (the `allowDirectives` update touches none of them).
  have h_stamp : s'.implicitValueLine = some s'.line :=
    ExplicitKeyCoupling.scanValue_stamp_of_key
      (dispatchBlock_colon_scanValue h_dispatch) h_noflow_disp hpeek_disp
      (by split <;> exact h_poss_pp)
      (by split <;> exact h_behind_pp)
      (by split <;> exact h_kline_pp)
  -- **Item 148: the cover crosses the `:`.**  `scanValuePrepare` opens at the
  -- KEY's column, which the pack's list already names, so the step adds a
  -- width the frames have and the cover comes out over the same list.
  have h_cov_step : ∀ (lo : Nat) (ks : List FrameLevel),
      IndentStackCover.Covered lo (FrameLevel.map k :: ks) s_prep →
      IndentStackCover.Covered lo (FrameLevel.map k :: ks) s' := fun lo ks hc =>
    (IndentStackCover.scanValue_cover_key (k := k)
      (dispatchBlock_colon_scanValue h_dispatch)
      (by split <;> exact h_poss_pp) (by split <;> exact h_kcol_pp)
      (hc.of_indents_eq (by split <;> rfl))).dedup_head
  exact ⟨sp_block, sp_block, sp_block, sp_scan', h_stream_block,
         BlockStack.nil sp_block, FlowStackB.nil sp_block .sep,
         PendingNode.pendingMapValue (h_next := fun _ => dispatchBlock_colon_next h_noflow_disp hpeek_disp h_dispatch) (h_offer := dispatchBlock_colon_offerPred h_dispatch) sp_start sp_block sp_scan' k
           (fun sp_v h_node =>
             h_route sp_v
               (SBlockMapEntry.implicitKeyNode k sp_key sp_ws sp_scan' sp_v h_ik h_lit
                 (SBlockNode_blockIn_to_blockOut h_node)))
           h_floor hpf.1 hpf.2.1 (Or.inl h_stamp) (Or.inr trivial) (Or.inr h_stamp)
           (scanValue_simpleKeyAllowed (dispatchBlock_colon_scanValue h_dispatch))
           -- Item 68: the `:` is a character, so the park is past column 0.  The
           -- INDEX is the half this producer cannot measure: `k` reaches it
           -- through `ImplicitKeyPack`, which carries the key's route and not the
           -- key's column, so `h_ncol` still punts (the floor stopped at item 81).
           (by have := glit_col h_lit; omega) (Or.inr trivial)
           -- Item 93: the pack's twin rides into the park — the entry folded
           -- in exactly as the closure above folds it, with a `nil` tail.
           -- Item 196: the fold is per-ancestor and the list rides through it
           -- untouched — the entry and the tail are the same for every index.
           (match h_kslot with
            | Or.inl ⟨ns, kslot⟩ => Or.inl ⟨ns, fun nv hmem =>
                fun sp_m h_node sp_i sp_c h_iv h_lit_v sp_v h_sbi =>
                  kslot nv hmem sp_m
                    (SBlockMapEntry.implicitKeyNode k sp_key sp_ws sp_scan' sp_m h_ik h_lit
                      (SBlockNode_blockIn_to_blockOut h_node))
                    sp_m (SCompactMapTail.nil k sp_m)
                    sp_i sp_c h_iv h_lit_v sp_v h_sbi⟩
            | Or.inr h_alt => Or.inr (h_alt_step h_alt))
             -- Item 99: the pack's resume twin pays both faces — the
             -- completed entry re-opens level `k` for the transport, and the
             -- EMPTY entry (`[189]`'s value that never arrived) does the
             -- same for the park's own dedent landing.
             (match h_routeF with
              | Or.inl ⟨ks, h_lt, h_cov, routeF⟩ => Or.inl ⟨ks, h_lt,
                  -- Item 148: the pack's stack, stepped across the `:`.
                  h_cov.imp (fun ⟨lo, hb, hc⟩ => ⟨lo, hb, h_cov_step lo ks hc⟩) id,
                  fun sp_mid h_node =>
                    ResumeFrames.level k ks sp_mid h_lt
                      (fun sp_end h_tail =>
                        routeF sp_mid
                          (SBlockMapEntry.implicitKeyNode k sp_key sp_ws sp_scan' sp_mid
                            h_ik h_lit (SBlockNode_blockIn_to_blockOut h_node))
                          sp_end h_tail)⟩
              | Or.inr _ => Or.inr trivial)
             (match h_routeF with
              | Or.inl ⟨ks, h_lt, h_cov, routeF⟩ => Or.inl ⟨FrameLevel.map k :: ks,
                  -- **Item 148: the chain's own hop.**  The widths grow by this
                  -- entry's level and the floor does not move, which is the
                  -- pack's field spent: a cover seeded at a root reaches a park
                  -- any number of implicit keys deep.
                  h_cov.imp (fun ⟨lo, hb, hc⟩ => ⟨lo, hb, h_cov_step lo ks hc⟩) id,
                  fun sp_mid h_ssl =>
                    ResumeFrames.level k ks sp_mid h_lt
                      (fun sp_end h_tail =>
                        routeF sp_mid
                          (SBlockMapEntry.implicitKeyEmpty k sp_key sp_ws sp_scan' sp_mid
                            h_ik h_lit h_ssl)
                          sp_end h_tail)⟩
              | Or.inr _ => Or.inr trivial)
             -- Item 108: the same two faces on the value-line-bottomed stack.
             -- This entry's own level `k` goes on top of whatever the pack
             -- carried, and the `?` frame stays at the bottom — so a landing
             -- that pops to `k` here is a SIBLING inside the explicit key and
             -- the key is still open when its `:` line arrives.
             (match h_routeFV with
              | Or.inl ⟨nv, ks, h_lt, h_covV, routeFV⟩ => Or.inl ⟨nv, FrameLevel.map k :: ks,
                  fun k' hk' => by
                    rcases List.mem_cons.mp hk' with h | h
                    · subst h; dsimp only; omega
                    · exact Nat.le_of_lt (h_lt k' h),
                  -- Item 150: the value-line chain's own hop — the widths grow by
                  -- this entry's level, and the floor climbs only as far as the
                  -- park's index demands (`n + 1` here, `n` at the pack).
                  h_covV.imp (fun ⟨lo, hb, hc⟩ =>
                    ⟨lo, hb.mono_index (Nat.le_succ k), h_cov_step lo ks hc⟩) id,
                  fun sp_mid h_node =>
                    KeyFrames.mapLevel k ks sp_mid h_lt
                      (fun sp_end h_tail =>
                        routeFV sp_mid
                          (SBlockMapEntry.implicitKeyNode k sp_key sp_ws sp_scan' sp_mid
                            h_ik h_lit (SBlockNode_blockIn_to_blockOut h_node))
                          sp_end h_tail)⟩
              | Or.inr h_alt => Or.inr (h_alt_step h_alt))
             (match h_routeFV with
              | Or.inl ⟨nv, ks, h_lt, h_covV, routeFV⟩ => Or.inl ⟨nv, FrameLevel.map k :: ks,
                  -- Item 150: the value-line chain's own hop — the widths grow by
                  -- this entry's level, and the floor climbs only as far as the
                  -- park's index demands (`n + 1` here, `n` at the pack).
                  h_covV.imp (fun ⟨lo, hb, hc⟩ =>
                    ⟨lo, hb.mono_index (Nat.le_succ k), h_cov_step lo ks hc⟩) id,
                  fun sp_mid h_ssl =>
                    KeyFrames.mapLevel k ks sp_mid h_lt
                      (fun sp_end h_tail =>
                        routeFV sp_mid
                          (SBlockMapEntry.implicitKeyEmpty k sp_key sp_ws sp_scan' sp_mid
                            h_ik h_lit h_ssl)
                          sp_end h_tail)⟩
              | Or.inr h_alt => Or.inr (h_alt_step h_alt))
           (nodir_of_block_dispatch h_dispatch)
           -- **Item 168: the sequence face, carried onto the park.**  The
           -- awaited node fills THIS entry; the entry's own `[187]` level stays
           -- tail-open behind it (so a sibling key at the same width conses),
           -- and what the pack's face names underneath is the enclosing
           -- collection's remaining tail rather than the finished stream.
           (match h_routeS with
            | Or.inl ⟨ke, ks, h_lt, routeS⟩ => Or.inl ⟨ke, ks, h_lt,
                fun sp_v h_node sp_e h_tail =>
                  routeS sp_v
                    (SBlockMapEntry.implicitKeyNode k sp_key sp_ws sp_scan' sp_v h_ik h_lit
                      (SBlockNode_blockIn_to_blockOut h_node))
                    sp_e h_tail⟩
            | Or.inr _ => Or.inr trivial)
           -- Item 190: an IMPLICIT key opens no `?` entry, so there is no
           -- literal to head the route an outer frame's value line needs.
           (Or.inr trivial),
         hcorr_result⟩

/-- **The anchored null key** (item 49): the parked `[96]` run IS the implicit
    key — `[161]`'s props-only `ns-flow-yaml-node` under `[193]`, `&a : b` —
    and the `:` parks the SAME `pendingMapValue` every keyed opener parks.
    The pack's entry route closes it; the floor punts (Reflection 653 — the
    run's own column is the pack's optional datum, not this producer's). -/
lemma colon_open_map_props (sp_start sp_block sp_p sp_scan : SurfPos) (k : Nat)
    (sc : ScannerState)
    (s_prep s' : ScannerState) (sp_prep sp_scan' : SurfPos)
    (h_route : ∀ sp_v, SBlockMapEntry k sp_p sp_v → SLYamlStream sp_start sp_v)
    -- Item 94: the pack's value-line pair (item 93's shape, at the run's
    -- start) — spent into the park's own twin below.
    (h_kslot : (∃ ns : List Nat, ∀ nv ∈ ns,
      ∀ sp_v : SurfPos, SBlockMapEntry k sp_p sp_v →
      ∀ sp_e : SurfPos, SCompactMapTail k sp_v sp_e →
      ∀ sp_i sp_c : SurfPos, SIndent nv sp_e sp_i → GLit ':' sp_i sp_c →
      ∀ sp_w : SurfPos, SBlockIndented nv .blockOut sp_c sp_w →
      SLYamlStream sp_start sp_w) ∨ PackAlt sc)
    -- Item 111: the pack's RESUME twins (`colon_open_map_implicit`'s items
    -- 99/108 premises, verbatim at the run's start) — handed on so the park
    -- this `:` opens can pay its own frames, which is what keeps the levels
    -- for the landing AFTER an anchored null key
    -- (`k:⏎  m:⏎    - a⏎  &p : 2⏎o: 3`).
    -- Item 148: and the scanner stack under them, as at
    -- `colon_open_map_implicit` — this producer reads the key off `sc` and
    -- `h_inh`, so the transport across the `:` is its own.
    (h_routeF : (∃ ks : List FrameLevel, (∀ fr ∈ ks, fr.width < k) ∧
      ((∃ lo : Nat, IndentStackCover.Floor lo k (FrameLevel.map k :: ks) ∧
        IndentStackCover.Covered lo (FrameLevel.map k :: ks) s_prep) ∨ True) ∧
      ∀ sp_v : SurfPos, SBlockMapEntry k sp_p sp_v →
      ∀ sp_e : SurfPos, SCompactMapTail k sp_v sp_e →
      ResumeFrames (SLYamlStream sp_start) ks sp_e) ∨ True)
    (h_routeFV : (∃ (nv : Nat) (ks : List FrameLevel), (∀ fr ∈ ks, fr.width < k) ∧
      -- Item 150: the value-line pack field's cover, handed across the `:`.
      ((∃ lo : Nat, IndentStackCover.Floor lo k (FrameLevel.map k :: ks) ∧
        IndentStackCover.Covered lo (FrameLevel.map k :: ks) s_prep) ∨ True) ∧
      ∀ sp_v : SurfPos, SBlockMapEntry k sp_p sp_v →
      ∀ sp_e : SurfPos, SCompactMapTail k sp_v sp_e →
      KeyFrames (ExplValueLine sp_start nv) ks sp_e) ∨ PackAlt sc)
    (h_props : SCNsProperties 0 .blockKey sp_p sp_scan)
    (h_ws : GStar SSWhite sp_scan sp_prep)
    -- Item 63: the pack's own coordinates — the key exists and sits at the
    -- entry's column — spent into `[187]`'s push through `implicit_key_floor`.
    (h_poss : sc.simpleKey.possible = true)
    (h_kcol : sc.simpleKey.pos.col = k)
    -- Item 80: the step INHERITED the key — derived by the caller from the
    -- park's own flag (`h_ska`) and the no-break transport.
    (h_inh : s_prep.simpleKey = sc.simpleKey)
    -- Item 81: the run's key is on the `:`'s line and strictly behind its
    -- cursor — the pack's guard and `KeysBehindCursor`, transported by the
    -- caller through the same no-break conjuncts.
    (h_kline : s_prep.simpleKey.pos.line = s_prep.line)
    (h_behind : s_prep.simpleKey.pos.offset ≠ s_prep.offset)
    (h_noflow : s_prep.inFlow = false)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, ':')))
    (h_stream_block : SLYamlStream sp_start sp_block)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (hcorr_result : ScannerSurfCorr s' sp_scan')
    (hpeek : s_prep.peek? = some ':')
    (h_noflow_disp : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).inFlow = false)
    (h_nic_disp : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).needIndentCheck = false)
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) ':' = .ok (some s')) :
    ∃ sp_gram' sp_block' sp_flow' sp_scan',
      SLYamlStream sp_start sp_gram' ∧
      BlockStack sp_gram' sp_block' ∧
      FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
      PendingNode s' false sp_start sp_flow' sp_scan' ∧
      ScannerSurfCorr s' sp_scan' := by
  have hpeek_disp : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).peek? = some ':' := by
    split
    · show s_prep.peek? = some ':'; exact hpeek
    · exact hpeek
  obtain ⟨sp_colon, h_lit, hcorr_colon⟩ :=
    dispatchBlockValue_full_prod _ sp_prep
      (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_dispatch
  have hsp_eq := ScannerSurfCorr_unique hcorr_colon hcorr_result
  rw [hsp_eq] at h_lit
  have h_ik : SImplicitKey sp_p sp_prep :=
    SImplicitKey.jsonKey sp_p sp_scan sp_prep
      (SFlowNode.propsEmpty 0 .blockKey sp_p sp_scan h_props)
      (ScalarProduction.gstar_sswhite_to_gopt_sep h_ws)
  have hpf := scanValue_ok_park_facts (dispatchBlock_colon_scanValue h_dispatch)
    h_noflow_disp h_nic_disp hpeek_disp
  -- Item 125: the resolved key makes the stamp REAL (see
  -- `colon_open_map_implicit`) — this lemma already holds all three facts.
  have h_stamp : s'.implicitValueLine = some s'.line :=
    ExplicitKeyCoupling.scanValue_stamp_of_key
      (dispatchBlock_colon_scanValue h_dispatch) h_noflow_disp hpeek_disp
      (by split <;> (rw [h_inh]; exact h_poss))
      (by split <;> exact h_behind)
      (by split <;> exact h_kline)
  -- Item 148: the same hop as at `colon_open_map_implicit` — the key this
  -- producer resolves is `sc`'s, inherited across the no-break landing.
  have h_cov_step : ∀ (lo : Nat) (ks : List FrameLevel),
      IndentStackCover.Covered lo (FrameLevel.map k :: ks) s_prep →
      IndentStackCover.Covered lo (FrameLevel.map k :: ks) s' := fun lo ks hc =>
    (IndentStackCover.scanValue_cover_key (k := k)
      (dispatchBlock_colon_scanValue h_dispatch)
      (by split <;> (rw [h_inh]; exact h_poss))
      (by split <;> (rw [h_inh]; exact h_kcol))
      (hc.of_indents_eq (by split <;> rfl))).dedup_head
  exact ⟨sp_block, sp_block, sp_block, sp_scan', h_stream_block,
         BlockStack.nil sp_block, FlowStackB.nil sp_block .sep,
         PendingNode.pendingMapValue (h_next := fun _ => dispatchBlock_colon_next h_noflow_disp hpeek_disp h_dispatch) (h_offer := dispatchBlock_colon_offerPred h_dispatch) sp_start sp_block sp_scan' k
           (fun sp_v h_node =>
             h_route sp_v
               (SBlockMapEntry.implicitKeyNode k sp_p sp_prep sp_scan' sp_v h_ik h_lit
                 (SBlockNode_blockIn_to_blockOut h_node)))
           (implicit_key_floor h_poss h_kcol h_inh h_kline h_behind
             h_noflow h_preprocess h_dispatch)
           hpf.1 hpf.2.1 (Or.inl h_stamp) (Or.inr trivial) (Or.inr h_stamp)
           (scanValue_simpleKeyAllowed (dispatchBlock_colon_scanValue h_dispatch))
           -- Item 68: `colon_open_map_implicit`'s boundary, for its reason — the
           -- run's own column is the pack's optional datum, not this producer's.
           (by have := glit_col h_lit; omega) (Or.inr trivial)
           -- Item 94: the park's twin, from the pack's pair — the completed
           -- inner value folds into the props-headed entry, `nil` tail
           -- (`? &p : b⏎: - w`; `colon_open_map_implicit`'s payment, with
           -- the props-empty key in the entry's head).
           -- Item 196: a chain, as at `colon_open_map_implicit`.
           (match h_kslot with
            | Or.inl ⟨ns, kslot⟩ => Or.inl ⟨ns, fun nv hmem =>
                fun sp_m h_node sp_i sp_c h_iv h_lit_v sp_v h_sbi =>
                  kslot nv hmem sp_m
                    (SBlockMapEntry.implicitKeyNode k sp_p sp_prep sp_scan' sp_m h_ik h_lit
                      (SBlockNode_blockIn_to_blockOut h_node))
                    sp_m (SCompactMapTail.nil k sp_m)
                    sp_i sp_c h_iv h_lit_v sp_v h_sbi⟩
            | Or.inr h_alt => Or.inr (PackAlt.step_value h_preprocess h_dispatch h_noflow h_alt))
             -- Item 111: the pack CARRIES frames now, so the anchored null
             -- key pays the four faces exactly as `colon_open_map_implicit`
             -- does — the completed entry re-opens level `k` for the
             -- transport, the EMPTY entry does the same for the park's own
             -- dedent landing, on both bottoms.
             (match h_routeF with
              | Or.inl ⟨ks, h_lt, h_cov, routeF⟩ => Or.inl ⟨ks, h_lt,
                  h_cov.imp (fun ⟨lo, hb, hc⟩ => ⟨lo, hb, h_cov_step lo ks hc⟩) id,
                  fun sp_mid h_node =>
                    ResumeFrames.level k ks sp_mid h_lt
                      (fun sp_end h_tail =>
                        routeF sp_mid
                          (SBlockMapEntry.implicitKeyNode k sp_p sp_prep sp_scan' sp_mid
                            h_ik h_lit (SBlockNode_blockIn_to_blockOut h_node))
                          sp_end h_tail)⟩
              | Or.inr _ => Or.inr trivial)
             (match h_routeF with
              | Or.inl ⟨ks, h_lt, h_cov, routeF⟩ => Or.inl ⟨FrameLevel.map k :: ks,
                  -- Item 148: the anchored null key is a hop like any other.
                  h_cov.imp (fun ⟨lo, hb, hc⟩ => ⟨lo, hb, h_cov_step lo ks hc⟩) id,
                  fun sp_mid h_ssl =>
                    ResumeFrames.level k ks sp_mid h_lt
                      (fun sp_end h_tail =>
                        routeF sp_mid
                          (SBlockMapEntry.implicitKeyEmpty k sp_p sp_prep sp_scan' sp_mid
                            h_ik h_lit h_ssl)
                          sp_end h_tail)⟩
              | Or.inr _ => Or.inr trivial)
             (match h_routeFV with
              | Or.inl ⟨nv, ks, h_lt, h_covV, routeFV⟩ => Or.inl ⟨nv, FrameLevel.map k :: ks,
                  fun k' hk' => by
                    rcases List.mem_cons.mp hk' with h | h
                    · subst h; dsimp only; omega
                    · exact Nat.le_of_lt (h_lt k' h),
                  -- Item 150: the value-line chain's own hop — the widths grow by
                  -- this entry's level, and the floor climbs only as far as the
                  -- park's index demands (`n + 1` here, `n` at the pack).
                  h_covV.imp (fun ⟨lo, hb, hc⟩ =>
                    ⟨lo, hb.mono_index (Nat.le_succ k), h_cov_step lo ks hc⟩) id,
                  fun sp_mid h_node =>
                    KeyFrames.mapLevel k ks sp_mid h_lt
                      (fun sp_end h_tail =>
                        routeFV sp_mid
                          (SBlockMapEntry.implicitKeyNode k sp_p sp_prep sp_scan' sp_mid
                            h_ik h_lit (SBlockNode_blockIn_to_blockOut h_node))
                          sp_end h_tail)⟩
              | Or.inr h_alt => Or.inr (PackAlt.step_value h_preprocess h_dispatch h_noflow h_alt))
             (match h_routeFV with
              | Or.inl ⟨nv, ks, h_lt, h_covV, routeFV⟩ => Or.inl ⟨nv, FrameLevel.map k :: ks,
                  -- Item 150: the value-line chain's own hop — the widths grow by
                  -- this entry's level, and the floor climbs only as far as the
                  -- park's index demands (`n + 1` here, `n` at the pack).
                  h_covV.imp (fun ⟨lo, hb, hc⟩ =>
                    ⟨lo, hb.mono_index (Nat.le_succ k), h_cov_step lo ks hc⟩) id,
                  fun sp_mid h_ssl =>
                    KeyFrames.mapLevel k ks sp_mid h_lt
                      (fun sp_end h_tail =>
                        routeFV sp_mid
                          (SBlockMapEntry.implicitKeyEmpty k sp_p sp_prep sp_scan' sp_mid
                            h_ik h_lit h_ssl)
                          sp_end h_tail)⟩
              | Or.inr h_alt => Or.inr (PackAlt.step_value h_preprocess h_dispatch h_noflow h_alt))
           (nodir_of_block_dispatch h_dispatch) (Or.inr trivial)
           -- Item 190: the props-headed implicit key opens no `?` entry either.
           (Or.inr trivial),
         hcorr_result⟩

/-! #### Wadler-style per-constructor theorems for block dispatch (Layer 4o/4x)

    Each theorem handles one substantial `PendingNode` constructor case for
    `accum_block_pending`. The main theorem delegates to these after the
    shared preamble (corr extraction + `h_close_pending`). Non-proven
    branches (residue/tab/width-mismatch) delegate to
    `block_dispatch_deferred`. -/

/-- **The line an `[77] s-b-comment` opens stops at a `#` or a break** (item
    287).  Past its `s-separate-in-line` whites, `[77]` reads an optional `[75]`
    comment, which opens with `#`, and then `[28]`'s break or the end of input. -/
def CommentStop (c : Char) : Prop := c = '#' ∨ c = '\n' ∨ c = '\r'

lemma sbComment_lineStop {s s' : SurfPos} (h : SBComment s s') :
    LineStop CommentStop s.chars := by
  match h with
  | .break _ _ hb =>
    match hb with
    | .crLf rest col => exact .stop _ (by decide) (Or.inr (Or.inr rfl))
    | .cr rest col => exact .stop _ (by decide) (Or.inr (Or.inr rfl))
    | .lf rest col => exact .stop _ (by decide) (Or.inr (Or.inl rfl))
  | .eof col => exact .nil

lemma optComment_lineStop {s₁ s₂ s' : SurfPos} (hc : GOpt SCNbCommentText s₁ s₂)
    (hb : SBComment s₂ s') : LineStop CommentStop s₁.chars := by
  match hc with
  | .none _ => exact sbComment_lineStop hb
  | .some _ _ h =>
    cases h
    exact .stop _ (by decide) (Or.inl rfl)

lemma gstar_white_lineStop {P : Char → Prop} {s s' : SurfPos} (hw : GStar SSWhite s s')
    (h : LineStop P s'.chars) : LineStop P s.chars := by
  induction hw with
  | nil => exact h
  | cons _ _ _ hstep _ ih =>
    cases hstep with
    | space rest col => exact .white (Or.inl rfl) (ih h)
    | tab rest col => exact .white (Or.inr rfl) (ih h)

lemma ssbComment_lineStop {s s' : SurfPos} (h : SSBComment s s') :
    LineStop CommentStop s.chars := by
  match h with
  | .noSep _ _ hb => exact sbComment_lineStop hb
  | .withSep _ _ _ _ hsep hc hb =>
    have h₁ := optComment_lineStop hc hb
    match hsep with
    | .whites _ _ (.mk _ _ _ h1 hrest) => exact gstar_white_lineStop (GStar.cons _ _ _ h1 hrest) h₁
    | .startOfLine _ => exact h₁

/-- **A crossed break refutes the inline residue** (item 287).  Off column 0,
    `[79] s-l-comments` opens with `[77] s-b-comment` — its `startOfLine`
    alternative is a column-0 one — and that line stops at a `#` or a break past
    its whites, while the residue's stops at a block indicator past the same
    whites.  At column 0 the residue's own first conjunct is false.

    This is what a LANDED branch hands `accum_block_on_closeThenBlock` for a
    park that holds no open slot: the two `:` consumers' crossed-break arms, and
    `accum_block_on_pendingBlock`'s dedent. -/
lemma sslComments_refutes_inline_residue {sp sp_mid : SurfPos} {c : Char}
    (h_ssl : SSLComments sp sp_mid) (hc : c = '-' ∨ c = ':' ∨ c = '?')
    (h_res : InlineResidue sp c) : False := by
  obtain ⟨hcol, sp_ws, hws, h_head⟩ := h_res
  match h_ssl with
  | .startOfLine chars _ _ => exact hcol rfl
  | .withComment _ _ _ hsb _ =>
    have hst := LineStop.across_whites (ssbComment_lineStop hsb) hws h_head
      (by rcases hc with rfl | rfl | rfl <;> decide)
    rcases hc with rfl | rfl | rfl <;> rcases hst with h | h | h <;> exact absurd h (by decide)

/-- The residue's premise, assembled from `preprocess_some_ssl_comments_landing`'s
    right disjunct: the park is off column 0, the step crossed only `s-white`,
    and the dispatched character is the head it reached. -/
lemma inline_residue_of_landing {sp_scan sp_mid sp_ws sp_p : SurfPos}
    {s_prep : ScannerState} {c : Char}
    (h_mid : sp_mid = sp_scan ∧ sp_scan.col ≠ 0)
    (hws : GStar SSWhite sp_mid sp_ws)
    (h_pk : sp_p = sp_ws ∨ s_prep.peek? = none)
    (hcorr : ScannerSurfCorr s_prep sp_p)
    (hpeek : s_prep.peek? = some c) :
    InlineResidue sp_scan c :=
  have h_eq : sp_p = sp_ws := h_pk.resolve_right (by simp [hpeek])
  ⟨h_mid.2, sp_ws, h_mid.1 ▸ hws, h_eq ▸ head_of_peek hcorr hpeek⟩

/-- The block dispatch's character, as the three indicators it can be. -/
lemma block_indicator_char {s s' : ScannerState} {c : Char}
    (h : scanNextToken_dispatchBlockIndicators s c = .ok (some s')) :
    c = '-' ∨ c = ':' ∨ c = '?' := by
  rcases dispatchBlockIndicators_indicator_of_some h with h | h | h
  · exact Or.inl h
  · exact Or.inr (Or.inr h)
  · exact Or.inr (Or.inl h)

/-- **Item 77 for the escape's park.**  All three block indicators re-arm the
    simple key (`scanBlockEntry`/`scanKey`/`scanValue` each end
    `simpleKeyAllowed := true`), so a `pendingFlow` opened by a DEFERRED block
    dispatch carries the arm for free. -/
lemma block_indicator_arm {s s' : ScannerState} {c : Char}
    (h : scanNextToken_dispatchBlockIndicators s c = .ok (some s')) :
    s'.simpleKeyAllowed = true := by
  rcases block_indicator_char h with rfl | rfl | rfl
  · exact dispatchBlockEntry_simpleKeyAllowed h
  · exact dispatchBlockValue_simpleKeyAllowed h
  · exact dispatchBlockKey_simpleKeyAllowed h

/-- **`...` never parks in the residue** (item 36).  `[204] l-document-suffix`
    ends the marker with `[79] s-l-comments`, and `scanDocumentEnd` enforces
    it: past the marker's own whites the line holds a break, a `#`, or nothing
    at all.  A block indicator is none of the three, so the mid-line park this
    escape stands for is a state the machine cannot be in — and unlike §7.5's
    node tails, `[204]`'s admits no `:` either, because a document-end marker
    is not a node and cannot be re-read as `[154]`'s implicit key. -/
lemma docEnd_refutes_inline_residue {sp_scan : SurfPos} {c : Char}
    (h_line : sp_scan.col = 0 ∨ LineTailSuffix sp_scan.chars)
    (hc : c = '-' ∨ c = ':' ∨ c = '?')
    (h_res : InlineResidue sp_scan c) : False := by
  obtain ⟨hcol, sp_ws, hws, h_head⟩ := h_res
  refine LineTailSuffix.no_content_across_whites (h_line.resolve_left hcol) hws h_head
    ?_ ?_ ?_
  · rcases hc with rfl | rfl | rfl <;> rintro (h | h) <;> exact absurd h (by decide)
  · rcases hc with rfl | rfl | rfl <;> rfl
  · rcases hc with rfl | rfl | rfl <;> exact (by decide)

/-- **§7.5's middle rung refutes the other two indicators** (item 37).  A park
    that follows a COMPLETE block-context node — a quoted scalar, an alias, a
    flow collection returned to block level, a plain or block scalar — stops
    the rest of its line at `NodeStop`, and neither `-` nor `?` is in that set:
    `validateTrailingContent`/`validateFlowClose` refuse them outright
    (`"a" - b`, `[1] ? b`), and the two scalar WALKS absorb them, so they never
    park in front of one. -/
lemma nodeStop_refutes_inline_residue {sp_scan : SurfPos} {c : Char}
    (h_line : sp_scan.col = 0 ∨ LineNodeStop sp_scan.chars)
    (hc : c = '-' ∨ c = '?')
    (h_res : InlineResidue sp_scan c) : False := by
  obtain ⟨hcol, sp_ws, hws, h_head⟩ := h_res
  exact LineNodeStop.no_indicator_across_whites (h_line.resolve_left hcol) hws h_head hc

/-- …so at such a park the residue IS the `:`, and an escape that still has to
    cover it owes exactly one production: `[154] ns-s-implicit-yaml-key` at a
    mid-line anchor (`"a" : b`, `[1] : b`, `- [1] : b`).  Read the other way,
    this is the measurement made structural — the obligation the site hands its
    callers is now the grammatical family alone. -/
lemma nodeStop_residue_is_colon {sp_scan : SurfPos} {c : Char}
    (h_line : sp_scan.col = 0 ∨ LineNodeStop sp_scan.chars)
    (hc : c = '-' ∨ c = ':' ∨ c = '?')
    (h_res : InlineResidue sp_scan c) : InlineResidue sp_scan ':' := by
  rcases hc with rfl | rfl | rfl
  · exact (nodeStop_refutes_inline_residue h_line (Or.inl rfl) h_res).elim
  · exact h_res
  · exact (nodeStop_refutes_inline_residue h_line (Or.inr rfl) h_res).elim

/-- **`...` never parks in front of the CONTENT dispatch either** (item 42).
    The block-indicator refutation above met `[204]`'s allowlist with the three
    indicators; here the dispatch's own character class does the whole job:
    `[204]` stops the marker's line at a break or a `#`, and
    `scanNextToken_dispatchContent` returns `.ok` on neither. -/
lemma docEnd_refutes_content_residue {sp_scan : SurfPos} {c : Char}
    {s s' : ScannerState}
    (h_line : sp_scan.col = 0 ∨ LineTailSuffix sp_scan.chars)
    (h_dispatch : scanNextToken_dispatchContent s c = .ok s')
    (h_res : InlineResidue sp_scan c) : False := by
  obtain ⟨hcol, sp_ws, hws, h_head⟩ := h_res
  exact dispatchContent_ok_not_tailSuffix h_dispatch
    ((h_line.resolve_left hcol).across_whites hws h_head
      (dispatchContent_ok_charFacts h_dispatch).1)

/-- **…and at a complete node's park the content residue IS the `:`**
    (item 42, §7.5's rung at the content dispatch).  The `-`/`?` never reach
    this dispatch (they are the block indicators'), so what the stop set
    leaves is the `:` whose follower is non-blank — `"a" :b`, `[1] :b` —
    which the scanner reads as a plain-scalar head and the parser refuses:
    row 19's over-acceptance, not a state to refute here. -/
lemma nodeStop_content_residue_is_colon {sp_scan : SurfPos} {c : Char}
    {s s' : ScannerState}
    (h_line : sp_scan.col = 0 ∨ LineNodeStop sp_scan.chars)
    (h_dispatch : scanNextToken_dispatchContent s c = .ok s')
    (h_res : InlineResidue sp_scan c) : c = ':' := by
  obtain ⟨hcol, sp_ws, hws, h_head⟩ := h_res
  exact (dispatchContent_ok_charFacts h_dispatch).2
    ((h_line.resolve_left hcol).across_whites hws h_head
      (dispatchContent_ok_charFacts h_dispatch).1)

/-- `lastRealTokenVal?` is the positioned reading's value projection. -/
lemma lastRealTokenVal?_eq_map (ts : Array (Positioned YamlToken)) :
    lastRealTokenVal? ts = (lastRealToken? ts).map (·.val) := by
  unfold lastRealTokenVal? lastRealToken?
  split
  · dsimp only []
    split
    · split <;> rfl
    · rfl
  · rfl

/-- **…and the stale tail refutes it** (item 47).  A park behind a complete
    node carries `StaleNodeTail`; with the entry flag down the preprocessing
    that reached this dispatch crossed no break, so the stale key, the token
    tail and the cursor gap all survive to the dispatch state — which is
    exactly `scanNextToken_checkAdjacentValue`'s firing condition on the `:`
    that fell through `isValueCandidate`.  The check therefore errored, and
    the step's own chain says it did not: the arm's residue is EMPTY. -/
lemma checkAdjacentValue_refutes_stale {sc s_prep : ScannerState}
    (h_st : StaleNodeTail sc)
    (h_noflow : (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).inFlow = false)
    (h_pay : sc.needIndentCheck = false → LastTokenReal sc.tokens →
      s_prep.line = sc.line ∧ s_prep.needIndentCheck = false ∧
      lastRealToken? s_prep.tokens = lastRealToken? sc.tokens ∧
      penultRealToken? s_prep.tokens = penultRealToken? sc.tokens)
    (h_pay_sk : sc.needIndentCheck = false → sc.simpleKeyAllowed = false →
      s_prep.simpleKey = sc.simpleKey ∧ s_prep.tokens = sc.tokens ∧
      sc.offset ≤ s_prep.offset ∧ s_prep.simpleKeyAllowed = false) :
    scanNextToken_checkAdjacentValue (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep) ':' ≠ .ok () := by
  obtain ⟨h_nic, h_al, h_real, t, h_last, h_cmp⟩ := h_st
  obtain ⟨-, -, h_tok_eq, -⟩ := h_pay h_nic h_real
  obtain ⟨-, -, -, h_al'⟩ := h_pay_sk h_nic h_al
  have h_val_eq : lastRealTokenVal? s_prep.tokens = lastRealTokenVal? sc.tokens := by
    rw [lastRealTokenVal?_eq_map, lastRealTokenVal?_eq_map, h_tok_eq]
  have h_tk : lastRealTokenVal? (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).tokens = some t := by
    split <;> exact h_val_eq.trans h_last
  have h_ska : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).simpleKeyAllowed = false := by
    split <;> exact h_al'
  intro h_adj
  unfold scanNextToken_checkAdjacentValue at h_adj
  rw [ite_eq_left ?hcond] at h_adj
  case hcond =>
    rw [h_noflow, h_tk, h_ska]
    simp [h_cmp]
  cases h_adj


-- Deferred sorry: constructs pendingFlow with stream evidence.
-- Concentrates all block-dispatch catch-all sorry into close_with_ssl.
--
-- What still reaches it, after item 34 refuted the tab in front of a compact
-- `:` and item 35 emptied the no-pending arm (6 call sites, TWO families — and
-- the domain is what the claim is, not the count; R645/R646):
--
--   * **the inline residue** (3 sites) — a mid-line park that crosses no
--     break, so `[79] s-l-comments` cannot exist and nothing can CLOSE there
--     (item 19's remainder).  Item 25 removed its largest inhabitant without
--     changing its shape: an indented `a: 1` parks mid-line and its `:` cannot
--     close the park, but it never needed to — the pack re-reads the parked
--     scalar as `[188]`'s key instead.  Item 33 did the same for the whole
--     `-`-parked family by not closing at all: `[185] s-l+block-indented`'s
--     `compactSeq`/`compactMap` fill the entry's still-open content slot and
--     ask for no comments, so `- - a`, `- : a`, `- ? a` and their nestings
--     compose; item 34 then closed that site outright by carrying
--     `sc.simpleKeyAllowed = true` on the pending, which is what lets the `:`
--     arm read `[66]`'s scan (see `tab_refutes_dispatch_inline`).  Item 35 then
--     took the `noPending` site by a different route again — not a production
--     and not a refutation from the scan, but an UNREACHABILITY: with nothing
--     pending and no flow open the machine parks at a line start, so the arm
--     has no inhabitant (the field is `noPending`'s own `h_col`).  The three
--     that remain are the same residue at pendings whose slot is not an
--     `SBlockIndented`: the generic close-and-reopen (`pendingMapValue`,
--     `pendingProps`, `pendingFlow`, the two document pendings),
--     `pendingBlockContent` — whose `- a: 1` item 38 composed, leaving the
--     punts (a break, a tab, a props or block-scalar head) — and the content
--     dispatch's own no-break arm, split per pending by item 42: the parks'
--     stop sets meet the dispatch's accept class, so `pendingDocEnd`'s arm is
--     EMPTY, the two content parks defer exactly the measured `:` (`"a" :b`,
--     row 19's over-acceptance), item 43 composed `pendingDocStart`'s `--- a`
--     through `content_dispatch_routed` and `h_doc_route`'s own closer, and
--     what is left there is `pendingFlow`'s arm, which cannot close while the
--     escape itself is what produces that pending.
--   * **an indented value the one-line reading does not reach** (3 sites: one
--     per indented content arm, plus the props consumer's nonzero side) — a
--     value that FOLDS, a step that landed on a fresh line, or a block scalar
--     whose entry index the pending could not measure.  The question is asked
--     ONCE per site and these are its negative answers.  The block-scalar third
--     was a MEASURED residue rather than a construct — `[170]`/`[174]` bind
--     their content indent existentially (item 26), the scanner proves
--     `d ≥ (max 0 (currentIndent + 1)).toNat`, and what was left was `n ≤ d` —
--     and items 27/28 carry it: `IndentFloor` rides the three pendings, the
--     three block indicators discharge it from their own push, and the implicit
--     key discharges it from the column `scanValuePrepare` resolves.  What
--     still lands here is a pending that could not measure at all: a
--     property-headed or alias KEY (the pack punts the column coupling), an
--     explicit-key `:`, or a step whose preprocessing re-saved.
--
-- The flow-collection value (`  - [1]`, and `  - &a [b]` with it) reaches
-- `scannerDrop` rather than this lemma, and for a third reason again: its
-- pinned 0 is in `FlowOpenStack`'s RESUME type, which no widening of the
-- content evidence or of the props route can reach.
--
-- What no longer reaches it: a non-indicator character (item 21, refuted from
-- the dispatcher — `block_indicator_exhausted`), `noPending` parked at a
-- column other than 0 (item 21 gated it on the landing; item 35 emptied it —
-- in block context there IS no such park, and the seed's is at column 0
-- because §5.2's BOM spends none), whitespace before the
-- indicator (item 22 — it is `s-indent(k)`, and the empty run is `k = 0`),
-- `pendingBlockContent` at a nonzero entry index (item 22 — the pending
-- carries its own index now, so the arm never had to assume one), an
-- indented entry's one-line scalar VALUE (item 23 — a break-free reading
-- mentions no indent, so it re-reads at the entry's), a PROPERTY-decorated
-- indented value (item 24 — the run itself is what carries the route, and a
-- fresh single-half run has no occurrence of the index to lift), and an
-- indented implicit KEY (item 25 — the whites in front of it are the entry's
-- own `[63] s-indent(k)`, and `[193]`/`[194]` carry no index to lift either),
-- an indented BLOCK SCALAR as a construct (item 26 — `[170]`/`[174]` were never
-- the pinned existential `[183]`/`[187]` were), the block scalar under an
-- indented block INDICATOR (item 27 — the entry index reaches the body's
-- content-indent floor, because `skipToContent` never writes the indent stack
-- and the indicator pushed at its own column), and the block scalar under an
-- indented IMPLICIT KEY (item 28 — the push is measured at the key's column,
-- which the pack already carried as `[63] s-indent(k)`), **a TAB where
-- `[63] s-indent` wants spaces** (item 32 — the disjunct, LOCATED, names a
-- character inside the run the scanner walks backwards, and all three
-- indicators refuse it: see `tab_refutes_dispatch`), a NESTED or dedented
-- collection at a width other than the pending's (item 30 — `n < k` is
-- `[199]`'s collection at `[183]`'s `m = k - n`, `k < n` takes the `:`/`?`
-- arm's route), **the COMPACT collection** (item 33 — `[185]`'s other two
-- alternatives, which need no `s-l-comments` because they share the entry
-- indicator's line), and **the tab in front of one** (item 34 — the pending
-- carries `simpleKeyAllowed`, so the `:` arm's tab test reads the compact
-- `s-indent(m)` from the key the step just saved rather than from a line
-- coordinate that stops at the entry indicator), and **the mid-line park with
-- nothing pending** (item 35 — `noPending` names the state it stands for, and
-- in block context that state is a line start; the residue was a park the
-- machine never makes).
lemma block_dispatch_deferred
    (sp_start sp_X sp_scan' : SurfPos) (s' : ScannerState)
    (h_stream : SLYamlStream sp_start sp_X)
    -- Item 77: the escape's own park still answers the ONE scanner question a
    -- landed `:` asks of it — see `PendingNode.pendingContent.h_arm`.
    (h_arm : (s'.simpleKeyAllowed = true ∧ s'.simpleKey.possible = false) ∨ 0 < sp_scan'.col)
    (hcorr : ScannerSurfCorr s' sp_scan')
    -- Item 138: the escape's park carries the directive face too — the
    -- deferral is a block-indicator dispatch like any other, and its caller
    -- holds the dispatch equation this reads.
    (h_nodir : s'.allowDirectives = false)
    -- **Item 206: the flag at the park this escape OPENS.**  Every caller can
    -- take this measurement from the step it just dispatched, which is why the
    -- park's field is required rather than optional (Reflection 653's test:
    -- a fact about the scan just performed, not one some producers cannot
    -- measure).
    (h_nic0 : sp_scan'.col = 0 → s'.needIndentCheck = true)
    -- Item 293: the park reads `flag ∨ live` — a block indicator leaves the
    -- flag up (`block_indicator_arm`), and content at the park keeps a live
    -- key or ends armed (`content_live0`).
    (h_live0 : s'.simpleKeyAllowed = true ∨ s'.simpleKey.possible = true)
    (h_gate : ∃ sp_g, GStar SSWhite sp_g sp_scan' ∧
        (sp_g = sp_scan' → s'.col ≠ 0 → ¬ (CommentOk s' ∧ s'.peek? = some '#'))) :
    ∃ sp_gram' sp_block' sp_flow' sp_scan',
      SLYamlStream sp_start sp_gram' ∧
      BlockStack sp_gram' sp_block' ∧
      FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
      PendingNode s' false sp_start sp_flow' sp_scan' ∧
      ScannerSurfCorr s' sp_scan' :=
  ⟨sp_X, sp_X, sp_X, sp_scan', h_stream,
   BlockStack.nil sp_X, FlowStackB.nil sp_X .sep,
   PendingNode.pendingFlow sp_start sp_X sp_scan' h_stream h_arm h_nodir h_nic0 h_live0 h_gate,
   hcorr⟩

