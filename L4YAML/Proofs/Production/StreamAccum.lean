        SLYamlStream sp_start sp_mid)
      (h_close_entry : ∀ sp_mid,
        SBlockIndented n .blockIn sp_scan sp_mid →
        ∀ sp_end, SCompactSeqTail n sp_mid sp_end → SLYamlStream sp_start sp_end)
