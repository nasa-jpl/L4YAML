      -- closure, so re-derive the reading with it (the value arms' idiom,
      -- item 112) — the scalar re-reads TO the landing and the route takes
      -- the re-read node, with no document suffix.  The park's other faces
      -- stay vacuous: a landed block scalar heads no entry, and its
      -- landed inputs are refused (`k:⏎  a: 1⏎|⏎  x` is §9.2).
      obtain ⟨sp_bs, _, hcorr_bs, h_absorb95⟩ :=
        dispatchContent_blockScalar_prod _ sp_prep
          (corr_of_allowDirectives_update hcorr_prep) hpeek_disp hbs h_dispatch
      have hsp_bs_eq := ScannerSurfCorr_unique hcorr_bs hcorr_result
      rw [hsp_bs_eq] at h_absorb95
      exact ⟨sp_res, sp_res, sp_res, sp_scan', h_stream_res,
             BlockStack.nil sp_res, FlowStackB.nil sp_res .sep,
             PendingNode.pendingContent (sp_gram := sp_scan') (h_run := GStar.nil _) (h_gate := fun _ hcol h => (scanBlockScalar_park (dispatchContent_blockScalar_scan _ sp_prep (corr_of_allowDirectives_update hcorr_prep) hpeek_disp hbs h_dispatch)).elim (fun h0 => hcol h0) (fun hne => hne h.2)) (h_live := live_of_dispatch h_dispatch hna hnt (by rw [allowDirectives_update_simpleKey]; exact h_possD) hcorr_result) sp_start sp_res sp_scan' h_line
               (fun h_nd _ sp_mid h_ssl =>
                 -- Item 174: the ride's `[198]` half — the held run fills the
                 -- block scalar's own properties slot (`&p⏎|⏎  x` is
                 -- `=VAL &p |x\n`), through the run's route.
                 match h_propsctx with
                 | Or.inl ⟨⟨_, _, _, ⟨sp_np, sp_pp, sp_rp, routeP, h_sepP, h_propsP, _,
                     h_sepB⟩, _⟩, _, _⟩ =>
                     routeP sp_mid
                       ((h_absorb95 sp_mid h_ssl).elim
                         (fun h_lit => literal_blockNode h_sepP
                           (GOpt.some sp_pp sp_prep (GSeq.mk sp_pp sp_rp sp_prep
                             (props_linesLift h_propsP) h_sepB)) h_lit)
                         (fun h_fld => folded_blockNode h_sepP
                           (GOpt.some sp_pp sp_prep (GSeq.mk sp_pp sp_rp sp_prep
                             (props_linesLift h_propsP) h_sepB)) h_fld))
                 | Or.inr _ =>
                     h_route h_nd sp_mid
                       ((h_absorb95 sp_mid h_ssl).elim
                         (fun h_lit => literal_blockNode h_sep (GOpt.none sp_prep) h_lit)
                         (fun h_fld => folded_blockNode h_sep (GOpt.none sp_prep) h_fld)))
               h_key
               (stale_of_dispatch h_dispatch hna hnt
                 (by split <;> show s_prep.needIndentCheck = false <;> exact h_nic_prep)
                 hcorr_result) (Or.inr (PackAlt.step_dispatch h_dispatch h_alt))
                 (content_park_arm hpeek
                   h_flow_disp h_not_doc h_dispatch hcorr_result)
               (Or.inr trivial) (Or.inr (PackAlt.step_dispatch h_dispatch h_alt))
               (nodir_of_content_dispatch h_dispatch)
               (completedTail_of_dispatch h_dispatch hna hnt)
               -- **Item 154: and the park's own indent check.**  `[170]`/`[174]`'s body
               -- begins past a `b-break`, so a park this scan leaves at column 0 has the
               -- check ARMED — which is the floor a landing off it needs.
               (content_park_nic hbs hpeek h_dispatch hcorr_result) (Or.inr trivial),
             hcorr_result⟩

/-- The bare-document instance of `content_dispatch_routed` — the node anchors
    at the CLOSED stream's landing and re-enters it as `implicitContinue`'s
    `SLAnyDocument.bare`.  Every pre-item-43 caller is this one. -/
lemma content_dispatch_after_close
    (sp_start sp_block : SurfPos)
    (s_prep s' : ScannerState) (c : Char) (sp_prep sp_scan' : SurfPos)
    (h_stream_block : SLYamlStream sp_start sp_block)
    (h_sep : SSeparateLines 0 sp_block sp_prep)
    (h_nic_prep : s_prep.needIndentCheck = false)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (hcorr_result : ScannerSurfCorr s' sp_scan')
    (h_not_doc : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).col = 0 →
      atDocumentBoundary (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) = false)
    (hpeek : s_prep.peek? = some c)
    (h_flow_disp : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).inFlow = false)
    (h_dispatch : scanNextToken_dispatchContent
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) c = .ok s')
    (h_keyctx : ((∃ (k : Nat) (sp_land : SurfPos),
                   sp_land.col = 0 ∧ SLYamlStream sp_start sp_land ∧
                   SIndent k sp_land sp_prep) ∧
                 s_prep.simpleKey.possible = true ∧
                 s_prep.simpleKey.pos = s_prep.currentPos) ∨ True)
    -- Item 109: forwarded unchanged — the anchor this instance picks is the
    -- CLOSED stream's landing, which is where a resuming context is stated too.
    (h_resumectx : ResumeKeyCtx s_prep sp_start sp_prep)
    -- Item 117: forwarded unchanged, for the same reason.
    (h_suffixctx : ((∃ (k : Nat) (sp_land : SurfPos),
        sp_land.col = 0 ∧ SuffixRun sp_start sp_land ∧ SIndent k sp_land sp_prep) ∧
      s_prep.simpleKey.possible = true ∧
      s_prep.simpleKey.pos = s_prep.currentPos) ∨ True)
    -- Item 136: forwarded unchanged, for the third time and the same reason.
    -- A caller that can pay this one has no business here at all — the head's
    -- own route is `nodocNodeRoute`, and `accum_content_on_noPending` spends
    -- it through `content_dispatch_routed` directly — but the key context is
    -- independent of the node route (the entry's document and the parked
    -- node's are different documents), so the parameter rides.
    (h_nodocctx : ((∃ (k : Nat) (sp_land : SurfPos),
        sp_land.col = 0 ∧ GStar SLDocumentPrefix sp_start sp_land ∧
        SIndent k sp_land sp_prep) ∧
      s_prep.simpleKey.possible = true ∧
      s_prep.simpleKey.pos = s_prep.currentPos) ∨ True)
    -- Item 137: forwarded unchanged, and for a sharper version of item 136's
    -- reason — a marker park does not reach this lemma at all now, because its
    -- landing anchors the node at the MARKER and `content_dispatch_routed` is
    -- where the anchor is a parameter.  The key context rides anyway: it is
    -- independent of the node route.
    (h_markerctx : ((∃ (k : Nat) (sp_land : SurfPos),
        sp_land.col = 0 ∧ MarkerNodeRoute sp_start sp_land ∧
        SIndent k sp_land sp_prep) ∧
      s_prep.simpleKey.possible = true ∧
      s_prep.simpleKey.pos = s_prep.currentPos) ∨ True)
    -- Item 144: forwarded, and ALWAYS `Or.inr` at the three call sites — see
    -- the note on `bareNodeRoute` in the body below.
    (sc : ScannerState)
    (h_ref : BareLandingFacts sc s_prep c ∨ True)
    -- Item 174: forwarded — the props landing is one of this lemma's three
    -- callers, and the SENTINEL-indexed park is the one that pays.  The ride
    -- re-enters by the park's own route, so the bare-document route below is
    -- never spent where the context is paid.
    (h_propsctx : ((∃ (k : Nat) (sp_land : SurfPos),
        sp_land.col = 0 ∧ PropsRideRoute sp_start sp_land sp_prep ∧
        SIndent k sp_land sp_prep) ∧
      s_prep.simpleKey.possible = true ∧
      s_prep.simpleKey.pos = s_prep.currentPos) ∨ True)
    -- Item 284: what the token behind this landing pays a property run's
    -- slot face with (`SlotGateAt`).
    (h_src : SlotGateAt s_prep)
    -- Item 293: the dispatch state's saved key is live, which
    -- `content_dispatch_routed` spends at its content parks.
    (h_possD : s_prep.simpleKey.possible = true) :
    ∃ sp_gram' sp_block' sp_flow' sp_scan',
      SLYamlStream sp_start sp_gram' ∧
      BlockStack sp_gram' sp_block' ∧
      FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
      PendingNode s' false sp_start sp_flow' sp_scan' ∧
      ScannerSurfCorr s' sp_scan' :=
  content_dispatch_routed (h_alt := trivial) (h_possD := h_possD) (h_src := h_src) sp_start sp_block sp_block s_prep s' c sp_prep sp_scan'
    h_stream_block h_sep h_nic_prep hcorr_prep hcorr_result h_not_doc hpeek
    h_flow_disp h_dispatch
    -- Item 139: the same route, named — this lemma is the INDENTED callers'
    -- entry to it, and they are the family the landing skeleton's guarded twin
    -- does not cover (the pending's own level is still open at their landings).
    --
    -- **Item 144 measured that this site's refutable half is EMPTY**, and for
    -- two different reasons.  Its three callers park on `pendingBlock`,
    -- `pendingMapValue` and `pendingProps`, and none of the three carries a
    -- `CompletedTail` field: their tails are `blockEntry`, `value` and an
    -- anchor/tag run, all three of which `completesFlowValue` excludes.  So
    -- `h_ref` below is `Or.inr` at every call site, and the guard would be a
    -- parameter nobody pays.  `k:⏎␣␣-⏎␣␣␣␣b` and `k:⏎␣␣a:⏎␣␣␣␣b` stand aside on
    -- the INDENT STACK too (`sz=3`); `&p⏎␣␣b` stands AT the sentinel (`sz=1`)
    -- and §9.2 stands aside anyway, on the token reading alone.  What is left
    -- here is row 19's 1c residue for the indented family — ~~item 141's park
    -- face~~, not this thread.
    --
    -- **Item 156 corrects the attribution.**  The face cannot reach these
    -- three: `danglingNodePos?` reads `none` at all of them, and for two
    -- different reasons.  The `pendingBlock` and `pendingMapValue` parks stand
    -- behind a `-` and a `:`, which are `YamlToken.offersNodeSlot`'s own
    -- members, so the content FILLS a slot and no dangling run exists; the
    -- props park stands at the sentinel-only stack, where no open level has
    -- the landing's column.  All three inputs parse.  What is left here is a
    -- ROUTE — the enclosing park's own — and not a refutation of any kind.
    (fun _ => bareNodeRoute h_stream_block)
    h_keyctx h_resumectx h_suffixctx h_nodocctx h_markerctx sc h_ref h_propsctx
    -- Item 300: a close is not a `---` park; the marker premise declines.
    (Or.inr trivial)

-- Content dispatch with noPending: build separate lines + grammar evidence.
lemma accum_content_on_noPending
    (sc : ScannerState) (sp_start sp_block : SurfPos)
    (s_prep s' : ScannerState) (c : Char) (sp_prep sp_scan' : SurfPos)
    (h_stream_block : SLYamlStream sp_start sp_block)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (hcorr_result : ScannerSurfCorr s' sp_scan')
    (h_corr : ScannerSurfCorr sc sp_block)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    -- Item 157: the key context's close is TOTAL here (`noPending` extends the
    -- stream past the comments), but the landing still has to name the face it
    -- is total ON — so the check and the park's arm ride in with it.
    (h_dn : scanNextToken_checkDanglingNode sc s_prep = .ok ())
    -- Item 275: §8.1's check, carried beside §9.2's.
    (h_fv : scanNextToken_checkFlowValueIndent sc s_prep = .ok ())
    -- Item 293: the flag itself — the one caller passes it (`h_arm`'s armed
    -- half), and the routed content reads the fresh save off it.
    (h_park : sc.simpleKeyAllowed = true)
    -- Item 340: the park's dead register (noPending's `h_noek`), the flip's premise.
    (h_alt : PackAlt sc)
    (h_not_doc : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).col = 0 →
      atDocumentBoundary (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) = false)
    (h_flow_disp : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).inFlow = false)
    (h_dispatch : scanNextToken_dispatchContent
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) c = .ok s')
    -- **Item 136: the park's own `h_nodoc`, resolved.**  A block-context
    -- `noPending` is the stream's seed (item 116's census; the other seven
    -- producers are flow-interior and this dispatch is not), so the region
    -- behind it is `[202] l-document-prefix*` and the node this content
    -- starts is the stream's FIRST document.  `[211]`'s `single` carries it,
    -- and `single`'s `l-any-document?` slot is the one row 19's 1c leaves
    -- untouched — where `content_dispatch_after_close` handed the same node
    -- to the implicit continuation of a stream that has started nothing.
    (h_nodoc : GStar SLDocumentPrefix sp_start sp_block)
    -- Item 284: what the token behind this landing pays a property run's
    -- slot face with (`SlotGateAt`).
    (h_src : SlotGateAt s_prep) :
    ∃ sp_gram' sp_block' sp_flow' sp_scan',
      SLYamlStream sp_start sp_gram' ∧
      BlockStack sp_gram' sp_block' ∧
      FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
      PendingNode s' false sp_start sp_flow' sp_scan' ∧
      ScannerSurfCorr s' sp_scan' := by
  have hpeek : s_prep.peek? = some c := preprocess_some_peek h_preprocess
  have h_noflow_prep : s_prep.inFlow = false := by
    unfold ScannerState.inFlow at h_flow_disp ⊢
    rw [show s_prep.flowLevel = (if s_prep.allowDirectives then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep).flowLevel from by split <;> rfl]
    exact h_flow_disp
  have h_keyctx := keyctx_of_preprocess sc sp_block sp_prep s_prep c h_corr hcorr_prep
    (fun _ _ sp_mid h_ssl => ssl_comments_extend_stream sp_start sp_block sp_mid
      h_stream_block h_ssl)
    h_dn h_fv h_noflow_prep (Or.inl h_park) h_preprocess
  -- Item 136: and the same landing read at the stream's HEAD — the entry a
  -- landed key would open belongs to the first document too, so `a: 1` and
  -- `# c⏎a: 1` route their `[187]` through `single` as well.
  have h_nodocctx := nodocctx_of_preprocess sc sp_block sp_prep s_prep c h_corr hcorr_prep
    h_nodoc h_preprocess
  by_cases hcol : sp_block.col = 0
  · obtain ⟨sp_sep, h_sep, hcorr_sep⟩ :=
      preprocess_some_separate_lines_0 sc sp_block s_prep c h_corr hcol h_preprocess
    have hsp_eq := ScannerSurfCorr_unique hcorr_prep hcorr_sep; subst hsp_eq
    exact content_dispatch_routed (h_alt := PackAlt.step_preprocess h_preprocess h_alt) (h_possD := (preprocess_saved_key_fresh h_park (noflow_of_noflow_disp h_flow_disp) h_preprocess).1) (h_src := h_src) sp_start sp_block sp_block s_prep s' c sp_prep sp_scan'
      h_stream_block h_sep (nic_false_of_flow_disp h_preprocess h_flow_disp)
      hcorr_prep hcorr_result h_not_doc hpeek h_flow_disp h_dispatch
      (fun _ => nodocNodeRoute h_nodoc)
      h_keyctx (Or.inr trivial) (Or.inr trivial) h_nodocctx (Or.inr trivial)
      -- Item 144: the virgin park finished no node, so §9.2's second conjunct
      -- has nothing to read and the refusal stands aside by its own reading.
      sc (Or.inr trivial)
      -- Item 174: no held run stands behind a virgin park.
      (Or.inr trivial)
      (Or.inr trivial)
  · obtain ⟨sp_sep, h_sep, hcorr_sep⟩ :=
      preprocess_some_separate_0_anyCol sc sp_block s_prep c h_corr h_preprocess
    have hsp_eq := ScannerSurfCorr_unique hcorr_prep hcorr_sep; subst hsp_eq
    exact content_dispatch_routed (h_alt := PackAlt.step_preprocess h_preprocess h_alt) (h_possD := (preprocess_saved_key_fresh h_park (noflow_of_noflow_disp h_flow_disp) h_preprocess).1) (h_src := h_src) sp_start sp_block sp_block s_prep s' c sp_prep sp_scan'
      h_stream_block h_sep (nic_false_of_flow_disp h_preprocess h_flow_disp)
      hcorr_prep hcorr_result h_not_doc hpeek h_flow_disp h_dispatch
      (fun _ => nodocNodeRoute h_nodoc)
      h_keyctx (Or.inr trivial) (Or.inr trivial) h_nodocctx (Or.inr trivial)
      -- Item 144: the virgin park finished no node, so §9.2's second conjunct
      -- has nothing to read and the refusal stands aside by its own reading.
      sc (Or.inr trivial)
      -- Item 174: no held run stands behind a virgin park.
      (Or.inr trivial)
      (Or.inr trivial)

/-- **Does this content step read at EVERY index?** (item 23; item 24; item 26)

    Not quite every — the block scalar (item 26) is why this lemma now takes the
    index `n` rather than concluding `∀ n`.  Both remaining negatives are ways
    for ONE question to fail, so it is asked once here and each caller has a
    single deferral point:

    * a value that FOLDS, or a step that LANDED on a fresh line — the two
      halves of one break.  `dispatchContent_evidence_oneLine` and
      `preprocess_some_separate_inline_or_landing` hold only across a
      break-free span, because that is exactly where the index fails to occur.
    * a block scalar whose entry sits DEEPER than the body's own content-indent
      floor — see below; this is not a fact about block scalars, it is the one
      inequality the accumulation invariant cannot yet state.

    There are THREE positive answers, because `[196]` has three ways to reach a
    value.  The first is the whole reading an indented entry needs directly: the
    separator and the flow node at every index, the trailing whites, and the
    `pendingBlockContent` line fact — parts none of which mention 0.  The second
    (item 24) is a `[96] c-ns-properties` run, which is not a value at all but a
    decoration awaiting one; a fresh run is single-half, so `PropsRun`'s only
    occurrence of the index — the separator inside `[96]`'s optional second half
    — is absent, and the run reads at every index with no side condition beyond
    the one the separator already needed.  What it hands back is exactly
    `pendingProps`' payload, so the caller parks the run at its own route index
    and item 12's machinery finishes the value on the next step.

    Item 41 adds three post-state conjuncts to that answer, of the same kind as
    the couplings already there: the run is SINGLE-half (which is the whole of
    what a fresh `&`/`!` push builds, and what `PropsRun.toPropertiesBlockKey`
    projects into the `block-key` re-read `PropsKeyPack` asks for), and the
    dispatch left the saved key and the line alone.  They are stated at this
    lemma's own strength rather than as the key reading itself, because the run's
    SHAPE is what it knows and the head is one thing a caller can do with it
    (Reflection 662).  With them `  - &p a: 1` composes where `- &p a: 1` does.

    The third (item 26) is `[198]`'s block scalar, and it was misfiled as a
    grammar gap.  `[170] c-l+literal(n)` binds its auto-detected `m`
    EXISTENTIALLY already — unlike `[183]`/`[187]`, which item 21 had to widen —
    so the reading holds at every `n` with `n + m` equal to the indent the body
    was collected at, and `scanBlockScalar_prod_at` keeps that indent instead of
    instantiating it at 0.  What survives is one inequality, `n ≤ d`, and item 27
    pays it: `h_floor` is the pending's own measurement against the scanner's
    indent stack (`IndentFloor`), the break-free branch this arm sits in is
    exactly the one on which that stack survives preprocessing, and the
    `minContentIndentOf` floor `scanBlockScalar_prod_at` returns names the same
    quantity.  A pending whose producer could NOT measure carries `True` and
    lands on the same deferral the fold uses, so the escape's site count is fixed
    by construction and what moves is the domain (R645/R646, R649 §4,
    Reflection 653). -/
lemma indentedValue_reads_at_any_indent
    (sc : ScannerState) (sp_scan : SurfPos) (n : Nat)
    (s_prep s' : ScannerState) (c : Char) (sp_prep sp_scan' : SurfPos)
    -- Item 83: the floor is a PREMISE now (every caller's park carries one)
    -- and the park is off a line start — which is what refutes the
    -- degenerate landing and lets the props arm return the floor AT `s'`.
    (h_floor : IndentFloor sc n)
    (h_col0 : 0 < sp_scan.col)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (hcorr_result : ScannerSurfCorr s' sp_scan')
    (h_corr : ScannerSurfCorr sc sp_scan)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h_not_doc : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).col = 0 →
      atDocumentBoundary (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) = false)
    (h_flow_disp : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).inFlow = false)
    (h_dispatch : scanNextToken_dispatchContent
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) c = .ok s')
    -- Item 284: what the token behind this landing pays a property run's
    -- slot face with (`SlotGateAt`).
    (h_src : SlotGateAt s_prep) :
    (∃ sp_gram,
      SSeparate n .flowOut sp_scan sp_prep ∧
      (∀ n : Nat, SFlowNode n .flowOut sp_prep sp_gram) ∧
      GStar SSWhite sp_gram sp_scan' ∧
      (sp_gram = sp_scan' → s'.col ≠ 0 → ¬ (CommentOk s' ∧ s'.peek? = some '#')) ∧
      (sp_scan'.col = 0 ∨ LineNodeStop sp_scan'.chars) ∧
      (c ≠ '&' ∧ c ≠ '!')) ∨
    -- Item 57: the run reads at the pending's OWN index, so a LANDED run
    -- answers here too (`k:⏎  -⏎    &a x`).  What the landing cannot carry is
    -- the indent STABILITY — preprocessing unwinds the stack on a fresh line —
    -- so that conjunct is optional and the consumer's floor transport punts
    -- with it; the reading itself is the same one the inline run gives.
    (∃ ha ht : Bool,
      SSeparateLines n sp_scan sp_prep ∧
      (∀ n : Nat, PropsRun n .flowOut ha ht sp_prep sp_scan') ∧
      s'.needIndentCheck = false ∧ LastTokenReal s'.tokens ∧
      (ha = true →
        (trailingPropertyRunOnLine s'.tokens s'.line).any YamlToken.isAnchorProperty = true) ∧
      (ht = true →
        (trailingPropertyRunOnLine s'.tokens s'.line).any YamlToken.isTagProperty = true) ∧
      -- Item 83: the run's park carries the entry's floor AT its own state —
      -- inline off the stability, landed off the landing's `s-indent(n)`
      -- (`preprocess_some_floor_at_landing`), the props scan preserving the
      -- stack either way.
      n ≤ minContentIndentOf s' ∧
      (ha = false ∨ ht = false) ∧
      s'.simpleKey = (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).simpleKey ∧
      s'.line = (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).line ∧
      -- Item 79: the property scan's own flag, which the park it feeds carries.
      s'.simpleKeyAllowed = false ∧
      -- Item 102: …and the implicit value's STAMP, carried across the property
      -- scan.  The arm knows which head it took and the caller does not, so
      -- the transport is returned rather than re-derived — it is what lets the
      -- run's park hand `KeyPackPunt.implicitValue` on (`k: &p a: 1`).
      s'.implicitValueLine = (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).implicitValueLine ∧
      -- Item 284: the new park's slot face, paid from the landing's gate.
      (danglingNodePos? s' = none → s'.indents.size ≤ 1 ∨ SlotFace s'.tokens)) ∨
    ((SCLLiteral n sp_prep sp_scan' ∨ SCLFolded n sp_prep sp_scan') ∧
      -- Item 95: the landing walk at the scalar's stop, absorbable into the
      -- SAME node through `[169] l-trail-comments` (or forced empty by the
      -- stop character); the TAB-led stop, the shape `[168]`/`[169]` cannot
      -- absorb, is refused by item 97's runtime gate.
      (∀ sp_mid : SurfPos, SSLComments sp_scan' sp_mid →
        SCLLiteral n sp_prep sp_mid ∨ SCLFolded n sp_prep sp_mid) ∧
      SSeparate n .blockIn sp_scan sp_prep ∧
      (sp_scan'.col = 0 ∨ LineNodeStop sp_scan'.chars) ∧
      (c ≠ '&' ∧ c ≠ '!') ∧ (c = '|' ∨ c = '>')) ∨
    -- Item 53: the token itself crossed a line — a QUOTED body reads at the
    -- pending's own index off the loop's own guards (the fold's, and the
    -- escaped break's since the runtime edit).  The node is FIXED at `n`
    -- (the guards were measured against this floor); the separator stays
    -- index-free (the step is break-free at the dispatch level).
    (∃ sp_gram,
      SFlowNode n .flowOut sp_prep sp_gram ∧
      GStar SSWhite sp_gram sp_scan' ∧
      (sp_gram = sp_scan' → s'.col ≠ 0 → ¬ (CommentOk s' ∧ s'.peek? = some '#')) ∧
      SSeparate n .flowOut sp_scan sp_prep ∧
      (sp_scan'.col = 0 ∨ LineNodeStop sp_scan'.chars) ∧
      (c ≠ '&' ∧ c ≠ '!')) ∨
    -- Item 64: the landing UNDER-RAN `s-indent(n)`, and what is left of that
    -- after §6.1 is the pure-space DEDENT, named.  It is a boundary rather
    -- than debt: the value is not this entry's, the enclosing collection
    -- resumes at `j`, and no separator at `n` exists to be derived.
    --
    -- Item 100: these five are ALL of it.  The catch-all `∨ True` that used to
    -- close the list stood for one input — a multi-line PLAIN value whose fold
    -- crossed a blank line with a tab under the floor — and the walk's own
    -- §6.1 gate has refused it since.
    (IndentFloor sc n → DedentLanding n sp_scan sp_prep) := by
  have hpeek : s_prep.peek? = some c := preprocess_some_peek h_preprocess
  have hpeek_disp : (if s_prep.allowDirectives then
      { s_prep with allowDirectives := false, documentEverStarted := true }
    else s_prep).peek? = some c := by
    split
    · show s_prep.peek? = some c; exact hpeek
    · exact hpeek
  -- The separator is asked for FIRST because every positive answer needs it,
  -- and its negative — the landing UNDER-RAN `s-indent(n)` — is the dedent,
  -- which is a different question (item 60).
  --
  -- Item 60: the three facts the body reads, derived ONCE per branch.  The
  -- separator is at the pending's own index either way (item 52/57); the
  -- indent STABILITY is the break-free step's alone; and the floor at the
  -- step's own state comes from the stability inline and from the landing's
  -- own `s-indent(n)` across the break (`preprocess_some_floor_at_landing`).
  have pre : (SSeparateLines n sp_scan sp_prep ∧
      ((sc.needIndentCheck = false → s_prep.indents = sc.indents) ∨ True) ∧
      n ≤ minContentIndentOf s_prep) ∨
      (IndentFloor sc n → DedentLanding n sp_scan sp_prep) := by
    obtain ⟨sp_mid, sp_ws, sp_prep2, h_disj, h_ws, _h_cmt, hcorr2, h_pk, h_ltsl⟩ :=
      preprocess_some_ssl_comments_anyCol sc sp_scan s_prep c h_corr h_preprocess
    have h_pe : sp_prep = sp_ws := by
      have hsp_eq2 := ScannerSurfCorr_unique hcorr_prep hcorr2
      have h_eq : sp_prep2 = sp_ws := by
        cases h_pk with
        | inl h => exact h
        | inr h => rw [preprocess_some_peek h_preprocess] at h; cases h
      exact hsp_eq2.trans h_eq
    cases h_disj with
    | inr h_mid =>
      -- No break: the whites are `[66] s-separate-in-line`, and the stack is
      -- untouched, so the pending's own floor transports.
      have h_sep : SSeparateLines n sp_scan sp_prep := by
        rw [h_pe, ← h_mid.1]
        exact SSeparateLines.inline n _ _ (GStar_SSWhite_to_SSeparateInLine _ _ h_ws)
      refine Or.inl ⟨h_sep, Or.inl h_mid.2.2.1, ?_⟩
      rw [minContentIndentOf_congr (h_mid.2.2.1 h_floor.1)]
      exact h_floor.2
    | inl h_land =>
      -- A break: `[63] s-indent(n)` off the fresh line, or the DEDENT.
      rcases gstar_white_take_sIndent n h_ws with ⟨sx, h_ind, h_rest⟩ | h_ur
      · have h_sep : SSeparateLines n sp_scan sp_prep := by
          rw [h_pe]
          exact SSeparateLines.commented n _ _ _ h_land.1
            (SFlowLinePrefix.mk n sp_mid sx sp_ws h_ind
              (ScalarProduction.gstar_sswhite_to_gopt_sep h_rest))
        refine Or.inl ⟨h_sep, Or.inr trivial, ?_⟩
        refine preprocess_some_floor_at_landing h_preprocess h_floor.2 ?_
        -- the landing's own indent: `n` columns past a column-0 start, and
        -- the residual whites only move right
        have h_sx : sx.col = n := by rw [SIndent_col h_ind, h_land.2.1]; omega
        have h_ge := gstar_sswhite_col_ge _ _ h_rest
        have h_col_eq : sp_prep.col = s_prep.col := hcorr_prep.col_eq
        rw [h_pe] at h_col_eq
        omega
      · -- **The under-run** (item 64).  Two halves, and only one of them is a
        -- landing at all: §6.1 refuses a TAB at or left of the paid floor
        -- (`LandingTabFacts`, which the loop now carries out of
        -- `skipToContentWs`), so what survives is the pure-space DEDENT.
        obtain ⟨j, sx, hj, h_ind, h_rest, hend⟩ := h_ur
        by_cases hmid : sp_mid = sp_scan
        · -- The degenerate "landing" that never left the line is REFUTED now
          -- (item 83): it demands a column-0 park, and no caller's park is at
          -- a line start.
          exact absurd (hmid ▸ h_land.2.1) (by omega)
        · rcases hend with hrun | htab
          · exact Or.inr (fun _ => ⟨sp_mid, j, h_land.1, h_land.2.1, hj,
              by rw [h_pe, ← hrun]; exact h_ind⟩)
          · refine Or.inr (fun hfloor => ?_)
            exfalso
            -- The floor's own arithmetic supplies both of §6.1's premises: an
            -- under-run needs `0 < n`, and `n ≤ currentIndent + 1` then puts
            -- the stack above stream level and the tab at or left of it.
            have h_le := hfloor.2
            unfold minContentIndentOf at h_le
            have hci : 0 ≤ sc.currentIndent := by omega
            have hsx : (sx.col : Int) ≤ sc.currentIndent := by
              rw [SIndent_col h_ind, h_land.2.1]; omega
            have hc_hash : c ≠ '#' := by
              intro hc
              have := (dispatchContent_ok_charFacts h_dispatch).2
                (hc ▸ (Or.inl (Or.inl (Or.inr rfl)) : NodeStop '#'))
              rw [hc] at this; cases this
            rcases h_ltsl (Or.inr hmid) hci j sx h_ind hsx htab with h | h
            · rw [hpeek] at h; simp at h
            · rw [hpeek] at h; exact hc_hash (Option.some.inj h)
  rcases pre with ⟨h_sep_n, h_indents_or, h_floor_at⟩ | h_dedent
  ·
    by_cases hprops : c = '&' ∨ c = '!'
    · -- Item 24: a fresh `[96]` run is single-half, so it has no occurrence of
      -- the index to lift and the couplings item 12 needs are unchanged.
      have h_nic_prep : s_prep.needIndentCheck = false :=
        nic_false_of_flow_disp h_preprocess h_flow_disp
      have h_nic_ad : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).needIndentCheck = false := by
        split <;> exact h_nic_prep
      cases hprops with
      | inl h =>
        subst h
        obtain ⟨sp_a, ha_ev, -, hc⟩ := dispatchContent_anchorProp_prod _ sp_prep
          (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_dispatch
        have hsp_eq2 := ScannerSurfCorr_unique hc hcorr_result
        rw [hsp_eq2] at ha_ev
        obtain ⟨name, h_tokens⟩ := dispatchContent_anchor_tokens h_dispatch
        obtain ⟨h_line', h_nic'⟩ := dispatchContent_anchor_line_nic hpeek_disp h_dispatch
        obtain ⟨h_nic_s, h_real_s, h_any⟩ := props_couplings_of_push h_tokens h_line' h_nic'
          h_nic_ad (by simp) (by simp [YamlToken.isNodeProperty])
        exact Or.inr (Or.inl ⟨true, false, h_sep_n,
          fun _ => PropsRun.anchor _ _ ha_ev, h_nic_s, h_real_s,
          (fun _ => h_any YamlToken.isAnchorProperty (by simp [YamlToken.isAnchorProperty])),
          (fun h => nomatch h),
          (by
            have h_ind_eq : s'.indents = s_prep.indents := by
              rw [dispatchContent_props_indents (Or.inl rfl) h_dispatch,
                  allowDirectives_update_indents]
            rw [minContentIndentOf_congr h_ind_eq]
            exact h_floor_at),
          Or.inr rfl, (dispatchContent_anchor_simpleKey h_dispatch).1, h_line',
          (dispatchContent_anchor_simpleKey h_dispatch).2,
          dispatchContent_implicitValueLine h_dispatch,
          slotGateAt_spend h_src (Or.inl rfl) h_flow_disp h_dispatch⟩)
      | inr h =>
        subst h
        obtain ⟨sp_t, ht_ev, -, hc⟩ := dispatchContent_tagProp_prod _ sp_prep
          (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_dispatch
        have hsp_eq2 := ScannerSurfCorr_unique hc hcorr_result
        rw [hsp_eq2] at ht_ev
        obtain ⟨handle, suffix, h_tokens⟩ := dispatchContent_tag_tokens h_dispatch
        obtain ⟨h_line', h_nic'⟩ := dispatchContent_tag_line_nic hpeek_disp h_dispatch
        obtain ⟨h_nic_s, h_real_s, h_any⟩ := props_couplings_of_push h_tokens h_line' h_nic'
          h_nic_ad (by simp) (by simp [YamlToken.isNodeProperty])
        exact Or.inr (Or.inl ⟨false, true, h_sep_n,
          fun _ => PropsRun.tag _ _ ht_ev, h_nic_s, h_real_s, (fun h => nomatch h),
          (fun _ => h_any YamlToken.isTagProperty (by simp [YamlToken.isTagProperty])),
          (by
            have h_ind_eq : s'.indents = s_prep.indents := by
              rw [dispatchContent_props_indents (Or.inr rfl) h_dispatch,
                  allowDirectives_update_indents]
            rw [minContentIndentOf_congr h_ind_eq]
            exact h_floor_at),
          Or.inl rfl, (dispatchContent_tag_simpleKey h_dispatch).1, h_line',
          (dispatchContent_tag_simpleKey h_dispatch).2,
          dispatchContent_implicitValueLine h_dispatch,
          slotGateAt_spend h_src (Or.inr rfl) h_flow_disp h_dispatch⟩)
    · by_cases hbs : c = '|' ∨ c = '>'
      · -- Item 26: a block scalar is not a one-line reading and never will be,
        -- but it does not need to be — `[170]`/`[174]` bind their content indent
        -- existentially, so the reading holds at every index below the indent the
        -- body was collected at, and the scanner's own `minContentIndent` floor is
        -- what says which indices those are.
        obtain ⟨sp_bs, d, h_floor', h_read, hcorr_bs, h_absorb95⟩ :=
          dispatchContent_blockScalar_prod_at _ sp_prep
            (corr_of_allowDirectives_update hcorr_prep) hpeek_disp hbs h_dispatch
        have hsp_bs_eq := ScannerSurfCorr_unique hcorr_bs hcorr_result
        rw [hsp_bs_eq] at h_read h_absorb95
        have h_ci : (if s_prep.allowDirectives then
            { s_prep with allowDirectives := false, documentEverStarted := true }
          else s_prep).currentIndent = s_prep.currentIndent := by
          split <;> rfl
        rw [h_ci] at h_floor'
        have hna : c ≠ '&' := fun h => hprops (Or.inl h)
        have hnt : c ≠ '!' := fun h => hprops (Or.inr h)
        have h_line := col0_or_lineStop
          (dispatchContent_restNodeStop h_flow_disp hna hnt hcorr_result.end_eq h_dispatch)
          hcorr_result
        -- Item 27: the guard is DISCHARGED here rather than split on.  The
        -- pending measured `n` against the indent stack when it parked, this
        -- step crossed no break (that is the branch we are in), and a
        -- break-free step leaves the stack alone — so the entry's index is
        -- still one the body's floor admits.  A pending whose producer could
        -- not measure it hands `True` and the case falls to the same single
        -- deferral the fold already uses; no caller gains a route (R645/R646).
        have hn : n ≤ d := Nat.le_trans h_floor_at h_floor'
        exact Or.inr (Or.inr (Or.inl
          ⟨h_read.elim (fun h => Or.inl (h n hn)) (fun h => Or.inr (h n hn)),
           fun sp_mid W =>
             (h_absorb95 sp_mid W).elim (fun h => Or.inl (h n hn)) (fun h => Or.inr (h n hn)),
           h_sep_n, h_line, ⟨hna, hnt⟩, hbs⟩))
      · have hna : c ≠ '&' := fun h => hprops (Or.inl h)
        have hnt : c ≠ '!' := fun h => hprops (Or.inr h)
        have hnp : c ≠ '|' := fun h => hbs (Or.inl h)
        have hng : c ≠ '>' := fun h => hbs (Or.inr h)
        by_cases hline_eq : s'.line = (if s_prep.allowDirectives then
            { s_prep with allowDirectives := false, documentEverStarted := true }
          else s_prep).line
        · have h_line := col0_or_lineStop
            (dispatchContent_restNodeStop h_flow_disp hna hnt hcorr_result.end_eq h_dispatch)
            hcorr_result
          obtain ⟨sp_gram, sp_ev, h_flow_all, h_trailing_ws, h_gate_ev, -, hcorr_ev⟩ :=
            dispatchContent_evidence_oneLine _ sp_prep c
              (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_flow_disp h_not_doc
              hna hnt hnp hng hline_eq h_dispatch
          have hsp_ev_eq := ScannerSurfCorr_unique hcorr_ev hcorr_result
          rw [hsp_ev_eq] at h_trailing_ws h_gate_ev
          exact Or.inl ⟨sp_gram, h_sep_n, h_flow_all,
                        h_trailing_ws, h_gate_ev, h_line, hna, hnt⟩
        · -- Item 53: the fold.  A quoted token reads at `n` when the floor
          -- was measured (`h_floor`'s left is `n ≤ currentIndent + 1`); the
          -- plain fold keeps the deferral (item 54's class).
          · have h_line := col0_or_lineStop
              (dispatchContent_restNodeStop h_flow_disp hna hnt hcorr_result.end_eq h_dispatch)
              hcorr_result
            have hn_disp : (n : Int) ≤ max 0 ((if s_prep.allowDirectives then
                { s_prep with allowDirectives := false, documentEverStarted := true }
              else s_prep).currentIndent + 1) := by
              have h_ci_ad : (if s_prep.allowDirectives then
                  { s_prep with allowDirectives := false, documentEverStarted := true }
                else s_prep).currentIndent = s_prep.currentIndent := by split <;> rfl
              rw [h_ci_ad]
              unfold minContentIndentOf at h_floor_at
              omega
            by_cases hdq : c = '"'
            · subst hdq
              obtain ⟨sp', h_gram, h_pb, hcorr'⟩ :=
                dispatchContent_doubleQuoted_prod_at n _ sp_prep
                  (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_dispatch hn_disp
              have hsp_eq := ScannerSurfCorr_unique hcorr' hcorr_result
              rw [hsp_eq] at h_gram
              exact Or.inr (Or.inr (Or.inr (Or.inl
                ⟨sp_scan',
                 SFlowNode.content n .flowOut sp_prep sp_scan'
                   (SFlowContent.doubleQ n .flowOut sp_prep sp_scan'
                     (SCDoubleQuoted_multiCtx .flowOut (Or.inl rfl) h_gram)),
                 GStar.nil _,
                 fun _ hcol h => CommentOk_false_of_peekBack hcol h_pb (by decide) h.1,
                 h_sep_n, h_line, hna, hnt⟩)))
            · by_cases hsq : c = '\''
              · subst hsq
                obtain ⟨sp', h_gram, h_pb, hcorr'⟩ :=
                  dispatchContent_singleQuoted_prod_at n _ sp_prep
                    (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_dispatch hn_disp
                have hsp_eq := ScannerSurfCorr_unique hcorr' hcorr_result
                rw [hsp_eq] at h_gram
                exact Or.inr (Or.inr (Or.inr (Or.inl
                  ⟨sp_scan',
                   SFlowNode.content n .flowOut sp_prep sp_scan'
                     (SFlowContent.singleQ n .flowOut sp_prep sp_scan'
                       (SCSingleQuoted_multiCtx .flowOut (Or.inl rfl) h_gram)),
                   GStar.nil _,
                   fun _ hcol h => CommentOk_false_of_peekBack hcol h_pb (by decide) h.1,
                   h_sep_n, h_line, hna, hnt⟩)))
              · -- Item 54: the PLAIN fold at `n`.  Item 61: the alias arm is a
                -- PHANTOM, not a deferral — `[102] ns-anchor-char` excludes
                -- `s-white` and `b-char`, so an alias cannot cross a break and
                -- the branch this is in (the token DID cross one) is empty.
                by_cases hstar : c = '*'
                · subst hstar
                  exact absurd
                    (dispatchContent_alias_line_nic hpeek_disp h_dispatch).1 hline_eq
                · have hn_mci : n ≤ minContentIndentOf (if s_prep.allowDirectives then
                      { s_prep with allowDirectives := false, documentEverStarted := true }
                    else s_prep) := by
                    have h1 : minContentIndentOf (if s_prep.allowDirectives then
                        { s_prep with allowDirectives := false, documentEverStarted := true }
                      else s_prep) = minContentIndentOf s_prep := by
                      refine minContentIndentOf_congr ?_
                      split <;> rfl
                    rw [h1]
                    exact h_floor_at
                  obtain ⟨sp_gram, sp', h_gram, h_tws, h_nohash, hcorr'⟩ :=
                    dispatchContent_plainScalar_prod_at n _ sp_prep
                      (corr_of_allowDirectives_update hcorr_prep) hpeek_disp
                      hna hstar hnt hnp hng hdq hsq h_not_doc h_dispatch
                      h_flow_disp hn_mci
                  have hsp_eq := ScannerSurfCorr_unique hcorr' hcorr_result
                  rw [hsp_eq] at h_tws h_nohash
                  exact Or.inr (Or.inr (Or.inr (Or.inl
                    ⟨sp_gram, h_gram, h_tws, fun heq _ h => h_nohash heq h.2,
                     h_sep_n, h_line, hna, hnt⟩)))
  · -- The DEDENT: the landing under-ran `s-indent(n)`, so the value is not
    -- this entry's at all — the enclosing collection ends and the next one
    -- resumes, which is a different question and its own item.  Item 64 hands
    -- it on LOCATED rather than as `True`, so that question can be asked.
    exact Or.inr (Or.inr (Or.inr (Or.inr h_dedent)))


/-- **The INDENTED entry's value** (item 23) — `accum_content_on_pendingBlock`
    at the entry index item 22 gave the pending.

    Not a generalisation of the arm above but a NARROWER sibling: keeping the
    `n = 0` arm intact is deliberate, because at column 0 a property run and a
    block scalar DO compose and a single lemma covering both indices would have
    to be the intersection.  What the indented arm can and cannot read is one
    question, asked once — `indentedValue_reads_at_any_indent`. -/
lemma accum_content_on_pendingBlock_indented
    (sc : ScannerState) (sp_start sp_block sp_scan : SurfPos) (n : Nat)
    (s_prep s' : ScannerState) (c : Char) (sp_prep sp_scan' : SurfPos)
    (h_stream_block : SLYamlStream sp_start sp_block)
    (h_close_old : ∀ (sp : SurfPos), SBlockIndented n .blockIn sp_scan sp → SLYamlStream sp_start sp)
    (h_close_entry_old : ∀ (sp : SurfPos), SBlockIndented n .blockIn sp_scan sp →
      ∀ (sp_end : SurfPos), SCompactSeqTail n sp sp_end → SLYamlStream sp_start sp_end)
    -- Item 92: the park's value-line pack, transported onto whatever this
    -- content step parks — the entry's node rides in exactly as it does for
    -- `h_close_entry_old` (`? - a⏎: - w`, `? - &a x⏎: - w`).
    (h_kslot_old : (∃ nv : Nat,
      ∀ sp_m : SurfPos, SBlockIndented n .blockIn sp_scan sp_m →
      ∀ sp_e : SurfPos, SCompactSeqTail n sp_m sp_e →
      ∀ sp_i sp_c : SurfPos, SIndent nv sp_e sp_i → GLit ':' sp_i sp_c →
      ∀ sp_v : SurfPos, SBlockIndented nv .blockOut sp_c sp_v →
      SLYamlStream sp_start sp_v) ∨ PackAlt sc)
    -- Item 99: the park's resume frames (`pendingBlock.h_closeF`), threaded
    -- so the pack lemmas can pay their resume twins.
    -- **Item 155: and the cover the field now carries** — the sequence lane's
    -- first, and the reason the lane's landings can read the scanner at all.
    (h_closeF_old : (∃ ks : List FrameLevel, (∀ fr ∈ ks, fr.width < n) ∧
      ((∃ lo : Nat, IndentStackCover.Floor lo n ks ∧
        IndentStackCover.Covered lo ks sc) ∨ True) ∧
      ∀ sp_mid : SurfPos, SBlockIndented n .blockIn sp_scan sp_mid →
      ∀ sp_end : SurfPos, SCompactSeqTail n sp_mid sp_end →
      ResumeFrames (SLYamlStream sp_start) ks sp_end) ∨ True)
    -- **Item 167: the park's ENCLOSING collection** (`pendingBlock.h_seqF`),
    -- threaded so the entry's CONTENT park carries it too.  It rides exactly
    -- as `h_close_entry_old` rides — the content becomes the entry's node and
    -- the field's own tail is untouched — which is why the three parks below
    -- pay it with their own node term and nothing else.
    (h_seqF_old : (∃ ke : Nat, ∀ sp_mid : SurfPos,
      SBlockIndented n .blockIn sp_scan sp_mid →
      ∀ sp_end : SurfPos, SCompactSeqTail n sp_mid sp_end →
      SeqEntryTail sp_start ke sp_end) ∨ True)
    -- Item 179: the floor at the SHIFTED index, `pendingBlock`'s own field.
    (h_floor_old : IndentFloor sc (n + 1))
    (h_col_old : sp_scan.col = n + 1)
    -- Item 90: the park's own flag (item 34), handed to the pack lemmas.
    (h_ska : sc.simpleKeyAllowed = true)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (hcorr_result : ScannerSurfCorr s' sp_scan')
    (h_corr : ScannerSurfCorr sc sp_scan)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h_not_doc : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).col = 0 →
      atDocumentBoundary (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) = false)
    (h_flow_disp : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).inFlow = false)
    (h_dispatch : scanNextToken_dispatchContent
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) c = .ok s')
    -- **Item 155 (LAST): the stack's base and shape**, the two facts this
    -- lemma's dedent relay has owed since item 151.  A carried cover becomes a
    -- landing's floor only through `Mono`, and the floor itself is read off the
    -- landed arm with `SentinelBase` covering the bottomed stack — so a relay
    -- holding neither could state a cover and never spend it.  Every caller
    -- already carries both.
    (h_base : IndentStackBase.SentinelBase sc)
    (h_mono : IndentStackMono.Mono sc)
    -- **Item 190 (LAST): the park's SECOND frame** (`pendingBlock.h_kslotUp`),
    -- transported onto whatever this content step parks exactly as `h_kslot_old`
    -- is — one term written twice, differing only in which entry's `:` line is
    -- owed after the fill (`?⏎  ? - a⏎: w`).
    -- Item 191: a LIST, relayed whole.
