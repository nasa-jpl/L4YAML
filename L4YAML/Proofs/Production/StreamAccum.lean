        split at h_dispatch
        · simp at h_dispatch
        · rename_i s_k hk
          have hc : c = '?' := by
            by_cases hcq : c = '?'
            · exact hcq
            · rw [show (c == '?') = false from by simp [hcq]] at heq; simp at heq
