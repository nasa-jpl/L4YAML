               h_entryTail sp_final h_indented sp_final (SCompactSeqTail.nil k sp_final))
             h_entryTail
             (indicator_floor_dash hcol_mid h_ind hcorr_prep h_preprocess h_dispatch)
             (dispatchBlockEntry_simpleKeyAllowed h_dispatch)
             (park_col_of_indicator hcol_mid h_ind h_dash)
             -- Item 92: the old pending closed and the landed `-` opens a NEW
             -- `[183]` sequence under no frame.  When the closed pending was a
             -- `?` park this is `?⏎- a⏎: - w`'s seq-spaces KEY — the
             -- `s-l+block-node` alternative of `[185]`, not the compact one —
             -- ~~and its value line stays with the deferral (the kind's own
             -- residue; `h_vpack` here bakes the e-node key and cannot serve).~~
             -- ═══ **Item 188: the frame's key is what this `-` opens, and the
             -- SLOT is what serves it.**  `h_vpack` does bake the `e-node` key
             -- and item 92 was right about that field; the reading it named as
             -- deferred is not that field's, it is `h_vslot`'s — the OPEN
             -- `[185]` slot the `?` park carries, whose inner pack is the
             -- frame's `[190] s-indent(nv) ':' s-l+block-indented(nv,
             -- block-out)` value line.  `slotLandedSeq` fills the slot with
             -- the collection this `-` opens, at `seq-spaces`' one-column-left
             -- index, and the pack then rides on the new park as its own
             -- value-line twin — which is what the landed `:` spends at
             -- `accum_block_on_pendingBlock` (`?⏎-⏎: w`, `?⏎- a⏎: w`,
             -- `?⏎  - a⏎: w`, and through the sibling arm `?⏎- a⏎- b⏎: w`).
             -- A slot with no inner pack, or a landing LEFT of the frame,
             -- keeps the deferral. ═══
             (match h_vslot with
              | Or.inl ⟨nv, _, _, _, _, _, _, _, Or.inl hkv, _⟩ =>
                  if hnk : nv ≤ k then
                    Or.inl ⟨nv, fun _ h_indented sp_e h_tail =>
                      hkv sp_e (slotLandedSeq hnk h_ssl
                        (SBlockSeqEntries_of_compactTail h_ind h_dash h_gnot
                          h_indented h_tail))⟩
                  -- Item 307: behind the slot, the resumed stack's close.
                  else (h_resKslot.imp id (PackAlt.step_blockEntry h_preprocess h_dispatch))
              | _ => (h_resKslot.imp id (PackAlt.step_blockEntry h_preprocess h_dispatch)))
             -- Item 99: the resume frames — the entry and the tail close the
             -- root sequence over the same closed prefix.
             -- **Item 155: …and the level the closed park awaited a node for,
             -- where there was one** — built above, because the bottomed
             -- reading is the fallback rather than the answer.
             h_seqFrames
             (nodir_of_block_dispatch h_dispatch) (Or.inr trivial)
             -- ═══ **Item 190: the frame ABOVE the slot, across the same
             -- crossing.**  `slotLandedSeq` fills the `?`'s key with the
             -- collection this `-` opens; item 188 then read the frame's OWN
             -- value line off it, and this reads the line of the frame that one
             -- stands inside.  Same carrier, same bound — what differs is only
             -- which `:` is owed. ═══
             (match h_vslot with
              | Or.inl ⟨nv, _, _, _, _, _, _, _, _, Or.inl ⟨nsU, hkvU⟩⟩ =>
                  if hnk : nv ≤ k then
                    -- Item 191: the crossing is indifferent to WHICH ancestor's
                    -- line follows, so the whole list rides one term.
                    Or.inl ⟨nsU, fun nvU hmem _ h_indented sp_e h_tail =>
                      hkvU nvU hmem sp_e (slotLandedSeq hnk h_ssl
                        (SBlockSeqEntries_of_compactTail h_ind h_dash h_gnot
                          h_indented h_tail))⟩
                  else Or.inr trivial
              -- Item 320: the frame-above alternative, carried across the `-` (the catch-all keeps the residue arm).
              | Or.inl ⟨_, _, _, _, _, _, _, _, _, Or.inr h_alt⟩ =>
                  Or.inr (PackAlt.step_blockEntry h_preprocess h_dispatch h_alt)
              | _ => Or.inr trivial)
             -- **Item 198: the value-line stack, across the same step.**  Built above
             -- from `h_valFV`, exactly as `h_closeF` is built from `h_valF`.
             (h_seqFramesV.imp id (PackAlt.step_blockEntry h_preprocess h_dispatch))
             -- Item 208: and the entry's TOP, off the landing's own floor — from the
             -- walk's unwind where the park stood off a line start, from item 207's
             -- flag where it stood on one.
             (indicator_top_dash hcol_mid h_ind hcorr_prep
               (dash_landing_floor h_noflow h_larm h_nic0 h_base h_preprocess)
               h_dispatch),
           hcorr_result⟩
  · -- c ≠ '-' at the landing: a ':' opens `[189]`'s empty-key entry there
    -- (item 13), a '?' opens `[186]`'s explicit-key one (item 20) — one arm.
    by_cases hcv : c = ':' ∨ c = '?'
    · have h_generic := fun (h_src : c = ':' → (if s_prep.allowDirectives then
            { s_prep with allowDirectives := false, documentEverStarted := true }
          else s_prep).explicitKeyLine = none ∨
          (scanValueClearKey (if s_prep.allowDirectives then
            { s_prep with allowDirectives := false, documentEverStarted := true }
          else s_prep)).simpleKey.possible = true ∨
          ((if s_prep.allowDirectives then
            { s_prep with allowDirectives := false, documentEverStarted := true }
          else s_prep).col : Int) ≠ (if s_prep.allowDirectives then
            { s_prep with allowDirectives := false, documentEverStarted := true }
          else s_prep).explicitKeyCol) =>
        indicator_open_map sp_start sp_mid _ k c hcv s_prep s' sp_scan'
          h_stream_new hcol_mid h_ind hcorr_prep hcorr_result
          (landing_or_park_save h_noflow h_larm (h_park.imp_left And.left) h_preprocess)
          (preprocess_some_peek h_preprocess) (noflow_disp_of_noflow h_noflow)
          (nic_false_of_indicator_noflow h_preprocess (noflow_disp_of_noflow h_noflow))
          h_dispatch h_preprocess h_src h_sfx_land
          -- Item 136: this landing closes a park that HAS started a document
          -- (`noPending` has its own lemma), so the head arm punts here.
          (Or.inr trivial) h_mk_land
          -- Item 173: the resume face, read above at this landing's width.
          h_res_land h_ref_land
          -- Item 147: the landing's floor, where this step reached the
          -- indicator across a break.
          (by
            by_cases hc0 : sp_scan.col = 0
            · exact Or.inr trivial
            · exact Or.inl ⟨h_mono, h_base,
                landing_floor_of_arm h_noflow h_larm hc0 h_base h_preprocess⟩)
          -- Item 175: the props arm, read above at the same landing.
          h_pr_land
          -- ═══ **Item 189: the landed MAPPING fills the frame's key slot.**
          -- The `?` this landing opens heads `[187] l+block-mapping(k)`, and
          -- where the park it closed carries a still-open `[185]` slot at
          -- `nv` with its value line in hand, that mapping IS the slot's
          -- content: `slotLandedMap` at `nv + 1 ≤ k`.  The bound is one column
          -- right of `slotLandedSeq`'s (item 188) because `[187]` is opened at
          -- `n + m` with no `seq-spaces` in front of it, and the runtime draws
          -- the same line — `?⏎  ?⏎: w` nests, `?⏎?⏎: w` fuses into one entry.
          -- Only the `?` opener can spend this; the `:` one is refused at the
          -- landing (see `indicator_open_map`).  **Item 196 retired the
          -- parameter this paid** — the chain below narrows to the awaited node
          -- exactly as the single index did, so the nearest frame rides in the
          -- list with the rest and this payment is a prefix of the next. ═══
          -- ═══ **Item 191: the park's WHOLE chain, consed at this step.**
          -- The crossing above is `slotLandedMap hnk` and its side condition
          -- reads the park's own index against the landing's — it says nothing
          -- about which ancestor's `:` line follows, so the identical term
          -- carries every one of them.  The new park therefore leaves this
          -- landing holding its own frame AND everything the closed park was
          -- already holding above it, which is the step item 190's payment
          -- dropped: `?⏎  ?⏎    ? -⏎: w` lands two frames up and
          -- `?⏎  ?⏎    ? -⏎  : v⏎: w` one, and the two inputs differ only in
          -- where the `:` stands. ═══
          (match h_vslot with
           | Or.inl ⟨nv, _, _, _, _, _, _, _, hkv, hkvUp⟩ =>
               if hnk : nv + 1 ≤ k then
                 match hkv, hkvUp with
                 | Or.inl kv, Or.inl ⟨nsU, kvU⟩ =>
                     Or.inl ⟨nv :: nsU, slotChainMap hnk h_ssl h_ind (by
                       rintro nvX hmem
                       rcases List.mem_cons.mp hmem with rfl | hmem'
                       · exact kv
                       · exact kvU nvX hmem')⟩
                 | Or.inl kv, Or.inr _ =>
                     Or.inl ⟨[nv], slotChainMap hnk h_ssl h_ind (by
                       rintro nvX hmem
                       rcases List.mem_cons.mp hmem with rfl | hmem'
                       · exact kv
                       · exact absurd hmem' (List.not_mem_nil))⟩
                 | Or.inr _, Or.inl ⟨nsU, kvU⟩ =>
                     Or.inl ⟨nsU, slotChainMap hnk h_ssl h_ind kvU⟩
                 | Or.inr h_alt, Or.inr _ => Or.inr h_alt
               else Or.inr trivial
           | _ => Or.inr trivial)
          -- Item 197: the landing's value-line resume, read above at this
          -- landing's width beside the stream one.
          h_resV_land
          -- Item 209: the dispatch's floor, required now — item 208's `h_nic0`
          -- is what closes the column-0 half the `h_cov` bundle used to punt on.
          (dash_landing_floor h_noflow h_larm h_nic0 h_base h_preprocess)
      by_cases hc_colon : c = ':'
      · subst hc_colon
        -- Item 51: an explicit-value pack fires on the `:` at its OWN column —
        -- `[187]`'s `s-indent(n)` is exact — and any other shape falls back to
        -- the generic close-and-reopen.
        have h_explicit := fun (hvp : ∀ sp_m sp_i sp_c : SurfPos,
            SSLComments sp_scan sp_m → SIndent k sp_m sp_i → GLit ':' sp_i sp_c →
            ∀ sp_v : SurfPos, SBlockIndented k .blockOut sp_c sp_v →
            SLYamlStream sp_start sp_v) =>
          colon_open_map_explicit sp_start sp_scan sp_mid _ k s_prep s'
            sp_scan' h_stream_new hvp h_ssl hcol_mid h_ind hcorr_prep hcorr_result
            -- Item 76: the explicit VALUE line measures on the same datum the
            -- keyless opener does — `h_vpack` carries no flag, and the
            -- landing supplies one for every park off a line start.
            (indicator_floor_colon_at_col_of_save
              (by have := SIndent_col h_ind; rw [hcol_mid] at this; omega)
              hcorr_prep (noflow_disp_of_noflow h_noflow)
              (landing_or_park_save h_noflow h_larm (h_park.imp_left And.left) h_preprocess)
              h_preprocess h_dispatch)
            (preprocess_some_peek h_preprocess) (noflow_disp_of_noflow h_noflow)
            (nic_false_of_indicator_noflow h_preprocess (noflow_disp_of_noflow h_noflow))
            h_dispatch
            -- Item 209: and the explicit `:`'s own TOP, off the same landing
            -- floor — this opener pushes nothing, so the bound passes through.
            (indicator_top_kv_at_col (Or.inl rfl)
              (by have := SIndent_col h_ind; rw [hcol_mid] at this; omega)
              hcorr_prep
              (landing_or_park_save h_noflow h_larm (h_park.imp_left And.left) h_preprocess)
              (noflow_disp_of_noflow h_noflow)
              (dash_landing_floor h_noflow h_larm h_nic0 h_base h_preprocess)
              h_dispatch)
        -- ═══ Item 125: the landed `:` decides its own stamp source by
        -- classical case split — both conjuncts are the dispatch state's own
        -- fields.  With a source the generic reopen's park carries a REAL
        -- stamp; without one the register is live AT the landing's own
        -- column, and the pack (when the park carries one at that column)
        -- still fires the explicit route.  What is left is a live register at
        -- the landing's column with no pack THERE, and that stays the
        -- deferral it already was (item 126). ═══
        -- ═══ **Item 189: …and the frames ABOVE the park are tried with it.**
        -- A park nested inside outer `?` frames holds a value line for each of
        -- them, at a different column each; the landing's own column names
        -- which.  Item 189 read a second candidate from a second parameter;
        -- **item 192 reads the whole chain from one list**, so the question the
        -- landing asks is MEMBERSHIP and the four fallbacks below become two. ═══
        by_cases h_src : (if s_prep.allowDirectives then
            { s_prep with allowDirectives := false, documentEverStarted := true }
          else s_prep).explicitKeyLine = none ∨
          (scanValueClearKey (if s_prep.allowDirectives then
            { s_prep with allowDirectives := false, documentEverStarted := true }
          else s_prep)).simpleKey.possible = true ∨
          ((if s_prep.allowDirectives then
            { s_prep with allowDirectives := false, documentEverStarted := true }
          else s_prep).col : Int) ≠ (if s_prep.allowDirectives then
            { s_prep with allowDirectives := false, documentEverStarted := true }
          else s_prep).explicitKeyCol
        · rcases h_vpack with ⟨ns, hvp⟩ | _
          · by_cases hknv : k ∈ ns
            · exact h_explicit (hvp k hknv)
            · exact h_generic (fun _ => h_src)
          · exact h_generic (fun _ => h_src)
        · rcases h_vpack with ⟨ns, hvp⟩ | _
          -- Item 189: the park's own frame misses and one ABOVE it hits
          -- (`?⏎  ?⏎: w`); item 192: or one further above still, which is why
          -- the test is membership rather than a pair of equalities.
          · by_cases hknv : k ∈ ns
            · exact h_explicit (hvp k hknv)
            · -- Item 185: no frame the park carries is at the landing's column.
              exact block_dispatch_deferred_stamp_offcol sp_start sp_mid sp_scan' s'
                h_stream_new
                (arm_tight_of_block_dispatch h_preprocess h_dispatch hcorr_result) hcorr_result
                (nodir_of_block_dispatch h_dispatch) h_src
                (explicit_at_indent_of_dispatch h_dispatch
                  (noflow_disp_of_noflow h_noflow) h_src) hknv
                (nic0_of_block_dispatch h_preprocess h_dispatch hcorr_result) (Or.inl (block_indicator_arm h_dispatch))
          · -- Item 185: the park carries NO pack.
            exact block_dispatch_deferred_stamp_nopack sp_start sp_mid sp_scan' s'
              h_stream_new
              (arm_tight_of_block_dispatch h_preprocess h_dispatch hcorr_result) hcorr_result
              (nodir_of_block_dispatch h_dispatch) h_src
              (explicit_at_indent_of_dispatch h_dispatch
                (noflow_disp_of_noflow h_noflow) h_src)
              (fun h => h_src (Or.inl (ekl_disp_none_of_park_none h_preprocess h)))
              (nic0_of_block_dispatch h_preprocess h_dispatch hcorr_result) (Or.inl (block_indicator_arm h_dispatch))
      · exact h_generic (fun h => absurd h hc_colon)
    · exact (block_indicator_exhausted h_dispatch hc hcv).elim

/-- **The coupling that fires `colon_open_map_props`** (item 49): at a props
    park the same-line `:` spends the pack — the landed side closes and reopens
    (or, since item 91, spends the park's `h_kslot` where a `[187]` frame is
    open), the pack-less side keeps the escape.

    Item 287 moved it here, beside `colon_fires_implicit_key`: its pack-less
    arms apply `block_dispatch_deferred_inline` themselves, and `h_punt` is a
    builder for the same reason as there.  **Item 289: the `tab` arm refutes**,
    on the saved key's possibility and line the reason carries, so ~~two arms
    apply the wrapper — `dedent` and `noKeyContext`~~ one arm applies the
    wrapper, `noKeyContext` (**item 297 deletes `dedent`**: the producers key a
    fresh document at the landing instead of punting).  **Item 300: the
    marker-line reason refutes too**, through `dispatch_refutes_sameLine`'s
    field disjunct, on the park's own flags. -/
lemma colon_fires_props_key (sc : ScannerState)
    (sp_start sp_block sp_p sp_scan : SurfPos)
    (s_prep s' : ScannerState) (sp_prep sp_scan' : SurfPos)
    (h_stream_block : SLYamlStream sp_start sp_block)
    -- Item 80: the park's own flags (`h_nic`/`h_ska`, items 12/79) are what
    -- the no-break transport spends — with the flag down preprocessing
    -- re-saved nothing, so the key the `:` resolves IS the run's.  Item 81
    -- adds the park's token reading (for the transport's line half) and the
    -- scanner-wide `KeysBehindCursor` (for the clear's offset half).
    (h_nic : sc.needIndentCheck = false)
    (h_ska : sc.simpleKeyAllowed = false)
    (h_real : LastTokenReal sc.tokens)
    (h_kbc : ScannerCorrectness.KeysBehindCursor sc)
    (h_key : PropsKeyPack sc sp_start sp_p sp_scan ∨ KeyPackPunt sc)
    (h_punt : (InlineResidue sp_scan ':' →
        (sc.needIndentCheck = false → LastTokenReal sc.tokens →
          s_prep.line = sc.line ∧ s_prep.needIndentCheck = false ∧
          lastRealToken? s_prep.tokens = lastRealToken? sc.tokens ∧
          penultRealToken? s_prep.tokens = penultRealToken? sc.tokens) →
        ∃ sp_gram' sp_block' sp_flow' sp_scan'',
          SLYamlStream sp_start sp_gram' ∧
          BlockStack sp_gram' sp_block' ∧
          FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
          PendingNode s' false sp_start sp_flow' sp_scan'' ∧
          ScannerSurfCorr s' sp_scan'') →
      ∃ sp_gram' sp_block' sp_flow' sp_scan'',
      SLYamlStream sp_start sp_gram' ∧
      BlockStack sp_gram' sp_block' ∧
      FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
      PendingNode s' false sp_start sp_flow' sp_scan'' ∧
      ScannerSurfCorr s' sp_scan'')
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (hcorr_result : ScannerSurfCorr s' sp_scan')
    (h_corr : ScannerSurfCorr sc sp_scan)
    (h_noflow : s_prep.inFlow = false)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, ':')))
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) ':' = .ok (some s')) :
    ∃ sp_gram' sp_block' sp_flow' sp_scan',
      SLYamlStream sp_start sp_gram' ∧
      BlockStack sp_gram' sp_block' ∧
      FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
      PendingNode s' false sp_start sp_flow' sp_scan' ∧
      ScannerSurfCorr s' sp_scan' := by
  cases h_key with
  | inr punt =>
    -- ═══ Item 102: the props park's punt is LOCATED now, so this `:` spends
    -- the one reason that is its own — the same §8.2.2 refusal item 101 gave
    -- the sibling, one construct over.  `k: &p : 1` and `k: !!str : 1` are an
    -- implicit value's second value indicator, and the property scan is not
    -- `scanValue`, so the stamp the indicator left is still on the park's
    -- line.  ~~Two ride the deferral: the dedent is row 19's and
    -- `noKeyContext` nobody's.~~  One rides the deferral, `noKeyContext`;
    -- `dedent` is deleted at item 297.  **Item 289: the TAB is refuted here, as at
    -- the sibling.**  Its refutation (`scanValue_tab_keyrun_ne`, item 65)
    -- also wants the saved key's LINE and its possibility, which
    -- `colon_fires_implicit_key` reads off the guard its own field is stated
    -- under and which the reason carries, so `k:⏎␣→&p : 1` is refuted at the
    -- run's own park; the decorated `k:⏎␣→&p a: 1` still lands on the
    -- sibling, through the transport. ═══
    cases punt with
    | implicitValue h_ivl _h_kl _h_st =>
      obtain ⟨_sp_mid, _sp_ws, _sp_prep2, h_disj, _h_ws, _h_cmt, hcorr_prep2, _h_pk, _⟩ :=
        preprocess_some_ssl_comments_anyCol sc sp_scan s_prep ':' h_corr h_preprocess
      have hsp_eq2 := ScannerSurfCorr_unique hcorr_prep hcorr_prep2; subst hsp_eq2
      cases h_disj with
      -- A break intervened, so the stamped line is behind us and the `:` is a
      -- landed one — the caller's own escape, as on the pack side below.
      | inl h_l => exact h_punt (fun h_res _ => (sslComments_refutes_inline_residue h_l.1 (Or.inr (Or.inl rfl)) h_res).elim)
      | inr h_mid =>
        exact (dispatch_refutes_sameLine h_nic h_real (Or.inl h_ivl)
          (preprocess_preserves_implicitValueLine sc s_prep ':' h_preprocess)
          (preprocess_preserves_docStartLine sc s_prep ':' h_preprocess)
          (noflow_disp_of_noflow h_noflow) h_mid.2.1 h_dispatch).elim
    | markerLine h_doc _h_kl =>
      -- ═══ Item 300: the marker's line, refuted here as the stamp is — the
      -- field `scanDocumentStart` wrote is still `some` of this line at the
      -- `:`'s own state (`--- &p a: 1`), and §9.1.1 refuses the entry. ═══
      obtain ⟨_sp_mid, _sp_ws, _sp_prep2, h_disj, _h_ws, _h_cmt, hcorr_prep2, _h_pk, _⟩ :=
        preprocess_some_ssl_comments_anyCol sc sp_scan s_prep ':' h_corr h_preprocess
      cases h_disj with
      | inl h_l => exact h_punt (fun h_res _ => (sslComments_refutes_inline_residue h_l.1 (Or.inr (Or.inl rfl)) h_res).elim)
      | inr h_mid =>
        exact (dispatch_refutes_sameLine h_nic h_real (Or.inr (Or.inl h_doc))
          (preprocess_preserves_implicitValueLine sc s_prep ':' h_preprocess)
          (preprocess_preserves_docStartLine sc s_prep ':' h_preprocess)
          (noflow_disp_of_noflow h_noflow) h_mid.2.1 h_dispatch).elim
    | tab h_run h_st h_poss h_kline =>
      obtain ⟨_sp_mid, _sp_ws, _sp_prep2, h_disj, _h_ws, _h_cmt, hcorr_prep2, _h_pk, _⟩ :=
        preprocess_some_ssl_comments_anyCol sc sp_scan s_prep ':' h_corr h_preprocess
      have hsp_eq2 := ScannerSurfCorr_unique hcorr_prep hcorr_prep2; subst hsp_eq2
      cases h_disj with
      | inl h_l => exact h_punt (fun h_res _ => (sslComments_refutes_inline_residue h_l.1 (Or.inr (Or.inl rfl)) h_res).elim)
      | inr h_mid =>
        exfalso
        obtain ⟨h_line_eq, -, -, -⟩ := h_mid.2.1 h_st.1 h_st.2.2
        obtain ⟨h_sk_eq, -, -, -⟩ := h_mid.2.2.2.1 h_st.1 h_st.2.1
        have h_inp : s_prep.input = sc.input := preprocess_input h_preprocess
        refine scanValue_tab_keyrun_ne (s := if s_prep.allowDirectives then
            { s_prep with allowDirectives := false, documentEverStarted := true }
          else s_prep) (noflow_disp_of_noflow h_noflow) ?_ ?_ ?_
          (dispatchBlockIndicators_value_scan h_dispatch)
        · show (if _ then _ else _ : ScannerState).simpleKey.possible = true
          rw [allowDirectives_update_simpleKey, h_sk_eq]; exact h_poss
        · show (if _ then _ else _ : ScannerState).simpleKey.pos.line
              = (if _ then _ else _ : ScannerState).line
          rw [allowDirectives_update_simpleKey, allowDirectives_update_line,
            h_sk_eq, h_line_eq]
          exact h_kline
        · have h_i : (if s_prep.allowDirectives then
              { s_prep with allowDirectives := false, documentEverStarted := true }
            else s_prep).input = sc.input := by split <;> exact h_inp
          rw [h_i, allowDirectives_update_simpleKey, h_sk_eq]
          exact h_run
    | noKeyContext => exact h_punt (fun h_res _ => block_dispatch_deferred_inline sp_start sp_block sp_scan' h_stream_block h_preprocess h_dispatch hcorr_result h_res)
  | inl pack =>
    obtain ⟨⟨k, h_route, h_kcol, h_kslot_pk, h_resF_pk, h_resFV_pk⟩,
      h_props, h_skline, h_poss⟩ := pack
    obtain ⟨sp_mid, sp_ws, sp_prep2, h_disj, h_ws, _h_cmt, hcorr_prep2, h_pk, _⟩ :=
      preprocess_some_ssl_comments_anyCol sc sp_scan s_prep ':' h_corr h_preprocess
    have hsp_eq2 := ScannerSurfCorr_unique hcorr_prep hcorr_prep2; subst hsp_eq2
    have h_eq : sp_prep = sp_ws := by
      cases h_pk with
      | inl h => exact h
      | inr h => rw [preprocess_some_peek h_preprocess] at h; cases h
    subst h_eq
    cases h_disj with
    | inl h_l =>
      -- A break intervened: the one-line key cannot span it; the landed side
      -- closes and reopens through the caller's own route.
      exact h_punt (fun h_res _ => (sslComments_refutes_inline_residue h_l.1 (Or.inr (Or.inl rfl)) h_res).elim)
    | inr h_mid =>
      rw [h_mid.1] at h_ws
      -- Item 80: the inherit, from the park's own flags through the no-break
      -- transport's stale conjunct.  Item 81: the same conjuncts place the
      -- key on the `:`'s line and strictly behind its cursor.
      obtain ⟨h_inh, -, h_off_ge, -⟩ := h_mid.2.2.2.1 h_nic h_ska
      obtain ⟨h_line_pp, -, -, -⟩ := h_mid.2.1 h_nic h_real
      exact colon_open_map_props sp_start sp_block sp_p sp_scan k sc s_prep s'
        sp_prep sp_scan' h_route h_kslot_pk
        -- Item 148: the pack's cover, carried across preprocessing — which
        -- only pops, so a cover of the incoming stack covers the landing's.
        (by
          rcases h_resF_pk with ⟨ks, h_lt, h_cov, r⟩ | h
          · exact Or.inl ⟨ks, h_lt,
              h_cov.imp (fun ⟨lo, hb, hc⟩ =>
                ⟨lo, hb, IndentStackCover.preprocess_cover h_preprocess hc⟩) id, r⟩
          · exact Or.inr h)
        -- Item 150: and the value-line twin's, across the same pops.
        (by
          rcases h_resFV_pk with ⟨nv, ks, h_lt, h_cov, r⟩ | h
          · exact Or.inl ⟨nv, ks, h_lt,
              h_cov.imp (fun ⟨lo, hb, hc⟩ =>
                ⟨lo, hb, IndentStackCover.preprocess_cover h_preprocess hc⟩) id, r⟩
          · exact Or.inr h)
        h_props h_ws h_poss h_kcol h_inh
        (by rw [h_inh, h_line_pp]; exact h_skline)
        (by rw [h_inh]; have := h_kbc.1 h_poss; omega)
        h_noflow h_preprocess
        h_stream_block hcorr_prep
        hcorr_result (preprocess_some_peek h_preprocess)
        (noflow_disp_of_noflow h_noflow)
        (nic_false_of_indicator_noflow h_preprocess (noflow_disp_of_noflow h_noflow))
        h_dispatch

/-- **The same-line `:` firing the pack** (items 15–17), lifted out of
    `accum_block_on_pendingContent` by item 38 so that the two pendings whose
    content is a complete node share it.

    The guard's two facts are decidable on the parking state, so a classical
    case split alone selects the arm; everything the arm then needs — the
    entry's route, the key head and its trailing whites — is inside the pack,
    and what the pack does NOT carry is where the mapping goes.  That is why
    one lemma can serve a document-root key (`a: 1`) and a compact one
    (`- a: 1`): the difference lives in the route the producer built.

    `h_punt` is the caller's own answer for every other shape — a punted pack
    (block-scalar header, or a landing this producer could not
    measure) or a `:` that arrived across a break, where the
    one-line key cannot span and the landing closes the parked node instead.

    **Item 287: it is a BUILDER**, the caller's answer once told what an inline
    residue at this park is.  An arm that crossed a break refutes the residue
    (`sslComments_refutes_inline_residue`); an arm whose reason rides the
    deferral applies `block_dispatch_deferred_inline` there, so the escape
    stands at the reason it stands for.

    **Item 293: `¬ possible` refutes.**  Every content park's inline `:` finds
    a live key (`h_live`), so the arm item 286 measured empty at the runtime
    is a proof's; ~~two arms ride the deferral here, `dedent` and
    `noKeyContext`~~ one arm rides the deferral here, `noKeyContext` (`dedent`
    is deleted at item 297).  **Item 300: the marker-line reason refutes**, as
    the stamp does, through the builder's residue and the stale guard. -/
lemma colon_fires_implicit_key
    (sc : ScannerState) (sp_start sp_block sp_scan : SurfPos)
    (s_prep s' : ScannerState) (sp_prep sp_scan' : SurfPos)
    (h_stream_block : SLYamlStream sp_start sp_block)
    (h_key : sc.simpleKey.possible = true → sc.simpleKey.pos.line = sc.line →
      ImplicitKeyPack sc sp_start sp_scan ∨ KeyPackPunt sc)
    -- Item 80: the park's stale tail and its armed shape — between them the
    -- pack arm answers the RE-SAVE question instead of punting on it.
    (h_stale : InlineResidue sp_scan ':' → StaleNodeTail sc)
    (h_arm : (sc.simpleKeyAllowed = true ∧ sc.simpleKey.possible = false) ∨
      0 < sp_scan.col)
    -- Item 81: every saved key sits strictly behind the cursor — what refutes
    -- `[197]`'s phantom-key clear at the floor.
    (h_kbc : ScannerCorrectness.KeysBehindCursor sc)
    -- Item 123: the stale-cursor floor — a stale live key puts the cursor
    -- strictly past `currentIndent`, which refutes `[197]`'s misindent pair
    -- at the stale-key `:`.
    (h_scf : StaleCursorFloor.StaleKeyCursorFloor sc)
    -- Item 293: the park's own `h_live` — an inline `:` finds a live key.
    (h_live : InlineResidue sp_scan ':' → sc.simpleKey.possible = true)
    (h_punt : (InlineResidue sp_scan ':' →
        (sc.needIndentCheck = false → LastTokenReal sc.tokens →
          s_prep.line = sc.line ∧ s_prep.needIndentCheck = false ∧
          lastRealToken? s_prep.tokens = lastRealToken? sc.tokens ∧
          penultRealToken? s_prep.tokens = penultRealToken? sc.tokens) →
        ∃ sp_gram' sp_block' sp_flow' sp_scan'',
          SLYamlStream sp_start sp_gram' ∧
          BlockStack sp_gram' sp_block' ∧
          FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
          PendingNode s' false sp_start sp_flow' sp_scan'' ∧
          ScannerSurfCorr s' sp_scan'') →
      ∃ sp_gram' sp_block' sp_flow' sp_scan'',
      SLYamlStream sp_start sp_gram' ∧
      BlockStack sp_gram' sp_block' ∧
      FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
      PendingNode s' false sp_start sp_flow' sp_scan'' ∧
      ScannerSurfCorr s' sp_scan'')
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (hcorr_result : ScannerSurfCorr s' sp_scan')
    (h_corr : ScannerSurfCorr sc sp_scan)
    (h_noflow : s_prep.inFlow = false)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, ':')))
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) ':' = .ok (some s')) :
    ∃ sp_gram' sp_block' sp_flow' sp_scan',
      SLYamlStream sp_start sp_gram' ∧
      BlockStack sp_gram' sp_block' ∧
      FlowStackB sp_start 0 0 none 0 #[] #[] .sep sp_block' sp_flow' ∧
      PendingNode s' false sp_start sp_flow' sp_scan' ∧
      ScannerSurfCorr s' sp_scan' := by
  by_cases h_poss : sc.simpleKey.possible = true
  · by_cases h_kline : sc.simpleKey.pos.line = sc.line
    · -- The landing is read FIRST (item 65): both the pack and the punt are
      -- questions about the step that follows this park, and only the
      -- break-free branch can answer either.
      obtain ⟨sp_mid, sp_ws, sp_prep2, h_disj, h_ws, _h_cmt, hcorr_prep2, h_pk, _⟩ :=
        preprocess_some_ssl_comments_anyCol sc sp_scan s_prep ':' h_corr h_preprocess
      have hsp_eq2 := ScannerSurfCorr_unique hcorr_prep hcorr_prep2; subst hsp_eq2
      have h_eq : sp_prep = sp_ws := by
        cases h_pk with
        | inl h => exact h
        | inr h => rw [preprocess_some_peek h_preprocess] at h; cases h
      subst h_eq
      cases h_disj with
      | inl h_l =>
        -- A break intervened: the one-line key cannot span it, so the pack is
        -- spent — but the break lands the step at a column-0 line start,
        -- which is item 19's arm (`x⏎: v` opens the EMPTY-key entry there).
        exact h_punt (fun h_res _ => (sslComments_refutes_inline_residue h_l.1 (Or.inr (Or.inl rfl)) h_res).elim)
      | inr h_mid =>
        cases h_key h_poss h_kline with
        | inr punt =>
          -- ═══ Item 65: the punt is LOCATED, so the `:` spends the one
          -- reason that is its own.  §6.1's preprocessing gate let the tab
          -- through (it fires at or left of `currentIndent`, and the tab in
          -- front of a KEY sits past it), and `scanValueIndentTabCheck` is
          -- where it is caught — reading the run in front of
          -- `simpleKey.pos`, which is exactly what the punt carries.  The
          -- transport needs the park's own stale tail, which the punt carries
          -- too: with the flag down and no break, preprocessing re-saved
          -- nothing, so the key the `:` resolves IS the key the tab precedes.
          -- The other three reasons are not this step's (the dedent is row
          -- 19's frame stack, deleted at item 297; the frameless park item 51's
          -- threading; an inherited key nobody's) and ride the deferral. ═══
          cases punt with
          | tab h_run h_st =>
            exfalso
            obtain ⟨h_line_eq, -, -, -⟩ := h_mid.2.1 h_st.1 h_st.2.2
            obtain ⟨h_sk_eq, -, -, -⟩ := h_mid.2.2.2.1 h_st.1 h_st.2.1
            have h_inp : s_prep.input = sc.input := preprocess_input h_preprocess
            refine scanValue_tab_keyrun_ne (s := if s_prep.allowDirectives then
                { s_prep with allowDirectives := false, documentEverStarted := true }
              else s_prep) (noflow_disp_of_noflow h_noflow) ?_ ?_ ?_
              (dispatchBlockIndicators_value_scan h_dispatch)
            · show (if _ then _ else _ : ScannerState).simpleKey.possible = true
              rw [allowDirectives_update_simpleKey, h_sk_eq]; exact h_poss
            · show (if _ then _ else _ : ScannerState).simpleKey.pos.line
                  = (if _ then _ else _ : ScannerState).line
              rw [allowDirectives_update_simpleKey, allowDirectives_update_line,
                h_sk_eq, h_line_eq]
              exact h_kline
            · have h_i : (if s_prep.allowDirectives then
                  { s_prep with allowDirectives := false, documentEverStarted := true }
                else s_prep).input = sc.input := by split <;> exact h_inp
              rw [h_i, allowDirectives_update_simpleKey, h_sk_eq]
              exact h_run
          | implicitValue h_ivl _h_kline h_st =>
            -- ═══ Item 101: the second reason that is REFUTABLE here, and for
            -- the same shape as the tab's.  The park is an implicit value's
            -- own content, its line carries the value indicator's stamp, and
            -- §8.2.2 refuses a second value indicator on a stamped line —
            -- the very check item 48 spent at `pendingMapValue`, one step
            -- later.  What carries it across that step is the park's own
            -- three flags: flag down and no break, so the preprocessing this
            -- `:` came through neither re-saved nor changed the line.  (Item
            -- 102's saved-key line is the props path's transport datum, not
            -- this step's — the `:` observes the guard on its own state.) ═══
            exact (dispatch_refutes_sameLine h_st.1 h_st.2.2 (Or.inl h_ivl)
              (preprocess_preserves_implicitValueLine sc s_prep ':' h_preprocess)
              (preprocess_preserves_docStartLine sc s_prep ':' h_preprocess)
              (noflow_disp_of_noflow h_noflow) h_mid.2.1 h_dispatch).elim
          | markerLine h_doc _h_kline =>
            -- ═══ Item 300: the marker's line, refuted as the stamp is — through
            -- the builder, whose residue is what the stale guard reads. ═══
            exact h_punt (fun h_res _ =>
              (dispatch_refutes_sameLine (h_stale h_res).1 (h_stale h_res).2.2.1
                (Or.inr (Or.inl h_doc))
                (preprocess_preserves_implicitValueLine sc s_prep ':' h_preprocess)
                (preprocess_preserves_docStartLine sc s_prep ':' h_preprocess)
                (noflow_disp_of_noflow h_noflow) h_mid.2.1 h_dispatch).elim)
          | noKeyContext => exact h_punt (fun h_res _ => block_dispatch_deferred_inline sp_start sp_block sp_scan' h_stream_block h_preprocess h_dispatch hcorr_result h_res)
        | inl pack =>
          obtain ⟨k, sp_key, sp_gram, h_route, h_ol, h_tws, h_kcol, h_kslot_pk, h_rfr_pk,
            h_rfrV_pk, h_rseq_pk⟩ := pack
          -- ═══ Item 80: whether preprocessing RE-SAVED is the park's own
          -- shape, so the floor takes the inherit as a premise now.  ARMED
          -- means the block scalar, and §8.1 cleared the key — the pack's
          -- guard is refuted outright.  MID-LINE means the `:` is this park's
          -- inline residue, whose stale tail carries the flag DOWN — and a
          -- down flag across no break inherits (`h_mid`'s stale conjunct):
          -- the key the `:` resolves IS the pack's. ═══
          rcases h_arm with ⟨_, h_poss_f⟩ | h_colpos
          · exact absurd h_poss (by rw [h_poss_f]; exact Bool.false_ne_true)
          -- Same line: chain the `:` step's own whites onto the pack's tail
          -- and open the mapping at the key.
          rw [h_mid.1] at h_ws
          have h_st := h_stale ⟨by omega, _, h_ws,
            head_of_peek hcorr_prep (preprocess_some_peek h_preprocess)⟩
          obtain ⟨h_inh, -, h_off_ge, -⟩ := h_mid.2.2.2.1 h_st.1 h_st.2.1
          -- Item 81: the same no-break conjuncts place the key on the `:`'s
          -- line, and `KeysBehindCursor` strictly behind its cursor.
          obtain ⟨h_line_pp, -, -, -⟩ := h_mid.2.1 h_st.1 h_st.2.2.1
          exact colon_open_map_implicit sp_start sp_block sp_key sp_gram sp_prep k
            s_prep s' sp_scan' h_stream_block h_route h_kslot_pk
            -- Item 148: the pack's cover, across preprocessing's own pops.
            (by
              rcases h_rfr_pk with ⟨ks, h_lt, h_cov, r⟩ | h
              · exact Or.inl ⟨ks, h_lt,
                  h_cov.imp (fun ⟨lo, hb, hc⟩ =>
                    ⟨lo, hb, IndentStackCover.preprocess_cover h_preprocess hc⟩) id, r⟩
              · exact Or.inr h)
            -- Item 150: and the value-line twin's, across the same pops.
            (by
              rcases h_rfrV_pk with ⟨nv, ks, h_lt, h_cov, r⟩ | h
              · exact Or.inl ⟨nv, ks, h_lt,
                  h_cov.imp (fun ⟨lo, hb, hc⟩ =>
                    ⟨lo, hb, IndentStackCover.preprocess_cover h_preprocess hc⟩) id, r⟩
              · exact Or.inr h)
            h_ol
            (gstar_sswhite_append h_tws h_ws)
            hcorr_prep hcorr_result (preprocess_some_peek h_preprocess)
            (noflow_disp_of_noflow h_noflow)
            (nic_false_of_indicator_noflow h_preprocess (noflow_disp_of_noflow h_noflow))
            h_dispatch
            (implicit_key_floor h_poss h_kcol h_inh
              (by rw [h_inh, h_line_pp]; exact h_kline)
              (by rw [h_inh]; have := h_kbc.1 h_poss; omega)
              h_noflow h_preprocess h_dispatch)
            -- Item 125: the resolved key's three facts, the floor's own
            -- transports re-read — they make the park's stamp REAL.
            (by rw [h_inh]; exact h_poss)
            (by rw [h_inh, h_line_pp]; exact h_kline)
            (by rw [h_inh]; have := h_kbc.1 h_poss; omega)
            -- Item 148: the key's column, the fourth of the same transports.
            (by rw [h_inh]; exact h_kcol)
            -- Item 168: and the pack's sequence face, unchanged — it names
            -- surface positions only, so preprocessing's pops do not touch it.
            h_rseq_pk
            -- Item 322: the alternative's transport across this `:`.
            (PackAlt.step_value h_preprocess h_dispatch h_noflow)
    · -- ═══ Item 104: the key is STALE — saved on an earlier line, which is
      -- what a flow collection closed across a break, a folded plain scalar
      -- and a folded quoted one all leave at the park.  §7.4 refuses that `:`
      -- outright (`invalidImplicitKey`), so this is not a deferral but a
      -- refutation, and it reads the landing for its own reason: only the
      -- break-free step carries the park's key to the dispatch.  Across a
      -- break the input is item 19's arm again (`x⏎: v`), where a stale key is
      -- ordinary.
      --
      -- What survives is BOTH halves of the one shape §7.4 does not decide:
      -- a `?` frame open on the key's own line, where `scanValueClearKey`
      -- takes the key down before §7.4 reads it, AND the `:` standing at the
      -- mapping's own indent, where `[197]`'s misindent check then lets it
      -- through.  Every input we can write for that pair is refused one stage
      -- earlier — the explicit key's continuation lines must be indented past
      -- the `?`, so the `:` after them cannot land at the `?`'s column — but
      -- that is the under-indent invariant's statement, not this step's. ═══
      obtain ⟨sp_mid, sp_ws, sp_prep2, h_disj, h_ws, _h_cmt, hcorr_prep2, h_pk, _⟩ :=
        preprocess_some_ssl_comments_anyCol sc sp_scan s_prep ':' h_corr h_preprocess
      have hsp_eq2 := ScannerSurfCorr_unique hcorr_prep hcorr_prep2; subst hsp_eq2
      have h_eq : sp_prep = sp_ws := by
        cases h_pk with
        | inl h => exact h
        | inr h => rw [preprocess_some_peek h_preprocess] at h; cases h
      subst h_eq
      cases h_disj with
      | inl h_l => exact h_punt (fun h_res _ => (sslComments_refutes_inline_residue h_l.1 (Or.inr (Or.inl rfl)) h_res).elim)
      | inr h_mid =>
        rcases h_arm with ⟨_, h_poss_f⟩ | h_colpos
        · exact absurd h_poss (by rw [h_poss_f]; exact Bool.false_ne_true)
        rw [h_mid.1] at h_ws
        have h_st := h_stale ⟨by omega, _, h_ws,
          head_of_peek hcorr_prep (preprocess_some_peek h_preprocess)⟩
        obtain ⟨h_inh, -, h_off_ge, -⟩ := h_mid.2.2.2.1 h_st.1 h_st.2.1
        obtain ⟨h_line_pp, -, -, -⟩ := h_mid.2.1 h_st.1 h_st.2.2.1
        by_cases hek : s_prep.explicitKeyLine = some sc.simpleKey.pos.line ∧
            (s_prep.col : Int) = s_prep.currentIndent
        · -- ═══ Item 123: the pair's SECOND conjunct is refuted, so the punt is
          -- spent.  The stale-cursor floor puts the park's cursor strictly past
          -- `currentIndent`; the no-break step carries the indent stack across
          -- unchanged (`h_mid`'s indents conjunct) and only moves the column
          -- right (the surface `s-white*` run), so the `:` cannot stand AT the
          -- mapping's own indent — `(s_prep.col : Int) = s_prep.currentIndent`
          -- is impossible with the key still live from an earlier line. ═══
          exfalso
          have h_nf_sc : sc.inFlow = false := by
            unfold ScannerState.inFlow at h_noflow ⊢
            rw [← preprocess_preserves_flowLevel sc s_prep ':' h_preprocess]
            exact h_noflow
          have h_floor := h_scf h_nf_sc h_poss h_kline
          have h_ind := h_mid.2.2.1 h_st.1
          have h_ci : s_prep.currentIndent = sc.currentIndent := by
            unfold ScannerState.currentIndent; rw [h_ind]
          have h_cols := gstar_sswhite_col_ge _ _ h_ws
          have h1 := h_corr.col_eq
          have h2 := hcorr_prep.col_eq
          omega
        · exact absurd (dispatch_refutes_staleKey h_poss h_kline (h_kbc.1 h_poss)
            h_inh h_line_pp h_off_ge (noflow_disp_of_noflow h_noflow) h_dispatch) hek
  · -- ═══ Item 293: no key is possible at all — and an inline `:` finds a
    -- live one at every content park (`h_live`), so the residue is refuted
    -- where it was deferred. ═══
    exact h_punt (fun h_res _ => absurd (h_live h_res) h_poss)

-- Block dispatch with pendingContent (item 15): the SAME-LINE `:` fires the
-- implicit-key coupling.  The guard's two facts are decidable on the parking
-- state, so a classical case split alone selects the arm: guard true and the
-- pack present → the parked plain scalar becomes `[193]`'s implicit key and
-- the mapping opens at its column-0 line start (`colon_open_map_implicit`);
-- everything else — other indicators, punted packs (quoted/alias keys, col ≠
-- 0), a crossed break — rides `accum_block_on_closeThenBlock` unchanged.
--
-- **The escape is the `:` alone** (item 37).  The pending's own `h_line` is
-- §7.5's set, so the `-` and `?` this lemma used to pay for are refuted here
-- rather than deferred, and the hypothesis its caller supplies names the one
-- production still owed at this park.
lemma accum_block_on_pendingContent
    (sc : ScannerState) (sp_start sp_block sp_scan : SurfPos)
    (s_prep s' : ScannerState) (c : Char) (sp_prep sp_scan' : SurfPos)
    (h_stream_block : SLYamlStream sp_start sp_block)
    (h_close_pending : danglingNodePos? sc = none →
      underIndentedFlowValuePos? sc = none →
      ∀ sp_mid, SSLComments sp_scan sp_mid → SLYamlStream sp_start sp_mid)
    (h_line : sp_scan.col = 0 ∨ LineNodeStop sp_scan.chars)
    (h_key : sc.simpleKey.possible = true → sc.simpleKey.pos.line = sc.line →
      ImplicitKeyPack sc sp_start sp_scan ∨ KeyPackPunt sc)
    -- Item 51: the pending's explicit-entry value pack, threaded to the
    -- landed `:` (see `accum_block_on_closeThenBlock`).  **Item 192: the
    -- park's whole chain of frames**, which is what a flow collection that
    -- closed into this park hands it.
    (h_vpack : (∃ ns : List Nat, ∀ nv ∈ ns,
      ∀ sp_m sp_i sp_c : SurfPos,
        SSLComments sp_scan sp_m → SIndent nv sp_m sp_i → GLit ':' sp_i sp_c →
        ∀ sp_v : SurfPos, SBlockIndented nv .blockOut sp_c sp_v →
        SLYamlStream sp_start sp_v) ∨ PackAlt sc)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (hcorr_result : ScannerSurfCorr s' sp_scan')
    (h_corr : ScannerSurfCorr sc sp_scan)
    (h_noflow : s_prep.inFlow = false)
    -- Item 81: the scanner-wide behind-the-cursor fact, for the floor.
    (h_kbc : ScannerCorrectness.KeysBehindCursor sc)
    -- Item 123: the stale-cursor floor, spent at the stale-key `:`.
    (h_scf : StaleCursorFloor.StaleKeyCursorFloor sc)
    -- Item 80: the park's stale tail, threaded to the `:`'s re-save question.
    (h_stale : InlineResidue sp_scan ':' → StaleNodeTail sc)
    -- **Item 77 — the park's own arm**, as at `accum_block_on_closeThenBlock`:
    -- this park is a CONTENT one, and its constructor field says the content
    -- scan either re-armed or spent a column (`content_park_arm`) — with the
    -- armed side carrying the cleared key since item 80.
    (h_park : (sc.simpleKeyAllowed = true ∧ sc.simpleKey.possible = false) ∨
      0 < sp_scan.col)
