    tailOf (scanFlowSequenceEnd s).tokens = .value ∧
    LastTokenReal (scanFlowSequenceEnd s).tokens := by
  rw [scanFlowSequenceEnd_tokens]; exact tailOf_push (by simp) (by simp [YamlToken.isNodeProperty])

