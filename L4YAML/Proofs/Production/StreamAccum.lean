              exact block_dispatch_deferred_stamp_nopack sp_start sp_mid sp_scan' s'
                (h_close_pending h_nd_land h_ui_land _ h_ssl)
                (arm_tight_of_block_dispatch h_preprocess h_dispatch hcorr_result) hcorr_result
                (nodir_of_block_dispatch h_dispatch) h_src
                (explicit_at_indent_of_dispatch h_dispatch
                  (noflow_disp_of_noflow h_noflow) h_src)
                (fun h => h_src (Or.inl (ekl_disp_none_of_park_none h_preprocess h)))
                (nic0_of_block_dispatch h_preprocess h_dispatch hcorr_result) (Or.inl (block_indicator_arm h_dispatch))
        · exact h_gen (fun h => absurd h hc_colon)
      · exact (block_indicator_exhausted h_dispatch hc hcv).elim
  by_cases hc0 : c = ':'
  · subst hc0
    exact colon_fires_implicit_key sc sp_start sp_block sp_scan s_prep s' sp_prep sp_scan'
      h_stream_block h_key h_stale h_park h_kbc h_scf h_live h_generic hcorr_prep hcorr_result h_corr
      h_noflow h_preprocess h_dispatch
  · exact h_generic (fun h_res _ => (nodeStop_refutes_inline_residue h_line
      ((block_indicator_char h_dispatch).imp id (fun h => h.resolve_left hc0)) h_res).elim)

-- Block dispatch with pendingBlock: accumulate entries via h_close_entry_old.
lemma accum_block_on_pendingBlock
    (sc : ScannerState) (sp_start sp_block sp_scan : SurfPos)
    (s_prep s' : ScannerState) (c : Char) (sp_prep sp_scan' : SurfPos) (n : Nat)
    (h_stream_block : SLYamlStream sp_start sp_block)
    (h_close_pending : danglingNodePos? sc = none →
      underIndentedFlowValuePos? sc = none →
      ∀ sp_mid, SSLComments sp_scan sp_mid → SLYamlStream sp_start sp_mid)
    (h_close_entry_old : ∀ (sp : SurfPos), SBlockIndented n .blockIn sp_scan sp →
      ∀ (sp_end : SurfPos), SCompactSeqTail n sp sp_end → SLYamlStream sp_start sp_end)
    -- Item 92: the park's value-line pack (`pendingBlock.h_kslot`) —
    -- `h_close_entry_old`'s twin.  The landed `:` closes the awaited entry
    -- empty and spends it (`? -⏎: - w`); the sibling, nested and inline `-`
    -- arms re-park it with their own entry folded in.
    (h_kslot : (∃ nv : Nat,
      ∀ sp_m : SurfPos, SBlockIndented n .blockIn sp_scan sp_m →
      ∀ sp_e : SurfPos, SCompactSeqTail n sp_m sp_e →
      ∀ sp_i sp_c : SurfPos, SIndent nv sp_e sp_i → GLit ':' sp_i sp_c →
      ∀ sp_v : SurfPos, SBlockIndented nv .blockOut sp_c sp_v →
      SLYamlStream sp_start sp_v) ∨ PackAlt sc)
    (h_sk : sc.simpleKeyAllowed = true)
    (h_col_old : sp_scan.col = n + 1)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (hcorr_result : ScannerSurfCorr s' sp_scan')
    (h_corr : ScannerSurfCorr sc sp_scan)
    (h_noflow : s_prep.inFlow = false)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h_dispatch : scanNextToken_dispatchBlockIndicators
        (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) c = .ok (some s'))
    -- Item 142: §9.2's landing refusal, threaded past this park.  Its own
    -- tail is the `-` that opened the entry, so it pays nothing; the thread
    -- exists because the landing under it does.
    (h_bare : scanNextToken_checkBareDocument s_prep = .ok ())
    -- **Item 157: and §9.2's DANGLING refusal beside it** — what `h_bare` is to
    -- the ROUTE this landing takes, this is to the PARK it closes.  The gate is
    -- the same break, so the flag `landing_or_park_ska` reads pays both.
    (h_dn : scanNextToken_checkDanglingNode sc s_prep = .ok ())
    -- Item 275: §8.1's check, carried beside §9.2's.
    (h_fv : scanNextToken_checkFlowValueIndent sc s_prep = .ok ())
    -- Item 146: the stack's BASE, carried by the accumulation from `mk'`
    -- down.  §9.2's landing refusal spends it to read the dedent exemption
    -- off the landing's column instead of splitting on it.
    (h_base : IndentStackBase.SentinelBase sc)
    -- Item 147: the stack's SHAPE beside its base, as at the other two landing
    -- arms — the cover the landing's opener pays needs both.
    (h_mono : IndentStackMono.Mono sc)
    -- **Item 167 (LAST): the park's ENCLOSING collection** (`pendingBlock.h_seqF`).
    -- The DEDENT arm below is where it is spent: `nestedBlockSeq`'s `m` cannot
    -- go negative, so the landing is not this entry's node — it is the next
    -- entry of the collection this entry itself belongs to.
    (h_seqF_old : (∃ ke : Nat, ∀ sp_mid : SurfPos,
      SBlockIndented n .blockIn sp_scan sp_mid →
      ∀ sp_end : SurfPos, SCompactSeqTail n sp_mid sp_end →
      SeqEntryTail sp_start ke sp_end) ∨ True)
    -- **Item 190 (LAST): the park's SECOND frame** (`pendingBlock.h_kslotUp`),
    -- `h_kslot`'s twin at the outer `?`'s column — tried at `k` after the
    -- park's own, so a park inside a single frame behaves exactly as before.
    -- **Item 191: a LIST of ancestors**, decided at the landing's own column.
