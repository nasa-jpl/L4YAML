/-- **Content dispatch for `&`, stopped at the PROPERTY** (β.3).  `[101]
    c-ns-anchor-property` on its own, before anything wraps it into a node.

    The wrapping is what the next step decides, and the two readings are not
    interchangeable: `dispatchContent_anchor_prod` below closes it as
    `propsEmpty` — a COMPLETE node — which is the right reading only for `[&a]`,
    `[&a, b]` and `{&a: v}`.  For `[&a b]` the anchor decorates the node that
    follows, and only the run survives to be wrapped later. -/
lemma dispatchContent_anchorProp_prod (sc : ScannerState) (sp : SurfPos)
    {s' : ScannerState}
    (hcorr : ScannerSurfCorr sc sp)
    (hpeek : sc.peek? = some '&')
    (hok : scanNextToken_dispatchContent sc '&' = .ok s') :
    ∃ sp', SCNsAnchorProperty sp sp' ∧ (∃ c, s'.peekBack? = some c ∧ (isWhiteSpaceBool c || isLineBreakBool c || c == '\uFEFF') = false) ∧ ScannerSurfCorr s' sp' := by
  unfold scanNextToken_dispatchContent at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  -- '&' == '&' = true: anchor branch
  split at hok
  · -- Item 9e: the property-run guard (`&a &b` has no derivation)
    split at hok
    · simp at hok
    generalize h_anch : scanAnchorOrAlias sc true = anch_result at hok
    cases anch_result with
    | error => simp at hok
    | ok s_anch =>
      change Except.ok _ = Except.ok s' at hok
      have h := Except.ok.inj hok; subst h
      obtain ⟨sp', h_anchor, hcorr'⟩ :=
        scanAnchorOrAlias_anchorProp_prod sc sp hcorr hpeek s_anch h_anch
      obtain ⟨c, hpb, hflag⟩ :=
        scanAnchorOrAlias_peekBack hcorr hpeek (by decide) (by decide) (by decide) h_anch
      exact ⟨sp', h_anchor, ⟨c, hpb, hflag⟩,
        ⟨hcorr'.chars_from, hcorr'.col_eq, hcorr'.end_eq, hcorr'.input_prefix,
          hcorr'.indent_cols_nonneg⟩⟩
  · rename_i h_neq; exact absurd rfl h_neq

-- Content dispatch for anchor: returns `SFlowNode 0 ctx` grammar evidence in ANY
-- context.  Anchor `&name` produces `SCNsAnchorProperty` → `SCNsProperties.anchorFirst`
-- → `SFlowNode.propsEmpty`; the property itself carries no context, and the
-- trailing separator is `GOpt.none`, so every context is equally derivable.
-- Since A10 Except conversion, `.ok` guarantees non-empty name unconditionally.
lemma dispatchContent_anchor_prod (n : Nat) (sc : ScannerState) (sp : SurfPos)
    {s' : ScannerState} (ctx : YamlContext)
    (hcorr : ScannerSurfCorr sc sp)
    (hpeek : sc.peek? = some '&')
    (hok : scanNextToken_dispatchContent sc '&' = .ok s') :
    ∃ sp', SFlowNode n ctx sp sp' ∧ (∃ c, s'.peekBack? = some c ∧ (isWhiteSpaceBool c || isLineBreakBool c || c == '\uFEFF') = false) ∧ ScannerSurfCorr s' sp' := by
  obtain ⟨sp', h_anchor, h_pb, hcorr'⟩ := dispatchContent_anchorProp_prod sc sp hcorr hpeek hok
  exact ⟨sp', SFlowNode.propsEmpty n ctx sp sp'
    (SCNsProperties.anchorFirst n ctx sp sp' sp' h_anchor (GOpt.none _)), h_pb, hcorr'⟩

/-- **Content dispatch for `!`, stopped at the PROPERTY** — the tag sibling of
    `dispatchContent_anchorProp_prod`.  All four `[97]` forms are covered
    (verbatim, secondary, named/primary). -/
lemma dispatchContent_tagProp_prod (sc : ScannerState) (sp : SurfPos)
    {s' : ScannerState}
    (hcorr : ScannerSurfCorr sc sp)
    (hpeek : sc.peek? = some '!')
    (hok : scanNextToken_dispatchContent sc '!' = .ok s') :
    ∃ sp', SCNsTagProperty sp sp' ∧ (∃ c, s'.peekBack? = some c ∧ (isWhiteSpaceBool c || isLineBreakBool c || c == '\uFEFF') = false) ∧ ScannerSurfCorr s' sp' := by
  unfold scanNextToken_dispatchContent at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  -- Skip '&' check
  split at hok
  · rename_i h_eq; exact absurd h_eq (by decide)
  · -- Skip '*' check
    split at hok
    · rename_i h_eq; exact absurd h_eq (by decide)
    · -- '!' == '!' = true: tag branch
      split at hok
      · -- Item 9e: the property-run guard (`!t !u` has no derivation)
        split at hok
        · simp at hok
        generalize h_tag : scanTag sc = tag_result at hok
        cases tag_result with
        | error => simp at hok
        | ok s_tag =>
          simp only [Except.ok.injEq] at hok; subst hok
          by_cases hpeek2 : sc.advance.peek? = some '!'
          · -- Secondary tag `!!suffix`
            obtain ⟨sp', h_tag_prop, hcorr'⟩ :=
              scanTag_secondary_prod sc sp hcorr hpeek hpeek2 s_tag h_tag
            obtain ⟨c, hpb, hflag⟩ := scanTag_peekBack hcorr hpeek h_tag
            exact ⟨sp', h_tag_prop, ⟨c, hpb, hflag⟩,
              ⟨hcorr'.chars_from, hcorr'.col_eq, hcorr'.end_eq, hcorr'.input_prefix,
                hcorr'.indent_cols_nonneg⟩⟩
          · -- Verbatim `!<uri>` or named `!handle!suffix` or non-specific `!`
            obtain ⟨sp', h_tag_prop, hcorr'⟩ :=
              scanTag_nonSecondary_prod sc sp hcorr hpeek hpeek2 s_tag h_tag
            obtain ⟨c, hpb, hflag⟩ := scanTag_peekBack hcorr hpeek h_tag
            exact ⟨sp', h_tag_prop, ⟨c, hpb, hflag⟩,
              ⟨hcorr'.chars_from, hcorr'.col_eq, hcorr'.end_eq, hcorr'.input_prefix,
                hcorr'.indent_cols_nonneg⟩⟩
      · rename_i h_neq; exact absurd rfl h_neq

-- Content dispatch for tag: returns `SFlowNode n ctx` grammar evidence in ANY
-- context (same context-freedom as the anchor case).
-- Tag `!` produces `SCNsTagProperty` → `SCNsProperties.tagFirst` → `SFlowNode.propsEmpty`.
lemma dispatchContent_tag_prod (n : Nat) (sc : ScannerState) (sp : SurfPos)
    {s' : ScannerState} (ctx : YamlContext)
    (hcorr : ScannerSurfCorr sc sp)
    (hpeek : sc.peek? = some '!')
    (hok : scanNextToken_dispatchContent sc '!' = .ok s') :
    ∃ sp', SFlowNode n ctx sp sp' ∧ (∃ c, s'.peekBack? = some c ∧ (isWhiteSpaceBool c || isLineBreakBool c || c == '\uFEFF') = false) ∧ ScannerSurfCorr s' sp' := by
  obtain ⟨sp', h_tag_prop, h_pb, hcorr'⟩ := dispatchContent_tagProp_prod sc sp hcorr hpeek hok
  exact ⟨sp', SFlowNode.propsEmpty n ctx sp sp'
    (SCNsProperties.tagFirst n ctx sp sp' sp' h_tag_prop (GOpt.none _)), h_pb, hcorr'⟩

-- Unified content evidence extraction (Wadler-style "theorems for free").
-- All content dispatch paths either produce `SFlowNode 0 .flowOut` (flow content:
-- double-quoted, single-quoted, alias, plain) or `SCLLiteral 0 ∨ SCLFolded 0`
-- (block scalar). Returns separate grammar and scanner endpoints with trailing
-- WS evidence bridging them. For non-plain-scalar paths, the WS is trivial
-- (`GStar.nil`); for plain scalars, it covers the trailing whitespace gap.
-- Proven ONCE, used by all PendingNode constructors.
lemma dispatchContent_evidence (sc : ScannerState) (sp : SurfPos)
    {s' : ScannerState} (c : Char)
    (hcorr : ScannerSurfCorr sc sp)
    (hpeek : sc.peek? = some c)
    (h_not_doc : sc.col = 0 → atDocumentBoundary sc = false)
    (hok : scanNextToken_dispatchContent sc c = .ok s') :
    ∃ sp_gram sp',
      (SFlowNode 0 .flowOut sp sp_gram ∨
        ((SCLLiteral 0 sp sp_gram ∨ SCLFolded 0 sp sp_gram) ∧ (c = '|' ∨ c = '>'))) ∧
      GStar SSWhite sp_gram sp' ∧
      (sp_gram = sp' → s'.col ≠ 0 → ¬ (CommentOk s' ∧ s'.peek? = some '#')) ∧
      ScannerSurfCorr s' sp' := by
  by_cases hc_dq : c = '"'
  · subst hc_dq
    obtain ⟨sp', h_gram, h_pb, hcorr'⟩ := dispatchContent_doubleQuoted_prod sc sp hcorr hpeek hok
    exact ⟨sp', sp', Or.inl (SFlowNode_doubleQ_ctx_lift h_gram (by decide) (by decide)),
           GStar.nil _,
           fun _ hcol h => CommentOk_false_of_peekBack hcol h_pb (by decide) h.1, hcorr'⟩
  · by_cases hc_sq : c = '\''
    · subst hc_sq
      obtain ⟨sp', h_gram, h_pb, hcorr'⟩ := dispatchContent_singleQuoted_prod sc sp hcorr hpeek hok
      exact ⟨sp', sp', Or.inl (SFlowNode_singleQ_ctx_lift h_gram (by decide) (by decide)),
             GStar.nil _,
             fun _ hcol h => CommentOk_false_of_peekBack hcol h_pb (by decide) h.1, hcorr'⟩
    · by_cases hc_alias : c = '*'
      · subst hc_alias
        obtain ⟨sp', h_gram, ⟨_, h_pb, h_nw⟩, hcorr'⟩ :=
          dispatchContent_alias_prod 0 sc sp .flowOut hcorr hpeek hok
        exact ⟨sp', sp', Or.inl h_gram, GStar.nil _,
               fun _ hcol h => CommentOk_false_of_peekBack hcol h_pb h_nw h.1, hcorr'⟩
      · by_cases hc_bs : c = '|' ∨ c = '>'
        · obtain ⟨sp', h_gram, hcorr', _⟩ :=
            dispatchContent_blockScalar_prod sc sp hcorr hpeek hc_bs hok
          have h_park := scanBlockScalar_park
            (dispatchContent_blockScalar_scan sc sp hcorr hpeek hc_bs hok)
          exact ⟨sp', sp', Or.inr ⟨h_gram, hc_bs⟩, GStar.nil _,
                 fun _ hcol h => h_park.elim (fun h0 => hcol h0) (fun hne => hne h.2), hcorr'⟩
        · -- Remaining cases: '&' (anchor), '!' (tag), plain scalar, error
          have hnotPipe : c ≠ '|' := fun h => hc_bs (Or.inl h)
          have hnotGt : c ≠ '>' := fun h => hc_bs (Or.inr h)
          by_cases hc_amp : c = '&'
          · -- Anchor: SCNsAnchorProperty → SCNsProperties.anchorFirst → SFlowNode.propsEmpty
            subst hc_amp
            obtain ⟨sp', h_gram, ⟨_, h_pb, h_nw⟩, hcorr'⟩ :=
              dispatchContent_anchor_prod 0 sc sp .flowOut hcorr hpeek hok
            exact ⟨sp', sp', Or.inl h_gram, GStar.nil _,
                   fun _ hcol h => CommentOk_false_of_peekBack hcol h_pb h_nw h.1, hcorr'⟩
          · by_cases hc_bang : c = '!'
            · -- Tag: SCNsTagProperty → SCNsProperties.tagFirst → SFlowNode.propsEmpty
              subst hc_bang
              obtain ⟨sp', h_gram, ⟨_, h_pb, h_nw⟩, hcorr'⟩ :=
                dispatchContent_tag_prod 0 sc sp .flowOut hcorr hpeek hok
              exact ⟨sp', sp', Or.inl h_gram, GStar.nil _,
                     fun _ hcol h => CommentOk_false_of_peekBack hcol h_pb h_nw h.1, hcorr'⟩
            · -- Plain scalar (or error — but .ok means it succeeded)
              obtain ⟨sp_gram, sp', h_gram, h_ws, h_nohash, hcorr'⟩ :=
                dispatchContent_plainScalar_prod sc sp hcorr hpeek
                  hc_amp hc_alias hc_bang hnotPipe hnotGt hc_dq hc_sq h_not_doc hok
              exact ⟨sp_gram, sp', Or.inl h_gram, h_ws,
                     fun heq _ h => h_nohash heq h.2, hcorr'⟩

/-- **The same content step, read at EVERY index** (item 23).

    `dispatchContent_evidence` above concludes at 0, and `[196]`'s flow arm
    wants the value at the ENTRY's index — the gap that made every indented
    entry's value defer once item 22 gave the collection its own `n`.  Widening
    the conclusion is not monotonicity (see `NodeProduction` §3b): it is the
    observation that a reading which crosses no break contains no occurrence of
    the index, and the one-line productions are where the spec says so.

    So the hypothesis is `s'.line = sc.line` — the SAME decidable state fact
    item 15's implicit key reads, consumed here for a different purpose.  One
    measurement, two consumers: §7.4 reads it to decide whether the scan can be
    a key, and this reads it to decide at what indent the scan can be a value.
    That is not a coincidence: both the simple-key restriction and every
    occurrence of `n` in `[161] ns-flow-node` live on line boundaries.

    Two of `dispatchContent_evidence`'s arms are excluded rather than lifted,
    and both are hypotheses here so the caller has to name them:

    * `&`/`!` extend a property RUN, which `pendingProps` routes through a
      closure still typed at 0 — the run's re-index, not the content's.
    * `|`/`>` are `[170] c-l+literal(n)` / `[174] c-l+folded(n)`, whose content
      indent is auto-detected by the SAME kind of existential item 22 had to
      bind on `[183]`/`[187]`, one level down: `SCLLiteral 0` fixes `0 + m`, and
      `n + m' = 0 + m` needs `m ≥ n`, which the reading at 0 does not carry.
      That one is a grammar-shaped gap, not a missing lift.

    Item 24 splits the statement one production lower: `[156] ns-flow-content`
    is what `[161]`'s `propsContent` arm slots under a property run, so a
    DECORATED value needs the content and only the bare value needs the node.
    The alias is the whole difference — `[104] c-ns-alias-node` is an arm of
    `[161]`, not of `[156]`, and a run followed by an alias is scanner-refuted
    anyway (`&a *b`, items 9e/9k), so the content lemma simply does not have
    that case and the node lemma is it plus one arm. -/
lemma dispatchContent_evidence_content_oneLine (sc : ScannerState) (sp : SurfPos)
    {s' : ScannerState} (c : Char)
    (hcorr : ScannerSurfCorr sc sp)
    (hpeek : sc.peek? = some c)
    (h_flow : sc.inFlow = false)
    (h_not_doc : sc.col = 0 → atDocumentBoundary sc = false)
    (h_amp : c ≠ '&') (h_star : c ≠ '*') (h_bang : c ≠ '!')
    (h_pipe : c ≠ '|') (h_gt : c ≠ '>')
    (h_line : s'.line = sc.line)
    (hok : scanNextToken_dispatchContent sc c = .ok s') :
    ∃ sp_gram sp',
      (∀ n : Nat, SFlowContent n .flowOut sp sp_gram) ∧
      GStar SSWhite sp_gram sp' ∧
      (sp_gram = sp' → s'.col ≠ 0 → ¬ (CommentOk s' ∧ s'.peek? = some '#')) ∧
      ScannerSurfCorr s' sp' := by
  by_cases hc_dq : c = '"'
  · subst hc_dq
    obtain ⟨_, h_cond⟩ := dispatchContent_doubleQuoted_key_prod sc sp hcorr hpeek hok
    obtain ⟨sp', h_dq, h_pb, hcorr'⟩ := h_cond h_line
    exact ⟨sp', sp', fun n => SFlowContent_doubleQ_of_key n h_dq, GStar.nil _,
           fun _ hcol h => CommentOk_false_of_peekBack hcol h_pb (by decide) h.1, hcorr'⟩
  · by_cases hc_sq : c = '\''
    · subst hc_sq
      obtain ⟨_, h_cond⟩ := dispatchContent_singleQuoted_key_prod sc sp hcorr hpeek hok
      obtain ⟨sp', h_sq, h_pb, hcorr'⟩ := h_cond h_line
      exact ⟨sp', sp', fun n => SFlowContent_singleQ_of_key n h_sq, GStar.nil _,
             fun _ hcol h => CommentOk_false_of_peekBack hcol h_pb (by decide) h.1, hcorr'⟩
    · obtain ⟨_, h_cond⟩ :=
        dispatchContent_plainScalar_key_prod sc sp hcorr hpeek h_flow
          h_amp h_star h_bang h_pipe h_gt hc_dq hc_sq h_not_doc hok
      obtain ⟨sp_gram, sp', h_ol, h_ws, h_nohash, hcorr'⟩ := h_cond h_line
      exact ⟨sp_gram, sp', fun n => SFlowContent_plain_of_keyOneLine n h_ol, h_ws,
             fun heq _ h => h_nohash heq h.2, hcorr'⟩

/-- `[161] ns-flow-node(n,flow-out)` at every index: the content reading above
    plus `[104] c-ns-alias-node`, which carries neither an indent nor a
    context and is therefore index-polymorphic with no side condition at all. -/
lemma dispatchContent_evidence_oneLine (sc : ScannerState) (sp : SurfPos)
    {s' : ScannerState} (c : Char)
    (hcorr : ScannerSurfCorr sc sp)
    (hpeek : sc.peek? = some c)
    (h_flow : sc.inFlow = false)
    (h_not_doc : sc.col = 0 → atDocumentBoundary sc = false)
    (h_amp : c ≠ '&') (h_bang : c ≠ '!') (h_pipe : c ≠ '|') (h_gt : c ≠ '>')
    (h_line : s'.line = sc.line)
    (hok : scanNextToken_dispatchContent sc c = .ok s') :
    ∃ sp_gram sp',
      (∀ n : Nat, SFlowNode n .flowOut sp sp_gram) ∧
      GStar SSWhite sp_gram sp' ∧
      (sp_gram = sp' → s'.col ≠ 0 → ¬ (CommentOk s' ∧ s'.peek? = some '#')) ∧
      ScannerSurfCorr s' sp' := by
  by_cases hc_alias : c = '*'
  · subst hc_alias
    obtain ⟨sp', h_alias, ⟨_, h_pb, h_nw⟩, hcorr'⟩ :=
      dispatchContent_aliasNode_prod sc sp hcorr hpeek hok
    exact ⟨sp', sp', fun n => alias_flowNode h_alias, GStar.nil _,
           fun _ hcol h => CommentOk_false_of_peekBack hcol h_pb h_nw h.1, hcorr'⟩
  · obtain ⟨sp_gram, sp', h_all, h_ws, h_gate, hcorr'⟩ :=
      dispatchContent_evidence_content_oneLine sc sp c hcorr hpeek h_flow h_not_doc
        h_amp hc_alias h_bang h_pipe h_gt h_line hok
    exact ⟨sp_gram, sp', fun n => flowContent_flowNode (h_all n), h_ws, h_gate, hcorr'⟩

/-- **β.3's flow-interior content evidence.**  The `.flowIn` sibling of
    `dispatchContent_evidence`, for a content dispatch that ran with
    `sc.inFlow = true` — the shape `ns-flow-seq-entry` [139] / `ns-flow-map-entry`
    [142] consume, since [137]/[140] wrap their entries in `in-flow(c)`.

    Two differences from the `.flowOut` original, both forced:

    * **No block-scalar disjunct.**  `c-l+literal` [170] and `c-l+folded` [174]
      are reachable only through `s-l+block-node` [196]; `ns-flow-content` [158]
      has no literal/folded arm.  Item 9c made that a scanner rejection, so
      `dispatchContent_not_blockScalar_of_inFlow` refutes the header characters
      outright rather than leaving a disjunct the caller cannot discharge.
    * **The plain-scalar arm is a native production, not a lift.**  `flowIn`
      forbids the `,[]{}` that `flowOut` admits, so containment runs the wrong
      way and a `.flowOut` plain scalar does NOT lift.  `scanPlainScalar` already
      collects with the `s.inFlow` rules, so the `.flowIn` core
      (`scanPlainScalar_to_flowNode_flowIn`) is the same walk read at its native
      context.  The quoted, alias, anchor and tag arms are context-free or lift
      freely between non-key contexts. -/
lemma dispatchContent_evidence_flowIn (sc : ScannerState) (sp : SurfPos)
    {s' : ScannerState} (c : Char)
    (hcorr : ScannerSurfCorr sc sp)
    (hpeek : sc.peek? = some c)
    (h_inflow : sc.inFlow = true)
    (h_not_doc : sc.col = 0 → atDocumentBoundary sc = false)
    (hok : scanNextToken_dispatchContent sc c = .ok s') :
    ∃ sp_gram sp',
      SFlowNode 0 .flowIn sp sp_gram ∧
      GStar SSWhite sp_gram sp' ∧
      ScannerSurfCorr s' sp' := by
  -- Item 9c: inside a flow the block-scalar arm cannot have fired.
  obtain ⟨hnotPipe, hnotGt⟩ :=
    Proofs.BlockScalarFlowGuard.dispatchContent_not_blockScalar_of_inFlow h_inflow hok
  by_cases hc_dq : c = '"'
  · subst hc_dq
    obtain ⟨sp', h_gram, -, hcorr'⟩ := dispatchContent_doubleQuoted_prod sc sp hcorr hpeek hok
    exact ⟨sp', sp', SFlowNode_doubleQ_ctx_lift h_gram (by decide) (by decide),
           GStar.nil _, hcorr'⟩
  · by_cases hc_sq : c = '\''
    · subst hc_sq
      obtain ⟨sp', h_gram, -, hcorr'⟩ := dispatchContent_singleQuoted_prod sc sp hcorr hpeek hok
      exact ⟨sp', sp', SFlowNode_singleQ_ctx_lift h_gram (by decide) (by decide),
             GStar.nil _, hcorr'⟩
    · by_cases hc_alias : c = '*'
      · subst hc_alias
        obtain ⟨sp', h_gram, -, hcorr'⟩ := dispatchContent_alias_prod 0 sc sp .flowIn hcorr hpeek hok
        exact ⟨sp', sp', h_gram, GStar.nil _, hcorr'⟩
      · by_cases hc_amp : c = '&'
        · subst hc_amp
          obtain ⟨sp', h_gram, -, hcorr'⟩ := dispatchContent_anchor_prod 0 sc sp .flowIn hcorr hpeek hok
          exact ⟨sp', sp', h_gram, GStar.nil _, hcorr'⟩
        · by_cases hc_bang : c = '!'
          · subst hc_bang
            obtain ⟨sp', h_gram, -, hcorr'⟩ := dispatchContent_tag_prod 0 sc sp .flowIn hcorr hpeek hok
            exact ⟨sp', sp', h_gram, GStar.nil _, hcorr'⟩
          · obtain ⟨sp_gram, sp'', h_c, h_ws, hcorr'⟩ :=
              dispatchContent_plainScalar_flowIn_prod sc sp hcorr hpeek h_inflow
                hc_amp hc_alias hc_bang hnotPipe hnotGt hc_dq hc_sq h_not_doc hok
            exact ⟨sp_gram, sp'', SFlowNode.content 0 .flowIn _ _ h_c, h_ws, hcorr'⟩

/-- **Where a flow-interior content dispatch leaves the cursor** (item 72):
    never at column 0.

    `InteriorGap`'s column field is stated on the SCANNER's landing, which trails
    the node's endpoint by the whitespace `collectPlainScalarLoop` consumed — and
    `[80] s-white` never moves left.  The evidence is the UNINDEXED
    `dispatchContent_evidence_flowIn`, so this is available at the `_at` faces
    too, where the index-carrying disjunct is not what pays: the column is
    paid by the dispatch having built a node at all, not by the index it was
    read at. -/
lemma dispatchContent_flowIn_col_pos {sc s' : ScannerState} {sp sp' : SurfPos} {c : Char}
    (hcorr : ScannerSurfCorr sc sp)
    (hpeek : sc.peek? = some c)
    (h_inflow : sc.inFlow = true)
    (h_not_doc : sc.col = 0 → atDocumentBoundary sc = false)
    (hok : scanNextToken_dispatchContent sc c = .ok s')
    (hcorr' : ScannerSurfCorr s' sp') : 0 < sp'.col := by
  obtain ⟨sp_g, sp_r, h_node, h_ws, hcorr_r⟩ :=
    dispatchContent_evidence_flowIn sc sp c hcorr hpeek h_inflow h_not_doc hok
  have h_eq : sp_r = sp' := ScannerSurfCorr_unique hcorr_r hcorr'
  subst h_eq
  have := flowNode_col_pos h_node
  have := gstar_white_col_le h_ws
  omega

/-- **The flow-interior content evidence at the STACK's own index** (item 67):
    `dispatchContent_evidence_flowIn` reads every token at 0 and lets the
    caller lift, which gives up the whole reading whenever a scalar crossed a
    line.  Here the reading is built at `n` from the scan itself, so a
    multi-line token composes instead.  Every arm
    reads at `n` with no disjunction (item 88): the quoted and plain landings
    all carry their checks (items 50, 62, 87), and the alias and property
    arms never fold.

    The two side conditions are the interior's own facts.  `n` is under the
    enclosing block's content floor (the stack carries that from the open), and
    the token starts past that floor — `scanNextToken_dispatchStructural`'s
    FIRST check refuses every flow-interior token at or left of
    `currentIndent`.  The quoted arms need only the first; the plain arm needs
    both, because its walk measures continuation lines against the block floor
    while its own `contentIndent` is the start column. -/
lemma dispatchContent_evidence_flowIn_at (n : Nat) (sc : ScannerState) (sp : SurfPos)
    {s' : ScannerState} (c : Char)
    (hcorr : ScannerSurfCorr sc sp)
    (hpeek : sc.peek? = some c)
    (h_inflow : sc.inFlow = true)
    (h_not_doc : sc.col = 0 → atDocumentBoundary sc = false)
    (hok : scanNextToken_dispatchContent sc c = .ok s')
    (hcol : sc.currentIndent < (sc.col : Int))
    (hn : (n : Int) ≤ max 0 (sc.currentIndent + 1)) :
    ∃ sp_gram sp',
      SFlowNode n .flowIn sp sp_gram ∧
      GStar SSWhite sp_gram sp' ∧
      ScannerSurfCorr s' sp' := by
  obtain ⟨hnotPipe, hnotGt⟩ :=
    Proofs.BlockScalarFlowGuard.dispatchContent_not_blockScalar_of_inFlow h_inflow hok
  by_cases hc_dq : c = '"'
  · subst hc_dq
    obtain ⟨sp', h_gram, -, hcorr'⟩ :=
      dispatchContent_doubleQuoted_prod_at n sc sp hcorr hpeek hok hn
    exact ⟨sp', sp', SFlowNode_doubleQ_ctx_lift h_gram (by decide) (by decide),
           GStar.nil _, hcorr'⟩
  · by_cases hc_sq : c = '\''
    · subst hc_sq
      obtain ⟨sp', h_gram, -, hcorr'⟩ :=
        dispatchContent_singleQuoted_prod_at n sc sp hcorr hpeek hok hn
      exact ⟨sp', sp', SFlowNode_singleQ_ctx_lift h_gram (by decide) (by decide),
             GStar.nil _, hcorr'⟩
    · by_cases hc_alias : c = '*'
      · subst hc_alias
        obtain ⟨sp', h_gram, -, hcorr'⟩ :=
          dispatchContent_alias_prod n sc sp .flowIn hcorr hpeek hok
        exact ⟨sp', sp', h_gram, GStar.nil _, hcorr'⟩
      · by_cases hc_amp : c = '&'
        · subst hc_amp
          obtain ⟨sp', h_gram, -, hcorr'⟩ :=
            dispatchContent_anchor_prod n sc sp .flowIn hcorr hpeek hok
          exact ⟨sp', sp', h_gram, GStar.nil _, hcorr'⟩
        · by_cases hc_bang : c = '!'
          · subst hc_bang
            obtain ⟨sp', h_gram, -, hcorr'⟩ :=
              dispatchContent_tag_prod n sc sp .flowIn hcorr hpeek hok
            exact ⟨sp', sp', h_gram, GStar.nil _, hcorr'⟩
          · obtain ⟨sp_gram, sp'', h_c, h_ws, hcorr'⟩ :=
              dispatchContent_plainScalar_flowIn_prod_at n sc sp hcorr hpeek h_inflow
                hc_amp hc_alias hc_bang hnotPipe hnotGt hc_dq hc_sq h_not_doc hok hcol hn
            exact ⟨sp_gram, sp'', SFlowNode.content n .flowIn _ _ h_c, h_ws, hcorr'⟩

/-- The CONTENT-level face of `dispatchContent_evidence_flowIn_at` — what a
    held flow-interior props run decorates (`[158] ns-flow-content`, since
    `SFlowNode.propsContent` wraps content and not a node).

    `*` has to be excluded rather than handled: `[104] c-ns-alias-node` is a
    whole node with no content reading, so `[&a *x]` has no derivation — and
    the scanner agrees, rejecting it at the `*` via `lastTokenIsNodeProperty`
    (item 9e). -/
lemma dispatchContent_evidence_flowIn_content_at (n : Nat) (sc : ScannerState) (sp : SurfPos)
    {s' : ScannerState} (c : Char)
    (hcorr : ScannerSurfCorr sc sp)
    (hpeek : sc.peek? = some c)
    (h_inflow : sc.inFlow = true)
    (h_not_doc : sc.col = 0 → atDocumentBoundary sc = false)
    (h_amp : c ≠ '&') (h_star : c ≠ '*') (h_bang : c ≠ '!')
    (hok : scanNextToken_dispatchContent sc c = .ok s')
    (hcol : sc.currentIndent < (sc.col : Int))
    (hn : (n : Int) ≤ max 0 (sc.currentIndent + 1)) :
    ∃ sp_gram sp',
      SFlowContent n .flowIn sp sp_gram ∧
      GStar SSWhite sp_gram sp' ∧
      ScannerSurfCorr s' sp' := by
  obtain ⟨hnotPipe, hnotGt⟩ :=
    Proofs.BlockScalarFlowGuard.dispatchContent_not_blockScalar_of_inFlow h_inflow hok
  by_cases hc_dq : c = '"'
  · subst hc_dq
    obtain ⟨sp'', h_gram, -, hcorr'⟩ :=
      dispatchContent_doubleQuoted_prod_at n sc sp hcorr hpeek hok hn
    exact ⟨sp'', sp'', SFlowContent_doubleQ_ctx_lift h_gram (by decide) (by decide),
           GStar.nil _, hcorr'⟩
  · by_cases hc_sq : c = '\''
    · subst hc_sq
      obtain ⟨sp'', h_gram, -, hcorr'⟩ :=
        dispatchContent_singleQuoted_prod_at n sc sp hcorr hpeek hok hn
      exact ⟨sp'', sp'', SFlowContent_singleQ_ctx_lift h_gram (by decide) (by decide),
             GStar.nil _, hcorr'⟩
    · exact dispatchContent_plainScalar_flowIn_prod_at n sc sp hcorr hpeek h_inflow
        h_amp h_star h_bang hnotPipe hnotGt hc_dq hc_sq h_not_doc hok hcol hn

/-- The `.flowOut` CONTENT-level evidence (item 12): what a held depth-0 props
    run's ride consumes.  Unlike the `.flowIn` sibling the block-scalar
    disjunct SURVIVES — `[198] s-l+block-scalar` carries its own props slot, so
    `&a |` is a legal anchored literal — and the plain arm lifts to `.flowOut`.
    `&`/`*`/`!` are excluded: the first and last extend the run, the alias is
    scanner-refuted. -/
lemma dispatchContent_evidence_content (sc : ScannerState) (sp : SurfPos)
    {s' : ScannerState} (c : Char)
    (hcorr : ScannerSurfCorr sc sp)
    (hpeek : sc.peek? = some c)
    (h_not_doc : sc.col = 0 → atDocumentBoundary sc = false)
    (h_amp : c ≠ '&') (h_star : c ≠ '*') (h_bang : c ≠ '!')
    (hok : scanNextToken_dispatchContent sc c = .ok s') :
    ∃ sp_gram sp',
      (SFlowContent 0 .flowOut sp sp_gram ∨
        ((SCLLiteral 0 sp sp_gram ∨ SCLFolded 0 sp sp_gram) ∧
          -- Item 95: the walk at the scalar's stop, absorbable into the
          -- same node (item 97's gate refuses the TAB stop).
          (∀ sp_mid : SurfPos, SSLComments sp_gram sp_mid →
            SCLLiteral 0 sp sp_mid ∨ SCLFolded 0 sp sp_mid))) ∧
      GStar SSWhite sp_gram sp' ∧
      (sp_gram = sp' → s'.col ≠ 0 → ¬ (CommentOk s' ∧ s'.peek? = some '#')) ∧
      ScannerSurfCorr s' sp' := by
  by_cases hc_dq : c = '"'
  · subst hc_dq
    obtain ⟨sp', h_gram, h_pb, hcorr'⟩ := dispatchContent_doubleQuoted_prod sc sp hcorr hpeek hok
    exact ⟨sp', sp', Or.inl (SFlowContent_doubleQ_ctx_lift h_gram (by decide) (by decide)),
           GStar.nil _,
           fun _ hcol h => CommentOk_false_of_peekBack hcol h_pb (by decide) h.1, hcorr'⟩
  · by_cases hc_sq : c = '\''
    · subst hc_sq
      obtain ⟨sp', h_gram, h_pb, hcorr'⟩ := dispatchContent_singleQuoted_prod sc sp hcorr hpeek hok
      exact ⟨sp', sp', Or.inl (SFlowContent_singleQ_ctx_lift h_gram (by decide) (by decide)),
             GStar.nil _,
             fun _ hcol h => CommentOk_false_of_peekBack hcol h_pb (by decide) h.1, hcorr'⟩
    · by_cases hc_bs : c = '|' ∨ c = '>'
      · obtain ⟨sp', h_gram, hcorr', h_absorb⟩ :=
          dispatchContent_blockScalar_prod sc sp hcorr hpeek hc_bs hok
        have h_park := scanBlockScalar_park
          (dispatchContent_blockScalar_scan sc sp hcorr hpeek hc_bs hok)
        exact ⟨sp', sp', Or.inr ⟨h_gram, h_absorb⟩, GStar.nil _,
               fun _ hcol h => h_park.elim (fun h0 => hcol h0) (fun hne => hne h.2), hcorr'⟩
      · have hnotPipe : c ≠ '|' := fun h => hc_bs (Or.inl h)
        have hnotGt : c ≠ '>' := fun h => hc_bs (Or.inr h)
        obtain ⟨sp_gram, sp', h_gram, h_ws, h_nohash, hcorr'⟩ :=
          dispatchContent_plainScalar_content_prod sc sp hcorr hpeek
            h_amp h_star h_bang hnotPipe hnotGt hc_dq hc_sq h_not_doc hok
        exact ⟨sp_gram, sp', Or.inl h_gram, h_ws, fun heq _ h => h_nohash heq h.2, hcorr'⟩

/-! #### The content dispatch's three property guards, inverted (β.3)

    Each is the same shape: the arm's `if` is a disjunction whose first disjunct
    is the §6.9/§7.5 property test, so a dispatch that returned `.ok` says that
    test was `false`.  That is how a held run refutes a repeat of its own half —
    the accumulation never meets `[&a &b]`, because the scanner errored. -/

lemma propertyRunHasAnchor_false_of_dispatch {s s' : ScannerState}
    (hok : scanNextToken_dispatchContent s '&' = .ok s') :
    propertyRunHasAnchor s = false := by
  unfold scanNextToken_dispatchContent at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  split at hok
  · split at hok
    · simp at hok
    · rename_i hg; simp at hg; exact hg.1.1
  · rename_i h_neq; exact absurd rfl h_neq

/-- **Item 165's third disjunct, inverted** — a dispatched property says the run
    it joins was not already full, which is the fact `[96]`'s own arithmetic
    hands the accumulation: a park whose last TWO real tokens are properties
    takes no third. -/
lemma propertyRunFull_false_of_anchor_dispatch {s s' : ScannerState}
    (hok : scanNextToken_dispatchContent s '&' = .ok s') :
    propertyRunFull s = false := by
  unfold scanNextToken_dispatchContent at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  split at hok
  · split at hok
    · simp at hok
    · rename_i hg; simp at hg; exact hg.1.2
  · rename_i h_neq; exact absurd rfl h_neq

lemma propertyRunHasTag_false_of_dispatch {s s' : ScannerState}
    (hok : scanNextToken_dispatchContent s '!' = .ok s') :
    propertyRunHasTag s = false := by
  unfold scanNextToken_dispatchContent at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  split at hok
  · rename_i h_eq; exact absurd h_eq (by decide)
  · split at hok
    · rename_i h_eq; exact absurd h_eq (by decide)
    · split at hok
      · split at hok
        · simp at hok
        · rename_i hg; simp at hg; exact hg.1.1
      · rename_i h_neq; exact absurd rfl h_neq

/-- …and its tag twin (item 165). -/
lemma propertyRunFull_false_of_tag_dispatch {s s' : ScannerState}
    (hok : scanNextToken_dispatchContent s '!' = .ok s') :
    propertyRunFull s = false := by
  unfold scanNextToken_dispatchContent at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  split at hok
  · rename_i h_eq; exact absurd h_eq (by decide)
  · split at hok
    · rename_i h_eq; exact absurd h_eq (by decide)
    · split at hok
      · split at hok
        · simp at hok
        · rename_i hg; simp at hg; exact hg.1.2
      · rename_i h_neq; exact absurd rfl h_neq

/-- Item 9e's third test: `[104]` is an alternative to the properties-bearing
    `[161]`, never its content, so a dispatched `*` says nothing was held. -/
lemma lastTokenIsNodeProperty_false_of_dispatch {s s' : ScannerState}
    (hok : scanNextToken_dispatchContent s '*' = .ok s') :
    lastTokenIsNodeProperty s = false := by
  unfold scanNextToken_dispatchContent at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  split at hok
  · rename_i h_eq; exact absurd h_eq (by decide)
  · split at hok
    · split at hok
      · simp at hok
      · rename_i hg; simp at hg; exact hg.1
    · rename_i h_neq; exact absurd rfl h_neq

/-- The simple-key facts a dispatched `&` leaves: the pending key rides
    through (`scanAnchorOrAlias` never touches it) and fresh saves are off —
    what keeps a completed entry's `KeyAfterValueLayout` alive under a freshly
    opened property run (item 10). -/
lemma dispatchContent_anchor_simpleKey {s s' : ScannerState}
    (hok : scanNextToken_dispatchContent s '&' = .ok s') :
    s'.simpleKey = s.simpleKey ∧ s'.simpleKeyAllowed = false := by
  unfold scanNextToken_dispatchContent at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  split at hok
  · split at hok
    · simp at hok
    generalize h_anch : scanAnchorOrAlias s true = anch_result at hok
    cases anch_result with
    | error => simp at hok
    | ok s_anch =>
      change Except.ok _ = Except.ok s' at hok
      have h := Except.ok.inj hok; subst h
      have h1 := ScannerCorrectness.scanAnchorOrAlias_preserves_simpleKey s true s_anch h_anch
      have h2 := scanAnchorOrAlias_simpleKeyAllowed_false h_anch
      exact ⟨h1, h2⟩
  · rename_i h_neq; exact absurd rfl h_neq

/-- ... and the `!` twin. -/
lemma dispatchContent_tag_simpleKey {s s' : ScannerState}
    (hok : scanNextToken_dispatchContent s '!' = .ok s') :
    s'.simpleKey = s.simpleKey ∧ s'.simpleKeyAllowed = false := by
  unfold scanNextToken_dispatchContent at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  split at hok
  · rename_i h_eq; exact absurd h_eq (by decide)
  · split at hok
    · rename_i h_eq; exact absurd h_eq (by decide)
    · split at hok
      · split at hok
        · simp at hok
        generalize h_tag : scanTag s = tag_result at hok
        cases tag_result with
        | error => simp at hok
        | ok s_tag =>
          simp only [Except.ok.injEq] at hok; subst hok
          exact ⟨ScannerCorrectness.scanTag_preserves_simpleKey s s_tag h_tag,
            scanTag_simpleKeyAllowed_false h_tag⟩
      · rename_i h_neq; exact absurd rfl h_neq

/-- `scanAnchorOrAlias` parks where `anchorNameEnd` does. -/
lemma scanAnchorOrAlias_peek {s s' : ScannerState} {b : Bool}
    (h : scanAnchorOrAlias s b = .ok s') : s'.peek? = (anchorNameEnd s).peek? := by
  simp only [scanAnchorOrAlias] at h
  split at h
  · cases h
  · simp only [Except.ok.injEq] at h; subst h
    unfold anchorNameEnd
    exact (peek_congr rfl rfl rfl).1

/-- A property park sits before a separator (`propertyFollowerOk`). -/
lemma dispatchContent_anchor_followerOk {s s' : ScannerState}
    (hok : scanNextToken_dispatchContent s '&' = .ok s') :
    propertyFollowerOk (anchorNameEnd s) = true := by
  unfold scanNextToken_dispatchContent at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  split at hok
  · split at hok
    · simp at hok
    rename_i hcond
    cases hp : propertyFollowerOk (anchorNameEnd s)
    · exfalso; apply hcond; simp [hp]
    · rfl
  · rename_i h_neq; exact absurd rfl h_neq

lemma dispatchContent_anchor_peek {s s' : ScannerState}
    (hok : scanNextToken_dispatchContent s '&' = .ok s') :
    s'.peek? = (anchorNameEnd s).peek? := by
  unfold scanNextToken_dispatchContent at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  split at hok
  · split at hok
    · simp at hok
    generalize h_anch : scanAnchorOrAlias s true = anch_result at hok
    cases anch_result with
    | error => simp at hok
    | ok s_anch =>
      change Except.ok _ = Except.ok s' at hok
      have h := Except.ok.inj hok; subst h
      exact (peek_congr (b := s_anch) rfl rfl rfl).1.trans (scanAnchorOrAlias_peek (b := true) h_anch)
  · rename_i h_neq; exact absurd rfl h_neq

lemma dispatchContent_anchor_next {s s' : ScannerState}
    (hok : scanNextToken_dispatchContent s '&' = .ok s') : NextIsSep s' := by
  have hn := nextIsSep_of_propertyFollowerOk (dispatchContent_anchor_followerOk hok)
  unfold NextIsSep at hn ⊢
  rw [dispatchContent_anchor_peek hok]; exact hn

lemma dispatchContent_tag_next {s s' : ScannerState}
    (hok : scanNextToken_dispatchContent s '!' = .ok s') : NextIsSep s' := by
  unfold scanNextToken_dispatchContent at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  split at hok
  · rename_i h_eq; exact absurd h_eq (by decide)
  · split at hok
    · rename_i h_eq; exact absurd h_eq (by decide)
    · split at hok
      · split at hok
        · simp at hok
        rename_i hcond
        generalize h_tag : scanTag s = tag_result at hok
        cases tag_result with
        | error => simp at hok
        | ok s_tag =>
          simp only [Except.ok.injEq] at hok; subst hok
          apply nextIsSep_of_propertyFollowerOk
          cases hp : propertyFollowerOk s_tag
          · exfalso; apply hcond; simp [propertyScanFollowerOk, h_tag, hp]
          · rfl
      · rename_i h_neq; exact absurd rfl h_neq

/-- **A content park keeps `flag ∨ live`** (item 293): the dispatch state's key
    is live (`preprocess_possible_of_live0`), a block scalar ends with the flag
    up, the property scans keep the key, and every other content scan keeps it
    too (`dispatchContent_value_key_facts`). -/
lemma content_live0 {sc s_prep s' : ScannerState} {c : Char}
    (h_live0 : sc.simpleKeyAllowed = true ∨ sc.simpleKey.possible = true)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h_flow_disp : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).inFlow = false)
    (h_dispatch : scanNextToken_dispatchContent (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) c = .ok s') :
    s'.simpleKeyAllowed = true ∨ s'.simpleKey.possible = true := by
  have h_pp : s_prep.simpleKey.possible = true :=
    preprocess_possible_of_live0 h_live0 (noflow_of_noflow_disp h_flow_disp) h_preprocess
  by_cases hbs : c = '|' ∨ c = '>'
  · exact Or.inl (dispatchContent_blockScalar_ska hbs h_dispatch)
  by_cases hamp : c = '&'
  · subst hamp
    exact Or.inr (by rw [(dispatchContent_anchor_simpleKey h_dispatch).1,
      allowDirectives_update_simpleKey]; exact h_pp)
  by_cases hbang : c = '!'
  · subst hbang
    exact Or.inr (by rw [(dispatchContent_tag_simpleKey h_dispatch).1,
      allowDirectives_update_simpleKey]; exact h_pp)
  exact Or.inr (by
    rw [(dispatchContent_value_key_facts h_dispatch hamp hbang (fun h => hbs (Or.inl h))
      (fun h => hbs (Or.inr h))).1.1, allowDirectives_update_simpleKey]; exact h_pp)

/-- ... and the `*` twin (item 29).  `[104]`'s scan is the same
    `scanAnchorOrAlias`, and the `validateAliasClose` that follows it in the
    dispatcher returns `Unit` — so an alias key's saved POSITION survives its
    own dispatch exactly as a property's does, which is the one datum item 28's
    alias arm was missing.  (`dispatchContent_value_key_facts` proves the same
    thing for every value-completing character, but it is stated a thousand
    lines below `content_dispatch_after_close` and cannot be used there.) -/
lemma dispatchContent_alias_simpleKey {s s' : ScannerState}
    (hok : scanNextToken_dispatchContent s '*' = .ok s') :
    s'.simpleKey = s.simpleKey ∧ s'.simpleKeyAllowed = false := by
  unfold scanNextToken_dispatchContent at hok
  simp only [bind, Except.bind, pure, Except.pure] at hok
  split at hok
  · rename_i h_eq; exact absurd h_eq (by decide)
  · split at hok
    · split at hok
      · simp at hok
      · split at hok
        · simp at hok
        · generalize h_al : scanAnchorOrAlias s false = al_result at hok
          cases al_result with
          | error => simp at hok
          | ok s_al =>
            dsimp only [] at hok
            split at hok
            · simp at hok
            · have h := Except.ok.inj hok; subst h
              exact ⟨ScannerCorrectness.scanAnchorOrAlias_preserves_simpleKey s false s_al h_al,
                scanAnchorOrAlias_simpleKeyAllowed_false h_al⟩
    · rename_i h_neq; exact absurd rfl h_neq

/-- **Opening a property run at a `.colon`-tailed white gap builds the
    completed-entry layout (item 10).**  The fresh reservation preprocessing
    saves lands directly above the gap's `.value`, the property scan then
    keeps the key and turns fresh saves off — `[a: &x : b]`'s scanner
    rejection reads exactly this state one dispatch later.  Dispatch-agnostic:
    the caller supplies the `&`/`!` arm's simple-key, token-push and progress
    facts. -/
lemma props_open_layout {sc s_prep s_ad s' : ScannerState} {c : Char}
    (h_flow : 0 < sc.flowLevel)
    (h_white : sc.simpleKeyAllowed = true ∧ sc.explicitKeyLine = none ∧
      ∃ tok, sc.tokens[sc.tokens.size - 1]? = some tok ∧ tok.val = .value)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h_ad_def : (if s_prep.allowDirectives = true then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep) = s_ad)
    (h_sk' : s'.simpleKey = s_ad.simpleKey)
    (h_al' : s'.simpleKeyAllowed = false)
    (h_tk' : ∃ p : Positioned YamlToken, s'.tokens = s_ad.tokens.push p)
    (h_off' : s_ad.offset < s'.offset) :
    KeyAfterValueLayout s' := by
  obtain ⟨h_a, h_ek, tok, h_back, h_val⟩ := h_white
  have h_sz : 0 < sc.tokens.size := by
    cases hsz : sc.tokens.size with
    | zero =>
      have hnone : sc.tokens[sc.tokens.size - 1]? = none :=
        Array.getElem?_eq_none (by omega)
      rw [hnone] at h_back
      exact absurd h_back (by simp)
    | succ n => omega
  obtain ⟨s_skip, hsk, hsave⟩ := preprocess_inFlow_elim h_flow h_preprocess
  have h_al_skip : s_skip.simpleKeyAllowed = true :=
    (skipToContent_preserves_simpleKeyAllowed_inFlow sc s_skip h_flow hsk).trans h_a
  have h_ek_skip : s_skip.explicitKeyLine = none :=
    (skipToContent_preserves_explicitKeyLine sc s_skip hsk).trans h_ek
  have h_tk_skip : s_skip.tokens = sc.tokens :=
    ScannerCorrectness.skipToContent_preserves_tokens sc s_skip hsk
  obtain ⟨hf_poss, hf_ti, hf_pref, _hf_al, hf_off, _hf_ek, _hf_fl, hf_pos, hf_sz⟩ :=
    saveSimpleKey_fresh_facts h_al_skip h_ek_skip
  obtain ⟨p, hp⟩ := h_tk'
  -- The `allowDirectives` update between preprocessing and dispatch moves none
  -- of the fields this layout reads.
  have h_ad_sk : s_ad.simpleKey = s_prep.simpleKey := by rw [← h_ad_def]; split <;> rfl
  have h_ad_tk : s_ad.tokens = s_prep.tokens := by rw [← h_ad_def]; split <;> rfl
  have h_ad_off : s_ad.offset = s_prep.offset := by rw [← h_ad_def]; split <;> rfl
  refine ⟨by rw [h_sk', h_ad_sk, hsave]; exact hf_poss,
    by rw [h_sk', h_ad_sk, hsave, hf_ti, h_tk_skip]; omega,
    ⟨tok, ?_, h_val⟩,
    by rw [h_sk', h_ad_sk, hsave, hf_pos]
       have h_po : s_prep.offset = s_skip.offset := by rw [hsave]; exact hf_off
       omega,
    h_al',
    by rw [h_sk', h_ad_sk, hsave, hf_ti, h_tk_skip, hp, Array.size_push, h_ad_tk,
           hsave, hf_sz, h_tk_skip]
       omega⟩
  rw [h_sk', h_ad_sk, hsave, hf_ti, h_tk_skip, hp, h_ad_tk, hsave]
  rw [Array.getElem?_push, ite_eq_right (by rw [hf_sz, h_tk_skip]; omega),
      hf_pref (sc.tokens.size - 1) (by rw [h_tk_skip]; omega), h_tk_skip]
  exact h_back

/-- **Extending a held run transports the layout (item 10).**  With fresh
    saves off, preprocessing keeps the key; the property scan appends one
    token above the reservation and turns fresh saves off again. -/
lemma props_extend_layout {sc s_prep s_ad s' : ScannerState} {c : Char}
    (h_flow : 0 < sc.flowLevel)
    (h_layout : KeyAfterValueLayout sc)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h_ad_def : (if s_prep.allowDirectives = true then
        { s_prep with allowDirectives := false, documentEverStarted := true }
      else s_prep) = s_ad)
    (h_sk' : s'.simpleKey = s_ad.simpleKey)
    (h_al' : s'.simpleKeyAllowed = false)
    (h_tk' : ∃ p : Positioned YamlToken, s'.tokens = s_ad.tokens.push p)
    (h_off' : s_ad.offset < s'.offset) :
    KeyAfterValueLayout s' := by
  obtain ⟨h_poss, h_ti, ⟨tok, h_slot, h_val⟩, h_pos_off, h_al, h_rng⟩ := h_layout
  have h_slot_lt : sc.simpleKey.tokenIndex - 1 < sc.tokens.size := by
    cases hlt : decide (sc.simpleKey.tokenIndex - 1 < sc.tokens.size) with
    | true => exact of_decide_eq_true hlt
    | false =>
      have hge : sc.tokens.size ≤ sc.simpleKey.tokenIndex - 1 := by
        have := of_decide_eq_false hlt; omega
      rw [Array.getElem?_eq_none hge] at h_slot
      exact absurd h_slot (by simp)
  obtain ⟨s_skip, hsk, hsave⟩ := preprocess_inFlow_elim h_flow h_preprocess
  have h_al_skip : s_skip.simpleKeyAllowed = false :=
    (skipToContent_preserves_simpleKeyAllowed_inFlow sc s_skip h_flow hsk).trans h_al
  have h_id : saveSimpleKey s_skip = s_skip := saveSimpleKey_id_of_not_allowed h_al_skip
  have h_sk_skip : s_skip.simpleKey = sc.simpleKey :=
    ScannerCorrectness.skipToContent_preserves_simpleKey sc s_skip hsk
  have h_tk_skip : s_skip.tokens = sc.tokens :=
    ScannerCorrectness.skipToContent_preserves_tokens sc s_skip hsk
  obtain ⟨p, hp⟩ := h_tk'
  have h_ad_sk : s_ad.simpleKey = s_prep.simpleKey := by rw [← h_ad_def]; split <;> rfl
  have h_ad_tk : s_ad.tokens = s_prep.tokens := by rw [← h_ad_def]; split <;> rfl
  have h_ad_off : s_ad.offset = s_prep.offset := by rw [← h_ad_def]; split <;> rfl
  refine ⟨by rw [h_sk', h_ad_sk, hsave, h_id, h_sk_skip]; exact h_poss,
    by rw [h_sk', h_ad_sk, hsave, h_id, h_sk_skip]; exact h_ti,
    ⟨tok, ?_, h_val⟩,
    by rw [h_sk', h_ad_sk, hsave, h_id, h_sk_skip]
       have h_ge := ScannerCorrectness.skipToContent_offset_ge sc s_skip hsk
       have h_po : s_prep.offset = s_skip.offset := by rw [hsave, h_id]
       omega,
    h_al',
    by rw [h_sk', h_ad_sk, hsave, h_id, h_sk_skip, hp, Array.size_push, h_ad_tk,
           hsave, h_id, h_tk_skip]
       omega⟩
  rw [h_sk', h_ad_sk, hsave, h_id, h_sk_skip, hp, h_ad_tk, hsave, h_id, h_tk_skip]
  rw [Array.getElem?_push, ite_eq_right (by omega)]
  exact h_slot

/-! #### Extracted content-dispatch per-constructor theorems

    Each theorem handles one substantial `PendingNode` constructor case for
    `accum_content_pending`. The main theorem delegates to these after the
    shared preamble. Trivial-close constructors and `pendingDirective`
    remain inline. -/

/-- Derive `content_dispatch_after_close`'s key context (item 15) from the
    caller's own preprocessing: the pending closes at a column-0 LINE START
    (preprocessing crossed to one, or consumed nothing at a col-0 position),
    the residual whites between that line start and the content are the entry's
    `[63] s-indent(k)`, and the save was fresh.

    Items 15–17 read the whites as an obstruction — `GStar.cons` punted, so
    only a key at column 0 packed.  Item 25 reads them as the MEASUREMENT they
    are: `[187] l+block-mapping(n)`'s auto-detected width is what the entry is
    indented by, exactly as item 22 read the whites before a block indicator,
    and `gstar_white_sIndent_or_tab` is the same splitter.  What still punts is
    a TAB (`[63]` wants spaces) and an inherited stale key. -/
lemma keyctx_of_preprocess (sc : ScannerState) (sp sp_prep : SurfPos)
    (s_prep : ScannerState) (c : Char) {sp_start : SurfPos}
    (h_corr : ScannerSurfCorr sc sp)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    -- Item 157: the park's close, with its own face — the two arms below are
    -- the same two `landing_or_park_ska` spells, so both pay it.
    (h_close : danglingNodePos? sc = none →
      underIndentedFlowValuePos? sc = none →
      ∀ sp_mid, SSLComments sp sp_mid → SLYamlStream sp_start sp_mid)
    (h_dn : scanNextToken_checkDanglingNode sc s_prep = .ok ())
    -- Item 275: §8.1's check, carried beside §9.2's.
    (h_fv : scanNextToken_checkFlowValueIndent sc s_prep = .ok ())
    (h_noflow : s_prep.inFlow = false)
    (h_park : sc.simpleKeyAllowed = true ∨ 0 < sp.col)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c))) :
    ((∃ (k : Nat) (sp_land : SurfPos),
        sp_land.col = 0 ∧ SLYamlStream sp_start sp_land ∧ SIndent k sp_land sp_prep) ∧
     s_prep.simpleKey.possible = true ∧
     s_prep.simpleKey.pos = s_prep.currentPos) ∨ True := by
  cases preprocess_some_savedKey_shape h_preprocess with
  | inr _ => exact Or.inr trivial
  | inl h_sk =>
    obtain ⟨sp_mid, sp_ws, sp_prep2, h_disj, h_ws, _h_cmt, hcorr_prep2, h_pk, _⟩ :=
      preprocess_some_ssl_comments_anyCol sc sp s_prep c h_corr h_preprocess
    have hsp_eq2 := ScannerSurfCorr_unique hcorr_prep hcorr_prep2
    have h_eq : sp_prep2 = sp_ws := by
      cases h_pk with
      | inl h => exact h
      | inr h => rw [preprocess_some_peek h_preprocess] at h; cases h
    have h_pe : sp_prep = sp_ws := hsp_eq2.trans h_eq
    cases gstar_white_sIndent_or_tab h_ws with
    | inr _ => exact Or.inr trivial
    | inl h_ind0 =>
      obtain ⟨k, h_ind⟩ := h_ind0
      have h_ind' : SIndent k sp_mid sp_prep := by rw [h_pe]; exact h_ind
      cases h_disj with
      | inl hssl =>
        exact Or.inl ⟨⟨k, sp_mid, hssl.2.1,
          h_close (dangling_none_of_check h_dn
            (landing_or_park_ska h_noflow hssl.2.2.2 h_park h_preprocess))
            (underIndented_none_of_check h_fv
              (landing_or_park_ska h_noflow hssl.2.2.2 h_park h_preprocess)) sp_mid hssl.1,
          h_ind'⟩, h_sk.1, h_sk.2⟩
      | inr hmid =>
        by_cases hc0 : sp.col = 0
        · have hcol_eq : sp = ⟨sp.chars, 0⟩ := by
            cases sp; simp at hc0; simp [hc0]
          have h_ssl_zero : SSLComments sp sp :=
            hcol_eq ▸ SSLComments.startOfLine sp.chars ⟨sp.chars, 0⟩
              (GStar.nil ⟨sp.chars, 0⟩)
          exact Or.inl ⟨⟨k, sp, hc0,
            h_close (dangling_none_of_check h_dn
              (preprocess_simpleKeyAllowed_mono (h_park.resolve_right (by omega))
                h_preprocess))
              (underIndented_none_of_check h_fv
                (preprocess_simpleKeyAllowed_mono (h_park.resolve_right (by omega))
                  h_preprocess)) sp h_ssl_zero, hmid.1 ▸ h_ind'⟩,
            h_sk.1, h_sk.2⟩
        · exact Or.inr trivial

/-- **`keyctx_of_preprocess`'s HEAD twin** (item 136) — the same landing read
    behind a park that has started no document.

    `keyctx_of_preprocess` hands the landed key the STREAM closed at a
    column-0 line start, which is one route and the over-approximating one:
    `rootMapRoute` appends the entry's mapping to that stream as a fresh bare
    document, and `[211]` has no such production once 1c tightens the implicit
    continuation.  A virgin block-context park says more — the region behind it
    is `[202] l-document-prefix*` alone (`noPending.h_nodoc`, item 116) — and
    the landing's own `[79] s-l-comments` are more prefixes
    (`ssl_comments_extend_prefixes`), so the key's entry heads the stream's
    FIRST document and routes through `single` (`nodocMapRoute`).

    Everything else is `keyctx_of_preprocess`'s, verbatim: the same landing
    split, the same `[63] s-indent(k)` measurement off the residual whites, and
    the same two punts — a TAB in them, and an inherited stale key. -/
lemma nodocctx_of_preprocess (sc : ScannerState) (sp sp_prep : SurfPos)
    (s_prep : ScannerState) (c : Char) {sp_start : SurfPos}
    (h_corr : ScannerSurfCorr sc sp)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (h_nodoc : GStar SLDocumentPrefix sp_start sp)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c))) :
    ((∃ (k : Nat) (sp_land : SurfPos),
        sp_land.col = 0 ∧ GStar SLDocumentPrefix sp_start sp_land ∧
        SIndent k sp_land sp_prep) ∧
     s_prep.simpleKey.possible = true ∧
     s_prep.simpleKey.pos = s_prep.currentPos) ∨ True := by
  cases preprocess_some_savedKey_shape h_preprocess with
  | inr _ => exact Or.inr trivial
  | inl h_sk =>
    obtain ⟨sp_mid, sp_ws, sp_prep2, h_disj, h_ws, _h_cmt, hcorr_prep2, h_pk, _⟩ :=
      preprocess_some_ssl_comments_anyCol sc sp s_prep c h_corr h_preprocess
    have hsp_eq2 := ScannerSurfCorr_unique hcorr_prep hcorr_prep2
    have h_eq : sp_prep2 = sp_ws := by
      cases h_pk with
      | inl h => exact h
      | inr h => rw [preprocess_some_peek h_preprocess] at h; cases h
    have h_pe : sp_prep = sp_ws := hsp_eq2.trans h_eq
    cases gstar_white_sIndent_or_tab h_ws with
    | inr _ => exact Or.inr trivial
    | inl h_ind0 =>
      obtain ⟨k, h_ind⟩ := h_ind0
      have h_ind' : SIndent k sp_mid sp_prep := by rw [h_pe]; exact h_ind
      cases h_disj with
      | inl hssl =>
        exact Or.inl ⟨⟨k, sp_mid, hssl.2.1,
          ssl_comments_extend_prefixes h_nodoc hssl.1, h_ind'⟩, h_sk.1, h_sk.2⟩
      | inr hmid =>
        by_cases hc0 : sp.col = 0
        · exact Or.inl ⟨⟨k, sp, hc0, h_nodoc, hmid.1 ▸ h_ind'⟩, h_sk.1, h_sk.2⟩
        · exact Or.inr trivial

/-- **The landing's key context when the levels it lands in are still OPEN**
    (item 109) — `keyctx_of_preprocess`'s answer read at the entries level.

    `keyctx_of_preprocess` hands the landed key a column-0 line start and the
    stream closed there, which is exactly one route: open a fresh `[187]` at the
    landing's width under a bare document (`rootMapRoute`).  That is the
    over-approximation row 19 names — the parser starts no document there — and
    it is what a landed SIBLING was given for want of anything else.

    A park that kept its frames can say more: the landing's width names a level
    that is still open, the entry the key heads is that level's next element,
    and what stands below is either the stream or the enclosing `?` frame's
    value line.  Both faces ride because they are different stacks (item 108),
    and the STREAM face is required inside the left disjunct — `ImplicitKeyPack`
    needs a route whose codomain is the stream, and only the stream-bottomed
    stack has one.  The value face is the twin the `?`'s own `: v` line spends.

    **Item 151: each face carries the landing's own cover.**  The two lists
    below are what the landing RESUMES on, and the pack the consumer builds
    wants exactly those lists covered — so the conjunct stands here in the
    shape the pack field takes, `FrameLevel.map k :: ks` at a floor bounded by every width in
    it.  It is stated at `s_prep` because that is the only state this context
    names; the consumer lifts it across the content dispatch, which writes no
    level.  **Both lanes take the pack's own index `k`**, which is where the
    value lane stops mirroring its parks: the key this landing heads is a
    mapping level of EITHER stack, so nothing is excluded here, where at the
    parks the `?`'s own level is not one of its value-line frames. -/
def ResumeKeyCtx (s_prep : ScannerState) (sp_start sp_prep : SurfPos) : Prop :=
  ((∃ (k : Nat) (ks : List FrameLevel) (sp_land : SurfPos),
      sp_land.col = 0 ∧ SIndent k sp_land sp_prep ∧
      (∀ fr ∈ ks, fr.width < k) ∧
      ((∃ lo : Nat, IndentStackCover.Floor lo k (FrameLevel.map k :: ks) ∧
        IndentStackCover.Covered lo (FrameLevel.map k :: ks) s_prep) ∨ True) ∧
      (∀ sp_end : SurfPos, SCompactMapTail k sp_land sp_end →
        ResumeFrames (SLYamlStream sp_start) ks sp_end) ∧
      ((∃ (nv : Nat) (ksv : List FrameLevel), (∀ fr ∈ ksv, fr.width < k) ∧
        ((∃ lo : Nat, IndentStackCover.Floor lo k (FrameLevel.map k :: ksv) ∧
          IndentStackCover.Covered lo (FrameLevel.map k :: ksv) s_prep) ∨ True) ∧
        ∀ sp_end : SurfPos, SCompactMapTail k sp_land sp_end →
          KeyFrames (ExplValueLine sp_start nv) ksv sp_end) ∨ PackAlt s_prep) ∧
      -- **Item 168: the same landing, bottomed at the enclosing `[183]`.**  A
      -- landing that resumes the level it stands in keeps whatever that level
      -- stands in OPEN, and where the park knew a collection underneath it the
      -- landing still does.  It rides here so the pack the landing builds can
      -- carry the collection across the next `:`, which is what keeps
      -- `- sku: X⏎  qty: 4⏎- sku: Y`'s second `-` an ENTRY.
      --
      -- **Item 169: with the levels below `k` listed, like the two lanes
      -- above.**  What is NOT like them is the test: those resume a level and
      -- so ask for membership; this one is read by a `-`, which closes every
      -- mapping level it crosses — so the landing's own width still has to
      -- MATCH the park's innermost (`resumectx_of_landing` decides it by
      -- equality), and what the list buys is the levels underneath that one.
      ((∃ (ke : Nat) (ksq : List FrameLevel), (∀ fr ∈ ksq, fr.width < k) ∧
        ∀ sp_end : SurfPos, SCompactMapTail k sp_land sp_end →
          ResumeFrames (SeqEntryTail sp_start ke) ksq sp_end) ∨ True)) ∧
    s_prep.simpleKey.possible = true ∧
    s_prep.simpleKey.pos = s_prep.currentPos) ∨ True

/-- Build a `ResumeKeyCtx` from the landing the caller already has in hand
    (item 109).  Unlike `keyctx_of_preprocess` this takes the landing rather
    than re-deriving it: the frames are stated over the park's OWN
    `[79] s-l-comments`, so the `sp_mid` they are spent at has to be the one the
    caller closed with — a second call to `preprocess_some_ssl_comments_anyCol`
    would produce a different witness and the two could not be joined.

    Two of the three punts are `keyctx_of_preprocess`'s own — an inherited stale
    key, and a TAB in the landing's whites (`[63]` wants spaces).  The third is
    this lemma's: a landing width that names NO open level, which is the dedent
    the scanner refuses upstream as `trailingContent`, and which the membership
    test therefore decides per input rather than assuming.

    **Item 151: and the cover rides both faces through.**  The incoming faces
    carry the park's cover over the widths they name, the outgoing context
    wants it over the widths the landing RESUMES on, and that hop is the
    dedent's — `dedent_cover_of_landing`, which this lemma takes as `h_pay`
    rather than performing.  Two reasons it is a parameter and not a proof: the
    scanner facts the hop needs (the stack's two readings, the landing arm's
    floor) are the CALLER's, and quantifying the payer over the list lets one
    argument serve both lanes, whose lists differ.

    **The floor's INDEX is existential on the incoming faces.**  A stream face
    is bounded at its park's index and a value face one column above it (item
    150), and the hop reads neither: `IndentStackCover.Floor.pop_to` spends the
    WIDTHS half alone.  So the two lanes hand `h_pay` the same shape, and the
    index a caller carries is simply forgotten at the door. -/
lemma resumectx_of_landing {sc s_prep : ScannerState} {c : Char}
    {sp_start sp_scan sp_mid sp_prep : SurfPos}
    (hcol_mid : sp_mid.col = 0)
    (h_ws : GStar SSWhite sp_mid sp_prep)
    (h_ssl : SSLComments sp_scan sp_mid)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (h_fS : (∃ ks : List FrameLevel,
        ((∃ lo n : Nat, IndentStackCover.Floor lo n ks ∧
          IndentStackCover.Covered lo ks sc) ∨ True) ∧
        ∀ sp_m : SurfPos, SSLComments sp_scan sp_m →
        ResumeFrames (SLYamlStream sp_start) ks sp_m) ∨ True)
    (h_fV : (∃ (nv : Nat) (ks : List FrameLevel),
        ((∃ lo n : Nat, IndentStackCover.Floor lo n ks ∧
          IndentStackCover.Covered lo ks sc) ∨ True) ∧
        ∀ sp_m : SurfPos, SSLComments sp_scan sp_m →
        KeyFrames (ExplValueLine sp_start nv) ks sp_m) ∨ PackAlt sc)
    (h_pay : ∀ (w : Nat) (ks ks' : List FrameLevel),
        ((∃ lo n : Nat, IndentStackCover.Floor lo n ks ∧
          IndentStackCover.Covered lo ks sc) ∨ True) →
        FrameLevel.map w ∈ ks → ResumeWidths ks ks' w → s_prep.col = w →
        ((∃ lo : Nat, IndentStackCover.Floor lo w (FrameLevel.map w :: ks') ∧
          IndentStackCover.Covered lo (FrameLevel.map w :: ks') s_prep) ∨ True))
    -- **Item 168 — the park's SEQUENCE face, taken to the landing** (LAST, so
    -- the existing call sites keep their argument order).  The test this lane
    -- runs is not membership but EQUALITY: the face names ONE open level, so
    -- the landing either stands at that width and resumes it or stands
    -- somewhere else and the collection is out of reach.  Deciding it here is
    -- what lets the context below be unconditional.
    -- Item 169: the levels below `kk` ride across the test untouched.
    (h_fQ : (∃ (ke kk : Nat) (ksq : List FrameLevel), (∀ fr ∈ ksq, fr.width < kk) ∧
        ∀ sp_m : SurfPos, SSLComments sp_scan sp_m →
        ∀ sp_e : SurfPos, SCompactMapTail kk sp_m sp_e →
        ResumeFrames (SeqEntryTail sp_start ke) ksq sp_e) ∨ True) :
    ResumeKeyCtx s_prep sp_start sp_prep := by
  cases preprocess_some_savedKey_shape h_preprocess with
  | inr _ => exact Or.inr trivial
  | inl h_sk =>
    cases gstar_white_sIndent_or_tab h_ws with
    | inr _ => exact Or.inr trivial
    | inl h_ind0 =>
      obtain ⟨k, h_ind⟩ := h_ind0
      cases h_fS with
      | inr _ => exact Or.inr trivial
      | inl h_fS0 =>
        obtain ⟨ks, h_cvS, fS⟩ := h_fS0
        by_cases hmem : FrameLevel.map k ∈ ks
        · obtain ⟨ks', h_w, cont⟩ := (fS sp_mid h_ssl).resumeAt hmem
          -- Item 151: the landing's width at the SCANNER, which is what the
          -- payer measures its floor against.  `[63] s-indent(k)` off a
          -- column-0 line start puts the key at column `k`, and the step's own
          -- correspondence reads that column off `s_prep`.
          have h_scol : s_prep.col = k := by
            rw [← hcorr_prep.col_eq]
            have := SIndent_col h_ind
            rw [hcol_mid] at this
            omega
          refine Or.inl ⟨⟨k, ks', sp_mid, hcol_mid, h_ind, h_w.lt,
            h_pay k ks ks' h_cvS hmem h_w h_scol, cont, ?_, ?_⟩,
            h_sk.1, h_sk.2⟩
          -- The value face is optional all the way down: the park may carry no
          -- explicit frame, or carry one whose stack this width misses.
          · match h_fV with
            | Or.inl ⟨nv, ksv, h_cvV, fV⟩ =>
              by_cases hmemV : FrameLevel.map k ∈ ksv
              · obtain ⟨ksv', h_wv, contv⟩ := (fV sp_mid h_ssl).resumeAtMap hmemV
                -- Item 151: the membership test and the payment are both taken a
                -- SECOND time, for item 108's reason — the two stacks are
                -- different, so a width can name a level in one and not the other.
                exact Or.inl ⟨nv, ksv', h_wv.lt, h_pay k ksv ksv' h_cvV hmemV h_wv h_scol, contv⟩
              · exact Or.inr trivial
            | Or.inr h_alt => exact Or.inr (PackAlt.step_preprocess h_preprocess h_alt)
          -- **Item 168: the sequence face, and its own test.**  The park names
          -- one open level `kk`; the landing resumes level `k`.  Where they are
          -- the same the face transfers unchanged — the landing's comments are
          -- the face's own `sp_m` — and where they are not, the collection is
          -- reachable only through a stack this lane does not carry.
          · match h_fQ with
            | Or.inl ⟨ke, kk, ksq, h_ltq, fQ⟩ =>
              by_cases hkk : kk = k
              · subst hkk
                exact Or.inl ⟨ke, ksq, h_ltq,
                  fun sp_end h_tail => fQ sp_mid h_ssl sp_end h_tail⟩
              · exact Or.inr trivial
            | Or.inr _ => exact Or.inr trivial
        · exact Or.inr trivial

/-- Build the SUFFIX key context from the landing the caller already has in
    hand (item 117) — `resumectx_of_landing`'s shape with the park's open
    suffix run in the frames' place.  The punts are `keyctx_of_preprocess`'s
    own: an inherited stale key, and a TAB in the landing's whites
    (`[63]` wants spaces). -/
lemma suffixctx_of_landing {sc s_prep : ScannerState} {c : Char}
    {sp_start sp_scan sp_mid sp_prep : SurfPos}
    (hcol_mid : sp_mid.col = 0)
    (h_ws : GStar SSWhite sp_mid sp_prep)
    (h_ssl : SSLComments sp_scan sp_mid)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h_sfx : (∀ sp_m : SurfPos, SSLComments sp_scan sp_m →
        SuffixRun sp_start sp_m) ∨ True) :
    ((∃ (k : Nat) (sp_land : SurfPos),
        sp_land.col = 0 ∧ SuffixRun sp_start sp_land ∧ SIndent k sp_land sp_prep) ∧
      s_prep.simpleKey.possible = true ∧
      s_prep.simpleKey.pos = s_prep.currentPos) ∨ True := by
  cases h_sfx with
  | inr _ => exact Or.inr trivial
  | inl sfx =>
    cases preprocess_some_savedKey_shape h_preprocess with
    | inr _ => exact Or.inr trivial
    | inl h_sk =>
      cases gstar_white_sIndent_or_tab h_ws with
      | inr _ => exact Or.inr trivial
      | inl h_ind0 =>
        obtain ⟨k, h_ind⟩ := h_ind0
        exact Or.inl ⟨⟨k, sp_mid, hcol_mid, sfx sp_mid h_ssl, h_ind⟩, h_sk.1, h_sk.2⟩

/-- **`suffixctx_of_landing`'s MARKER twin** (item 137): the same landing, the
    same three facts, and the marker's own content slot in the suffix run's
    place.  `---⏎a: 1` is one explicit document whose node is the mapping this
    key opens, so the context the cascade prefers is this one. -/
lemma markerctx_of_landing {sc s_prep : ScannerState} {c : Char}
    {sp_start sp_scan sp_mid sp_prep : SurfPos}
    (hcol_mid : sp_mid.col = 0)
    (h_ws : GStar SSWhite sp_mid sp_prep)
    (h_ssl : SSLComments sp_scan sp_mid)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h_mk : (∀ sp_m : SurfPos, SSLComments sp_scan sp_m →
        MarkerNodeRoute sp_start sp_m) ∨ True) :
    ((∃ (k : Nat) (sp_land : SurfPos),
        sp_land.col = 0 ∧ MarkerNodeRoute sp_start sp_land ∧ SIndent k sp_land sp_prep) ∧
      s_prep.simpleKey.possible = true ∧
      s_prep.simpleKey.pos = s_prep.currentPos) ∨ True := by
  cases h_mk with
  | inr _ => exact Or.inr trivial
  | inl mk =>
    cases preprocess_some_savedKey_shape h_preprocess with
    | inr _ => exact Or.inr trivial
    | inl h_sk =>
      cases gstar_white_sIndent_or_tab h_ws with
      | inr _ => exact Or.inr trivial
      | inl h_ind0 =>
        obtain ⟨k, h_ind⟩ := h_ind0
        exact Or.inl ⟨⟨k, sp_mid, hcol_mid, mk sp_mid h_ssl, h_ind⟩, h_sk.1, h_sk.2⟩

/-- **`[188]`'s HEAD, read off the content dispatch that just parked it**
    (items 15–17), with the entry's ROUTE left to the caller (item 38).

    Items 15–17 grew this inside `content_dispatch_after_close`, where the
    route was fixed — a column-0 line start and `[63] s-indent(k)` — so the
    head and the route were written together.  They are independent: `[193]
    ns-s-implicit-yaml-key` and `[194] c-s-implicit-json-key` take no indent at
    all (the spec writes `n/a`), so the reading is the same whether the entry
    is the root mapping's or a compact one's.  Separating them is what lets
    `- a: 1` reuse `a: 1`'s four arms verbatim.

    The last conjunct is the one fact each arm has to supply about the scan it
    just did: whether the dispatch left the SAVED key's position alone.  The
    caller turns it into its own column claim (item 28/29), because what `k`
    is depends on the route.

    **The head is TOTAL** (item 65).  `|` is a node and never a key, and until
    this item that was written as a punt — leaving the `:` step unable to tell
    a block-scalar park from a genuinely missing head.  It is not a punt but a
    REFUTATION, and the guard the caller already passes is what spends it:
    §8.1's body clears the saved key (`scanBlockScalarBody`'s own last line),
    so `s'.simpleKey.possible = true` is false there.  The alias, both quoted
    arms and the plain arm cover everything else, so what the `:`-punt residue
    was missing was never the head. -/
lemma implicitKeyHead_of_dispatch
    (s_prep s' : ScannerState) (c : Char) (sp_prep sp_scan' : SurfPos)
    (h_poss : s'.simpleKey.possible = true)
    (h_kline : s'.simpleKey.pos.line = s'.line)
    (h_sk_pos : s_prep.simpleKey.pos = s_prep.currentPos)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (hcorr_result : ScannerSurfCorr s' sp_scan')
    (hna : c ≠ '&') (hnt : c ≠ '!')
    (h_not_doc : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).col = 0 →
      atDocumentBoundary (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) = false)
    (h_flow_disp : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).inFlow = false)
    (hpeek_disp : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).peek? = some c)
    (h_dispatch : scanNextToken_dispatchContent (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) c = .ok s') :
    ∃ sp_gram, ImplicitKeyHead sp_prep sp_gram ∧ GStar SSWhite sp_gram sp_scan' ∧
      s'.simpleKey.pos = (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).simpleKey.pos := by
  by_cases hc5 : c = '|' ∨ c = '>'
  · exact absurd h_poss
      (by rw [dispatchContent_blockScalar_simpleKey_false hc5 h_dispatch]; simp)
  have hnPipe : c ≠ '|' := fun h => hc5 (Or.inl h)
  have hnGt : c ≠ '>' := fun h => hc5 (Or.inr h)
  by_cases hstar : c = '*'
  · -- `[188]`'s alias head (item 17): `[104] c-ns-alias-node` is
    -- `'*' ns-anchor-name`, and `ns-anchor-char` excludes `s-white` and
    -- `b-char` — an alias CANNOT cross a break, so there is no one-line
    -- reading to prove and no line hypothesis to discharge.  The production is
    -- context-free, so it reads at `.blockKey` directly.
    subst hstar
    obtain ⟨sp_res2, h_al, -, hcorr2⟩ :=
      dispatchContent_alias_prod 0 _ sp_prep .blockKey
        (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_dispatch
    have hsp2 := ScannerSurfCorr_unique hcorr2 hcorr_result
    rw [hsp2] at h_al
    exact ⟨sp_scan', ImplicitKeyHead.json h_al, GStar.nil _,
           by rw [(dispatchContent_alias_simpleKey h_dispatch).1]⟩
  have hnStar : c ≠ '*' := hstar
  -- The coupling chain: the key was saved AT the content start, so the guard's
  -- `pos.line = line` says the scan crossed no break.  Only the key's POSITION
  -- need survive the dispatch — §7.4's own `endLine` bookkeeping on the quoted
  -- branches leaves it alone.
  have h_line_scan : s'.simpleKey.pos = (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).simpleKey.pos →
      s'.line = (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).line := by
    intro hpp
    have h1 : s'.simpleKey.pos.line = s_prep.currentPos.line := by
      rw [hpp, allowDirectives_update_simpleKey, h_sk_pos]
    have h2 : s_prep.currentPos.line = s_prep.line := rfl
    rw [allowDirectives_update_line, ← h2, ← h1]
    exact h_kline.symm
  by_cases hdq : c = '"'
  · -- `[188]`'s JSON arm, double-quoted: the scan ends AT the closing quote,
    -- so the key's trailing `s-white*` slot is empty.
    subst hdq
    obtain ⟨h_pp, h_cond⟩ :=
      dispatchContent_doubleQuoted_key_prod _ sp_prep
        (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_dispatch
    obtain ⟨sp_res2, h_dq, -, hcorr2⟩ := h_cond (h_line_scan h_pp)
    have hsp2 := ScannerSurfCorr_unique hcorr2 hcorr_result
    rw [hsp2] at h_dq
    exact ⟨sp_scan',
           ImplicitKeyHead.json
             (SFlowNode.content 0 .blockKey sp_prep sp_scan'
               (SFlowContent.doubleQ 0 .blockKey sp_prep sp_scan' h_dq)),
           GStar.nil _, h_pp⟩
  · by_cases hsq : c = '\''
    · -- `[188]`'s JSON arm, single-quoted.
      subst hsq
      obtain ⟨h_pp, h_cond⟩ :=
        dispatchContent_singleQuoted_key_prod _ sp_prep
          (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_dispatch
      obtain ⟨sp_res2, h_sq, -, hcorr2⟩ := h_cond (h_line_scan h_pp)
      have hsp2 := ScannerSurfCorr_unique hcorr2 hcorr_result
      rw [hsp2] at h_sq
      exact ⟨sp_scan',
             ImplicitKeyHead.json
               (SFlowNode.content 0 .blockKey sp_prep sp_scan'
                 (SFlowContent.singleQ 0 .blockKey sp_prep sp_scan' h_sq)),
             GStar.nil _, h_pp⟩
    · -- `[188]`'s YAML arm (item 15).
      obtain ⟨h_sk_pres, h_cond⟩ :=
        dispatchContent_plainScalar_key_prod _ sp_prep
          (corr_of_allowDirectives_update hcorr_prep) hpeek_disp h_flow_disp
          hna hnStar hnt hnPipe hnGt hdq hsq h_not_doc h_dispatch
      obtain ⟨sp_gram2, sp_res2, h_ol, h_tws2, -, hcorr2⟩ :=
        h_cond (h_line_scan (by rw [h_sk_pres]))
      have hsp2 := ScannerSurfCorr_unique hcorr2 hcorr_result
      rw [hsp2] at h_tws2
      exact ⟨sp_gram2, ImplicitKeyHead.yaml h_ol, h_tws2, by rw [h_sk_pres]⟩

/-- **The dedent landing's hop on the cover, at a landing already floored**
    (item 151) — the arithmetic `dedent_cover_of_landing` performs, with the
    two escapes that lemma carries taken OUT of it.

    The escapes are about reaching the floor, not about the hop: a caller with
    no measure of its stack, and a park at a line start whose walk armed no
    unwind.  A caller that has discharged both hands the top's bound straight
    in, and gets the payment with no disjunct to case on — which is what the
    resuming key context wants, since a landing that reaches it came off a park
    OFF a line start by that park's own field. -/
lemma dedent_cover_of_floor {s : ScannerState} {lo n w : Nat} {ks ks' : List FrameLevel}
    (h_mono : IndentStackMono.Mono s)
    (h_top : s.currentIndent ≤ (w : Int))
    (h_fl : IndentStackCover.Floor lo n ks)
    (h_cv : IndentStackCover.Covered lo ks s)
    (hmem : FrameLevel.map w ∈ ks)
    (h_w' : ResumeWidths ks ks' w) :
    ∃ lo : Nat, IndentStackCover.Floor lo w (FrameLevel.map w :: ks') ∧
      IndentStackCover.Covered lo (FrameLevel.map w :: ks') s :=
  ⟨lo, h_fl.pop_to hmem h_w'.sub, h_cv.pop_to h_mono h_top h_w'.keep⟩

/-- **The dedent landing's hop on the cover** (item 149) — the payment both
    pack lemmas make at the branch item 148 left punting, written once.

    The park's frames cover the park's stack over the whole of `ks`; the pack
    the landing opens carries the widths the landing RESUMES on, `FrameLevel.map w :: ks'`,
    and `ks'` holds none of the levels above `w`.  Reading the one list as the
    other is not a list fact — it is the landing's own floor: preprocessing's
    unwind stopped at `w`, so the stack it hands the dispatch has nothing above
    `w` left to name, and monotonicity turns that statement about the TOP into
    one about every entry (`IndentStackCover.Covered.pop_to`).  The floor value
    itself does not move — `w` is one of the frames, so the bound the park
    carried already reaches it (`IndentStackCover.Floor.pop_to`).

    Two escapes stay, and both are the caller's to close rather than
    consequences of the reading: a caller that cannot measure its stack
    (`h_cov`), and a park AT a line start, whose walk crossed nothing and so
    armed no unwind (`hc0` — item 147's own residue, at the lane's other
    consumer as well). -/
lemma dedent_cover_of_landing {sc s_prep s' : ScannerState} {c : Char}
    {sp_scan : SurfPos} {n w : Nat} {ks : List FrameLevel}
    (h_cov : (IndentStackMono.Mono sc ∧ IndentStackBase.SentinelBase sc) ∨ True)
    (h_dcov : (∃ lo : Nat, IndentStackCover.Floor lo n ks ∧
      IndentStackCover.Covered lo ks sc) ∨ True)
    (hmem : FrameLevel.map w ∈ ks)
    (h_larm : sp_scan.col ≠ 0 → s_prep.inFlow = false →
      s_prep.simpleKey.possible = true ∧ s_prep.simpleKey.pos.col = s_prep.col ∧
      s_prep.simpleKeyAllowed = true ∧
      (s_prep.currentIndent ≤ (s_prep.col : Int) ∨ s_prep.indents.size ≤ 1))
    (h_scol : s_prep.col = w)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    (h_ind_eq : s'.indents = s_prep.indents)
    (h_noflow : s_prep.inFlow = false)
    (h_cov_step : ∀ (lo : Nat) (ks : List FrameLevel),
      IndentStackCover.Covered lo ks sc → IndentStackCover.Covered lo ks s') :
    ∀ ks' : List FrameLevel, ResumeWidths ks ks' w →
      ((∃ lo : Nat, IndentStackCover.Floor lo w (FrameLevel.map w :: ks') ∧
        IndentStackCover.Covered lo (FrameLevel.map w :: ks') s') ∨ True) := by
  intro ks' h_w'
  rcases h_cov with ⟨h_mono, h_base⟩ | _
  · rcases h_dcov with ⟨lo, h_fl, h_cv⟩ | _
    · by_cases hc0 : sp_scan.col = 0
      · exact Or.inr trivial
      · have h_floor : s_prep.currentIndent ≤ (s_prep.col : Int) :=
          landing_floor_of_arm h_noflow h_larm hc0 h_base h_preprocess
        have h_mono' : IndentStackMono.Mono s' :=
          (IndentStackMono.preprocess_mono h_preprocess h_mono).of_indents_eq h_ind_eq
        have h_top : s'.currentIndent ≤ (w : Int) := by
          rw [currentIndent_of_indents_eq h_ind_eq, ← h_scol]; exact h_floor
        -- Item 151: the hop itself, shared with the resuming key context.
        exact Or.inl (dedent_cover_of_floor h_mono' h_top h_fl
          (h_cov_step lo ks h_cv) hmem h_w')
    · exact Or.inr trivial
  · exact Or.inr trivial

/-- **The implicit-key pack a parked block ENTRY hands its content** — items
    38 and 39's two producers, merged by item 40 into ONE reading of the
    characters with the frame chosen by the branch the landing took.

    Everything about the READING is shared and was shared before the merge: the
    whites in front of the content are `[63] s-indent(w)`, the content is
    `[193]`/`[194]`'s head (`implicitKeyHead_of_dispatch`, unchanged since item
    38), and what the pack owes besides the head is a ROUTE.  What the two
    branches disagree about is only where `w` is measured FROM — which is the
    disjunct `preprocess_some_ssl_comments_anyCol` already returns, so casing on
    it once is the whole of the merge:

    * the step stayed on the LINE (`- a: 1`).  There is no landing and never
      will be — the key shares its line with the `-`, so `[79] s-l-comments` has
      no occurrence to match — and the entry is `[185] s-l+block-indented`'s
      `s-indent(m) ns-l-compact-mapping(n+1+m)`, closing the ENCLOSING entry
      through the closure the pending carries (`compactMapRoute`).  Only a
      pending whose slot is `SBlockIndented` has that alternative, so this
      closure is the optional argument: a `[189]` entry's VALUE is
      `s-l+block-node`, which has no compact alternative at all.
    * the step crossed a BREAK to column 0 (`-⏎  a: 1`, `k:⏎  a: 1`).  Then the
      entry belongs to a mapping nested INSIDE the node the pending awaits, and
      `[199] s-l+block-collection` spends the landing as its own leading
      comments (`valueMapRoute` over `nestedBlockMap`).  Both pendings reach it,
      which is why `h_node` is the argument neither can do without.  The floor
      conjunct is RECOVERED here and punted there, for item 39's reason: a known
      zero is what lets `[63]`'s width be measured.

    **The side condition is decided per INPUT, not per site** (item 40).
    `nestedBlockMap` wants `n ≤ w`, the pending's index below the column the key
    landed at, and both numbers are in hand at the split — so the arm serves
    every landing that nests and defers every DEDENT.  Item 39 read the same
    inequality as a property of the indented ARM and left it punting whole; what
    is permanent is the dedent, not the arm (Reflection 666).  **Items 99, 296
    and 297: the dedent is served too.**  A landing width naming a frame of the
    park's stack resumes there (item 99); a width naming none, and a park
    without frames, key a fresh document at the landing (items 297 and 296) —
    row 19's over-approximation of the sibling reading.

    **What punts, and why each one is a different question** (item 65).  The
    `&`/`!` head is not among them any more: a `[96]` run parks `pendingProps`,
    whose own pack is item 17's, and every caller knows which it dispatched, so
    the two characters are hypotheses rather than a branch.  Nor is the
    block-scalar head: §8.1 clears the saved key, so the guard the consumer
    passes refutes it.  What is left is a TAB in the whites, the DEDENT, and a
    park with no compact frame — `KeyPackPunt`'s three, returned LOCATED so the
    `:` step can tell them apart.  (The inherited stale key was the fourth;
    item 90 reads the save off the park's own flag —
    `preprocess_saved_key_fresh` — so the inherit arm has no inhabitant here.)

    **The tab punt is REACHED** — corrected 2026-09-04 by measurement; this
    docstring used to say §6.1 refuses it first and the branch is unobservable,
    and that is false at THIS step.  `k:⏎␣<TAB>a` is ACCEPTED: preprocessing's
    own §6.1 gate fires only at or left of `currentIndent`, the tab here sits
    past it, and a plain VALUE reads there.  What refuses the KEY form
    `k:⏎␣<TAB>a: 1` is the `:`'s own §6.1 backward scan one step LATER
    (`scanValueIndentTabCheck`, items 31/32) — so the pack punts on an input
    the scanner accepts, and the refutation is the CONSUMER's.  It is spendable
    because the punt now carries that scan's own reading: the tab is located in
    the surface run, `tabRun_scan_of_located` turns it into preprocessing's
    backward scan, and the dispatch moves neither the string nor the saved key's
    offset — so the fact travels to the park as a statement about the run in
    front of `simpleKey.pos`. -/
lemma entryKeyPack_of_dispatch
    (sc : ScannerState) (sp_start sp_scan : SurfPos) (n : Nat)
    (s_prep s' : ScannerState) (c : Char) (sp_prep sp_scan' : SurfPos)
    -- Item 179: `n` is the RAW entry column throughout; the node-domain
    -- hypotheses read at the SHIFTED index `n + 1`, where the awaited
    -- `SBlockNode` now sits.
    (h_node : ∀ sp, SBlockNode (n + 1) .blockIn sp_scan sp → SLYamlStream sp_start sp)
    -- **Item 106 — `h_node`'s VALUE-LINE twin**, for the branch `h_compact`'s
    -- own twin cannot reach.  Where the key LANDS, the entry belongs to a
    -- mapping nested inside the node the pending awaits — the `[199]`
    -- alternative, not the compact one — and when that node is an open `[186]`
    -- explicit KEY the landed `:` still has the frame's own value line to
    -- close (`?⏎  a: b⏎: - w`).  The route is the same `nestedBlockMap` the
    -- branch already builds, ending in this twin instead of in `h_node`.
    -- Callers derive it with `explFrameValueLine`; those whose frame has no
    -- value line pass `Or.inr trivial`.
    (h_nodeV : (∃ ns : List Nat, ∀ nv ∈ ns,
      ∀ sp_m : SurfPos, SBlockNode (n + 1) .blockIn sp_scan sp_m →
      ∀ sp_i sp_c : SurfPos, SIndent nv sp_m sp_i → GLit ':' sp_i sp_c →
      ∀ sp_v : SurfPos, SBlockIndented nv .blockOut sp_c sp_v →
      SLYamlStream sp_start sp_v) ∨ PackAlt sc)
    -- Item 59: the COMPACT frame, with the park's own column beside it.  The
    -- column is what that branch's key needs in order to know its `[187]` entry
    -- index IS the column the scanner pushed its indent at — the conjunct item
    -- 28 had to punt here ("the compact route cannot measure its own column").
    -- Item 79 BUNDLED the two: item 59 asked for them separately and all six
    -- call sites read them off the same field anyway, so the arm that has the
    -- route has the width to measure it against and the key stops punting.
    -- Item 93: …and the frame's VALUE-LINE pack rides as a third conjunct —
    -- given the completed compact content, `s-indent(nv) ':'` and the value
    -- slot still close the enclosing `[188]` explicit entry.  The compact
    -- branch below folds the mapping into it, which is what gives
    -- `ImplicitKeyPack` its twin (`? a: b⏎: - w`).  Callers whose frame has
    -- no value line pass `Or.inr trivial` for it.
    (h_compact : ((∀ sp, SBlockIndented n .blockIn sp_scan sp → SLYamlStream sp_start sp) ∧
      sp_scan.col = n + 1 ∧
      -- Item 196: a CHAIN, in step with the pack conjunct it funds.
      ((∃ ns : List Nat, ∀ nv ∈ ns, ∀ sp : SurfPos, SBlockIndented n .blockIn sp_scan sp →
        ∀ sp_i sp_c : SurfPos, SIndent nv sp sp_i → GLit ':' sp_i sp_c →
        ∀ sp_v : SurfPos, SBlockIndented nv .blockOut sp_c sp_v →
        SLYamlStream sp_start sp_v) ∨ PackAlt sc)) ∨ True)
    -- **Item 101 — the park's own implicit-value stamp**, for the branch
    -- `h_compact` has no frame for.  A `[189]` value slot cannot offer a
    -- compact alternative, so a key on the park's own line punts there; but
    -- the value indicator that opened the slot stamped its line, and §8.2.2
    -- refuses a second value indicator on a stamped line — so the punt names
    -- a REFUTABLE reason rather than an unread input.  The two companions are
    -- the transport: with the entry flag down and a real tail the no-break
    -- landing keeps `s_prep` on the park's line, which is the line the stamp
    -- names.  **Item 125: the other disjunct is the FACE** — `h_compact`'s
    -- own left shape, paid from `pendingMapValue.h_ivl`'s face — so the
    -- same-line branch composes through the compact construction where it
    -- used to punt `noFrame` (that constructor is deleted).  Callers whose
    -- `h_compact` is real pass the same frame here.
    (h_ivl : (sc.implicitValueLine = some sc.line ∧ sc.needIndentCheck = false ∧
      LastTokenReal sc.tokens) ∨
      ((∀ sp, SBlockIndented n .blockIn sp_scan sp → SLYamlStream sp_start sp) ∧
        sp_scan.col = n + 1 ∧
        ((∃ ns : List Nat, ∀ nv ∈ ns, ∀ sp : SurfPos, SBlockIndented n .blockIn sp_scan sp →
          ∀ sp_i sp_c : SurfPos, SIndent nv sp sp_i → GLit ':' sp_i sp_c →
          ∀ sp_v : SurfPos, SBlockIndented nv .blockOut sp_c sp_v →
          SLYamlStream sp_start sp_v) ∨ PackAlt sc)))
    -- Item 99: `h_node`'s RESUME twin — the levels still open once the
    -- awaited node completes (the entry's own level at `n` included, so the
    -- bound is `≤ n`).  The nested branch pays the pack's resume twin from
    -- it whenever the landing is strictly deeper (`n < w`; at `w = n` the
    -- sibling belongs to the level itself, R4's rewiring).  Callers without
    -- frames pass `Or.inr trivial`.
    (h_nodeF : (∃ ks : List FrameLevel, (∀ fr ∈ ks, fr.width ≤ n) ∧
      -- Item 148: the scanner stack under those levels, which the NESTED
      -- branch conses the landed key's own level onto and hands to the pack.
      ((∃ lo : Nat, IndentStackCover.Floor lo n ks ∧
        IndentStackCover.Covered lo ks sc) ∨ True) ∧
      ∀ sp_m : SurfPos, SBlockNode (n + 1) .blockIn sp_scan sp_m →
      ResumeFrames (SLYamlStream sp_start) ks sp_m) ∨ True)
    -- Item 99: the pending's own DEDENT frames — the awaited entry closed
    -- EMPTY on the landing's comments (only the producer holds that entry's
    -- shape), the levels it leaves open standing ready.  This is what the
    -- dedent branch below spends: the landing width pops to its level and
    -- the landed key conses there, which is the parser's own sibling
    -- reading.  Callers without frames pass `Or.inr trivial`.
    (h_dframes : (∃ ks : List FrameLevel,
      -- **Item 149: the cover rides this face too** — `pendingMapValue`'s
      -- `h_frames` verbatim, where item 148 stopped at the relay.  The DEDENT
      -- branch reads its frames here, so this is the only face that can fund
      -- the landing's own hop; `h_nodeF`'s cover is the NESTED branch's and
      -- the two existentials are different lists.
      ((∃ lo : Nat, IndentStackCover.Floor lo n ks ∧
        IndentStackCover.Covered lo ks sc) ∨ True) ∧
      ∀ sp_m : SurfPos, SSLComments sp_scan sp_m →
      ResumeFrames (SLYamlStream sp_start) ks sp_m) ∨ True)
    -- Item 108: the same two faces under an open `[186]` explicit KEY,
    -- bottomed at the frame's value line.  `h_nodeFV` is what the NESTED
    -- branch chains for a deeper landing; `h_dframesV` is what the DEDENT
    -- branch pops, and popping it is what lets that branch hand the pack a
    -- real value-line twin instead of the `Or.inr trivial` item 99 left.
    -- Callers without an explicit frame pass `Or.inr trivial`.
    (h_nodeFV : (∃ (nv : Nat) (ks : List FrameLevel), (∀ fr ∈ ks, fr.width ≤ n) ∧
      -- Item 150: the NESTED branch's value-line cover.
      ((∃ lo : Nat, IndentStackCover.Floor lo (n + 1) ks ∧
        IndentStackCover.Covered lo ks sc) ∨ True) ∧
      ∀ sp_m : SurfPos, SBlockNode (n + 1) .blockIn sp_scan sp_m →
      KeyFrames (ExplValueLine sp_start nv) ks sp_m) ∨ PackAlt sc)
    (h_dframesV : (∃ (nv : Nat) (ks : List FrameLevel),
      -- Item 150: the DEDENT branch's value-line cover — the face whose
      -- landing pays.
      ((∃ lo : Nat, IndentStackCover.Floor lo (n + 1) ks ∧
        IndentStackCover.Covered lo ks sc) ∨ True) ∧
      ∀ sp_m : SurfPos, SSLComments sp_scan sp_m →
      KeyFrames (ExplValueLine sp_start nv) ks sp_m) ∨ PackAlt sc)
    -- **Item 149: the stack's own two readings**, the pair item 147 gave the
    -- indicator lane (`indicator_open_map`'s `h_cov`), now in the CONTENT lane.
    -- Monotone is what turns a top bound into a bound on every entry; based is
    -- what closes `landing_floor_of_arm`'s sentinel escape.  Only the DEDENT
    -- branch reads them, and only to pay `h_dframes`'s cover forward — so a
    -- caller that cannot measure its stack passes `Or.inr trivial` and keeps
    -- the frames it already pays.
    (h_cov : (IndentStackMono.Mono sc ∧ IndentStackBase.SentinelBase sc) ∨ True)
    -- Item 65: the props head is the CALLER's branch, not a punt.
    (hna : c ≠ '&') (hnt : c ≠ '!')
    -- Item 90: the park's own flag (items 34/58) — outside a flow the
    -- save declines only with it down, so the walk saved FRESH.
    (h_ska : sc.simpleKeyAllowed = true)
    (hcorr_prep : ScannerSurfCorr s_prep sp_prep)
    (hcorr_result : ScannerSurfCorr s' sp_scan')
    (h_corr : ScannerSurfCorr sc sp_scan)
    (h_not_doc : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).col = 0 →
      atDocumentBoundary (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) = false)
    (h_flow_disp : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).inFlow = false)
    (h_preprocess : scanNextToken_preprocess sc = .ok (some (s_prep, c)))
    -- Item 340: the park's alternative, carried into the pack the content step builds.
    (h_alt : PackAlt sc)
    (h_dispatch : scanNextToken_dispatchContent (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep) c = .ok s')
    -- **Item 168 — `h_compact`'s SEQUENCE twin** (LAST, so the existing call
    -- sites keep their argument order).  Where the park's awaited node is an
    -- ENTRY of a `[183]`, the entry's own collection is still open underneath
    -- it, and a park that knows so carries the fact already: `pendingBlock`'s
    -- `h_close_entry` and `pendingBlockContent`'s `h_closable_entry` ARE this
    -- face at the park's own width.  Only the COMPACT branch spends it — a
    -- key on the indicator's own line wraps into `[195]` exactly as the route
    -- does, so the same `SBlockIndented.compactMap` serves both and the twin
    -- costs one more application.  The landed branches punt: their key belongs
    -- to a mapping nested in the awaited node, whose own collection this face
    -- does not name.
    (h_nodeS : (∃ ke : Nat, ∀ sp : SurfPos, SBlockIndented n .blockIn sp_scan sp →
      SeqEntryTail sp_start ke sp) ∨ True)
    -- **Item 169 — `h_nodeS`'s LANDED twin** (LAST, so the existing call sites
    -- keep their argument order), and it is `h_nodeF` on the sequence lane.
    -- Item 168 read the corpus's dedenting landings by DROP DEPTH and paid the
    -- one branch that depth named; what it did not read is the entry HEAD, and
    -- the two are independent.  A `-` whose node begins on the NEXT line
    -- (`-⏎  a: 1⏎  b: 2⏎- c`) has no compact alternative to wrap — `[185]`
    -- reaches its mapping through `s-l+block-node`, so the key LANDS — and a
    -- `pendingMapValue` whose value is itself a mapping (`- step:⏎    x: 1`)
    -- lands one level deeper again.  Both are this branch, and both are
    -- `nestedBlockMap` composed against the caller's own face, exactly as item
    -- 99 composes `h_nodeF`.
    --
    -- The frames are what make it one parameter instead of two: a park at the
    -- entry's own level pays `ks = []` off its `h_close_entry`, and a
    -- `pendingMapValue` at level `n` pays `FrameLevel.map n :: ks` off its `h_seqF` — the
    -- level its own entry leaves tail-open behind the value.  `≤ n` (not
    -- `< n`) because that list includes `n` itself.
    (h_nodeSF : (∃ (ke : Nat) (ks : List FrameLevel), (∀ fr ∈ ks, fr.width ≤ n) ∧
      ∀ sp_m : SurfPos, SBlockNode (n + 1) .blockIn sp_scan sp_m →
      ResumeFrames (SeqEntryTail sp_start ke) ks sp_m) ∨ True) :
    s'.simpleKey.possible = true → s'.simpleKey.pos.line = s'.line →
      ImplicitKeyPack s' sp_start sp_scan' ∨ KeyPackPunt s' := by
  intro h_poss h_kline
  by_cases hbs : c = '|' ∨ c = '>'
  · -- Item 65: not a punt.  §8.1's body clears the saved key, so the guard the
    -- consumer passes is already false at a block-scalar park.
    exact absurd h_poss
      (by rw [dispatchContent_blockScalar_simpleKey_false hbs h_dispatch]; simp)
  have hnPipe : c ≠ '|' := fun h => hbs (Or.inl h)
  have hnGt : c ≠ '>' := fun h => hbs (Or.inr h)
  have hpeek_disp : (if s_prep.allowDirectives then
          { s_prep with allowDirectives := false, documentEverStarted := true }
        else s_prep).peek? = some c := by
    have := preprocess_some_peek h_preprocess
    split
    · show s_prep.peek? = some c; exact this
    · exact this
  -- Item 90: the save is FRESH — every producer's park carries the flag
  -- up, so the shape lemma's inherit arm has no inhabitant here and the
  -- `staleKey` punt no producer.
  have h_sk : s_prep.simpleKey.possible = true ∧
      s_prep.simpleKey.pos = s_prep.currentPos :=
    preprocess_saved_key_fresh h_ska
      (by revert h_flow_disp; split <;> (intro h; exact h)) h_preprocess
  -- **Item 148: the caller's stack, stepped to this park.**  Preprocessing
  -- only pops and a content dispatch writes no indent, so a cover of the
  -- incoming stack is a cover of the key's.
  have h_cov_step : ∀ (lo : Nat) (ks : List FrameLevel),
      IndentStackCover.Covered lo ks sc → IndentStackCover.Covered lo ks s' :=
    fun lo ks hc =>
      IndentStackCover.dispatchContent_cover h_dispatch
        ((IndentStackCover.preprocess_cover h_preprocess hc).of_indents_eq
          (by split <;> rfl))
  obtain ⟨sp_mid, sp_ws, sp_prep2, h_disj, h_ws, _h_cmt, hcorr_prep2, h_pk, _⟩ :=
    preprocess_some_ssl_comments_anyCol sc sp_scan s_prep c h_corr h_preprocess
  have hsp_eq2 := ScannerSurfCorr_unique hcorr_prep hcorr_prep2
  have h_eq : sp_prep2 = sp_ws := by
    cases h_pk with
    | inl h => exact h
    | inr h => rw [preprocess_some_peek h_preprocess] at h; cases h
  have h_pe : sp_prep = sp_ws := hsp_eq2.trans h_eq
  rw [← h_pe] at h_ws
  -- The reading, taken ONCE: `[63] s-indent(w)` in front of the content, and
  -- the content read back as `[188]`'s key head.  Neither mentions the frame.
  cases gstar_white_sIndent_or_tab h_ws with
  | inr htab =>
    -- Item 65: the tab is LOCATED, and what locates it for the consumer is
    -- the `:`'s own backward scan — which walks from the KEY's offset, where
    -- preprocessing saved it, and which the dispatch moved neither the
    -- string nor the position of.  Item 289: the guard's two facts ride
    -- along, for the consumer whose field is not stated under it.
    refine Or.inr (KeyPackPunt.tab ?_
      (StaleNodeTail.toStalePark <|
       staleNodeTail_of_dispatchContent_value h_dispatch hna hnt hnPipe hnGt
        (by split <;>
          exact nic_false_of_flow_disp (sc := sc) (s_prep := s_prep) h_preprocess h_flow_disp))
      h_poss h_kline)
    have hsuf : sp_mid.chars <:+ s_prep.input.toList := by
      rw [preprocess_input h_preprocess]
      rcases h_disj with h | h
      · exact (sslComments_suffix h.1).trans (corr_chars_suffix h_corr)
      · rw [h.1]; exact corr_chars_suffix h_corr
    have h_run : s_prep.hasTabInPrecedingWhitespace = true :=
      tabRun_scan_of_located hcorr_prep hsuf htab
    have h_facts := dispatchContent_value_key_facts h_dispatch hna hnt hnPipe hnGt
    have h_pos : s'.simpleKey.pos = s_prep.simpleKey.pos := by
      rw [h_facts.1.2.2, allowDirectives_update_simpleKey]
    have h_inp : s'.input = s_prep.input := by
      rw [dispatchContent_input (corr_of_allowDirectives_update hcorr_prep) h_dispatch]
      split <;> rfl
    unfold ScannerState.hasTabInPrecedingWhitespace at h_run
    rw [h_inp, h_pos, h_sk.2]
    exact h_run
  | inl h_ind0 =>
    obtain ⟨w, h_ind⟩ := h_ind0
    · obtain ⟨sp_gram2, h_ol, h_tws2, h_pp⟩ :=
        implicitKeyHead_of_dispatch s_prep s' c sp_prep sp_scan' h_poss h_kline h_sk.2
          hcorr_prep hcorr_result hna hnt h_not_doc h_flow_disp hpeek_disp h_dispatch
      cases h_disj with
      | inl h_land =>
        -- Across a break: the entry is `[187]`'s at the landing's own width,
        -- inside the node this pending awaits.  The side condition is
        -- `nestedBlockMap`'s and it is decidable here, so the DEDENT ~~defers~~
        -- takes the branch below and nothing else does (item 40).  Item 179: the bound is STRICT —
        -- the awaited node reads at `n + 1`, so a landing AT the entry's own
        -- column joins the dedent branch (R4's rewiring, as `h_nodeF`'s
        -- docstring has said since item 99).
        by_cases hnw : n + 1 ≤ w
        · have h_ind' : SIndent w sp_mid sp_prep := h_ind
          -- The floor conjunct, recovered: the landing is at column 0 and the
          -- save is fresh at the content, so the column the `:` will push its
          -- mapping indent at is the index this pack carries (items 28/29).
          have h_kcol : s'.simpleKey.pos.col = w := by
            rw [h_pp, allowDirectives_update_simpleKey, h_sk.2]
            show s_prep.col = w
            rw [← hcorr_prep.col_eq]
            have := SIndent_col h_ind'
            rw [h_land.2.1] at this
            omega
          exact Or.inl ⟨w, sp_prep, sp_gram2,
                        valueMapRoute hnw h_node h_land.1 h_ind', h_ol, h_tws2, h_kcol,
                        -- ~~Item 93: the landed key belongs to a mapping
                        -- nested in a `[199] s-l+block-node` slot — no
                        -- compact alternative, so no frame twins it (the map
                        -- face of item 92's seq-spaces residue).~~  The slot
                        -- has no compact alternative and never will, but the
                        -- FRAME is not the slot: item 106 reads it one level
                        -- up.  The `[199]` nesting is the `?`'s KEY, so the
                        -- landed `:` still owes `s-indent(n) ':'` and the
                        -- value — `h_nodeV` — and the route is the same
                        -- `nestedBlockMap` the entry route above takes
                        -- (`?⏎  a: b⏎: - w`, `?⏎  "a": b⏎: c: d`).
                        -- Item 196: the nesting is the same for every ancestor
                        -- — only the index of the `:` line that follows it
                        -- differs — so the whole chain rides one term, as at
                        -- `question_open_map`'s entry route.
                        (match h_nodeV with
                         | Or.inl ⟨ns, nodeV⟩ => Or.inl ⟨ns, fun nv hmem =>
                             fun sp_v h_entry sp_e h_tail sp_i sp_c h_iv h_lit sp_w h_sbi =>
                               nodeV nv hmem sp_e
                                 (nestedBlockMap hnw h_land.1
                                   (SBlockMapEntries_of_compactTail h_ind' h_entry h_tail))
                                 sp_i sp_c h_iv h_lit sp_w h_sbi⟩
                         | Or.inr h => Or.inr (PackAlt.step_content h_preprocess h_dispatch h)),
                        -- Item 99: the nested mapping's resume twin — the
                        -- entry and tail close the mapping the caller's node
                        -- awaits, and the caller's own frames (`h_nodeF`)
                        -- carry on below it.  Only the strictly-deeper
                        -- landing pays (`n < w`): at `w = n` the levels
                        -- include `w` itself and the sibling belongs there.
                        if hlt : n < w then
                          match h_nodeF with
                          | Or.inl ⟨ks, h_le, h_cov, nodeF⟩ => Or.inl ⟨ks,
                              fun k' hk' => Nat.lt_of_le_of_lt (h_le k' hk') hlt,
                              -- **Item 148: the chain's hop.**  The landed key
                              -- opens its level at the `:` still to come, so
                              -- its width joins the frames for free and the
                              -- floor stays where the caller put it — strictly
                              -- left of `w`, since `n < w` here.
                              h_cov.imp (fun ⟨lo, hb, hc⟩ =>
                                ⟨lo, (hb.mono_index (Nat.le_of_lt hlt)).cons
                                    (Nat.le_of_lt (Nat.lt_of_le_of_lt hb.1 hlt)),
                                  (h_cov_step lo ks hc).cons w⟩) id,
                              fun sp_v h_entry sp_e h_tail =>
                                nodeF sp_e (nestedBlockMap hnw h_land.1
                                  (SBlockMapEntries_of_compactTail h_ind' h_entry h_tail))⟩
                          | Or.inr _ => Or.inr trivial
                        else Or.inr trivial,
                        -- Item 108: the value-line-bottomed stack chains the
                        -- same way and for the same reason — the entry and
                        -- tail close the nested mapping, and what stands below
                        -- it is the `?` frame's own unpaid value line rather
                        -- than the finished stream.
                        if hlt : n < w then
                          match h_nodeFV with
                          | Or.inl ⟨nv, ks, h_le, h_covV, nodeFV⟩ => Or.inl ⟨nv, ks,
                              fun k' hk' => Nat.lt_of_le_of_lt (h_le k' hk') hlt,
                              -- **Item 150: the value lane's own hop.**  Same
                              -- move as the stream lane's above; what differs is
                              -- the floor's index, which stands one column above
                              -- the park (`n + 1`) because the `?`'s own level is
                              -- not a frame.  `n < w` carries it either way.
                              h_covV.imp (fun ⟨lo, hb, hc⟩ =>
                                ⟨lo, (hb.mono_index hlt).cons (Nat.le_trans hb.1 hlt),
                                  (h_cov_step lo ks hc).cons w⟩) id,
                              fun sp_v h_entry sp_e h_tail =>
                                nodeFV sp_e (nestedBlockMap hnw h_land.1
                                  (SBlockMapEntries_of_compactTail h_ind' h_entry h_tail))⟩
                          | Or.inr h => Or.inr (PackAlt.step_content h_preprocess h_dispatch h)
                        else Or.inr (PackAlt.step_content h_preprocess h_dispatch h_alt),
                        -- **Item 169: the sequence face, on the branch item 168
                        -- could not reach.**  Same composition as the two lanes
                        -- above — the landed entry and its tail close the
                        -- mapping the caller's node awaits, and what stands
                        -- below it is the enclosing `[183]`'s remaining tail
                        -- rather than the stream or a value line.  It is what
                        -- carries `-⏎  a: 1⏎  b: 2⏎- c` (the entry head with no
                        -- compact alternative) and `- step:⏎    x: 1⏎- …` (a
                        -- value that is itself a mapping); item 168 reached
                        -- neither.  `n < w` for item 99's reason: at `w = n`
                        -- the caller's own level IS this one.
                        if hlt : n < w then
                          match h_nodeSF with
                          | Or.inl ⟨ke, ks, h_le, nodeSF⟩ => Or.inl ⟨ke, ks,
                              fun k' hk' => Nat.lt_of_le_of_lt (h_le k' hk') hlt,
                              fun sp_v h_entry sp_e h_tail =>
                                nodeSF sp_e (nestedBlockMap hnw h_land.1
                                  (SBlockMapEntries_of_compactTail h_ind' h_entry h_tail))⟩
                          | Or.inr _ => Or.inr trivial
                        else Or.inr trivial⟩
        · -- Item 99: the DEDENT composed.  The landing under-ran the awaited
          -- node's index, so the entry it opens is a SIBLING at an enclosing
          -- mapping level: the pending's frames close the awaited entry
          -- empty, the landing width pops to its own level, and the key
          -- conses there — `k:⏎  :⏎b: 2` reads as ONE outer mapping.  A
          -- width naming no frame keys a fresh document at the landing too
          -- (item 297; where the frames cover the stack the scanner refuses
          -- that landing as `trailingContent`), as does a caller without
          -- frames (item 296).
          rcases h_dframes with ⟨ks, h_dcov, dframes⟩ | _
          · by_cases hmem : FrameLevel.map w ∈ ks
            · have h_ind' : SIndent w sp_mid sp_prep := h_ind
              have h_scol : s_prep.col = w := by
                rw [← hcorr_prep.col_eq]
                have := SIndent_col h_ind'
                rw [h_land.2.1] at this
                omega
              have h_kcol : s'.simpleKey.pos.col = w := by
                rw [h_pp, allowDirectives_update_simpleKey, h_sk.2]
                exact h_scol
              -- **Item 149: the landing's own hop, paid** — taken here, before
              -- the pop, because it is stated over the CALLER's `ks` and the
              -- pack's field wants it over the list the landing resumes on.
              -- `dedent_cover_of_landing` carries the whole cost; the pack's
              -- resume twin below is the one field that spends it.
              have h_pay : ∀ ks' : List FrameLevel, ResumeWidths ks ks' w →
                  ((∃ lo : Nat, IndentStackCover.Floor lo w (FrameLevel.map w :: ks') ∧
                    IndentStackCover.Covered lo (FrameLevel.map w :: ks') s') ∨ True) :=
                dedent_cover_of_landing h_cov h_dcov hmem h_land.2.2.2 h_scol
                  h_preprocess
                  (by
                    rw [IndentStackBase.dispatchContent_preserves_indents h_dispatch]
                    split <;> rfl)
                  (by revert h_flow_disp; split <;> (intro h; exact h)) h_cov_step
              -- **Item 150: the same payment, for the value-line stack.**  The
              -- list is the only thing that differs — `dedent_cover_of_landing`
              -- reads `Floor`'s WIDTHS half and never its index, so the lane's
              -- higher floor index rides through untouched — and the list is
              -- bound inside the match below, so the payment is taken as a
              -- function OF it.
              have h_payV : ∀ ksV : List FrameLevel,
                  ((∃ lo : Nat, IndentStackCover.Floor lo (n + 1) ksV ∧
                    IndentStackCover.Covered lo ksV sc) ∨ True) → FrameLevel.map w ∈ ksV →
                  ∀ ks' : List FrameLevel, ResumeWidths ksV ks' w →
                    ((∃ lo : Nat, IndentStackCover.Floor lo w (FrameLevel.map w :: ks') ∧
                      IndentStackCover.Covered lo (FrameLevel.map w :: ks') s') ∨ True) :=
                fun _ h_cv hmemV =>
                  dedent_cover_of_landing h_cov h_cv hmemV h_land.2.2.2 h_scol
                    h_preprocess
                    (by
                      rw [IndentStackBase.dispatchContent_preserves_indents h_dispatch]
                      split <;> rfl)
                    (by revert h_flow_disp; split <;> (intro h; exact h)) h_cov_step
              obtain ⟨ks', h_w', cont'⟩ :=
                (dframes sp_mid h_land.1).resumeAt hmem
              -- ═══ Item 108: the frame the landing keeps.  Item 99 paid the
              -- ROUTE here and handed the pack `Or.inr trivial` for its
              -- value-line twin, because `ResumeFrames` bottomed at the fused
              -- stream and a stack closed to a stream has no `?` left in it.
              -- With the bottom a parameter the SAME pop runs on the
              -- value-line-bottomed stack, and closing it lands on
              -- `s-indent(nv) ':'` still owed — so a dedent sibling INSIDE an
              -- explicit key keeps the key open (`?⏎  a:⏎    b:⏎  c: 2⏎: - w`).
              -- The two stacks pop independently: a landing width can name a
              -- level in one and not the other (the stream stack carries the
              -- levels the `?` entry itself sits in), so the membership test is
              -- taken twice and the value-line face falls back to the punt
              -- item 99 always paid. ═══
              exact Or.inl ⟨w, sp_prep, sp_gram2,
                fun sp_v h_entry =>
                  (cont' sp_v (SCompactMapTail.cons w sp_mid sp_prep sp_v sp_v
                    h_ind' h_entry (SCompactMapTail.nil w sp_v))).close,
                h_ol, h_tws2, h_kcol,
                -- Item 196: the value-line FACE still bottoms at one index —
                -- `ExplValueLine sp_start nv` names it — so this lane answers
                -- with the one-element chain rather than with a list it has no
                -- second member for.
                (match h_dframesV with
                 | Or.inl ⟨nv, ksV, h_covV, dframesV⟩ =>
                     if hmemV : FrameLevel.map w ∈ ksV then
                       match (dframesV sp_mid h_land.1).resumeAtMap hmemV with
                       | ⟨_, _, contV⟩ => Or.inl ⟨[nv], frameChainOne (a := nv)
                           (fun sp_v h_entry sp_e h_tail sp_i sp_c h_iv h_lit sp_w h_sbi =>
                             (contV sp_e (SCompactMapTail.cons w sp_mid sp_prep sp_v sp_e
                               h_ind' h_entry h_tail)).close sp_i sp_c h_iv h_lit sp_w h_sbi)⟩
                     else Or.inr (PackAlt.step_content h_preprocess h_dispatch h_alt)
                 | Or.inr h => Or.inr (PackAlt.step_content h_preprocess h_dispatch h)),
                Or.inl ⟨ks', h_w'.lt,
                  -- ~~Item 148: the landing's own hop is the one that does not
                  -- come free.~~  **Item 149 pays it.**  The level the landing
                  -- popped TO is still on the scanner's stack, so the cover
                  -- here is over `FrameLevel.map w :: ks'` while the caller's is over the
                  -- whole of `ks` — and `ks'` drops every width above `w`.
                  -- What reads the one as the other is the landing's own
                  -- FLOOR: the unwind stopped at `w`, so nothing above it is
                  -- left to name.
                  h_pay ks' h_w',
                  fun sp_v h_entry sp_e h_tail =>
                    cont' sp_e (SCompactMapTail.cons w sp_mid sp_prep sp_v sp_e
                      h_ind' h_entry h_tail)⟩,
                -- Item 108: and the popped value-line stack rides on, so a
                -- SECOND dedent sibling at the same level composes the same way.
                (match h_dframesV with
                 | Or.inl ⟨nv, ksV, h_covV, dframesV⟩ =>
                     if hmemV : FrameLevel.map w ∈ ksV then
                       match (dframesV sp_mid h_land.1).resumeAtMap hmemV with
                       | ⟨ksV', h_wV', contV⟩ => Or.inl ⟨nv, ksV', h_wV'.lt,
                           -- **Item 150: the value lane's landing pays too.**
                           -- The same pop, the same floor, the same lemma — what
                           -- the two lanes do NOT share is the list, so the
                           -- membership test and the payment are both taken
                           -- twice.
                           h_payV ksV h_covV hmemV ksV' h_wV',
                           fun sp_v h_entry sp_e h_tail =>
                             contV sp_e (SCompactMapTail.cons w sp_mid sp_prep sp_v sp_e
                               h_ind' h_entry h_tail)⟩
                     else Or.inr (PackAlt.step_content h_preprocess h_dispatch h_alt)
                 | Or.inr h => Or.inr (PackAlt.step_content h_preprocess h_dispatch h)), Or.inr trivial⟩
            · -- **Item 297: a width naming no frame keys a fresh document at the
              -- landing too**, with the frameless exit's terms (item 296): the
              -- park's own `h_node` closes the awaited entry empty, so the
              -- stream stands at the landing.  Where the frames cover the
              -- scanner's stack the scanner refuses this landing
              -- (`trailingContent`, `k:⏎  a:⏎ b: 2`, measured at item 296), so
              -- the reading is spent on no input there; where they do not —
              -- the fresh document's own `[w]` frames carry no cover —
              -- `k:⏎  ? a⏎  :⏎  b:⏎d: 3` is accepted, and `d` keys a document
              -- where the sibling reading conses at `k`'s level.  Both halves
              -- are row 19's: the refused one to refute, the accepted one to
              -- refine.
              have h_kcol : s'.simpleKey.pos.col = w := by
                rw [h_pp, allowDirectives_update_simpleKey, h_sk.2]
                show s_prep.col = w
                rw [← hcorr_prep.col_eq]
                have := SIndent_col h_ind
                rw [h_land.2.1] at this
                omega
              have h_stream_mid : SLYamlStream sp_start sp_mid :=
                h_node sp_mid (SBlockNode.emptyNode (n + 1) .blockIn sp_scan sp_mid h_land.1)
              exact Or.inl ⟨w, sp_prep, sp_gram2,
                rootMapRoute_or_refused (sc := sc) (s_prep := s_prep) (c := c) (Or.inr trivial)
                  h_land.2.1 h_stream_mid h_ind, h_ol, h_tws2, h_kcol,
                Or.inr (PackAlt.step_content h_preprocess h_dispatch h_alt),
                Or.inl ⟨[], fun _ h => absurd h (List.not_mem_nil), Or.inr trivial,
                  rootMapRouteF_or_refused (sc := sc) (s_prep := s_prep) (c := c) (Or.inr trivial)
                    h_land.2.1 h_stream_mid h_ind⟩,
                Or.inr (PackAlt.step_content h_preprocess h_dispatch h_alt), Or.inr trivial⟩
          · -- **Item 296: a caller WITHOUT frames keys a fresh document at the
            -- landing.**  The pop spends the frames on one thing, the awaited
            -- entry's EMPTY close, and the park's own `h_node` has it:
            -- `[189]`'s `e-node` value (`SBlockNode.emptyNode`, the term
            -- `PendingNode.close_with_ssl` closes both parks with).  So the
            -- stream stands at the landing, and `rootMapRoute_or_refused` keys
            -- the entry as a new document's root mapping (`? a⏎:⏎b: 1`, whose
            -- explicit `:` builds its park without frames).  Its `h_ref` is
            -- declined: a landing that dedents emits a `blockEnd` first, which
            -- completes no value, so §9.2's check stands aside.  That is row 19's
            -- over-approximation, the reading every landing no face claims
            -- takes (item 295's under-run open); the sibling reading is the
            -- frames', and paying them is row 19's.
            have h_kcol : s'.simpleKey.pos.col = w := by
              rw [h_pp, allowDirectives_update_simpleKey, h_sk.2]
              show s_prep.col = w
              rw [← hcorr_prep.col_eq]
              have := SIndent_col h_ind
              rw [h_land.2.1] at this
              omega
            have h_stream_mid : SLYamlStream sp_start sp_mid :=
              h_node sp_mid (SBlockNode.emptyNode (n + 1) .blockIn sp_scan sp_mid h_land.1)
            exact Or.inl ⟨w, sp_prep, sp_gram2,
              rootMapRoute_or_refused (sc := sc) (s_prep := s_prep) (c := c) (Or.inr trivial)
                h_land.2.1 h_stream_mid h_ind, h_ol, h_tws2, h_kcol,
              Or.inr (PackAlt.step_content h_preprocess h_dispatch h_alt),
              -- The fresh document's root level is the key's own, so the park
              -- made after its value resumes it (`ks = []`, nothing below).
              Or.inl ⟨[], fun _ h => absurd h (List.not_mem_nil), Or.inr trivial,
                rootMapRouteF_or_refused (sc := sc) (s_prep := s_prep) (c := c) (Or.inr trivial)
                  h_land.2.1 h_stream_mid h_ind⟩,
              Or.inr (PackAlt.step_content h_preprocess h_dispatch h_alt), Or.inr trivial⟩
      | inr h_mid =>
        -- On the line: `[195]`, closing the enclosing entry.  ═══ Item 125:
        -- the frame is `h_compact`'s or the field's own FACE — a park with
        -- neither carries the stamp, so the split below is total and the
        -- frameless punt (`KeyPackPunt.noFrame`, deleted) has no arm left.
        have h_split : ((∀ sp, SBlockIndented n .blockIn sp_scan sp →
            SLYamlStream sp_start sp) ∧ sp_scan.col = n + 1 ∧
            ((∃ ns : List Nat, ∀ nv ∈ ns, ∀ sp : SurfPos, SBlockIndented n .blockIn sp_scan sp →
              ∀ sp_i sp_c : SurfPos, SIndent nv sp sp_i → GLit ':' sp_i sp_c →
              ∀ sp_v : SurfPos, SBlockIndented nv .blockOut sp_c sp_v →
              SLYamlStream sp_start sp_v) ∨ PackAlt sc)) ∨
            (sc.implicitValueLine = some sc.line ∧ sc.needIndentCheck = false ∧
              LastTokenReal sc.tokens) :=
          match h_compact with
          | Or.inl h_cp => Or.inl h_cp
          | Or.inr _ =>
            match h_ivl with
            | Or.inl h_stamp => Or.inr h_stamp
            | Or.inr h_face => Or.inl h_face
        cases h_split with
        | inr h_stamp =>
          -- ═══ Item 101: no frame — the park is an IMPLICIT value slot: its
          -- indicator stamped its line, and the stamp travels: the content
          -- scan between the value indicator and this park is not
          -- `scanValue`, so it left the field alone, and the no-break landing
          -- keeps the park on the stamped line. ═══
          obtain ⟨h_ivl0, h_nic0, h_real0⟩ := h_stamp
          -- The park's line is the preprocessing's (no break crossed) and the
          -- preprocessing's is the value indicator's.
          have h_line_pp : s_prep.line = sc.line := (h_mid.2.1 h_nic0 h_real0).1
          have h_line_s' : s'.line = s_prep.line := by
            have h := h_kline
            rw [h_pp, allowDirectives_update_simpleKey, h_sk.2] at h
            exact h.symm
          have h_ivl_disp : (if s_prep.allowDirectives then
              { s_prep with allowDirectives := false, documentEverStarted := true }
            else s_prep).implicitValueLine = s_prep.implicitValueLine := by
            split <;> rfl
          have h_stamp' : s'.implicitValueLine = some s'.line := by
            rw [dispatchContent_implicitValueLine h_dispatch,
                h_ivl_disp, preprocess_preserves_implicitValueLine sc s_prep c h_preprocess,
                h_ivl0, h_line_s', h_line_pp]
          exact Or.inr (KeyPackPunt.implicitValue h_stamp' h_kline
            (StaleNodeTail.toStalePark <|
             staleNodeTail_of_dispatchContent_value h_dispatch hna hnt hnPipe hnGt
              (by split <;>
                exact nic_false_of_flow_disp (sc := sc) (s_prep := s_prep) h_preprocess h_flow_disp)))
        | inl h_cp =>
          have h_ind' : SIndent w sp_scan sp_prep := by
            rw [← h_mid.1]; exact h_ind
          -- Item 59: the column conjunct item 28 had to punt here.  The park
          -- is one past the indicator, the key is `s-indent(w)` past the
          -- park, and the entry index is `n + 1 + w` — the same number.
          -- Item 79: the width travels WITH the route, so this is a
          -- measurement rather than a second option.
          have h_kcol : s'.simpleKey.pos.col = n + 1 + w := by
            rw [h_pp, allowDirectives_update_simpleKey, h_sk.2]
            show s_prep.col = n + 1 + w
            rw [← hcorr_prep.col_eq]
            have := SIndent_col h_ind'
            rw [h_cp.2.1] at this
            omega
          exact Or.inl ⟨n + 1 + w, sp_prep, sp_gram2,
                        compactMapRoute h_cp.1 h_ind', h_ol, h_tws2, h_kcol,
                        -- Item 93: the frame's value line, the entry and its
                        -- tail folded into the same `[195]` wrap the route
                        -- builds — this is `ImplicitKeyPack`'s twin's one
                        -- real producer (`? a: b⏎: - w`, `? - a: 1⏎: - w`).
                        -- Item 196: the `[195]` wrap is the same for every
                        -- ancestor, so the chain rides it whole.
                        match h_cp.2.2 with
                        | Or.inl ⟨ns, kslot⟩ => Or.inl ⟨ns, fun nv hmem =>
                            fun sp_v h_entry sp_e h_tail sp_i sp_c h_iv h_lit sp_w h_sbi =>
                              kslot nv hmem sp_e
                                (SBlockIndented.compactMap n .blockIn w sp_scan sp_prep sp_e
                                  h_ind'
                                  (SCompactMap.mk (n + 1 + w) sp_prep sp_v sp_e h_entry h_tail))
                                sp_i sp_c h_iv h_lit sp_w h_sbi⟩
                        | Or.inr h => Or.inr (PackAlt.step_content h_preprocess h_dispatch h),
                        -- Item 99: a compact key's levels are fused into the
                        -- enclosing entry's closure — its dedent is a named
                        -- residue.  Item 108: and so is its value line's.
                        Or.inr trivial, Or.inr (PackAlt.step_content h_preprocess h_dispatch h_alt),
                        -- **Item 168: the sequence face, paid.**  The entry and
                        -- its tail are the `[195]` the route wraps; what differs
                        -- is where the wrap lands — `h_nodeS` stops at the
                        -- enclosing `[183]`'s own remaining tail where
                        -- `h_cp.1` runs on to the stream.  This is the step
                        -- `- sku: BL394D⏎  …⏎- sku: BL4438H` needs in order to
                        -- read its second `-` as the collection's next entry.
                        --
                        -- Item 169: `ks = []`.  A compact key's own level is
                        -- the entry's first, so there is no mapping level
                        -- between it and the collection — the frames bottom
                        -- out immediately and `ResumeFrames.bottom` is the
                        -- whole of the wrap.
                        (match h_nodeS with
                         | Or.inl ⟨ke, nodeS⟩ => Or.inl ⟨ke, [], by simp,
                             fun sp_v h_entry sp_e h_tail =>
                               ResumeFrames.bottom sp_e
                                 (nodeS sp_e
                                   (SBlockIndented.compactMap n .blockIn w sp_scan sp_prep sp_e
                                     h_ind'
                                     (SCompactMap.mk (n + 1 + w) sp_prep sp_v sp_e
                                       h_entry h_tail)))⟩
                         | Or.inr _ => Or.inr trivial)⟩

/-- **The props-key pack a parked block ENTRY hands the run it just scanned**
    (item 41) — `entryKeyPack_of_dispatch` with the head removed and the run put
    in its place.

    The two lemmas read the same characters for the same purpose and share the
    whole of the FRAME reasoning: the whites in front of the property are
    `[63] s-indent(w)`, and where `w` is measured from is the disjunct
    `preprocess_some_ssl_comments_anyCol` already returns — on the line, `[195]
    ns-l-compact-mapping` closing the enclosing entry (`- &p a: 1`); across a
    break to column 0, `[187] l+block-mapping` nested inside the node the pending
    awaits (`-⏎  &p a: 1`, `k:⏎  &p a: 1`).  `h_compact` is the frame only a
    pending whose slot is `SBlockIndented` can offer, and the `n ≤ w` side
    condition is decided HERE, per input, so a dedent ~~defers~~ takes the
    dedent branch and nothing else does (Reflection 666; the branch serves it —
    items 99, 296 and 297).

    What is NOT shared is the head, and that is the whole difference: a `[96]`
    run is not a complete key, so this lemma takes the run's `block-key` re-read
    from its caller — which holds it as the very evidence the property dispatch
    just produced — instead of reading a scalar back with
    `implicitKeyHead_of_dispatch`.  The content that will FINISH the key has not
    been scanned yet; item 17's consumer reads it one step later, off
    `pendingProps`, and composes `[161]`'s `propsContent` arm around it.

    The §7.4 datum is where the two packs differ in DIRECTION.
    `ImplicitKeyPack` demands `simpleKey.pos.line = line` as the guard its
    consumer observes on its own post-state; a run carries it, because the
    consumer that will read the guard is a step further on and the key the `:`
    resolves was saved AT the property.  Both come from the same fresh-save
    shape, and an inherited key punts on both. -/
lemma entryPropsKeyPack_of_dispatch
    (sc : ScannerState) (sp_start sp_scan : SurfPos) (n : Nat)
    (s_prep s' : ScannerState) (c : Char) (sp_prep sp_scan' : SurfPos)
    -- Item 179: `n` is the RAW entry column; node-domain hypotheses read at
    -- the SHIFTED index, as at `entryKeyPack_of_dispatch`.
    (h_node : ∀ sp, SBlockNode (n + 1) .blockIn sp_scan sp → SLYamlStream sp_start sp)
    -- Item 106: `entryKeyPack_of_dispatch`'s new twin, verbatim — the frame's
    -- value line stated at `h_node`'s domain, for the LANDED branch, whose
    -- nesting the compact conjunct above cannot reach (`?⏎  &p a: b⏎: - w`).
    (h_nodeV : (∃ ns : List Nat, ∀ nv ∈ ns,
