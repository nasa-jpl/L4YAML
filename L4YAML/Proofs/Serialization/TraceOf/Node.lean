        (s s₁ s₂ s₃ s₄ s₅ s₆ s' : SurfPos) (ev1 ev2 : List Event) :
        GLit '?' s s₁ →
        SSeparate n c s₁ s₂ →
        TCFlowJsonNode n c s₂ s₃ ev1 →
        GOpt (SSeparate n c) s₃ s₄ →
        GLit ':' s₄ s₅ →
        GOpt (SSeparate n c) s₅ s₆ →
        TFlowNode n c s₆ s' ev2 →
        TFlowMapEntry n c s s' (ev1 ++ ev2)
    | bareKey (n : Nat) (c : YamlContext) (s s' : SurfPos) (ev1 : List Event) :
        TFlowNode n c s s' ev1 →
        TFlowMapEntry n c s s' (ev1)
    | emptyKeyValue (n : Nat) (c : YamlContext) (s s₁ s₂ s' : SurfPos) (ev1 : List Event) :
        GLit ':' s s₁ →
        SSeparate n c s₁ s₂ →
        TFlowNode n c s₂ s' ev1 →
        TFlowMapEntry n c s s' (ev1)
    | emptyKeyEmpty (n : Nat) (c : YamlContext) (s s' : SurfPos) :
        GLit ':' s s' →
        TFlowMapEntry n c s s' ([])
    | explicitEmptyNodes (n : Nat) (c : YamlContext) (s s₁ s' : SurfPos) :
        GLit '?' s s₁ →
        SSeparate n c s₁ s' →
        TFlowMapEntry n c s s' ([])
    | explicitEmptyKeyValue (n : Nat) (c : YamlContext) (s s₁ s₂ s₃ s₄ s' : SurfPos) (ev1 : List Event) :
        GLit '?' s s₁ →
        SSeparate n c s₁ s₂ →
        GLit ':' s₂ s₃ →
        SSeparate n c s₃ s₄ →
        TFlowNode n c s₄ s' ev1 →
        TFlowMapEntry n c s s' (ev1)
    | explicitEmptyKeyEmpty (n : Nat) (c : YamlContext) (s s₁ s₂ s' : SurfPos) :
        GLit '?' s s₁ →
        SSeparate n c s₁ s₂ →
        GLit ':' s₂ s' →
        TFlowMapEntry n c s s' ([])

end

end

end L4YAML.Proofs.Serialization.TraceOf
